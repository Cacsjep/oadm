<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Autofocus\Oadm.Plugins.Autofocus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- getCapabilities recorded read-only on the AXIS Virtual Loan Tool on 2026-11-24: AXIS P3735-PLE (AXIS OS 13.0.114,
         4 sensors) and AXIS P4708-PLVE (12.11.147, 2 sensors); one optics per sensor, the group view has none. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs plugins against a step list the way the task engine does. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk.Testing\Oadm.Sdk.Testing.csproj" />
  </ItemGroup>
</Project>
