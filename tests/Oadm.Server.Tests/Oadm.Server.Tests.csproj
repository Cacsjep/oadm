    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oadm.Server\Oadm.Server.csproj" />
    <!-- SelfCheckTests: a real plugin with a real library to take away. -->
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Notifications\Oadm.Plugins.Notifications.csproj" />
    <ProjectReference Include="..\..\src\Oadm.Sdk.Testing\Oadm.Sdk.Testing.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Restart\Oadm.Plugins.Restart.csproj" />
    <!-- The bundled tasks the tools of AI agents offer and refuse (docs/spec/mcp.md "Tasks"). -->
