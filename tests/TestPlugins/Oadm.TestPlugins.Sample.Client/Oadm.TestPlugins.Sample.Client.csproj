<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only client plugin part: a toolbar plugin, built into artifacts/test-plugins/oadm.sample/
       next to the server part and loaded at runtime by the client plugin loader tests. -->

  <PropertyGroup>
    <AssemblyName>Oadm.TestPlugins.Sample.Client</AssemblyName>
    <RootNamespace>Oadm.TestPlugins.Sample.Client</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
    <OadmPluginId>oadm.sample</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'artifacts', 'test-plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia and the SDKs are shared from the client host: compile against them, never copy them. -->
    <PackageReference Include="Avalonia" Version="12.0.4" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\src\Oadm.Sdk.Client\Oadm.Sdk.Client.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
