<Project>

  <!-- The real model and photos of the RealModel tests (docs/spec/vision-center.md "Tests"): never in git, never shipped.
       Downloaded only when the build is asked for them (-p:OadmRealModels=true; manage test models) from their pinned
       revisions into the cache Text recognition uses ($(OADM_MODEL_CACHE), else %LOCALAPPDATA%\Oadm\model-cache or
       ~/.cache/oadm/models), each in a folder named after its SHA-256, and checked. A failed download or another hash never
       fails the build: the file is left out and the tests skip with the reason. The tests find the files through the
       assembly metadata "RealModelFile" (name|path|sha256). Keep the table in plugins/Oadm.Plugins.Vision/README.md
       "Tests" the same (RealModelSourcesTests compares them). -->

  <PropertyGroup>
    <VisionRealModelCache Condition="'$(VisionRealModelCache)' == ''">$(OADM_MODEL_CACHE)</VisionRealModelCache>
    <VisionRealModelCache Condition="'$(VisionRealModelCache)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\Oadm\model-cache</VisionRealModelCache>
    <VisionRealModelCache Condition="'$(VisionRealModelCache)' == ''">$(HOME)/.cache/oadm/models</VisionRealModelCache>
    <VisionRealModelCache>$([MSBuild]::EnsureTrailingSlash('$(VisionRealModelCache)'))</VisionRealModelCache>
  </PropertyGroup>

  <ItemGroup>
    <VisionRealModelFile Include="rf-detr-medium.onnx"
                         Url="https://huggingface.co/PierreMarieCurie/rf-detr-onnx/resolve/94f91976449c187be38e649863e3dadecc312437/rf-detr-medium.onnx"
                         Sha256="18250b5a3a9552ae117d592f8e8c27fe52438d70c914a77a8913fc45d8f29e69" />
    <VisionRealModelFile Include="rf-detr-small.onnx"
                         Url="https://huggingface.co/PierreMarieCurie/rf-detr-onnx/resolve/94f91976449c187be38e649863e3dadecc312437/rf-detr-small.onnx"
                         Sha256="0e0817f4cafa479ccba17662a142092932b0b10c98947e7cf60f3badd0f5c219" />
    <VisionRealModelFile Include="detr-resnet-50.onnx"
                         Url="https://huggingface.co/Xenova/detr-resnet-50/resolve/8be7ab59ff663484ee9ba2e8d8f267330d5ad03e/onnx/model.onnx"
                         Sha256="5dffb3205e68b0be1686eea283ecf87e7592d3dceed5dfc83249f7303e9e95e8" />
    <VisionRealModelFile Include="detr-resnet-50-quantized.onnx"
                         Url="https://huggingface.co/Xenova/detr-resnet-50/resolve/8be7ab59ff663484ee9ba2e8d8f267330d5ad03e/onnx/model_quantized.onnx"
                         Sha256="cae09a307ed9247da7e2ce8bcf81522a6817f1ea2e82b9c4dde59f5964b62b4f" />
    <VisionRealModelFile Include="rtdetr-v2-r18vd.onnx"
                         Url="https://huggingface.co/onnx-community/rtdetr_v2_r18vd-ONNX/resolve/936f90b6a476c6da4dfe053fc521af55285976ba/onnx/model.onnx"
                         Sha256="583a236ac21c95a7fd94f284fc21485e42355bfef82c27011ba78fbc09ee87e2" />
    <VisionRealModelFile Include="dfine-s-coco.onnx"
                         Url="https://huggingface.co/onnx-community/dfine_s_coco-ONNX/resolve/a3cf03147a9b86c78475139115c8ac142577352d/onnx/model.onnx"
                         Sha256="cd8a49a945feda6d28c6304ae8ae85c2759ba1d78a5a83a22c5ce8db82ef7238" />
    <VisionRealModelFile Include="resnet-50.onnx"
                         Url="https://huggingface.co/Xenova/resnet-50/resolve/a16f29143f08c4e5c5a4a89f6f185d8edac4b6af/onnx/model.onnx"
                         Sha256="7e6fd9fa712c93139c2dab22fe109232d9fb760e3ddea117110f72de9d4f665a" />
    <VisionRealModelFile Include="resnet-50-config.json"
                         Url="https://huggingface.co/Xenova/resnet-50/resolve/a16f29143f08c4e5c5a4a89f6f185d8edac4b6af/config.json"
                         Sha256="47c111a56be828e8b0c4b7860be8279abf78aae0287c9baf5981dc813bf43606" />
    <VisionRealModelFile Include="mobilenetv2-12.onnx"
                         Url="https://media.githubusercontent.com/media/onnx/models/c5cae0f1942c8d7727372c7b1f6b485aa39e4421/validated/vision/classification/mobilenet/model/mobilenetv2-12.onnx"
                         Sha256="c0c3f76d93fa3fd6580652a45618618a220fced18babf65774ed169de0432ad5" />
    <VisionRealModelFile Include="yolo11n-cls.onnx"
                         Url="https://huggingface.co/mobilint/YOLO11n-cls/resolve/ea1f8e6d3e3f4441bbc09052ab532d36e694186d/yolo11n-cls.onnx"
                         Sha256="fe2a60c3a3dd68bc5ef28195caa0300e5622ef814cfab01f6c14c1e5589edd55" />
    <VisionRealModelFile Include="coco-000000278705.jpg"
                         Url="http://images.cocodataset.org/val2017/000000278705.jpg"
                         Sha256="d01c906a85c3f77702bdbf9dc7cedf11310e9aa47c6730927f51d9651dece310" />
    <VisionRealModelFile Include="coco-000000065350.jpg"
                         Url="http://images.cocodataset.org/val2017/000000065350.jpg"
                         Sha256="963a129714e3675b99b6a405a2cb46eca5678241358bb6b6bbefc3c3f1943ae0" />
  </ItemGroup>

  <!-- One assembly metadata per file, also without the download: the tests skip by what is in the cache. -->
  <Target Name="VisionRealModelMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RealModelFile</_Parameter1>
        <_Parameter2>%(VisionRealModelFile.Identity)|$(VisionRealModelCache)%(VisionRealModelFile.Sha256)/%(VisionRealModelFile.Identity)|%(VisionRealModelFile.Sha256)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="VisionFetchRealModels" BeforeTargets="BeforeBuild" Condition="'$(OadmRealModels)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_VisionRealMissing Include="@(VisionRealModelFile)" Condition="!Exists('$(VisionRealModelCache)%(VisionRealModelFile.Sha256)/%(VisionRealModelFile.Identity)')">
        <Folder>$(VisionRealModelCache)%(VisionRealModelFile.Sha256)/</Folder>
        <Download>$(VisionRealModelCache)%(VisionRealModelFile.Sha256)/%(VisionRealModelFile.Identity).download</Download>
      </_VisionRealMissing>
    </ItemGroup>

    <Message Importance="high" Text="Vision Center tests: downloading %(_VisionRealMissing.Identity) into $(VisionRealModelCache)" Condition="'@(_VisionRealMissing)' != ''" />
    <DownloadFile SourceUrl="%(_VisionRealMissing.Url)" DestinationFolder="%(_VisionRealMissing.Folder)" DestinationFileName="%(_VisionRealMissing.Identity).download" Retries="3" RetryDelayMilliseconds="5000" ContinueOnError="true" Condition="'@(_VisionRealMissing)' != ''" />

    <ItemGroup>
      <_VisionRealArrived Include="@(_VisionRealMissing->'%(Download)')" Condition="Exists('%(_VisionRealMissing.Download)')" />
    </ItemGroup>
    <GetFileHash Files="@(_VisionRealArrived)" Algorithm="SHA256" Condition="'@(_VisionRealArrived)' != ''">
      <Output TaskParameter="Items" ItemName="_VisionRealDownloaded" />
    </GetFileHash>

    <!-- A good file goes into the cache; one with another hash is deleted and its tests skip. -->
    <Move SourceFiles="%(_VisionRealDownloaded.Identity)" DestinationFiles="%(_VisionRealDownloaded.Folder)%(_VisionRealDownloaded.Filename)" Condition="'@(_VisionRealDownloaded)' != '' and '%(_VisionRealDownloaded.FileHash)' == '%(_VisionRealDownloaded.Sha256)'" />
    <Message Importance="high" Condition="'@(_VisionRealDownloaded)' != '' and '%(_VisionRealDownloaded.FileHash)' != '%(_VisionRealDownloaded.Sha256)'"
             Text="Vision Center tests: %(_VisionRealDownloaded.Filename) from %(_VisionRealDownloaded.Url) has the SHA-256 %(_VisionRealDownloaded.FileHash), expected %(_VisionRealDownloaded.Sha256); deleted, its tests skip." />
    <Delete Files="%(_VisionRealDownloaded.Identity)" Condition="'@(_VisionRealDownloaded)' != '' and '%(_VisionRealDownloaded.FileHash)' != '%(_VisionRealDownloaded.Sha256)'" />
  </Target>

</Project>
