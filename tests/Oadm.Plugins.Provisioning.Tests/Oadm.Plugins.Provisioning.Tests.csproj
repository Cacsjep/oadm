<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA2000;CA1849;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- The page's headless screenshots. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <!-- The configuration file ADM wrote from an AXIS P3265-V (Device configuration's tests): the file of the Configuration node. -->
  <ItemGroup>
    <None Include="..\Oadm.Plugins.DeviceConfig.Tests\Fixtures\configure\adm-p3265v-12.11.77.cfg" Link="Fixtures\adm-p3265v-12.11.77.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oadm.Client supplies the host theme (OadmTheme.axaml), the host page around the view and the shared runtime
         assemblies (Avalonia, CommunityToolkit, SDK) the client part compiles against only. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk.Testing\Oadm.Sdk.Testing.csproj" />
    <ProjectReference Include="..\..\src\Oadm.Client\Oadm.Client.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Provisioning\Oadm.Plugins.Provisioning.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Provisioning.Client\Oadm.Plugins.Provisioning.Client.csproj" />
  </ItemGroup>
</Project>
