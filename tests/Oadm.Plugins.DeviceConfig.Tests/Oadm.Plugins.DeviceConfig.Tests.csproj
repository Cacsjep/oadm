<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA2000;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- In-process server for the hardware test, dev-cameras.yaml loader. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oadm.Client supplies the host theme (OadmTheme.axaml), the fake API and the shared runtime assemblies
         (Avalonia, CommunityToolkit, SDK) that the plugin projects compile against only. -->
    <ProjectReference Include="..\..\src\Oadm.Client\Oadm.Client.csproj" />
    <ProjectReference Include="..\..\src\Oadm.Server\Oadm.Server.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.DeviceConfig\Oadm.Plugins.DeviceConfig.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.DeviceConfig.Client\Oadm.Plugins.DeviceConfig.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared dev-cameras.yaml loader of the core hardware tests. -->
    <Compile Include="..\Oadm.Core.Tests\Hardware\DevCameras.cs" Link="Hardware\DevCameras.cs" />
    <Compile Include="..\Oadm.Core.Tests\Hardware\HardwareFactAttribute.cs" Link="Hardware\HardwareFactAttribute.cs" />
    <!-- The engine's step end rules for step assertions. -->
    <Compile Include="..\Shared\StepRun.cs" Link="Shared\StepRun.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded read-only from 10.0.0.48 (AXIS P3265-V, AXIS OS 12.11.77). -->
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
