<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA2000;CA1849;CA5394;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oadm.Client supplies the host theme (OadmTheme.axaml) and the shared runtime assemblies (Avalonia, CommunityToolkit,
         SDK) the plugin projects compile against only; Oadm.Core the core plugin host and the plugin event hub. -->
    <ProjectReference Include="..\..\src\Oadm.Client\Oadm.Client.csproj" />
    <ProjectReference Include="..\..\src\Oadm.Core\Oadm.Core.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.NtpServer\Oadm.Plugins.NtpServer.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.NtpServer.Client\Oadm.Plugins.NtpServer.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\StepRun.cs" Link="Shared\StepRun.cs" />
    <!-- The stateful fake camera (recorded 10.0.0.48 NTP answers) of the Date and time tests: the task reuses that plugin's requests. -->
    <Compile Include="..\Oadm.Plugins.DateTime.Tests\Fakes.cs" Link="DateTime\Fakes.cs" />
    <None Include="..\Oadm.Plugins.DateTime.Tests\Fixtures\*" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fake host firewall (NTP / DHCP firewall rules). -->
    <Compile Include="..\Shared\RecordingFirewall.cs" Link="Shared\RecordingFirewall.cs" />
  </ItemGroup>

</Project>
