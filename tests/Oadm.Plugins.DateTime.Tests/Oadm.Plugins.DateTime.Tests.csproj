<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host client supplies the real theme for the headless dialog test. -->
    <ProjectReference Include="..\..\src\Oadm.Client\Oadm.Client.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.DateTime\Oadm.Plugins.DateTime.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.DateTime.Client\Oadm.Plugins.DateTime.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs plugins against a step list the way the task engine does. -->
    <Compile Include="..\Shared\StepRun.cs" Link="Shared\StepRun.cs" />
  </ItemGroup>
</Project>
