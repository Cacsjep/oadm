<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA2000;CA1849;CA5394;CA1001;CA5359</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded read-only answers and the public device ID certificates of 10.0.0.48 (P3265-V, AXIS OS 12.11.77). -->
    <None Include="Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oadm.Sdk.Testing\Oadm.Sdk.Testing.csproj" />
    <!-- Oadm.Client supplies the host theme and the host page view for the page tests. -->
    <ProjectReference Include="..\..\src\Oadm.Client\Oadm.Client.csproj" />
    <!-- The EST server is part of the PKI package (Est/ in both projects). -->
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Pki\Oadm.Plugins.Pki.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Pki.Client\Oadm.Plugins.Pki.Client.csproj" />
    <!-- The hardware test: the real VAPIX client and the dev cameras. -->
    <ProjectReference Include="..\..\src\Oadm.Core\Oadm.Core.csproj" />
    <Compile Include="..\Oadm.Core.Tests\Hardware\DevCameras.cs" Link="Hardware\DevCameras.cs" />
  </ItemGroup>
</Project>
