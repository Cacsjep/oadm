<?xml version="1.0" encoding="iso-8859-1" ?>
<parameterDefinitions
xmlns="http://www.axis.com/ParameterDefinitionsSchema"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.axis.com/ParameterDefinitionsSchema https://10.0.0.48/pub/parameterdefinitions.xsd"
version="1.0">
  <model>AXIS P3265-V</model>
  <firmwareVersion>12.11.77</firmwareVersion>
  <group name="root">
    <group name="Network">
      <group name="Interface">
        <group name="I0">
          <group name="dot1x">
            <parameter name="EAPOLVersion" value="3" securityLevel="7766" niceName="EAPOL version">
              <type>
                <enum>
                  <entry value="1" />
                  <entry value="2" />
                  <entry value="3" />
                </enum>
              </type>
            </parameter>
            <parameter name="Enabled" value="no" securityLevel="7766" niceName="Enabled">
              <type>
                <bool true="yes" false="no" />
              </type>
            </parameter>
            <parameter name="Status" value="Stopped" securityLevel="7767" niceName="Status">
              <type readonly="true">
                <string />
              </type>
            </parameter>
            <group name="EAP">
              <parameter name="MultiAuthEnabled" value="no" securityLevel="7766" niceName="Multi auth enabled">
                <type>
                  <bool true="yes" false="no" />
                </type>
              </parameter>
            </group>
            <group name="EAPTLS">
              <parameter name="Identity" value="48" securityLevel="7766" niceName="Identity">
                <type>
                  <string maxlen="128" />
                </type>
              </parameter>
              <parameter name="PrivateKeyPassword" value="******" securityLevel="7766" niceName="Private key password">
                <type writeonly="true">
                  <password maxlen="16" />
                </type>
              </parameter>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group name="HTTPS">
      <parameter name="Ciphers" value="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305" securityLevel="7706" niceName="Ciphers">
        <type>
          <string />
        </type>
      </parameter>
      <parameter name="Enabled" value="yes" securityLevel="7706" niceName="Enabled">
        <type>
          <bool true="yes" false="no" />
        </type>
      </parameter>
      <parameter name="Port" value="443" securityLevel="7706" niceName="Port">
        <type>
          <int min="1" max="65535" />
        </type>
      </parameter>
    </group>
    <group name="Network">
      <group name="HTTP">
        <parameter name="AuthenticationPolicy" value="recommended" securityLevel="7716" niceName="Authentication policy">
          <type>
            <enum>
              <entry value="basic" niceValue="Basic" />
              <entry value="digest" niceValue="Digest" />
              <entry value="basic_digest" niceValue="Basic and Digest" />
              <entry value="recommended" niceValue="Recommended" />
            </enum>
          </type>
        </parameter>
        <parameter name="AuthenticationWithQop" value="no" securityLevel="7716" niceName="Authentication with qop">
          <type>
            <bool true="yes" false="no" />
          </type>
        </parameter>
      </group>
    </group>
  </group>
</parameterDefinitions>
