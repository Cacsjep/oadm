<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA2000;CA1849;CA5394;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded read-only answers of 10.0.0.48 (AXIS OS 12.11) from the PKI research, plus the time-service answer. -->
    <None Include="Fixtures\*.json;Fixtures\*.xml;Fixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Oadm.Plugins.DateTime.Tests\Fixtures\time-service-getDateTimeInfo-P3265-V-12.11.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Runs plugins against a step list the way the task engine does. -->
    <Compile Include="..\Shared\StepRun.cs" Link="Shared\StepRun.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oadm.Client supplies the host theme (OadmTheme.axaml), the host page view and the fake backend; Oadm.Core the
         event hub, the secret protector and the trust anchor registry. -->
    <ProjectReference Include="..\..\src\Oadm.Client\Oadm.Client.csproj" />
    <ProjectReference Include="..\..\src\Oadm.Core\Oadm.Core.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Pki\Oadm.Plugins.Pki.csproj" />
    <ProjectReference Include="..\..\plugins\Oadm.Plugins.Pki.Client\Oadm.Plugins.Pki.Client.csproj" />
  </ItemGroup>
</Project>
