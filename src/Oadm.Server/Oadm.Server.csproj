<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Oadm.Server</RootNamespace>
    <!-- No web.config on publish: it only serves IIS hosting; OADM runs as its own service / console process (gRPC only, no web API). -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- No static web files either (gRPC only): no staticwebassets manifests in the publish folder. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oadm.Core\Oadm.Core.csproj" />
    <ProjectReference Include="..\Oadm.Contracts\Oadm.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Windows service (MSI) and systemd unit (.deb); both are no-ops on a console. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Server.Tests" />
  </ItemGroup>

</Project>
