<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Oadm.Server</RootNamespace>
    <!-- No web.config on publish: it only serves IIS hosting; OADM runs as its own service / console process (gRPC only, no web API). -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- No static web files either (gRPC only): no staticwebassets manifests in the publish folder. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oadm.Core\Oadm.Core.csproj" />
    <ProjectReference Include="..\Oadm.Contracts\Oadm.Contracts.csproj" />
    <ProjectReference Include="..\Oadm.Sites\Oadm.Sites.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Windows service (MSI) and systemd unit (.deb); both are no-ops on a console. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The release's list of Axis CVEs (docs/spec/vulnerabilities.md; made by tools/Oadm.Vulnerabilities). -->
    <EmbeddedResource Include="Vulnerabilities\axis-vulnerabilities.json" LogicalName="Oadm.Server.Vulnerabilities.axis-vulnerabilities.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Server.Tests" />
  </ItemGroup>

  <!-- The SHA-256 of the add-on ZIPs of this version and system (docs/spec/add-ons.md rule 2): the file "manage package addons"
       writes, one "<plugin id> <sha256> <fingerprint>" per line, becomes one assembly metadata per add-on (read by AssemblyAddOnHashes).
       In the assembly itself, so it survives PublishSingleFile. Without the property the build has no hashes. -->
  <Target Name="OadmAddOnHashMetadata" BeforeTargets="GetAssemblyAttributes" Condition="'$(OadmAddOnHashFile)' != ''">
    <Error Condition="!Exists('$(OadmAddOnHashFile)')" Text="OadmAddOnHashFile: $(OadmAddOnHashFile) does not exist." />
    <ReadLinesFromFile File="$(OadmAddOnHashFile)">
      <Output TaskParameter="Lines" ItemName="_OadmAddOnHashLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_OadmAddOnHash Include="@(_OadmAddOnHashLine)">
        <PluginId>$([System.String]::Copy('%(Identity)').Split(' ')[0])</PluginId>
        <Sha256>$([System.String]::Copy('%(Identity)').Split(' ')[1])</Sha256>
        <Content>$([System.String]::Copy('%(Identity) none').Split(' ')[2])</Content>
      </_OadmAddOnHash>
      <AssemblyMetadata Include="@(_OadmAddOnHash->'OadmAddOnSha256:%(PluginId)')" Value="%(_OadmAddOnHash.Sha256)" />
      <AssemblyMetadata Include="@(_OadmAddOnHash->'OadmAddOnContent:%(PluginId)')" Value="%(_OadmAddOnHash.Content)" />
    </ItemGroup>
  </Target>

</Project>
