<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    OADM colors, light appearance (Settings > This computer). The keys must match the other appearance's file (ThemeColorsTests);
    loaded by OadmColors (OadmColors.cs), brushes and styles are in OadmTheme.axaml.
  -->
  <Color x:Key="Oadm.WindowBackgroundColor">#F3F3F3</Color>
  <Color x:Key="Oadm.CardBackgroundColor">#FFFFFF</Color>
  <Color x:Key="Oadm.SurfaceRaisedColor">#E8E8E8</Color>
  <Color x:Key="Oadm.SurfaceHoverColor">#EDEDED</Color>
  <!-- Navigation rail: hover and the selected entry, quieter than the raised surfaces of buttons and menus -->
  <Color x:Key="Oadm.NavHoverColor">#EAEAEA</Color>
  <Color x:Key="Oadm.NavSelectedColor">#E3E3E3</Color>
  <Color x:Key="Oadm.InputBackgroundColor">#FFFFFF</Color>
  <Color x:Key="Oadm.BorderColor">#E5E5E5</Color>
  <Color x:Key="Oadm.InputBorderColor">#C8C8C8</Color>
  <Color x:Key="Oadm.AccentColor">#6C5CE7</Color>
  <Color x:Key="Oadm.AccentHoverColor">#5B4BD6</Color>
  <Color x:Key="Oadm.AccentPressedColor">#4A3BC4</Color>
  <Color x:Key="Oadm.AccentMutedColor">#7D6EF0</Color>
  <!-- A disabled primary keeps its role: the accent at about 35 % on the card -->
  <Color x:Key="Oadm.AccentDisabledColor">#596C5CE7</Color>
  <Color x:Key="Oadm.TextOnAccentDisabledColor">#99FFFFFF</Color>
  <!-- Danger buttons (delete, remove): red fill with white text -->
  <Color x:Key="Oadm.DangerColor">#C73B34</Color>
  <Color x:Key="Oadm.DangerHoverColor">#D9463F</Color>
  <Color x:Key="Oadm.DangerPressedColor">#AE322C</Color>
  <Color x:Key="Oadm.DangerDisabledColor">#59C73B34</Color>
  <!-- Buttons placed on a raised surface (inline editors) need a lighter fill to read as buttons -->
  <Color x:Key="Oadm.ButtonOnRaisedColor">#D6D6D6</Color>
  <Color x:Key="Oadm.ButtonOnRaisedHoverColor">#CBCBCB</Color>
  <!-- The purple of the app icon (lens of the splash logo) -->
  <Color x:Key="Oadm.BrandColor">#5B2D8E</Color>
  <Color x:Key="Oadm.SelectionColor">#336C5CE7</Color>
  <Color x:Key="Oadm.SelectionHoverColor">#4D6C5CE7</Color>
  <Color x:Key="Oadm.GridRowHoverColor">#F2F2F2</Color>
  <Color x:Key="Oadm.GridHeaderHoverColor">#F0F0F0</Color>
  <Color x:Key="Oadm.CaptionHoverColor">#E5E5E5</Color>
  <Color x:Key="Oadm.CaptionPressedColor">#D6D6D6</Color>
  <Color x:Key="Oadm.SplitterGripColor">#D0D0D0</Color>
  <Color x:Key="Oadm.TealColor">#1F8A94</Color>
  <Color x:Key="Oadm.TextPrimaryColor">#1A1A1A</Color>
  <Color x:Key="Oadm.TextSecondaryColor">#616161</Color>
  <Color x:Key="Oadm.TextDisabledColor">#A3A3A3</Color>
  <Color x:Key="Oadm.TextOnAccentColor">#FFFFFF</Color>
  <Color x:Key="Oadm.IconColor">#424242</Color>
  <Color x:Key="Oadm.StatusOkColor">#1E8E5A</Color>
  <Color x:Key="Oadm.StatusWarningColor">#B7791F</Color>
  <Color x:Key="Oadm.StatusErrorColor">#C93C37</Color>
  <Color x:Key="Oadm.StatusNeutralColor">#707070</Color>
  <Color x:Key="Oadm.StatusInfoColor">#2F80C8</Color>
  <Color x:Key="Oadm.StatusOkBackgroundColor">#263FB27F</Color>
  <Color x:Key="Oadm.StatusWarningBackgroundColor">#26E0A43A</Color>
  <Color x:Key="Oadm.StatusErrorBackgroundColor">#26E5534B</Color>
  <Color x:Key="Oadm.StatusNeutralBackgroundColor">#268A8A8A</Color>
  <Color x:Key="Oadm.StatusAccentBackgroundColor">#336C5CE7</Color>
  <!-- Callouts (login problems): a faint fill of the status color and a stronger border -->
  <Color x:Key="Oadm.StatusInfoBackgroundColor">#1F2F80C8</Color>
  <Color x:Key="Oadm.StatusErrorBorderColor">#99E5534B</Color>
  <Color x:Key="Oadm.StatusWarningBorderColor">#99E0A43A</Color>
  <Color x:Key="Oadm.StatusInfoBorderColor">#802F80C8</Color>
  <!-- Status chip fills: solid, slightly darker than the status colors so white text stays readable -->
  <Color x:Key="Oadm.ChipOkColor">#2B8A5E</Color>
  <Color x:Key="Oadm.ChipWarningColor">#A86F0E</Color>
  <Color x:Key="Oadm.ChipErrorColor">#C73B34</Color>
  <Color x:Key="Oadm.ChipAccentColor">#6253DB</Color>
  <Color x:Key="Oadm.ChipNeutralColor">#5F5F5F</Color>
  <Color x:Key="Oadm.ChipTextColor">#FFFFFF</Color>
  <Color x:Key="Oadm.OverlayColor">#E6FFFFFF</Color>
  <Color x:Key="Oadm.VideoBackgroundColor">#0C0C0C</Color>
  <!-- Code highlighting (ui:CodeView): readable on the white input background -->
  <Color x:Key="Oadm.Code.KeyColor">#1F7A85</Color>
  <Color x:Key="Oadm.Code.StringColor">#A0522D</Color>
  <Color x:Key="Oadm.Code.NumberColor">#3D7A1E</Color>
  <Color x:Key="Oadm.Code.LiteralColor">#5B4BD6</Color>
  <Color x:Key="Oadm.Code.PunctuationColor">#6E6E6E</Color>
  <Color x:Key="Oadm.Code.TagColor">#2457A6</Color>
  <Color x:Key="Oadm.Code.AttributeColor">#1F7A85</Color>
  <Color x:Key="Oadm.Code.CommentColor">#5E7A5F</Color>
  <Color x:Key="Oadm.Code.ErrorColor">#C93C37</Color>
  <!-- Tag palette (device tags): readable as text on the white cards and the chip background -->
  <Color x:Key="Oadm.Tag.BlueColor">#2F6FCC</Color>
  <Color x:Key="Oadm.Tag.GreenColor">#1F8A50</Color>
  <Color x:Key="Oadm.Tag.TealColor">#1D8A94</Color>
  <Color x:Key="Oadm.Tag.AmberColor">#946A00</Color>
  <Color x:Key="Oadm.Tag.OrangeColor">#BD5A12</Color>
  <Color x:Key="Oadm.Tag.RedColor">#C83A3A</Color>
  <Color x:Key="Oadm.Tag.PinkColor">#C2387F</Color>
  <Color x:Key="Oadm.Tag.VioletColor">#6A55D8</Color>
  <Color x:Key="Oadm.Tag.NeutralColor">#6B6B6B</Color>
  <Color x:Key="Oadm.Tag.ChipBackgroundColor">#ECECEC</Color>
  <!-- Neutral badges (what a row is, Border.badge.neutral) -->
  <Color x:Key="Oadm.BadgeNeutralColor">#E6E6E6</Color>
  <!-- Menus, context menus and flyouts -->
  <Color x:Key="Oadm.MenuBackgroundColor">#FFFFFF</Color>
  <!-- Covers a whole camera picture while it is edited (Live View), lighter than the plates so the picture shows -->
  <Color x:Key="Oadm.VideoCoverColor">#99FFFFFF</Color>
  <!-- Dims the picture around the autofocus area: dark in both appearances -->
  <Color x:Key="Oadm.VideoDimColor">#99000000</Color>
  <!-- The hexagons of the start splash logo -->
  <Color x:Key="Oadm.LogoColor">#262626</Color>
</ResourceDictionary>
