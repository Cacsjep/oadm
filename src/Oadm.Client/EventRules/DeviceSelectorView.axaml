<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Client.EventRules"
             x:Class="Oadm.Client.EventRules.DeviceSelectorView"
             x:DataType="vm:DeviceSelectorViewModel">
  <!-- Which devices: one purple button that says what is chosen ("Selected devices: Tag Building A") and opens the shared
       device picker (the device of the event, All devices, or chosen devices and tags); the addresses as tooltip. -->
  <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding ChooseDevicesCommand}" ToolTip.Tip="{Binding ChosenText}">
    <ui:IconLabel Icon="{StaticResource Icon.devices}" Text="{Binding ButtonText}" />
  </Button>
</UserControl>
