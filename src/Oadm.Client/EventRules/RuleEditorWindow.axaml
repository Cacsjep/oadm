<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.EventRules"
        x:Class="Oadm.Client.EventRules.RuleEditorWindow"
        x:DataType="vm:RuleEditorViewModel"
        Title="{Binding Title}"
        Width="1160" Height="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- A wizard: title bar, the step switch, one step at a time in a scroll area, footer with
       Back / Next, Save on the overview. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <ui:WizardSteps Grid.Row="1" ItemsSource="{Binding Steps}" Margin="12,0,16,12" />

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{DynamicResource Oadm.Gap}" Margin="16,0,16,8">

        <!-- 1 Rule: name, turned on, limits against event storms -->
        <Border Classes="card" IsVisible="{Binding IsRuleStep}">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="24">
              <ui:FormField Label="Name">
                <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="64" />
              </ui:FormField>
              <CheckBox Content="Turned on" IsChecked="{Binding Enabled}" VerticalAlignment="Top" />
            </StackPanel>
            <StackPanel Classes="form">
              <TextBlock Classes="sectionTitle" Text="Limits" />
              <ui:FormField Label="Dead time (s)" InputWidth="120"
                            Info="After the rule ran for a device, that device is ignored for this many seconds. Stops a flickering event from running the actions again and again.">
                <TextBox Text="{Binding Cooldown}" />
              </ui:FormField>
              <ui:FormField Label="Max per minute" InputWidth="120"
                            Info="At most this many runs per minute for all devices together. Further events are skipped and noted in the event log.">
                <TextBox Text="{Binding MaxRuns}" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 2 When: the trigger and any number of "And" -->
        <Border Classes="card" IsVisible="{Binding IsWhenStep}">
          <StackPanel Spacing="12">
            <ui:CardHeader Title="Conditions" Description="{Binding StateHint}" />
            <ItemsControl ItemsSource="{Binding Conditions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConditionViewModel">
                  <Border Classes="ruleItem">
                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                      <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{Binding Title}" VerticalAlignment="Top" Margin="0,6,0,0" />
                      <StackPanel Grid.Column="1" Spacing="8">
                        <!-- Event -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsEvent}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox ItemsSource="{Binding EventTypes}" SelectedItem="{Binding SelectedEventType}" PlaceholderText="Choose an event"
                                      HorizontalAlignment="Stretch" />
                            <ui:InfoIcon Grid.Column="1" Text="{Binding EventDescription}" />
                          </Grid>
                          <Panel IsVisible="{Binding ShowSelector}">
                            <vm:DeviceSelectorView DataContext="{Binding Selector}" />
                          </Panel>
                          <ItemsControl ItemsSource="{Binding Filters}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:FilterFieldViewModel">
                                <ui:FormField Label="{Binding Label}" Hint="Optional">
                                  <TextBox Text="{Binding Value}" />
                                </ui:FormField>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <!-- Schedule -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSchedule}">
                          <TextBlock Classes="secondary" Text="Inside this time window (server time)" />
                          <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:DayToggle">
                                <ToggleButton Classes="day" Content="{Binding Text}" IsChecked="{Binding IsChecked}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="fieldLabel" Text="From" VerticalAlignment="Center" />
                            <TextBox Text="{Binding From}" Width="80" />
                            <TextBlock Classes="fieldLabel" Text="To" VerticalAlignment="Center" />
                            <TextBox Text="{Binding To}" Width="80" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="error small" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="toolbar iconOnly danger" VerticalAlignment="Top" ToolTip.Tip="Remove condition"
                              Command="{Binding RemoveCommand}" IsVisible="{Binding !IsTrigger}">
                        <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Command="{Binding AddEventConditionCommand}" IsEnabled="{Binding CanAddCondition}">
                <ui:IconLabel Icon="{StaticResource Icon.add}" Text="Add event" />
              </Button>
              <Button Classes="secondary" Command="{Binding AddScheduleCommand}" IsEnabled="{Binding CanAddCondition}">
                <ui:IconLabel Icon="{StaticResource Icon.clock}" Text="Add schedule" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 3 Then: one to five actions, in this order; the placeholders the texts can use on the right -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Oadm.Gap}" IsVisible="{Binding IsThenStep}">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <ui:CardHeader Title="Actions" Description="They run in this order." />
            <ItemsControl ItemsSource="{Binding RuleActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleActionViewModel">
                  <Border Classes="ruleItem">
                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                      <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Then" VerticalAlignment="Top" Margin="0,6,0,0" />
                      <StackPanel Grid.Column="1" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" PlaceholderText="Choose an action" HorizontalAlignment="Stretch" />
                          <ui:InfoIcon Grid.Column="1" Text="{Binding Description}" />
                        </Grid>
                        <StackPanel Spacing="6" IsVisible="{Binding ShowTargets}">
                          <TextBlock Classes="fieldLabel" Text="On" />
                          <vm:DeviceSelectorView DataContext="{Binding Targets}" />
                        </StackPanel>
                        <vm:SettingsFormView Fields="{Binding Fields}" />
                        <TextBlock Classes="error small" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanTest}">
                          <Button Classes="secondary" Command="{Binding TestCommand}" ToolTip.Tip="Sends it once now, with sample event values">
                            <ui:IconLabel Icon="{StaticResource Icon.send}" Text="Send test" />
                          </Button>
                          <ui:StatusChip Text="{Binding TestResult}" IsOk="{Binding TestOk}" IsError="{Binding TestFailed}" IsAccent="{Binding IsTesting}"
                                         MaxLines="2" MaxWidth="460" ToolTip.Tip="{Binding TestResult}" IsVisible="{Binding HasTestResult}" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                        <Button Classes="toolbar iconOnly" ToolTip.Tip="Move up" Command="{Binding MoveUpCommand}">
                          <ui:OadmIcon Data="{StaticResource Icon.chevronUp}" />
                        </Button>
                        <Button Classes="toolbar iconOnly" ToolTip.Tip="Move down" Command="{Binding MoveDownCommand}">
                          <ui:OadmIcon Data="{StaticResource Icon.chevronDown}" />
                        </Button>
                        <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Remove action" Command="{Binding RemoveCommand}">
                          <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding AddActionCommand}" IsEnabled="{Binding CanAddAction}">
              <ui:IconLabel Icon="{StaticResource Icon.add}" Text="Add action" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Placeholders: what the texts of an action can use; each one copies with its button -->
        <Border Grid.Column="1" Classes="card" Width="300" VerticalAlignment="Top" IsVisible="{Binding ShowPlaceholders}">
          <StackPanel Spacing="10">
            <ui:CardHeader Title="Placeholders" Description="Use them in the texts of an action." />
            <ItemsControl ItemsSource="{Binding PlaceholderGroups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceholderGroup">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sectionTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaceholderItem">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Background="Transparent" ToolTip.Tip="{Binding Description}">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Classes="mono" Text="{Binding Text}" />
                              <TextBlock Classes="secondary small" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="toolbar iconOnly" ToolTip.Tip="Copy" Click="OnCopyPlaceholder" VerticalAlignment="Center">
                              <ui:OadmIcon Data="{StaticResource Icon.copy}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </Grid>

        <!-- 4 Overview: the whole rule in short lines, then Save -->
        <Border Classes="card" IsVisible="{Binding IsOverviewStep}">
          <StackPanel Spacing="12">
            <ui:CardHeader Title="Overview" Description="{Binding StateHint}" />
            <ItemsControl ItemsSource="{Binding Overview}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewLine">
                  <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="error" Text="{Binding ServerError}" IsVisible="{Binding HasServerError}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ui:DialogFooter Grid.Row="3" CancelCommand="{Binding CancelCommand}">
      <Button Classes="secondary" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
      <Button Classes="primary" IsDefault="True" Content="Next" Command="{Binding NextCommand}" IsVisible="{Binding !IsOverviewStep}"
              ToolTip.Tip="{Binding StepProblem}" ToolTip.ShowOnDisabled="True" />
      <Button Classes="primary" IsDefault="True" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsOverviewStep}"
              ToolTip.Tip="{Binding Problem}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
