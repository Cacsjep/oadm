<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:dev="using:Oadm.Client.Devices"
             x:Class="Oadm.Client.Controls.FirstPasswordChoiceBox"
             x:DataType="dev:FirstPasswordChoice"
             IsVisible="{Binding IsAvailable}">
  <!-- Right of a first password's fields: type a new password or use a password of root from the credential list.
       The eye shows the chosen entry's password with the Credentials page's rules (Administrators only, audited). -->
  <StackPanel Classes="form">
    <ui:FormField Classes="inline" Label="{x:Static dev:FirstPasswordChoice.Label}" Error="{Binding FieldError}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dev:FirstPasswordOption">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Classes="secondary" Text="{Binding AddedText}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ui:PasswordRevealButton Grid.Column="1" IsRevealed="{Binding IsRevealed}" Command="{Binding ToggleRevealCommand}"
                                   IsVisible="{Binding CanReveal}" IsEnabled="{Binding UsesCredential}" />
        </Grid>
        <!-- The stored password, masked like the Credentials page until the eye shows it -->
        <TextBlock Text="{Binding PasswordText}" TextWrapping="Wrap" IsVisible="{Binding ShowsStoredPassword}" />
      </StackPanel>
    </ui:FormField>
  </StackPanel>
</UserControl>
