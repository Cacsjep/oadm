<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:dev="using:Oadm.Client.Devices"
             xmlns:tasks="using:Oadm.Client.Tasks"
             xmlns:lv="using:Oadm.Client.LiveView"
             xmlns:v1="using:Oadm.Contracts.V1"
             x:Class="Oadm.Client.Devices.DevicesView"
             x:DataType="dev:DevicesViewModel">
  <!-- Rows: title, device card, splitter, tasks card. DevicesView.axaml.cs sizes the last two from the TasksViewModel. -->
  <Grid x:Name="LayoutRoot" RowDefinitions="Auto,*,Auto,Auto">
    <TextBlock Grid.Row="0" Classes="pageTitle" Text="Devices" Margin="4,0,0,16" />

    <!-- Device card, and the live view panel on its right while open (DevicesView.axaml.cs sizes the columns) -->
    <Grid x:Name="DeviceRow" Grid.Row="1" ColumnDefinitions="*,Auto,0">
    <!-- Device card: toolbar, status line, grid -->
    <Border Grid.Column="0" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}" MinHeight="{StaticResource Oadm.DevicesCardMinHeight}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <Button Classes="primary" Command="{Binding AddDevicesCommand}" ToolTip.Tip="Search the network with zero-configuration (Bonjour)" Margin="0,0,6,0">
              <ui:IconLabel Icon="{StaticResource Icon.add}" Text="Add devices" Spacing="8" />
            </Button>
            <Button Classes="toolbar" Command="{Binding AddFromRangeCommand}" ToolTip.Tip="Scan an IP address range">
              <ui:IconLabel Icon="{StaticResource Icon.range}" Text="Add from IP range" Spacing="8" />
            </Button>
            <Button Classes="toolbar" Command="{Binding RemoveCommand}">
              <ui:IconLabel Icon="{StaticResource Icon.remove}" Text="Remove" Spacing="8" />
            </Button>
            <Border Classes="vseparator" IsVisible="{Binding !!ToolbarActions.Count}" />
            <ItemsControl ItemsSource="{Binding ToolbarActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="v1:TaskPluginInfo">
                  <Button Classes="toolbar"
                          Command="{Binding $parent[UserControl].((dev:DevicesViewModel)DataContext).RunPluginCommand}"
                          CommandParameter="{Binding}">
                    <ui:IconLabel Icon="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Text="{Binding DisplayName}" Spacing="8" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="toolbar" ToolTip.Tip="Choose columns">
              <ui:IconLabel Icon="{StaticResource Icon.columns}" Text="Columns" Spacing="8" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="4" MinWidth="220">
                    <TextBlock Classes="secondary" Text="Visible columns" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Columns.Choosable}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dev:ColumnOptionViewModel">
                          <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <ui:SearchBox Text="{Binding SearchText}" />
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="secondary" Text="{Binding StatusLine}" Margin="2,14,0,8" />

        <Panel Grid.Row="2">
          <DataGrid x:Name="DeviceGrid"
                    ItemsSource="{Binding FilteredDevices}"
                    c:GridSelection.SelectedItems="{Binding SelectedDevices}"
                    SelectionMode="Extended"
                    IsReadOnly="True">
            <DataGrid.ContextMenu>
              <ContextMenu ItemsSource="{Binding ContextMenuEntries}">
                <ContextMenu.Styles>
                  <Style Selector="MenuItem" x:DataType="dev:MenuEntryViewModel">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="Icon">
                      <Template>
                        <ui:OadmIcon Data="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" />
                      </Template>
                    </Setter>
                  </Style>
                </ContextMenu.Styles>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Tag="icon" Width="44" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:DeviceRowViewModel">
                    <!-- Click: live view (video devices only) -->
                    <Button Classes="liveViewIcon" ToolTip.Tip="Live view"
                            IsEnabled="{Binding Converter={x:Static lv:LiveViewSupport.IsSupportedConverter}}"
                            Command="{Binding $parent[UserControl].((dev:DevicesViewModel)DataContext).LiveView.ToggleCommand}"
                            CommandParameter="{Binding}">
                    <Panel Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding CategoryTooltip}">
                      <ui:OadmIcon Data="{Binding CategoryIconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" />
                      <Ellipse Classes="statusDot" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Classes.ok="{Binding IsStatusOk}" Classes.warn="{Binding IsStatusWarning}" Classes.error="{Binding IsStatusError}" />
                    </Panel>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Tag="mac" Header="MAC address" Width="140*" MinWidth="70" Binding="{Binding Serial}" x:DataType="dev:DeviceRowViewModel" />
              <DataGridTemplateColumn Tag="status" Header="Status" Width="160*" MinWidth="70" SortMemberPath="StatusText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:DeviceRowViewModel">
                    <Border Classes="pill" Margin="10,0" Classes.ok="{Binding IsStatusOk}" Classes.warn="{Binding IsStatusWarning}" Classes.error="{Binding IsStatusError}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusText}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="address" Header="Address" Width="120*" MinWidth="70" SortMemberPath="DisplayAddress">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:DeviceRowViewModel">
                    <Button Classes="link" Margin="10,0" HorizontalAlignment="Left" ToolTip.Tip="Open the web interface of the device"
                            Command="{Binding $parent[UserControl].((dev:DevicesViewModel)DataContext).OpenWebUiCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding DisplayAddress}" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Tag="model" Header="Model" Width="160*" MinWidth="70" Binding="{Binding Model}" x:DataType="dev:DeviceRowViewModel" />
              <DataGridTextColumn Tag="firmware" Header="Firmware" Width="100*" MinWidth="70" Binding="{Binding FirmwareVersion}" x:DataType="dev:DeviceRowViewModel" />
              <DataGridTextColumn Tag="dhcp" Header="DHCP" Width="86*" MinWidth="70" Binding="{Binding DhcpText}" x:DataType="dev:DeviceRowViewModel" />
              <DataGridTextColumn Tag="https" Header="HTTPS" Width="96*" MinWidth="70" Binding="{Binding HttpsText}" x:DataType="dev:DeviceRowViewModel" />
              <DataGridTemplateColumn Tag="certExpires" Header="Certificate expires" Width="156*" MinWidth="70" SortMemberPath="CertExpiresSortKey">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:DeviceRowViewModel">
                    <Border Classes="pill" Margin="10,0" IsVisible="{Binding CertExpires.HasText}" ToolTip.Tip="{Binding CertTooltip}"
                            Classes.ok="{Binding CertExpires.IsOk}" Classes.warn="{Binding CertExpires.IsWarning}" Classes.error="{Binding CertExpires.IsError}">
                      <TextBlock Text="{Binding CertExpires.Text}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="certTrust" Header="Certificate" Width="110*" MinWidth="70" SortMemberPath="CertTrust.Text">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:DeviceRowViewModel">
                    <Border Classes="pill" Margin="10,0" IsVisible="{Binding CertTrust.HasText}" ToolTip.Tip="{Binding CertTooltip}"
                            Classes.ok="{Binding CertTrust.IsOk}" Classes.warn="{Binding CertTrust.IsWarning}" Classes.error="{Binding CertTrust.IsError}">
                      <TextBlock Text="{Binding CertTrust.Text}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Tag="dot1x" Header="IEEE 802.1X" Width="124*" MinWidth="70" Binding="{Binding Dot1xText}" x:DataType="dev:DeviceRowViewModel" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ui:OadmIcon Data="{StaticResource Icon.devices}" Width="32" Height="32" HorizontalAlignment="Center" />
            <TextBlock Classes="sectionTitle" Text="No devices yet" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" Text="Click Add devices to search the network, or Add from IP range." HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <GridSplitter x:Name="LiveSplitter" Grid.Column="1" Classes="paneSplitter vertical" IsVisible="{Binding LiveView.IsOpen}" />
    <c:LiveViewPanel x:Name="LivePanel" Grid.Column="2"
                     IsOpen="{Binding LiveView.IsOpen}"
                     Title="{Binding LiveView.Title}"
                     Subtitle="{Binding LiveView.Subtitle}"
                     StateText="{Binding LiveView.StateText}"
                     StateKind="{Binding LiveView.StateKind}"
                     DetailText="{Binding LiveView.DetailText}"
                     Source="{Binding LiveView.Image}"
                     CloseCommand="{Binding LiveView.CloseCommand}"
                     Sources="{Binding LiveView.Sources}"
                     HasSourceChoice="{Binding LiveView.HasSourceChoice}"
                     SelectSourceCommand="{Binding LiveView.SelectSourceCommand}" />
    </Grid>

    <!-- Drag to resize the tasks pane; hidden while the pane is collapsed (then a plain gap) -->
    <GridSplitter x:Name="PaneSplitter" Grid.Row="2" Classes="paneSplitter"
                  IsVisible="{Binding Tasks.IsExpanded}" />
    <Border Grid.Row="2" Height="{StaticResource Oadm.SplitterHeight}" IsVisible="{Binding !Tasks.IsExpanded}" />

    <!-- Tasks pane -->
    <tasks:TasksPaneView Grid.Row="3" DataContext="{Binding Tasks}" />
  </Grid>
</UserControl>
