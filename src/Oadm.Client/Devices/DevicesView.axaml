<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:dev="using:Oadm.Client.Devices"
             xmlns:tasks="using:Oadm.Client.Tasks"
             xmlns:lv="using:Oadm.Client.LiveView"
                      x:Class="Oadm.Client.Devices.DevicesView"
             x:DataType="dev:DevicesViewModel">
  <!-- Rows: title, then the shared TasksPaneLayout (device card above, splitter, tasks pane below). -->
  <Grid x:Name="LayoutRoot" RowDefinitions="Auto,*">
    <c:PageTitleBar Grid.Row="0" Title="Devices" Subtitle="The cameras and other devices this server manages." Margin="0,0,0,16" />

    <tasks:TasksPaneLayout Grid.Row="1" Tasks="{Binding Tasks}" MainMinHeight="{StaticResource Oadm.DevicesCardMinHeight}">
    <tasks:TasksPaneLayout.MainContent>
    <!-- Device card, and the live view panel on its right while open (DevicesView.axaml.cs sizes the columns) -->
    <Grid x:Name="DeviceRow" ColumnDefinitions="*,Auto,0">
    <!-- Device card: toolbar, status line, grid -->
    <Border Grid.Column="0" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}" MinHeight="{StaticResource Oadm.DevicesCardMinHeight}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <!-- Toolbar plugins (built-in: Scan, Scan IP range, Add manually | Remove | task actions), filled by DevicesView.axaml.cs -->
          <StackPanel x:Name="ToolbarPanel" Grid.Column="0" Orientation="Horizontal" Spacing="4" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="GroupByTagButton" Classes="toolbar iconOnly" Classes.active="{Binding GroupByTag}" ToolTip.Tip="Group by tag"
                    Command="{Binding ToggleGroupByTagCommand}">
              <ui:OadmIcon Data="{StaticResource Icon.groupBy}" />
            </Button>
            <Button Classes="toolbar iconOnly" ToolTip.Tip="Choose columns">
              <ui:OadmIcon Data="{StaticResource Icon.columns}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="4" MinWidth="220">
                    <TextBlock Classes="secondary" Text="Visible columns" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Columns.Choosable}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dev:ColumnOptionViewModel">
                          <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <ui:SearchBox Text="{Binding SearchText}" />
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="secondary" Text="{Binding StatusLine}" Margin="2,14,0,8" />

        <Panel Grid.Row="2">
          <!-- ItemsSource: the device rows, or in group mode the (device x tag) rows grouped by tag (DevicesView.axaml.cs) -->
          <DataGrid x:Name="DeviceGrid"
                    c:GridSelection.SelectedItems="{Binding SelectedGridItems}"
                    SelectionMode="Extended"
                    IsReadOnly="True">
            <DataGrid.ContextMenu>
              <ContextMenu ItemsSource="{Binding ContextMenuEntries}">
                <ContextMenu.Styles>
                  <Style Selector="MenuItem" x:DataType="dev:MenuEntryViewModel">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="ItemsSource" Value="{Binding Items}" />
                    <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
                    <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
                    <Setter Property="Icon">
                      <Template>
                        <ui:OadmIcon Data="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" />
                      </Template>
                    </Setter>
                  </Style>
                </ContextMenu.Styles>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Tag="icon" Width="44" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:IDeviceGridItem">
                    <!-- Click: live view (video devices only) -->
                    <Button Classes="liveViewIcon" ToolTip.Tip="Live view"
                            IsEnabled="{Binding Row, Converter={x:Static lv:LiveViewSupport.IsSupportedConverter}}"
                            Command="{Binding $parent[UserControl].((dev:DevicesViewModel)DataContext).LiveView.ToggleCommand}"
                            CommandParameter="{Binding Row}">
                    <Panel Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding Row.CategoryTooltip}">
                      <ui:OadmIcon Data="{Binding Row.CategoryIconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Classes.ok="{Binding Row.IsStatusOk}" Classes.warn="{Binding Row.IsStatusWarning}" Classes.error="{Binding Row.IsStatusError}" />
                    </Panel>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Tag="mac" Header="MAC address" Width="140*" MinWidth="70" Binding="{Binding Row.Serial}" x:DataType="dev:IDeviceGridItem" />
              <DataGridTemplateColumn Tag="status" Header="Status" Width="160*" MinWidth="70" SortMemberPath="Row.StatusText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:IDeviceGridItem">
                    <TextBlock Text="{Binding Row.StatusText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="address" Header="Address" Width="120*" MinWidth="70" SortMemberPath="Row.DisplayAddress">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:IDeviceGridItem">
                    <Button Classes="link" Margin="10,0" HorizontalAlignment="Left" ToolTip.Tip="Open the web interface of the device"
                            Command="{Binding $parent[UserControl].((dev:DevicesViewModel)DataContext).OpenWebUiCommand}"
                            CommandParameter="{Binding Row}">
                      <TextBlock Text="{Binding Row.DisplayAddress}" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="tags" Header="Tags" Width="150*" MinWidth="70" SortMemberPath="Row.TagsText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:IDeviceGridItem">
                    <c:TagChipList Tags="{Binding Row.TagChips}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Tag="model" Header="Model" Width="160*" MinWidth="70" Binding="{Binding Row.Model}" x:DataType="dev:IDeviceGridItem" />
              <DataGridTextColumn Tag="firmware" Header="Firmware" Width="100*" MinWidth="70" Binding="{Binding Row.FirmwareVersion}" x:DataType="dev:IDeviceGridItem" />
              <DataGridTextColumn Tag="dhcp" Header="DHCP" Width="86*" MinWidth="70" Binding="{Binding Row.DhcpText}" x:DataType="dev:IDeviceGridItem" />
              <DataGridTextColumn Tag="https" Header="HTTPS" Width="96*" MinWidth="70" Binding="{Binding Row.HttpsText}" x:DataType="dev:IDeviceGridItem" />
              <DataGridTemplateColumn Tag="certExpires" Header="Certificate expires" Width="156*" MinWidth="70" SortMemberPath="Row.CertExpiresSortKey">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:IDeviceGridItem">
                    <ui:StatusChip Text="{Binding Row.CertExpires.Text}" IsVisible="{Binding Row.CertExpires.HasText}" ToolTip.Tip="{Binding Row.CertTooltip}" IsOk="{Binding Row.CertExpires.IsOk}" IsWarning="{Binding Row.CertExpires.IsWarning}" IsError="{Binding Row.CertExpires.IsError}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="certTrust" Header="Certificate" Width="110*" MinWidth="70" SortMemberPath="Row.CertTrust.Text">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="dev:IDeviceGridItem">
                    <ui:StatusChip Text="{Binding Row.CertTrust.Text}" IsVisible="{Binding Row.CertTrust.HasText}" ToolTip.Tip="{Binding Row.CertTooltip}" IsOk="{Binding Row.CertTrust.IsOk}" IsWarning="{Binding Row.CertTrust.IsWarning}" IsError="{Binding Row.CertTrust.IsError}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Tag="dot1x" Header="IEEE 802.1X" Width="124*" MinWidth="70" Binding="{Binding Row.Dot1xText}" x:DataType="dev:IDeviceGridItem" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ui:OadmIcon Data="{StaticResource Icon.devices}" Width="32" Height="32" HorizontalAlignment="Center" />
            <TextBlock Classes="sectionTitle" Text="No devices yet" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" Text="Click Scan to find devices on the network, or Scan IP range or Add manually." HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <GridSplitter x:Name="LiveSplitter" Grid.Column="1" Classes="paneSplitter vertical" IsVisible="{Binding LiveView.IsOpen}" />
    <c:LiveViewPanel x:Name="LivePanel" Grid.Column="2"
                     IsOpen="{Binding LiveView.IsOpen}"
                     Title="{Binding LiveView.Title}"
                     Subtitle="{Binding LiveView.Subtitle}"
                     StateText="{Binding LiveView.StateText}"
                     StateKind="{Binding LiveView.StateKind}"
                     DetailText="{Binding LiveView.DetailText}"
                     Source="{Binding LiveView.Image}"
                     CloseCommand="{Binding LiveView.CloseCommand}"
                     Sources="{Binding LiveView.Sources}"
                     HasSourceChoice="{Binding LiveView.HasSourceChoice}"
                     SelectSourceCommand="{Binding LiveView.SelectSourceCommand}" />
    </Grid>
    </tasks:TasksPaneLayout.MainContent>
    </tasks:TasksPaneLayout>
  </Grid>
</UserControl>
