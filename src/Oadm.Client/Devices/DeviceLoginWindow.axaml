<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.Devices"
        x:Class="Oadm.Client.Devices.DeviceLoginWindow"
        x:DataType="vm:DeviceLoginViewModel"
        Title="Log in"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Single operation: title bar, form in Border.dialogBody, footer. Errors and results below the fields. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Log in" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Intro}" />
        <ui:FormField Label="User name">
          <TextBox x:Name="UserNameBox" Text="{Binding UserName}" IsEnabled="{Binding IsIdle}" />
        </ui:FormField>
        <ui:FormField Label="Password">
          <ui:PasswordBox x:Name="PasswordInput" Text="{Binding Password}" IsEnabled="{Binding IsIdle}" />
        </ui:FormField>
        <ui:FormField IsVisible="{Binding CanSaveToCredentialList}" Hint="{Binding CredentialListNote}">
          <CheckBox Content="Save to credential list" IsChecked="{Binding SaveToCredentialList}" IsEnabled="{Binding IsIdle}"
                    ToolTip.Tip="OADM tries it on devices it finds later" />
        </ui:FormField>
        <ui:ProgressRow IsActive="{Binding IsBusy}" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Content="Log in" Command="{Binding LogInCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
