<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.Devices"
        x:Class="Oadm.Client.Devices.DeviceSetPasswordWindow"
        x:DataType="vm:DeviceSetPasswordViewModel"
        Title="Set password"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Single operation: title bar, form in Border.dialogBody, footer. Errors and results below the fields. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Set password" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Intro}" />
        <ui:FormField Label="User name">
          <TextBox Text="{Binding UserName, Mode=OneWay}" IsReadOnly="True" IsEnabled="False" />
        </ui:FormField>
        <ui:FormField Label="New password" Hint="{Binding PolicyHint}">
          <ui:PasswordBox x:Name="PasswordInput" Text="{Binding Password}" IsEnabled="{Binding IsIdle}" />
        </ui:FormField>
        <ui:FormField Label="Confirm password">
          <ui:PasswordBox Text="{Binding ConfirmPassword}" IsEnabled="{Binding IsIdle}" />
        </ui:FormField>
        <ui:ProgressRow IsActive="{Binding IsBusy}" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Content="Set password" Command="{Binding SetPasswordCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
