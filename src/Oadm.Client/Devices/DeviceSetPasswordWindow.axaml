<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:vm="using:Oadm.Client.Devices"
        x:Class="Oadm.Client.Devices.DeviceSetPasswordWindow"
        x:DataType="vm:DeviceSetPasswordViewModel"
        Title="Set password"
        MinWidth="460" SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- Single operation: title bar, form in Border.dialogBody, footer. Errors and results below the fields. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Set password" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Intro}" />
        <!-- Right of the fields: a password of root from the credential list instead (shared with the add page);
             the window takes the width of its fields, wider for Administrators with the choice -->
        <ui:FormField Label="User name">
          <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" />
        </ui:FormField>
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Oadm.Gap}">
          <StackPanel Classes="form">
            <ui:FormField Label="New password" Hint="{Binding PolicyHint}">
              <ui:PasswordBox x:Name="PasswordInput" Text="{Binding Password}" IsEnabled="{Binding CanType}" />
            </ui:FormField>
            <ui:FormField Label="Confirm password">
              <ui:PasswordBox Text="{Binding ConfirmPassword}" IsEnabled="{Binding CanType}" />
            </ui:FormField>
          </StackPanel>
          <c:FirstPasswordChoiceBox Grid.Column="1" VerticalAlignment="Top" DataContext="{Binding PasswordChoice}"
                                    IsEnabled="{Binding $parent[Window].((vm:DeviceSetPasswordViewModel)DataContext).IsIdle}" />
        </Grid>
        <ui:ProgressRow IsActive="{Binding IsBusy}" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" />
        <ui:ProgressRow IsActive="{Binding IsReadingRules}" Text="Reading the password rules of the devices" IsVisible="{Binding IsReadingRules}" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Content="Set password" Command="{Binding SetPasswordCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
