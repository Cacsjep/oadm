<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.Devices"
        x:Class="Oadm.Client.Devices.DeviceTrustCertificateWindow"
        x:DataType="vm:DeviceTrustCertificateViewModel"
        Title="Trust new certificate"
        Width="1100" Height="520" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- Title bar, one card (intro, the devices with the certificate each presents now, progress or error), footer. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Trust new certificate" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Trust a new certificate only if you know why it changed, for example a certificate you installed or a factory default." />

        <!-- Virtualized; read in pages -->
        <DataGrid x:Name="CertificateGrid" Grid.Row="1" Classes="wrapRows" ItemsSource="{Binding Rows}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Device" Binding="{Binding DeviceText}" Width="200" MinWidth="140" />
            <DataGridTextColumn Header="Issued to" Binding="{Binding IssuedTo}" Width="160" MinWidth="100" />
            <DataGridTextColumn Header="Issued by" Binding="{Binding IssuedBy}" Width="160" MinWidth="100" />
            <DataGridTextColumn Header="Valid until" Binding="{Binding ValidUntil}" Width="100" MinWidth="90" />
            <DataGridTemplateColumn Header="Fingerprint (SHA-256)" Width="*" MinWidth="220" SortMemberPath="Fingerprint">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TrustCertificateRowViewModel">
                  <Panel>
                    <TextBlock Text="{Binding FingerprintText}" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding CanTrust}" />
                    <ui:StatusChip Text="{Binding StatusText}" IsWarning="True" MaxLines="2" IsVisible="{Binding HasStatus}" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2">
          <ui:ProgressRow Margin="0,10,0,0" Text="{Binding BusyText}" IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
          <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Content="Trust" Command="{Binding TrustCommand}"
              ToolTip.Tip="{Binding TrustTip}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
