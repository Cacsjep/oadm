<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:vm="using:Oadm.Client.Tags"
        x:Class="Oadm.Client.Tags.DeviceTagsWindow"
        x:DataType="vm:DeviceTagsViewModel"
        Title="Tags"
        Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- A list with its editors: title bar, one card (intro, search + New tag, new tag editor, tag list, edit editor), footer. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Tags" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Intro}" />

        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
          <ui:SearchBox Grid.Column="0" Text="{Binding SearchText}" Placeholder="Search tags" Width="NaN" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" x:Name="NewTagButton" Classes="secondary" Margin="8,0,0,0" Command="{Binding StartNewTagCommand}" IsEnabled="{Binding !IsAddingTag}">
            <ui:IconLabel Icon="{StaticResource Icon.add}" Text="New tag" />
          </Button>
        </Grid>

        <!-- New tag: name (error below the field) and color -->
        <Border Classes="inlineEditor" IsVisible="{Binding IsAddingTag}">
          <StackPanel Classes="form">
            <ui:FormField Label="Name">
              <TextBox x:Name="NewTagNameBox" Text="{Binding NewTagName}" MaxLength="64" />
            </ui:FormField>
            <ui:FormField Label="Color">
              <c:TagColorPicker SelectedColor="{Binding NewTagColor}" />
            </ui:FormField>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Create tag" IsDefault="True" Command="{Binding CreateTagCommand}" />
              <Button Classes="secondary" Content="Cancel" Command="{Binding CancelNewTagCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Every tag: three-state check box (all / some / none of the selected devices), color dot, name, device count, admin actions. Virtualized. -->
        <Panel Margin="0,12,0,0">
          <ScrollViewer MaxHeight="{StaticResource Oadm.TagListMaxHeight}" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TagList" ItemsSource="{Binding Choices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChoiceViewModel">
                  <Grid Classes="tagRow" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <CheckBox Grid.Column="0" IsThreeState="False" IsChecked="{Binding IsChecked, Mode=OneWay}" Command="{Binding ToggleCommand}"
                              ToolTip.Tip="{Binding StateText}" />
                    <Ellipse Grid.Column="1" Classes="tagDot" Fill="{Binding Color, Converter={x:Static vm:TagColorBrushConverter.Instance}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{Binding Color, Converter={x:Static vm:TagColorBrushConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding CountText}" Margin="12,0" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2"
                                IsVisible="{Binding $parent[Window].((vm:DeviceTagsViewModel)DataContext).IsAdmin}">
                      <Button Classes="toolbar iconOnly" ToolTip.Tip="Rename or recolor"
                              Command="{Binding $parent[Window].((vm:DeviceTagsViewModel)DataContext).StartEditCommand}" CommandParameter="{Binding}">
                        <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                      </Button>
                      <Button Classes="toolbar iconOnly" ToolTip.Tip="Delete tag"
                              Command="{Binding $parent[Window].((vm:DeviceTagsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                        <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Margin="0,8" />
        </Panel>

        <!-- A failed server call: directly below the list -->
        <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <!-- Administrators: rename / recolor the chosen tag -->
        <Border Classes="inlineEditor" IsVisible="{Binding IsEditing}">
          <StackPanel Classes="form">
            <TextBlock Classes="sectionTitle" Text="{Binding EditingChoice.Name, StringFormat='Change tag {0}', FallbackValue=''}" />
            <ui:FormField Label="Name">
              <TextBox Text="{Binding EditName}" MaxLength="64" />
            </ui:FormField>
            <ui:FormField Label="Color">
              <c:TagColorPicker SelectedColor="{Binding EditColor}" />
            </ui:FormField>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Save" Command="{Binding SaveEditCommand}" />
              <Button Classes="secondary" Content="Cancel" Command="{Binding CancelEditCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ui:ProgressRow IsActive="{Binding IsBusy}" Text="Saving" IsVisible="{Binding IsBusy}" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="OK" Command="{Binding ApplyCommand}" />
    </ui:DialogFooter>
  </Grid>
</Window>
