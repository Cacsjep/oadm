<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:ui="using:Oadm.Sdk.Client.Controls">
  <!--
    OADM visual style (see CLAUDE.md "Visual Style"). Dark only, MultiDrive look.
    Every color and size used by the views is defined here; views reference these keys only.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Oadm.Client/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Colors -->
      <Color x:Key="Oadm.WindowBackgroundColor">#141414</Color>
      <Color x:Key="Oadm.CardBackgroundColor">#181818</Color>
      <Color x:Key="Oadm.SurfaceRaisedColor">#2A2A2A</Color>
      <Color x:Key="Oadm.SurfaceHoverColor">#252525</Color>
      <Color x:Key="Oadm.InputBackgroundColor">#232323</Color>
      <Color x:Key="Oadm.BorderColor">#262626</Color>
      <Color x:Key="Oadm.InputBorderColor">#383838</Color>
      <Color x:Key="Oadm.AccentColor">#6C5CE7</Color>
      <Color x:Key="Oadm.AccentHoverColor">#7D6EF0</Color>
      <Color x:Key="Oadm.AccentPressedColor">#5B4BD6</Color>
      <Color x:Key="Oadm.AccentMutedColor">#3A3480</Color>
      <Color x:Key="Oadm.SelectionColor">#526C5CE7</Color>
      <Color x:Key="Oadm.SelectionHoverColor">#666C5CE7</Color>
      <Color x:Key="Oadm.GridRowHoverColor">#222222</Color>
      <Color x:Key="Oadm.GridHeaderHoverColor">#202020</Color>
      <Color x:Key="Oadm.CaptionHoverColor">#2B2B2B</Color>
      <Color x:Key="Oadm.CaptionPressedColor">#383838</Color>
      <Color x:Key="Oadm.SplitterGripColor">#2E2E2E</Color>
      <Color x:Key="Oadm.TealColor">#7FC8D0</Color>
      <Color x:Key="Oadm.TextPrimaryColor">#F2F2F2</Color>
      <Color x:Key="Oadm.TextSecondaryColor">#9A9A9A</Color>
      <Color x:Key="Oadm.TextDisabledColor">#5E5E5E</Color>
      <Color x:Key="Oadm.TextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="Oadm.IconColor">#CFCFCF</Color>
      <Color x:Key="Oadm.StatusOkColor">#3FB27F</Color>
      <Color x:Key="Oadm.StatusWarningColor">#E0A43A</Color>
      <Color x:Key="Oadm.StatusErrorColor">#E5534B</Color>
      <Color x:Key="Oadm.StatusNeutralColor">#8A8A8A</Color>
      <Color x:Key="Oadm.StatusOkBackgroundColor">#263FB27F</Color>
      <Color x:Key="Oadm.StatusWarningBackgroundColor">#26E0A43A</Color>
      <Color x:Key="Oadm.StatusErrorBackgroundColor">#26E5534B</Color>
      <Color x:Key="Oadm.StatusNeutralBackgroundColor">#268A8A8A</Color>
      <Color x:Key="Oadm.StatusAccentBackgroundColor">#336C5CE7</Color>
      <!-- Status chip fills: solid, slightly darker than the status colors so white text stays readable -->
      <Color x:Key="Oadm.ChipOkColor">#2B8A5E</Color>
      <Color x:Key="Oadm.ChipWarningColor">#A86F0E</Color>
      <Color x:Key="Oadm.ChipErrorColor">#C73B34</Color>
      <Color x:Key="Oadm.ChipAccentColor">#6253DB</Color>
      <Color x:Key="Oadm.ChipNeutralColor">#5F5F5F</Color>
      <Color x:Key="Oadm.ChipTextColor">#FFFFFF</Color>
      <Color x:Key="Oadm.OverlayColor">#99000000</Color>
      <Color x:Key="Oadm.VideoBackgroundColor">#0C0C0C</Color>
      <!-- Code highlighting (ui:CodeView): readable on the input background #232323 -->
      <Color x:Key="Oadm.Code.KeyColor">#7FC8D0</Color>
      <Color x:Key="Oadm.Code.StringColor">#E2B88E</Color>
      <Color x:Key="Oadm.Code.NumberColor">#B5D99C</Color>
      <Color x:Key="Oadm.Code.LiteralColor">#B4A9F7</Color>
      <Color x:Key="Oadm.Code.PunctuationColor">#8C8C8C</Color>
      <Color x:Key="Oadm.Code.TagColor">#8DB6F2</Color>
      <Color x:Key="Oadm.Code.AttributeColor">#7FC8D0</Color>
      <Color x:Key="Oadm.Code.CommentColor">#7E957F</Color>
      <Color x:Key="Oadm.Code.ErrorColor">#F0776F</Color>
      <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource Oadm.WindowBackgroundColor}" />
      <!-- Drawn caption buttons (Fluent WindowDrawnDecorations): hover is the Background, pressed the BorderBrush.
           Minimize/maximize use these neutral greys instead of the accent; close keeps its red from the theme. -->
      <SolidColorBrush x:Key="CaptionButtonBackground" Color="{StaticResource Oadm.CaptionHoverColor}" />
      <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="{StaticResource Oadm.CaptionPressedColor}" />
      <SolidColorBrush x:Key="CaptionButtonForeground" Color="{StaticResource Oadm.TextPrimaryColor}" />
      <x:Double x:Key="CaptionButtonWidth">46</x:Double>
      <x:Double x:Key="CaptionButtonHeight">32</x:Double>

      <!-- Brushes -->
      <SolidColorBrush x:Key="Oadm.WindowBackgroundBrush" Color="{StaticResource Oadm.WindowBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.CardBackgroundBrush" Color="{StaticResource Oadm.CardBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.SurfaceRaisedBrush" Color="{StaticResource Oadm.SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="Oadm.SurfaceHoverBrush" Color="{StaticResource Oadm.SurfaceHoverColor}" />
      <SolidColorBrush x:Key="Oadm.InputBackgroundBrush" Color="{StaticResource Oadm.InputBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.BorderBrush" Color="{StaticResource Oadm.BorderColor}" />
      <SolidColorBrush x:Key="Oadm.InputBorderBrush" Color="{StaticResource Oadm.InputBorderColor}" />
      <SolidColorBrush x:Key="Oadm.AccentBrush" Color="{StaticResource Oadm.AccentColor}" />
      <SolidColorBrush x:Key="Oadm.AccentHoverBrush" Color="{StaticResource Oadm.AccentHoverColor}" />
      <SolidColorBrush x:Key="Oadm.AccentPressedBrush" Color="{StaticResource Oadm.AccentPressedColor}" />
      <SolidColorBrush x:Key="Oadm.AccentMutedBrush" Color="{StaticResource Oadm.AccentMutedColor}" />
      <SolidColorBrush x:Key="Oadm.SelectionBrush" Color="{StaticResource Oadm.SelectionColor}" />
      <SolidColorBrush x:Key="Oadm.SelectionHoverBrush" Color="{StaticResource Oadm.SelectionHoverColor}" />
      <SolidColorBrush x:Key="Oadm.TealBrush" Color="{StaticResource Oadm.TealColor}" />
      <SolidColorBrush x:Key="Oadm.TextPrimaryBrush" Color="{StaticResource Oadm.TextPrimaryColor}" />
      <SolidColorBrush x:Key="Oadm.TextSecondaryBrush" Color="{StaticResource Oadm.TextSecondaryColor}" />
      <SolidColorBrush x:Key="Oadm.TextDisabledBrush" Color="{StaticResource Oadm.TextDisabledColor}" />
      <SolidColorBrush x:Key="Oadm.TextOnAccentBrush" Color="{StaticResource Oadm.TextOnAccentColor}" />
      <SolidColorBrush x:Key="Oadm.IconBrush" Color="{StaticResource Oadm.IconColor}" />
      <SolidColorBrush x:Key="Oadm.StatusOkBrush" Color="{StaticResource Oadm.StatusOkColor}" />
      <SolidColorBrush x:Key="Oadm.StatusWarningBrush" Color="{StaticResource Oadm.StatusWarningColor}" />
      <SolidColorBrush x:Key="Oadm.StatusErrorBrush" Color="{StaticResource Oadm.StatusErrorColor}" />
      <SolidColorBrush x:Key="Oadm.StatusNeutralBrush" Color="{StaticResource Oadm.StatusNeutralColor}" />
      <SolidColorBrush x:Key="Oadm.StatusOkBackgroundBrush" Color="{StaticResource Oadm.StatusOkBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.StatusWarningBackgroundBrush" Color="{StaticResource Oadm.StatusWarningBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.StatusErrorBackgroundBrush" Color="{StaticResource Oadm.StatusErrorBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.StatusNeutralBackgroundBrush" Color="{StaticResource Oadm.StatusNeutralBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.StatusAccentBackgroundBrush" Color="{StaticResource Oadm.StatusAccentBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.GridRowHoverBrush" Color="{StaticResource Oadm.GridRowHoverColor}" />
      <SolidColorBrush x:Key="Oadm.SplitterGripBrush" Color="{StaticResource Oadm.SplitterGripColor}" />
      <SolidColorBrush x:Key="Oadm.ChipOkBrush" Color="{StaticResource Oadm.ChipOkColor}" />
      <SolidColorBrush x:Key="Oadm.ChipWarningBrush" Color="{StaticResource Oadm.ChipWarningColor}" />
      <SolidColorBrush x:Key="Oadm.ChipErrorBrush" Color="{StaticResource Oadm.ChipErrorColor}" />
      <SolidColorBrush x:Key="Oadm.ChipAccentBrush" Color="{StaticResource Oadm.ChipAccentColor}" />
      <SolidColorBrush x:Key="Oadm.ChipNeutralBrush" Color="{StaticResource Oadm.ChipNeutralColor}" />
      <SolidColorBrush x:Key="Oadm.ChipTextBrush" Color="{StaticResource Oadm.ChipTextColor}" />
      <SolidColorBrush x:Key="Oadm.OverlayBrush" Color="{StaticResource Oadm.OverlayColor}" />
      <SolidColorBrush x:Key="Oadm.VideoBackgroundBrush" Color="{StaticResource Oadm.VideoBackgroundColor}" />
      <SolidColorBrush x:Key="Oadm.TransparentBrush" Color="Transparent" />
      <SolidColorBrush x:Key="Oadm.Code.KeyBrush" Color="{StaticResource Oadm.Code.KeyColor}" />
      <SolidColorBrush x:Key="Oadm.Code.StringBrush" Color="{StaticResource Oadm.Code.StringColor}" />
      <SolidColorBrush x:Key="Oadm.Code.NumberBrush" Color="{StaticResource Oadm.Code.NumberColor}" />
      <SolidColorBrush x:Key="Oadm.Code.LiteralBrush" Color="{StaticResource Oadm.Code.LiteralColor}" />
      <SolidColorBrush x:Key="Oadm.Code.PunctuationBrush" Color="{StaticResource Oadm.Code.PunctuationColor}" />
      <SolidColorBrush x:Key="Oadm.Code.TagBrush" Color="{StaticResource Oadm.Code.TagColor}" />
      <SolidColorBrush x:Key="Oadm.Code.AttributeBrush" Color="{StaticResource Oadm.Code.AttributeColor}" />
      <SolidColorBrush x:Key="Oadm.Code.CommentBrush" Color="{StaticResource Oadm.Code.CommentColor}" />
      <SolidColorBrush x:Key="Oadm.Code.ErrorBrush" Color="{StaticResource Oadm.Code.ErrorColor}" />

      <!-- Sizes -->
      <!-- Rail: total ~56 px collapsed / ~220 px expanded including its 8 px side margins -->
      <x:Double x:Key="Oadm.NavWidthCollapsed">40</x:Double>
      <x:Double x:Key="Oadm.NavWidthExpanded">204</x:Double>
      <!-- Context menus and submenus: wide enough for task names (TaskPluginNames.MaxDisplayNameLength) -->
      <x:Double x:Key="Oadm.MenuMinWidth">240</x:Double>
      <Thickness x:Key="Oadm.NavMargin">8,4,8,16</Thickness>
      <x:Double x:Key="Oadm.TitleBarHeight">32</x:Double>
      <x:Double x:Key="Oadm.IconSize">16</x:Double>
      <x:Double x:Key="Oadm.FontSizeBody">11.7</x:Double>
      <x:Double x:Key="Oadm.FontSizeSmall">9.9</x:Double>
      <x:Double x:Key="Oadm.FontSizeCardTitle">18</x:Double>
      <x:Double x:Key="Oadm.FontSizePageTitle">21.6</x:Double>
      <x:Double x:Key="Oadm.FontSizeAppName">14.4</x:Double>
      <x:Double x:Key="Oadm.GridRowHeight">34</x:Double>
      <x:Double x:Key="Oadm.GridHeaderHeight">36</x:Double>
      <x:Double x:Key="Oadm.ControlHeight">32</x:Double>
      <x:Double x:Key="Oadm.SearchWidth">260</x:Double>
      <x:Double x:Key="Oadm.SplitterHeight">16</x:Double>
      <x:Double x:Key="Oadm.DevicesCardMinHeight">220</x:Double>
      <!-- Device card keeps its toolbar on one line next to the live view; the live view never gets narrower than this -->
      <x:Double x:Key="Oadm.DevicesCardMinWidth">900</x:Double>
      <x:Double x:Key="Oadm.LiveViewMinWidth">320</x:Double>
      <x:Double x:Key="Oadm.ProgressHeight">6</x:Double>
      <x:Double x:Key="Oadm.Gap">16</x:Double>
      <CornerRadius x:Key="Oadm.CardCornerRadius">16</CornerRadius>
      <CornerRadius x:Key="Oadm.ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="Oadm.PillCornerRadius">10</CornerRadius>
      <CornerRadius x:Key="Oadm.ProgressCornerRadius">3</CornerRadius>
      <Thickness x:Key="Oadm.CardPadding">20</Thickness>
      <Thickness x:Key="Oadm.GridCardPadding">20,18,20,12</Thickness>
      <Thickness x:Key="Oadm.PagePadding">8,0,16,16</Thickness>
      <Thickness x:Key="Oadm.GapTop">0,16,0,0</Thickness>
      <Thickness x:Key="Oadm.PillPadding">9,2</Thickness>
      <Thickness x:Key="Oadm.NavItemPadding">12,9</Thickness>
      <Thickness x:Key="Oadm.ToolbarButtonPadding">10,6</Thickness>
      <FontFamily x:Key="Oadm.FontFamily">fonts:Inter#Inter</FontFamily>
      <FontFamily x:Key="Oadm.FontFamilyMono">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
      <x:Double x:Key="ControlContentThemeFontSize">11.7</x:Double>

      <!-- Fluent DataGrid resources mapped onto the OADM palette -->
      <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{StaticResource Oadm.TextSecondaryColor}" />
      <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{StaticResource Oadm.CardBackgroundColor}" />
      <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{StaticResource Oadm.GridHeaderHoverColor}" />
      <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{StaticResource Oadm.SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="DataGridColumnHeaderDraggedBackgroundBrush" Color="{StaticResource Oadm.SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="{StaticResource Oadm.GridRowHoverColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{StaticResource Oadm.SelectionColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{StaticResource Oadm.SelectionHoverColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{StaticResource Oadm.SelectionColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{StaticResource Oadm.SelectionHoverColor}" />
      <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="{StaticResource Oadm.BorderColor}" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                             Accent="#6C5CE7"
                             RegionColor="#141414"
                             AltHigh="#181818"
                             BaseHigh="#F2F2F2"
                             BaseMedium="#9A9A9A"
                             ErrorText="#E5534B" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

  <!-- Base -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Oadm.WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Oadm.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
  </Style>
  <!-- Our title bars draw their own title; hide the title text of Avalonia's drawn decorations -->
  <Style Selector="chrome|WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel TextBlock">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="chrome|WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ui|OadmIcon">
    <Setter Property="Width" Value="{StaticResource Oadm.IconSize}" />
    <Setter Property="Height" Value="{StaticResource Oadm.IconSize}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.IconBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.appName">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeAppName}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizePageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeCardTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeSmall}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusWarningBrush}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Oadm.CardBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.CardCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource Oadm.CardPadding}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Oadm.BorderBrush}" />
  </Style>
  <Style Selector="Border.vseparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource Oadm.BorderBrush}" />
    <Setter Property="Margin" Value="6,6" />
  </Style>

  <!-- Status everywhere: ui:StatusChip = colored icon + plain text (no chips, no borders).
       The same color classes color any OadmIcon, e.g. the device icon in the grid. -->
  <Style Selector="ui|StatusChip ui|OadmIcon.statusIcon">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusNeutralBrush}" />
  </Style>
  <Style Selector="ui|StatusChip.ok ui|OadmIcon.statusIcon, ui|OadmIcon.ok">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusOkBrush}" />
  </Style>
  <Style Selector="ui|StatusChip.warn ui|OadmIcon.statusIcon, ui|OadmIcon.warn">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusWarningBrush}" />
  </Style>
  <Style Selector="ui|StatusChip.error ui|OadmIcon.statusIcon, ui|OadmIcon.error">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusErrorBrush}" />
  </Style>
  <Style Selector="ui|StatusChip.accent ui|OadmIcon.statusIcon, ui|OadmIcon.accent">
    <Setter Property="Foreground" Value="{StaticResource Oadm.AccentBrush}" />
  </Style>
  <Style Selector="ui|StatusChip.accent ui|OadmIcon.statusIcon">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="ui|StatusChip TextBlock.statusText">
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="DataGridCell ui|StatusChip">
    <Setter Property="Margin" Value="10,0" />
  </Style>
  <Style Selector="DataGridCell ui|StatusChip TextBlock">
    <Setter Property="Margin" Value="8,3,0,0" />
  </Style>

  <!-- No status dot on the device icon: the Status column already says it -->
  <Style Selector="Ellipse.statusDot">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Count badge (navigation, tasks header): same chip look -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource Oadm.ChipAccentBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.PillCornerRadius}" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeSmall}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.ChipTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="{StaticResource Oadm.NavItemPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="DockPanel.rail">
    <Setter Property="Width" Value="{StaticResource Oadm.NavWidthCollapsed}" />
    <Setter Property="Margin" Value="{StaticResource Oadm.NavMargin}" />
  </Style>
  <Style Selector="DockPanel.rail.expanded">
    <Setter Property="Width" Value="{StaticResource Oadm.NavWidthExpanded}" />
  </Style>

  <!-- Icon + text rows (buttons, menu entries, rail items): center both vertically -->
  <!-- Icon + text rows are always ui:IconLabel (it owns centering and the Inter correction). -->
  <Style Selector="StackPanel[Orientation=Horizontal] > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel[Orientation=Horizontal] > ui|OadmIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Toolbar buttons: icon + text -->
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Oadm.ToolbarButtonPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource Oadm.ControlHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.toolbar:disabled ui|OadmIcon">
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.iconOnly">
    <Setter Property="Padding" Value="7" />
  </Style>

  <!-- Primary (accent) button -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Oadm.AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary ui|OadmIcon">
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextOnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextOnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.AccentPressedBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled ui|OadmIcon">
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextDisabledBrush}" />
  </Style>

  <!-- Secondary button (dialogs) -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
  </Style>

  <!-- Hyperlink-style button (device address) -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TealBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TealBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource Oadm.ControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
    <!-- Every text field (also inside NumericUpDown and SearchBox): text vertically centered.
         Measured: centered text boxes need no Inter correction (digit centers match the box). -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0,8,0" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.TextDisabledBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="NumericUpDown">
    <!-- The inner text box takes padding and alignment from the NumericUpDown (TemplateBinding). -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0,8,0" />
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource Oadm.ControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
    <!-- Selected item vertically centered. It is a plain TextBlock, so it needs the measured
         Inter correction (top padding 3 moves the centered line 1.5 px down), unlike text boxes. -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,3,8,0" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.TextDisabledBrush}" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
  </Style>
  <!-- Every checkbox: box and check mark at 80 % (16 px instead of Fluent's 20 px), scaled
       around their own center so a checkbox centered in a cell stays exactly centered. -->
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(0.8)" />
  </Style>
  <Style Selector="CheckBox /template/ Viewbox">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(0.8)" />
  </Style>

  <!-- Progress -->
  <!-- The one progress bar. Class "stream" (set while work is running) shows the Vuetify-style
       stream: a dotted line in the unfilled part that keeps flowing toward the filled part. -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Oadm.AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="MinHeight" Value="{StaticResource Oadm.ProgressHeight}" />
    <Setter Property="Height" Value="{StaticResource Oadm.ProgressHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ProgressCornerRadius}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Panel>
            <Border Name="PART_Stream" IsVisible="False" Margin="0,0,-16,0" Opacity="0.55">
              <Border.Background>
                <DrawingBrush TileMode="Tile" DestinationRect="0,0,8,6" Stretch="None" AlignmentX="Left" AlignmentY="Top">
                  <DrawingBrush.Drawing>
                    <DrawingGroup>
                      <GeometryDrawing Brush="Transparent" Geometry="M0,0 H8 V6 H0 Z" />
                      <GeometryDrawing Brush="{StaticResource Oadm.AccentBrush}">
                        <GeometryDrawing.Geometry>
                          <EllipseGeometry Center="2,3" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryDrawing.Geometry>
                      </GeometryDrawing>
                    </DrawingGroup>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.Background>
              <Border.RenderTransform>
                <TranslateTransform />
              </Border.RenderTransform>
            </Border>
            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                    CornerRadius="{TemplateBinding CornerRadius}" HorizontalAlignment="Left" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ProgressBar.stream">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ProgressBar.stream /template/ Border#PART_Stream">
    <Setter Property="IsVisible" Value="True" />
    <Style.Animations>
      <Animation Duration="0:0:0.4" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.X" Value="-8" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Data grids -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Oadm.BorderBrush}" />
    <Setter Property="RowHeight" Value="{StaticResource Oadm.GridRowHeight}" />
    <Setter Property="ColumnHeaderHeight" Value="{StaticResource Oadm.GridHeaderHeight}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserReorderColumns" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="CanUserSortColumns" Value="True" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextSecondaryBrush}" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="SeparatorBrush" Value="{StaticResource Oadm.TransparentBrush}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
    <Setter Property="MinHeight" Value="{StaticResource Oadm.GridRowHeight}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="DataGridCell Button.link TextBlock">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- Editable cell (e.g. the new address in the address assignment table): fits the row height -->
  <Style Selector="DataGridCell TextBox">
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridRow.muted">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Rows that cannot be selected (e.g. protected accounts in the Users dialog): greyed like muted rows -->
  <Style Selector="DataGridRow:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Splitter between the device card and the tasks card -->
  <Style Selector="GridSplitter.paneSplitter">
    <Setter Property="Height" Value="{StaticResource Oadm.SplitterHeight}" />
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="ResizeDirection" Value="Rows" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Name="grip" Width="40" Height="4" CornerRadius="2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{StaticResource Oadm.SplitterGripBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.paneSplitter:pointerover /template/ Border#grip">
    <Setter Property="Background" Value="{StaticResource Oadm.AccentBrush}" />
  </Style>

  <!-- Same splitter between the device card and the live view panel (side by side) -->
  <Style Selector="GridSplitter.paneSplitter.vertical">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Width" Value="{StaticResource Oadm.SplitterHeight}" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="GridSplitter.paneSplitter.vertical /template/ Border#grip">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- Live view -->
  <Style Selector="ui|IconLabel.sectionTitle TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.liveViewSurface">
    <Setter Property="Background" Value="{StaticResource Oadm.VideoBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MinHeight" Value="120" />
  </Style>
  <!-- Picture tile (snapshot report grid): raised surface, accent outline when selected.
       The picture inside sits on a Border.liveViewSurface. -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.tile:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
  </Style>
  <Style Selector="Border.tile.selected">
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.AccentBrush}" />
  </Style>
  <!-- Clickable picture (tile picture opens the large preview): no button chrome -->
  <Style Selector="Button.picture">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.picture:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
  </Style>
  <Style Selector="Button.picture:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
  </Style>
  <!-- Segmented switch (live view source: view area / sensor / channel) -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.segment.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextOnAccentBrush}" />
  </Style>

  <!-- Device icon cell: opens the live view of video devices -->
  <Style Selector="Button.liveViewIcon">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.liveViewIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Button.liveViewIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.liveViewIcon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.TransparentBrush}" />
  </Style>
  <Style Selector="Button.liveViewIcon:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Menus and flyouts -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="MinWidth" Value="{StaticResource Oadm.MenuMinWidth}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
  </Style>
  <!-- Submenu popups have no presenter of their own: their entries carry the minimum width -->
  <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
    <Setter Property="MinWidth" Value="{StaticResource Oadm.MenuMinWidth}" />
  </Style>
  <!-- Same alignment as ui:IconLabel: icon centered, header text with the Inter correction -->
  <Style Selector="MenuItem /template/ ContentPresenter#PART_IconPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Dialog windows (add devices page, task plugin dialogs): title bar, card headings, button row -->
  <Style Selector="ui|DialogTitleBar">
    <Setter Property="Height" Value="{StaticResource Oadm.TitleBarHeight}" />
    <Setter Property="Padding" Value="24,0" />
  </Style>
  <Style Selector="ui|CardHeader">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <!-- Header whose following content is optional: that content adds the gap itself (Oadm.GapTop) -->
  <Style Selector="ui|CardHeader.flush">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ui|DialogFooter">
    <Setter Property="Margin" Value="16" />
  </Style>
  <!-- Form rows in cards: label column left, input right (same as the wizard steps) -->
  <Style Selector="Grid.form">
    <Setter Property="RowSpacing" Value="10" />
  </Style>
  <Style Selector="StackPanel.form">
    <Setter Property="Spacing" Value="10" />
  </Style>

  <!-- Multi-line code fields: request and response bodies, headers (VAPIX Commander) -->
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource Oadm.FontFamilyMono}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Multi-line plain text fields, one entry per line (NTP servers of the date and time dialog) -->
  <Style Selector="TextBox.multiline">
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MinHeight" Value="88" />
  </Style>

  <!-- The one read-only code display (ui:CodeView): response bodies and headers, highlighted -->
  <Style Selector="ui|CodeView">
    <Setter Property="Background" Value="{StaticResource Oadm.InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Oadm.InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ui|CodeView SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="{StaticResource Oadm.FontFamilyMono}" />
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Oadm.TextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Oadm.SelectionBrush}" />
    <Setter Property="Margin" Value="10,8" />
  </Style>

  <!-- Trees (command library) -->
  <Style Selector="TreeViewItem">
    <Setter Property="FontSize" Value="{StaticResource Oadm.FontSizeBody}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <!-- The one search field -->
  <Style Selector="ui|SearchBox">
    <Setter Property="Width" Value="{StaticResource Oadm.SearchWidth}" />
  </Style>

  <!-- Inline editor below a list (add devices page: log in, set password) -->
  <Style Selector="Border.inlineEditor">
    <Setter Property="Background" Value="{StaticResource Oadm.SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="{StaticResource Oadm.GapTop}" />
  </Style>
  <!-- Input row above a list (IP range, address) -->
  <Style Selector="StackPanel.inputRow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!-- Connection banner -->
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="{StaticResource Oadm.ControlCornerRadius}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{StaticResource Oadm.StatusErrorBackgroundBrush}" />
  </Style>
  <Style Selector="Border.banner TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusErrorBrush}" />
  </Style>
  <Style Selector="Border.banner.connecting">
    <Setter Property="Background" Value="{StaticResource Oadm.StatusWarningBackgroundBrush}" />
  </Style>
  <Style Selector="Border.banner.connecting TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Oadm.StatusWarningBrush}" />
  </Style>
</Styles>
