<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:tags="using:Oadm.Client.Tags"
        xmlns:collections="using:Avalonia.Collections"
        xmlns:dgp="using:Avalonia.Controls.Primitives">
  <!--
    The client's theme: the shared OADM theme (src/Oadm.Theme, also used by the OADM Site Node app) plus the styles of
    types only the client has. Resources of the shared theme are reached as DynamicResource here (a sibling include).
  -->
  <StyleInclude Source="avares://Oadm.Theme/OadmTheme.axaml" />

  <!-- Group mode of the device grid (and Compliance): a group's header is a row of the grid's flat list (Tags/TagGroupRows):
       chevron, "Building A · 42 devices" in the tag color, collapsible; no cells, never shown as selected -->
  <Style Selector="DataGrid.tagGroups DataGridRow.tagHeader">
    <Setter Property="Template">
      <ControlTemplate x:DataType="tags:TagGroupKey">
        <dgp:DataGridFrozenGrid Name="PART_Root" Background="{DynamicResource Oadm.CardBackgroundBrush}"
                                MinHeight="{DynamicResource Oadm.GridRowHeight}" ColumnDefinitions="Auto,Auto,*">
          <ToggleButton Grid.Column="0" Classes="groupExpander" Margin="8,0,0,0" Focusable="False"
                        IsChecked="{Binding IsExpanded}" dgp:DataGridFrozenGrid.IsFrozen="True" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                      TextElement.FontSize="{DynamicResource Oadm.FontSizeBody}" dgp:DataGridFrozenGrid.IsFrozen="True">
            <TextBlock Classes="groupHeader" Text="{Binding HeaderText}"
                       Foreground="{Binding Color, Converter={x:Static tags:TagColorBrushConverter.Instance}}" />
          </StackPanel>
        </dgp:DataGridFrozenGrid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="DataGridCell c|TagChipList">
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|TagColorPicker">
    <Setter Property="Spacing" Value="6" />
  </Style>
</Styles>
