<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:tags="using:Oadm.Client.Tags"
        xmlns:collections="using:Avalonia.Collections"
        xmlns:dgp="using:Avalonia.Controls.Primitives">
  <!--
    The client's theme: the shared OADM theme (src/Oadm.Theme, also used by the OADM Site Node app) plus the styles of
    types only the client has. Resources of the shared theme are reached as DynamicResource here (a sibling include).
  -->
  <StyleInclude Source="avares://Oadm.Theme/OadmTheme.axaml" />

  <!-- Group mode of the device grid: dot + "Building A · 42 devices" in the tag color, collapsible -->
  <Style Selector="DataGrid.tagGroups DataGridRowGroupHeader">
    <Setter Property="Background" Value="{DynamicResource Oadm.CardBackgroundBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource Oadm.GridRowHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Oadm.FontSizeBody}" />
    <Setter Property="Template">
      <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
        <dgp:DataGridFrozenGrid Name="PART_Root" Background="{TemplateBinding Background}" MinHeight="{TemplateBinding MinHeight}"
                                ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="*,Auto">
          <Rectangle Name="PART_IndentSpacer" Grid.Column="1" />
          <ToggleButton Name="PART_ExpanderButton" Grid.Column="2" Classes="groupExpander" Margin="8,0,0,0" Focusable="False" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
            <Ellipse Classes="tagDot" Fill="{Binding ((tags:TagGroupKey)Key).Color, Converter={x:Static tags:TagColorBrushConverter.Instance}}" />
            <TextBlock Classes="groupHeader" Text="{Binding ((tags:TagGroupKey)Key).HeaderText}"
                       Foreground="{Binding ((tags:TagGroupKey)Key).Color, Converter={x:Static tags:TagColorBrushConverter.Instance}}" />
            <TextBlock Name="PART_PropertyNameElement" IsVisible="False" />
            <TextBlock Name="PART_ItemCountElement" IsVisible="False" />
          </StackPanel>
          <DataGridRowHeader Name="PART_RowHeader" Grid.RowSpan="2" dgp:DataGridFrozenGrid.IsFrozen="True" />
        </dgp:DataGridFrozenGrid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="DataGridCell c|TagChipList">
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|TagColorPicker">
    <Setter Property="Spacing" Value="6" />
  </Style>
</Styles>
