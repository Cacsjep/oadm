<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:dlg="using:Oadm.Client.Dialogs"
        x:Class="Oadm.Client.Dialogs.MessageWindow"
        x:DataType="dlg:MessageDialogModel"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">
  <StackPanel>
    <ui:DialogTitleBar Text="{Binding Title}" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="24,4,24,24" />
    <ui:DialogFooter x:Name="Footer" CancelText="{Binding CancelText}">
      <Button Classes="primary" Content="{Binding ConfirmText}" Click="OnConfirm" IsDefault="True" />
    </ui:DialogFooter>
  </StackPanel>
</Window>
