<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:dev="using:Oadm.Client.Devices"
             xmlns:vm="using:Oadm.Client.Compliance"
             x:Class="Oadm.Client.Compliance.ComplianceView"
             x:DataType="vm:ComplianceViewModel">
  <!-- A count card per check (a click shows the devices that fail it; Edit and Delete on the card while the pointer is on
       it), then the tabs and the devices with one column per check (built in code-behind from ColumnChecks). -->
  <Grid RowDefinitions="Auto,Auto,*">
    <c:PageTitleBar Grid.Row="0" Title="Compliance" Subtitle="Which devices need attention." Margin="0,0,0,16" />

    <!-- Compliance is off (the server's default): what it does and Enable. -->
    <ui:OffState Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowOffState}" Icon="{StaticResource Icon.squareActivity}" Title="Compliance checks are off"
                 Text="See at first glance which devices need attention: devices OADM cannot reach or log in to, expiring certificates, and your own checks.">
        <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding EnableCommand}" IsVisible="{Binding MayTurnOnOff}">
          <ui:IconLabel Icon="{StaticResource Icon.squareActivity}" Text="Enable Compliance Checks" />
        </Button>
        <TextBlock Classes="secondary" HorizontalAlignment="Center" IsVisible="{Binding !MayTurnOnOff}"
                   Text="An administrator can turn them on." />
        <TextBlock Classes="error" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding ErrorText}"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </ui:OffState>

    <ScrollViewer Grid.Row="1" MaxHeight="244" Margin="0,0,0,16" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasCards}">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="{StaticResource Oadm.Gap}" LineSpacing="{StaticResource Oadm.Gap}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ComplianceCardViewModel">
            <Panel Classes="hoverActions">
              <Button Classes="statCardButton" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding ToolTip}"
                      Command="{Binding $parent[UserControl].((vm:ComplianceViewModel)DataContext).SelectCardCommand}" CommandParameter="{Binding}">
                <ui:StatCard Width="220" Title="{Binding Title}" Value="{Binding Value}" Detail="{Binding Detail}"
                             IsOk="{Binding IsOk}" IsWarning="{Binding IsWarning}" IsError="{Binding IsError}" />
              </Button>
              <StackPanel Classes="hoverActions rowActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,10"
                          IsVisible="{Binding $parent[UserControl].((vm:ComplianceViewModel)DataContext).MayManage}">
                <Button Classes="toolbar iconOnly" ToolTip.Tip="Edit" CommandParameter="{Binding}"
                        Command="{Binding $parent[UserControl].((vm:ComplianceViewModel)DataContext).EditCommand}">
                  <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                </Button>
                <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete" CommandParameter="{Binding}"
                        Command="{Binding $parent[UserControl].((vm:ComplianceViewModel)DataContext).DeleteCommand}">
                  <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                </Button>
              </StackPanel>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}" IsVisible="{Binding IsEnabled}">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <ui:ToolbarOverflowPanel Grid.Column="0" Spacing="4">
            <ui:ToolbarButton Text="New check" IconKey="add" Command="{Binding NewCheckCommand}" IsVisible="{Binding MayManage}" />
            <ui:ToolbarButton Text="Check now" IconKey="refresh" Command="{Binding CheckNowCommand}" ToolTip.Tip="The selected devices, else all" />
          </ui:ToolbarOverflowPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="toolbar danger" Command="{Binding TurnOffCommand}" IsVisible="{Binding MayTurnOnOff}">
              <ui:IconLabel Icon="{StaticResource Icon.stop}" Text="Turn off compliance" Spacing="8" />
            </Button>
            <ui:ToolbarButton Text="Export" IconKey="export" Command="{Binding ExportCommand}" />
            <Button Classes="toolbar iconOnly" Classes.active="{Binding ShowText}" ToolTip.Tip="Show the result text"
                    Command="{Binding ToggleShowTextCommand}">
              <ui:OadmIcon Data="{StaticResource Icon.text}" />
            </Button>
            <Button Classes="toolbar iconOnly" Classes.active="{Binding GroupByTag}" ToolTip.Tip="Group by tag"
                    Command="{Binding ToggleGroupByTagCommand}">
              <ui:OadmIcon Data="{StaticResource Icon.groupBy}" />
            </Button>
            <Button Classes="toolbar iconOnly" ToolTip.Tip="Choose columns">
              <ui:OadmIcon Data="{StaticResource Icon.columns}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="4" MinWidth="220">
                    <TextBlock Classes="secondary" Text="Visible columns" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ColumnOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dev:ColumnOptionViewModel">
                          <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <ui:SearchBox Width="220" VerticalAlignment="Center" Text="{Binding SearchText}" Placeholder="Search devices" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,12,0,8">
          <!-- A chosen card shows one check's failing devices: the tabs are greyed until "Show all devices". -->
          <Border Classes="segmented" IsEnabled="{Binding !IsCheckView}">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment" Classes.selected="{Binding IsAllTab}" Content="{Binding AllText}" Command="{Binding ShowAllCommand}" />
              <Button Classes="segment" Classes.selected="{Binding IsProblemsTab}" Content="{Binding ProblemsText}" Command="{Binding ShowProblemsCommand}" />
              <Button Classes="segment" Classes.selected="{Binding IsWarningsTab}" Content="{Binding WarningsText}" Command="{Binding ShowWarningsCommand}" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsCheckView}">
            <TextBlock VerticalAlignment="Center" Text="{Binding CheckViewText}" />
            <Button Classes="secondary" Command="{Binding LeaveCheckViewCommand}">
              <ui:IconLabel Icon="{StaticResource Icon.close}" Text="Show all devices" />
            </Button>
          </StackPanel>
          <TextBlock Grid.Column="3" Classes="secondary" VerticalAlignment="Center" Text="{Binding StatusText}" />
        </Grid>

        <!-- Thousands of devices: virtualized; one column per check is added in code-behind; group mode in code-behind. -->
        <DataGrid x:Name="ResultGrid" Grid.Row="2" IsReadOnly="True" SelectionMode="Extended"
                  CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                  c:GridSelection.SelectedItems="{Binding SelectedRows}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Tag="icon" Width="44" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="dev:IDeviceGridItem">
                  <ui:DeviceIcon Category="{Binding Row.SdkCategory}" Status="{Binding Row.SdkStatus}" ShowStatusToolTip="True"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Tag="address" Header="Address" Width="150" MinWidth="110" Binding="{Binding Row.DisplayAddress}" x:DataType="dev:IDeviceGridItem" />
            <DataGridTextColumn Tag="model" Header="Model" Width="140" MinWidth="100" Binding="{Binding Row.Model}" x:DataType="dev:IDeviceGridItem" />
            <DataGridTemplateColumn Tag="tags" Header="Tags" Width="140" MinWidth="80" SortMemberPath="Row.TagsText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="dev:IDeviceGridItem">
                  <c:TagChipList Tags="{Binding Row.TagChips}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Tag="result" Header="Result" Width="170" MinWidth="120" SortMemberPath="Row.Compliance.SortKey">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="dev:IDeviceGridItem">
                  <vm:ComplianceSummaryCell Compliance="{Binding Row.Compliance}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EmptyText}"
                   IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Row="3" Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
