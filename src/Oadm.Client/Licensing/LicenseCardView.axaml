<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:vm="using:Oadm.Client.Licensing"
             xmlns:lic="using:Oadm.Sdk.Licensing"
             x:Class="Oadm.Client.Licensing.LicenseCardView"
             x:DataType="vm:LicenseViewModel">
  <!-- Settings page, every user: the OADM PRO license of the server. Administrators import and remove it. -->
  <c:CollapsibleCard Title="License">
    <StackPanel Classes="form">
      <ui:FormField Label="Server ID" IsVisible="{Binding HasServerId}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <SelectableTextBlock Classes="mono" Text="{Binding ServerId}" VerticalAlignment="Center" />
          <Button Classes="toolbar iconOnly" ToolTip.Tip="Copy server ID" Command="{Binding CopyServerIdCommand}">
            <ui:OadmIcon Data="{StaticResource Icon.copy}" />
          </Button>
        </StackPanel>
      </ui:FormField>
      <ui:FormField Label="OADM PRO" Hint="{Binding CustomerText}">
        <Panel>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" IsVisible="{Binding !HasLicense}" />
          <ui:StatusChip Text="{Binding StatusText}" IsOk="{Binding IsActive}" IsWarning="{Binding IsTrial}" IsError="{Binding IsProblem}"
                         MaxLines="2" IsVisible="{Binding HasLicense}" />
        </Panel>
      </ui:FormField>
      <!-- Once per server, while no trial ran and PRO is not active; administrators start it, others are told who can. -->
      <ui:FormField Classes="wide" IsVisible="{Binding ShowStartTrial}">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Command="{Binding StartTrialCommand}" IsVisible="{Binding ShowTrialButton}">
              <ui:IconLabel Icon="{StaticResource Icon.clock}" Text="{x:Static lic:ProLicenseTexts.StartTrial}" />
            </Button>
            <TextBlock Classes="secondary" Text="{x:Static lic:ProLicenseTexts.TrialOffer}" VerticalAlignment="Center" IsVisible="{Binding ShowTrialButton}" />
            <TextBlock Classes="secondary" Text="{x:Static lic:ProLicenseTexts.TrialAdminLine}" VerticalAlignment="Center" IsVisible="{Binding ShowTrialAdminLine}" />
          </StackPanel>
          <TextBlock Classes="error" Text="{Binding TrialError}" TextWrapping="Wrap" IsVisible="{Binding HasTrialError}" />
        </StackPanel>
      </ui:FormField>
      <ui:FormField Classes="wide" IsVisible="{Binding IsAdmin}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary" Command="{Binding ImportCommand}">
            <ui:IconLabel Icon="{StaticResource Icon.key}" Text="Import license" />
          </Button>
          <ui:ToolbarButton Classes="danger" Text="Remove license" IconKey="remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
          <!-- The result sits next to the buttons it reports on. -->
          <TextBlock Text="{Binding Message}" Classes.error="{Binding MessageIsError}" Classes.secondary="{Binding !MessageIsError}" VerticalAlignment="Center"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ui:FormField>
      <ui:FormField Classes="wide" IsVisible="{Binding ShowActivate}">
        <Button Classes="link" Content="Activate license" Command="{Binding ActivateCommand}" />
      </ui:FormField>
    </StackPanel>
  </c:CollapsibleCard>
</UserControl>
