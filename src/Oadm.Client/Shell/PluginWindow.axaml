<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:shell="using:Oadm.Client.Shell"
        x:Class="Oadm.Client.Shell.PluginWindow"
        x:DataType="shell:CorePluginPageViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="900" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">
  <!-- A plugin page in a window of its own (rail entry, "Open in new window"): the main window's title bar and page
       padding around the same page view. -->
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Height="{StaticResource Oadm.TitleBarHeight}" Background="{StaticResource Oadm.WindowBackgroundBrush}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <TextBlock Classes="appName" Text="{Binding WindowTitle}" Margin="20,0,0,0" VerticalAlignment="Center" />
    </Border>
    <shell:CorePluginPageView Grid.Row="1" Margin="{StaticResource Oadm.PagePadding}" />
  </Grid>
</Window>
