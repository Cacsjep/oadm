<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Oadm.Client.Shell"
        xmlns:c="using:Oadm.Client.Controls"
        x:Class="Oadm.Client.Shell.SplashWindow"
        x:DataType="shell:SplashViewModel"
        Title="OADM"
        Width="420" Height="420" CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="{StaticResource Oadm.WindowBackgroundBrush}">
  <!-- Start splash: the mark slicing in (the support portal's intro) and the real loading step (see SplashViewModel). -->
  <Panel x:Name="Root">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32">
      <c:SplashMark x:Name="Mark" HorizontalAlignment="Center" />
      <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{Binding Status}" />
    </StackPanel>
  </Panel>
</Window>
