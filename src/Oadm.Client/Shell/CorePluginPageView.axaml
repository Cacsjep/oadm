<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Oadm.Client.Shell"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:tasks="using:Oadm.Client.Tasks"
             x:Class="Oadm.Client.Shell.CorePluginPageView"
             x:DataType="shell:CorePluginPageViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <!-- Page header: title, optional subtitle and trailing content from the plugin page (ui:PageHeader). -->
    <c:PageTitleBar Title="{Binding Title}" Subtitle="{Binding Subtitle}" Trailing="{Binding HeaderTrailing}" />
    <!-- Page content above; with ShowTasksPane the shared tasks pane below (same as the Devices page). -->
    <tasks:TasksPaneLayout Grid.Row="1" Tasks="{Binding Tasks}" ShowTasks="{Binding ShowTasksPane}">
      <tasks:TasksPaneLayout.MainContent>
        <Panel>
          <Border Classes="card" IsVisible="{Binding ShowInCard}">
            <Panel>
              <ContentControl Content="{Binding CardView}" IsVisible="{Binding HasView}" />
              <TextBlock Classes="secondary" IsVisible="{Binding !HasView}"
                         Text="{Binding NoViewText}" TextWrapping="Wrap" />
            </Panel>
          </Border>
          <!-- Pages with several panels (ICorePluginPage.HasOwnCards) bring their own cards. -->
          <ContentControl Content="{Binding OwnCardsView}" IsVisible="{Binding HasOwnCards}" />
        </Panel>
      </tasks:TasksPaneLayout.MainContent>
    </tasks:TasksPaneLayout>
  </Grid>
</UserControl>
