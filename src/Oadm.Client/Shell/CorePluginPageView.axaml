<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Oadm.Client.Shell"
             x:Class="Oadm.Client.Shell.CorePluginPageView"
             x:DataType="shell:CorePluginPageViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <TextBlock Classes="pageTitle" Text="{Binding Title}" />
    <Border Grid.Row="1" Classes="card">
      <Panel>
        <ContentControl Content="{Binding View}" IsVisible="{Binding HasView}" />
        <TextBlock Classes="secondary" IsVisible="{Binding !HasView}"
                   Text="The page of this plugin is not installed on this client." />
      </Panel>
    </Border>
  </Grid>
</UserControl>
