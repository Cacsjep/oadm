<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:shell="using:Oadm.Client.Shell"
        xmlns:dev="using:Oadm.Client.Devices"
        xmlns:log="using:Oadm.Client.Logging"
        xmlns:rules="using:Oadm.Client.EventRules"
        xmlns:settings="using:Oadm.Client.Settings"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Oadm.Client.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="OADM"
        Width="1800" Height="900" MinWidth="1800" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">

  <Window.DataTemplates>
    <DataTemplate DataType="dev:DevicesViewModel">
      <dev:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="rules:EventRulesViewModel">
      <rules:EventRulesView />
    </DataTemplate>
    <DataTemplate DataType="log:LogsViewModel">
      <log:LogsView />
    </DataTemplate>
    <DataTemplate DataType="settings:SettingsViewModel">
      <settings:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="settings:UsersViewModel">
      <settings:UsersPageView />
    </DataTemplate>
    <DataTemplate DataType="settings:CredentialsViewModel">
      <settings:CredentialsView />
    </DataTemplate>
    <DataTemplate DataType="settings:PluginsViewModel">
      <settings:PluginsPageView />
    </DataTemplate>
    <DataTemplate DataType="settings:AboutViewModel">
      <settings:AboutPageView />
    </DataTemplate>
    <DataTemplate DataType="shell:CorePluginPageViewModel">
      <shell:CorePluginPageView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <!-- Title bar: app name left, system window buttons top-right. No connection indicator (see banner). -->
    <Border Grid.Row="0" Height="{StaticResource Oadm.TitleBarHeight}" Background="{StaticResource Oadm.WindowBackgroundBrush}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <TextBlock Classes="appName" Text="{x:Static shell:MainWindowViewModel.AppName}" Margin="20,0,0,0" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <!-- Navigation rail: collapsed = icons with tooltips, expanded = icon + label -->
      <DockPanel Grid.Column="0" Classes="rail" Classes.expanded="{Binding IsNavExpanded}">
        <Button DockPanel.Dock="Bottom" Classes="nav toggle" Margin="0,2"
                Command="{Binding ToggleNavCommand}"
                ToolTip.Tip="{Binding NavToggleText}" ToolTip.Placement="Right">
          <Panel>
            <ui:IconLabel Icon="{StaticResource Icon.panelOpen}" Text="{Binding NavToggleText}" Spacing="7"
                         IsTextVisible="False" IsVisible="{Binding !IsNavExpanded}" />
            <ui:IconLabel Icon="{StaticResource Icon.panelClose}" Text="{Binding NavToggleText}" Spacing="7"
                         IsVisible="{Binding IsNavExpanded}" />
          </Panel>
        </Button>
        <Border DockPanel.Dock="Bottom" Classes="separator" Margin="4,6" />
        <!-- Logged-in user and Log out, above the expand toggle -->
        <Button DockPanel.Dock="Bottom" Classes="nav" Margin="0,2" Command="{Binding LogoutCommand}"
                ToolTip.Tip="Log out" ToolTip.Placement="Right"
                ToolTip.ServiceEnabled="{Binding !IsNavExpanded}">
          <ui:IconLabel Icon="{StaticResource Icon.logout}" Text="Log out" Spacing="7" IsTextVisible="{Binding IsNavExpanded}" />
        </Button>
        <!-- Initial avatar + name: the account, not a navigation entry; a click shows what the user's role allows -->
        <Button DockPanel.Dock="Bottom" x:Name="RailUser" Classes="railUser" Margin="0,2" Command="{Binding ShowMyRoleCommand}"
                ToolTip.Tip="{Binding UserTooltip}" ToolTip.Placement="Right">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Border Classes="avatar">
              <TextBlock Text="{Binding UserInitial}" />
            </Border>
            <TextBlock Text="{Binding Session.UserName}" IsVisible="{Binding IsNavExpanded}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Border DockPanel.Dock="Bottom" Classes="separator" Margin="4,6" />
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BottomNavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <StackPanel>
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,2"
                        Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right"
                        ToolTip.ServiceEnabled="{Binding !$parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}">
                  <ui:IconLabel Icon="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Text="{Binding Title}" Spacing="7"
                               IsTextVisible="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}" />
                </Button>
                <!-- Plugins: a divider below it -->
                <Border Classes="separator" Margin="4,6" IsVisible="{Binding HasSeparatorAfter}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- The pages fill the rest and scroll when there are more than fit -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding NavItems}" VerticalAlignment="Top">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <StackPanel>
                <Border Classes="separator" Margin="4,6" IsVisible="{Binding HasSeparatorBefore}" />
                <TextBlock Classes="navGroup" Text="{Binding GroupTitle}" IsVisible="{Binding ShowGroupHeader}" />
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,2"
                        Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right"
                        ToolTip.ServiceEnabled="{Binding !$parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}">
                  <!-- Plugin pages: right click opens another copy in its own window -->
                  <Button.ContextMenu>
                    <ContextMenu IsEnabled="{Binding CanOpenInWindow}" IsVisible="{Binding CanOpenInWindow}">
                      <MenuItem Header="Open in new window" Command="{Binding OpenInNewWindowCommand}">
                        <MenuItem.Icon>
                          <ui:OadmIcon Data="{StaticResource Icon.externalLink}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="*,Auto">
                    <ui:IconLabel Grid.Column="0" Icon="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Text="{Binding Title}" Spacing="7"
                                 IsTextVisible="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}" />
                    <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Page; the connection banner shows only while the server is unreachable, the key banner after the
           server replaced its master key until dismissed -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="{StaticResource Oadm.PagePadding}">
        <Border Grid.Row="0" Classes="banner" Classes.connecting="{Binding Connection.IsConnecting}" Margin="0,0,0,12"
                IsVisible="{Binding !Connection.IsConnected}">
          <TextBlock Text="{Binding Connection.StatusText}" />
        </Border>
        <StackPanel Grid.Row="1">
          <Border Classes="banner warning" Margin="0,0,0,12" IsVisible="{Binding HasKeyNotice}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Dismiss" Command="{Binding DismissKeyNoticeCommand}" Margin="12,0,0,0" />
              <TextBlock Text="{Binding KeyNoticeText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <!-- Administrators after the upgrade to roles: what operators lost -->
          <Border Classes="banner warning" Margin="0,0,0,12" IsVisible="{Binding HasRolesNotice}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Dismiss" Command="{Binding DismissRolesNoticeCommand}" Margin="12,0,0,0" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Check roles" Command="{Binding OpenRolesCommand}" Margin="12,0,0,0" />
              <TextBlock Text="{Binding RolesNoticeText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
        </StackPanel>
        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
