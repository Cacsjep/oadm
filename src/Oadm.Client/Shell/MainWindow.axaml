<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:shell="using:Oadm.Client.Shell"
        xmlns:dev="using:Oadm.Client.Devices"
        xmlns:log="using:Oadm.Client.Logging"
        xmlns:settings="using:Oadm.Client.Settings"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Oadm.Client.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="OADM"
        Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">

  <Window.DataTemplates>
    <DataTemplate DataType="dev:DevicesViewModel">
      <dev:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="log:LogsViewModel">
      <log:LogsView />
    </DataTemplate>
    <DataTemplate DataType="settings:SettingsViewModel">
      <settings:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="shell:CorePluginPageViewModel">
      <shell:CorePluginPageView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <!-- Title bar: app name left, system window buttons top-right. No connection indicator (see banner). -->
    <Border Grid.Row="0" Height="{StaticResource Oadm.TitleBarHeight}" Background="{StaticResource Oadm.WindowBackgroundBrush}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <TextBlock Classes="appName" Text="{x:Static shell:MainWindowViewModel.AppName}" Margin="20,0,0,0" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <!-- Navigation rail: collapsed = icons with tooltips, expanded = icon + label -->
      <DockPanel Grid.Column="0" Classes="rail" Classes.expanded="{Binding IsNavExpanded}" LastChildFill="False">
        <Button DockPanel.Dock="Bottom" Classes="nav toggle" Margin="0,2"
                Command="{Binding ToggleNavCommand}"
                ToolTip.Tip="{Binding NavToggleText}" ToolTip.Placement="Right">
          <Panel>
            <ui:IconLabel Icon="{StaticResource Icon.panelOpen}" Text="{Binding NavToggleText}" Spacing="12"
                         IsTextVisible="False" IsVisible="{Binding !IsNavExpanded}" />
            <ui:IconLabel Icon="{StaticResource Icon.panelClose}" Text="{Binding NavToggleText}" Spacing="12"
                         IsVisible="{Binding IsNavExpanded}" />
          </Panel>
        </Button>
        <Border DockPanel.Dock="Bottom" Classes="separator" Margin="4,6" />
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BottomNavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,2"
                      Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right"
                      ToolTip.ServiceEnabled="{Binding !$parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}">
                <ui:IconLabel Icon="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Text="{Binding Title}" Spacing="12"
                             IsTextVisible="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <StackPanel>
                <Border Classes="separator" Margin="4,6" IsVisible="{Binding HasSeparatorBefore}" />
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,2"
                        Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right"
                        ToolTip.ServiceEnabled="{Binding !$parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}">
                  <Grid ColumnDefinitions="*,Auto">
                    <ui:IconLabel Grid.Column="0" Icon="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Text="{Binding Title}" Spacing="12"
                                 IsTextVisible="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).IsNavExpanded}" />
                    <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <!-- Page; the banner shows only while the server is unreachable -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="{StaticResource Oadm.PagePadding}">
        <Border Grid.Row="0" Classes="banner" Classes.connecting="{Binding Connection.IsConnecting}" Margin="0,0,0,12"
                IsVisible="{Binding !Connection.IsConnected}">
          <TextBlock Text="{Binding Connection.StatusText}" />
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
