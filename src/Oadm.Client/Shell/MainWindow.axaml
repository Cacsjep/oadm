<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:shell="using:Oadm.Client.Shell"
        xmlns:dev="using:Oadm.Client.Devices"
        xmlns:tasks="using:Oadm.Client.Tasks"
        xmlns:settings="using:Oadm.Client.Settings"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Oadm.Client.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="OADM"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">

  <Window.DataTemplates>
    <DataTemplate DataType="dev:DevicesViewModel">
      <dev:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="tasks:TasksViewModel">
      <tasks:TasksPageView />
    </DataTemplate>
    <DataTemplate DataType="settings:SettingsViewModel">
      <settings:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="shell:AboutViewModel">
      <shell:AboutView />
    </DataTemplate>
    <DataTemplate DataType="shell:CorePluginPageViewModel">
      <shell:CorePluginPageView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <!-- Title bar: app name left, connection state, system window buttons top-right -->
    <Border Grid.Row="0" Height="{StaticResource Oadm.TitleBarHeight}" Background="{StaticResource Oadm.WindowBackgroundBrush}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0,150,0">
        <TextBlock Grid.Column="0" Classes="appName" Text="{x:Static shell:MainWindowViewModel.AppName}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Classes="statusDot titleBar"
                   Classes.ok="{Binding Connection.IsConnected}"
                   Classes.warn="{Binding Connection.IsConnecting}"
                   Classes.error="{Binding Connection.IsDisconnected}" />
          <TextBlock Classes="secondary" Text="{Binding Connection.StatusText}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <!-- Navigation rail -->
      <DockPanel Grid.Column="0" Width="{StaticResource Oadm.NavWidth}" Margin="16,4,16,16" LastChildFill="False">
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BottomNavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,2"
                      Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <c:OadmIcon Data="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" />
                  <TextBlock Classes="navLabel" Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <StackPanel>
                <Border Classes="separator" Margin="10,6" IsVisible="{Binding HasSeparatorBefore}" />
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="0,2"
                        Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:OadmIcon Grid.Column="0" Data="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" />
                    <TextBlock Grid.Column="1" Classes="navLabel" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <!-- Page -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="{StaticResource Oadm.PagePadding}">
        <Border Grid.Row="0" Classes="banner" Classes.connecting="{Binding Connection.IsConnecting}" Margin="0,0,0,12"
                IsVisible="{Binding !Connection.IsConnected}">
          <TextBlock Text="{Binding Connection.StatusText}" />
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
