<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:c="using:Oadm.Client.Controls"
        xmlns:disc="using:Oadm.Client.Discovery"
        x:Class="Oadm.Client.Discovery.AddDevicesWizardWindow"
        x:DataType="disc:AddDevicesWizardViewModel"
        Title="{Binding Title}"
        Width="1040" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Title bar -->
    <Border Grid.Row="0" Height="{StaticResource Oadm.TitleBarHeight}" Padding="24,0" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <TextBlock Classes="appName" Text="{Binding Title}" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="200,*" Margin="16,0,16,0">
      <!-- Step indicator -->
      <ItemsControl Grid.Column="0" ItemsSource="{Binding Steps}" Margin="8,8,16,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="disc:WizardStepItem">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
              <Border Classes="stepDot" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}">
                <Panel>
                  <TextBlock Text="{Binding Number}" IsVisible="{Binding !IsDone}" />
                  <c:OadmIcon Data="{StaticResource Icon.check}" Width="12" Height="12" HorizontalAlignment="Center" IsVisible="{Binding IsDone}" />
                </Panel>
              </Border>
              <TextBlock Classes="stepLabel" Classes.current="{Binding IsCurrent}" Classes.skipped="{Binding IsSkipped}" Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Step content -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Classes="cardTitle" Text="{Binding StepTitle}" />
          <TextBlock Grid.Row="1" Classes="secondary" Text="{Binding StepDescription}" TextWrapping="Wrap" Margin="0,6,0,16" />

          <Panel Grid.Row="2">
            <!-- 0. IP range -->
            <Grid IsVisible="{Binding IsIpRangeStep}" ColumnDefinitions="120,260" RowDefinitions="Auto,Auto" RowSpacing="12" VerticalAlignment="Top">
              <TextBlock Grid.Row="0" Classes="fieldLabel" Text="From" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RangeFrom}" PlaceholderText="192.168.0.1" />
              <TextBlock Grid.Row="1" Classes="fieldLabel" Text="To" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RangeTo}" PlaceholderText="192.168.0.254" />
            </Grid>

            <!-- 1. Select devices -->
            <Grid IsVisible="{Binding IsSelectStep}" RowDefinitions="Auto,Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="toolbar" Command="{Binding SelectAllCommand}">
                    <c:IconLabel Icon="{StaticResource Icon.check}" Text="Select all" Spacing="8" />
                  </Button>
                  <Button Classes="toolbar" Command="{Binding SelectNoneCommand}">
                    <c:IconLabel Icon="{StaticResource Icon.close}" Text="Clear selection" Spacing="8" />
                  </Button>
                  <TextBlock Classes="secondary" Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <c:SearchBox Grid.Column="2" Text="{Binding SearchText}" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding IsRangeMode}">
                <ProgressBar Value="{Binding ScanProgress}" Minimum="0" Maximum="100" />
                <TextBlock Grid.Column="1" Classes="secondary" Margin="12,0,0,0" Text="{Binding ScanStatusText}" />
              </Grid>
              <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDiscovered}" SelectionMode="Single" IsReadOnly="True" CanUserReorderColumns="False">
                <DataGrid.Styles>
                  <Style Selector="DataGridRow" x:DataType="disc:DiscoveredRowViewModel">
                    <Setter Property="Opacity" Value="{Binding IsSelectable, Converter={x:Static c:Converters.MutedOpacity}}" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="disc:DiscoveredRowViewModel">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Center" MinWidth="0" Padding="0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Address" Width="150" Binding="{Binding Address}" x:DataType="disc:DiscoveredRowViewModel" />
                  <DataGridTextColumn Header="Serial" Width="150" Binding="{Binding Serial}" x:DataType="disc:DiscoveredRowViewModel" />
                  <DataGridTextColumn Header="Model" Width="*" Binding="{Binding Model}" x:DataType="disc:DiscoveredRowViewModel" />
                  <DataGridTemplateColumn Header="Status" Width="180" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="disc:DiscoveredRowViewModel">
                        <Border Classes="pill" Margin="10,0" Classes.ok="{Binding IsStatusOk}" Classes.warn="{Binding IsStatusWarning}" Classes.error="{Binding IsStatusError}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusText}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <!-- 2. Host name -->
            <StackPanel IsVisible="{Binding IsHostNameStep}" Spacing="10">
              <CheckBox IsChecked="{Binding UseHostName}" Content="Use host name when available, otherwise IP address" />
              <TextBlock Classes="secondary" TextWrapping="Wrap"
                         Text="With host names the devices stay reachable when DHCP gives them a new address. This requires working DNS for the device host names." />
            </StackPanel>

            <!-- 3. Set password -->
            <Grid IsVisible="{Binding IsPasswordStep}" RowDefinitions="*,Auto">
              <DataGrid Grid.Row="0" ItemsSource="{Binding PasswordDevices}" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,16">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Address" Width="150" Binding="{Binding Address}" x:DataType="disc:PlanRowViewModel" />
                  <DataGridTextColumn Header="Serial" Width="150" Binding="{Binding Serial}" x:DataType="disc:PlanRowViewModel" />
                  <DataGridTextColumn Header="Model" Width="*" Binding="{Binding Model}" x:DataType="disc:PlanRowViewModel" />
                </DataGrid.Columns>
              </DataGrid>
              <Grid Grid.Row="1" ColumnDefinitions="150,280" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Classes="fieldLabel" Text="User" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="root" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="New password" />
                <TextBox Grid.Row="1" Grid.Column="1" PasswordChar="&#x2022;" Text="{Binding NewPassword}" />
                <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Confirm password" />
                <TextBox Grid.Row="2" Grid.Column="1" PasswordChar="&#x2022;" Text="{Binding ConfirmPassword}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="secondary small" TextWrapping="Wrap" Text="{x:Static disc:AddDevicesWizardViewModel.PasswordRules}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Classes="error" Text="{Binding PasswordError}" />
              </Grid>
            </Grid>

            <!-- 4. Credentials -->
            <Grid IsVisible="{Binding IsCredentialsStep}" RowDefinitions="Auto,Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="150,280" RowDefinitions="Auto,Auto" RowSpacing="10" IsEnabled="{Binding UseForAll}">
                <TextBlock Grid.Row="0" Classes="fieldLabel" Text="User name" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" />
                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Password" />
                <TextBox Grid.Row="1" Grid.Column="1" PasswordChar="&#x2022;" Text="{Binding Password}" />
              </Grid>
              <CheckBox Grid.Row="1" Margin="0,12,0,12" IsChecked="{Binding UseForAll}" Content="Use these credentials for all selected devices" />
              <DataGrid Grid.Row="2" ItemsSource="{Binding CredentialDevices}" SelectionMode="Single" CanUserReorderColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Address" Width="140" IsReadOnly="True" Binding="{Binding Address}" x:DataType="disc:CredentialRowViewModel" />
                  <DataGridTextColumn Header="Serial" Width="140" IsReadOnly="True" Binding="{Binding Serial}" x:DataType="disc:CredentialRowViewModel" />
                  <DataGridTextColumn Header="Model" Width="*" IsReadOnly="True" Binding="{Binding Model}" x:DataType="disc:CredentialRowViewModel" />
                  <DataGridTemplateColumn Header="User name" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="disc:CredentialRowViewModel">
                        <TextBox Text="{Binding UserName}" Margin="4,2" MinHeight="28"
                                 IsEnabled="{Binding $parent[Window].((disc:AddDevicesWizardViewModel)DataContext).ShowPerDeviceCredentials}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Password" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="disc:CredentialRowViewModel">
                        <TextBox Text="{Binding Password}" PasswordChar="&#x2022;" Margin="4,2" MinHeight="28"
                                 IsEnabled="{Binding $parent[Window].((disc:AddDevicesWizardViewModel)DataContext).ShowPerDeviceCredentials}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <!-- 5. Review -->
            <DataGrid IsVisible="{Binding IsReviewStep}" ItemsSource="{Binding ReviewRows}" IsReadOnly="True" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Width="200" Binding="{Binding Address}" x:DataType="disc:ReviewRow" />
                <DataGridTextColumn Header="Serial" Width="140" Binding="{Binding Serial}" x:DataType="disc:ReviewRow" />
                <DataGridTextColumn Header="Model" Width="160" Binding="{Binding Model}" x:DataType="disc:ReviewRow" />
                <DataGridTemplateColumn Header="Action" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="disc:ReviewRow">
                      <TextBlock Text="{Binding Action}" Classes.warning="{Binding IsWarning}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Panel>

          <TextBlock Grid.Row="3" Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,12,0,0"
                     IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="232,16,16,16">
      <Button Grid.Column="0" Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" IsCancel="True" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
        <Button Classes="secondary" Content="Skip" Command="{Binding SkipCommand}" IsVisible="{Binding IsPasswordStep}"
                ToolTip.Tip="Add the factory-default devices without setting a password" />
        <Button Classes="primary" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" IsDefault="True">
          <Panel>
            <TextBlock Text="Next" IsVisible="{Binding !IsLastStep}" />
            <TextBlock Text="Finish" IsVisible="{Binding IsLastStep}" />
          </Panel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
