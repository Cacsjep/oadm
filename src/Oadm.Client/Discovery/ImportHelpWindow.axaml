<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.Discovery"
        x:Class="Oadm.Client.Discovery.ImportHelpWindow"
        x:DataType="vm:ImportHelpViewModel"
        Title="{Binding Title}"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- Before the file picker of "Import from file" and "Import from ADM": what the file holds, an example. Single operation. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <TextBlock TextWrapping="Wrap" Text="{Binding Intro}" />
        <!-- A handful of fixed rows (not a device list) -->
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Classes="form" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportHelpRow">
              <Grid ColumnDefinitions="140,*">
                <TextBlock Classes="secondary" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Text}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="secondary" Text="Example" IsVisible="{Binding HasExample}" />
        <ui:CodeView Language="Plain" Text="{Binding Example}" IsVisible="{Binding HasExample}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Limits}" />
        <ui:StatusChip IsWarning="True" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Command="{Binding ChooseCommand}">
        <ui:IconLabel Icon="{StaticResource Icon.download}" Text="Choose file" />
      </Button>
    </ui:DialogFooter>
  </Grid>
</Window>
