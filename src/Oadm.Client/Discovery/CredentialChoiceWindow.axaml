<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.Discovery"
        x:Class="Oadm.Client.Discovery.CredentialChoiceWindow"
        x:DataType="vm:CredentialChoiceViewModel"
        Title="{x:Static vm:CredentialChoiceViewModel.Title}"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- Before the add devices page: a list with its editor (title bar, one card: intro, Add credential and Show passwords,
       the credential list with boxes, the error below the list, the add editor), footer. At most 20 entries: not virtualized. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static vm:CredentialChoiceViewModel.Title}" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static vm:CredentialChoiceViewModel.Intro}" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <ui:ToolbarButton Text="Add credential" IconKey="add" Command="{Binding StartAddCommand}" IsEnabled="{Binding !IsAdding}" />
          <ui:ToolbarButton Text="{Binding PasswordsButtonText}" IconKey="{Binding PasswordsButtonIcon}" Command="{Binding TogglePasswordsCommand}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CredentialChoiceItem">
              <Grid ColumnDefinitions="Auto,200,*" ColumnSpacing="12" Margin="0,0,0,4">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" />
                <ui:IconLabel Grid.Column="1" Icon="{StaticResource Icon.key}" Text="{Binding Entry.UserName}" />
                <TextBlock Grid.Column="2" Text="{Binding Entry.PasswordText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Whole-list errors: directly below the list -->
        <TextBlock Classes="error" Text="{Binding ChoiceError}" TextWrapping="Wrap"
                   IsVisible="{Binding ChoiceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Add credential: saved to the credential list and ticked -->
        <Border Classes="inlineEditor" IsVisible="{Binding IsAdding}">
          <StackPanel Classes="form">
            <ui:FormField Label="User name">
              <TextBox x:Name="NewUserNameBox" Text="{Binding NewUserName}" />
            </ui:FormField>
            <ui:FormField Label="Password">
              <ui:PasswordBox Text="{Binding NewPassword}">
                <ui:PasswordBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </ui:PasswordBox.KeyBindings>
              </ui:PasswordBox>
            </ui:FormField>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Add" Command="{Binding AddCommand}"
                      ToolTip.Tip="{Binding AddBlockedReason}" ToolTip.ShowOnDisabled="True" />
              <Button Classes="secondary" Content="Cancel" Command="{Binding CancelAddCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <!-- While the add editor is open its Add is the one accent button -->
      <Button Classes.primary="{Binding !IsAdding}" Classes.secondary="{Binding IsAdding}" IsDefault="{Binding !IsAdding}"
              Content="Continue" Command="{Binding ContinueCommand}"
              ToolTip.Tip="{Binding ContinueBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
