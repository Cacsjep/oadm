<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="using:Oadm.Client.Tasks"
             xmlns:log="using:Oadm.Client.Logging"
             x:Class="Oadm.Client.Tasks.LogListView"
             x:DataType="tasks:TasksViewModel">
  <DataGrid ItemsSource="{Binding LogEntries}" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False" CanUserReorderColumns="False">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Time" Width="100" Binding="{Binding TimeText}" x:DataType="log:LogEntry" />
      <DataGridTemplateColumn Header="Level" Width="110">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="log:LogEntry">
            <Border Classes="pill" Margin="10,0" Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarning}">
              <TextBlock Text="{Binding Level}" />
            </Border>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" x:DataType="log:LogEntry" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
