<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:tasks="using:Oadm.Client.Tasks"
        x:Class="Oadm.Client.Tasks.TaskDetailsWindow"
        x:DataType="tasks:TaskDetailsViewModel"
        Title="{Binding Title}"
        Width="1040" Height="820" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{StaticResource Oadm.TitleBarHeight}">
  <Grid RowDefinitions="Auto,Auto,0,3*,16,2*,Auto">
    <ui:DialogTitleBar Text="{Binding Title}" />

    <!-- A task targets exactly one device: one header line with its facts and state -->
    <WrapPanel Grid.Row="1" Margin="24,4,24,12" Orientation="Horizontal" ItemSpacing="20" LineSpacing="6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="secondary" Text="Device" />
        <TextBlock Text="{Binding Device.Device, FallbackValue=''}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="secondary" Text="MAC address" />
        <TextBlock Text="{Binding Device.Serial, FallbackValue=''}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="secondary" Text="Model" />
        <TextBlock Text="{Binding Device.Model, FallbackValue=''}" />
      </StackPanel>
      <ui:StatusChip Text="{Binding Device.StateText, FallbackValue=''}" Detail="{Binding Device.Message, FallbackValue=''}"
                     ToolTip.Tip="{Binding Device.Message, FallbackValue=''}"
                     IsOk="{Binding Device.IsStateOk, FallbackValue=False}" IsWarning="{Binding Device.IsStateWarning, FallbackValue=False}"
                     IsError="{Binding Device.IsStateError, FallbackValue=False}" IsAccent="{Binding Device.IsStateAccent, FallbackValue=False}" />
    </WrapPanel>

    <!-- What the task did, step by step (live while it runs) -->
    <Border Grid.Row="3" Classes="card" Margin="16,0">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Classes="cardTitle" Text="Steps" />
          <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding StepsStatus}" VerticalAlignment="Center" />
        </Grid>
        <DataGrid x:Name="StepsGrid" Grid.Row="1" ItemsSource="{Binding Steps}" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="False" CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Width="48" Binding="{Binding Number}" x:DataType="tasks:TaskStepRowViewModel" />
            <DataGridTemplateColumn Header="Status" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="tasks:TaskStepRowViewModel">
                  <ui:StatusChip Text="{Binding StateText}" IsOk="{Binding IsStateOk}" IsWarning="{Binding IsStateWarning}" IsError="{Binding IsStateError}" IsAccent="{Binding IsStateAccent}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Step" Width="2*" Binding="{Binding Name}" x:DataType="tasks:TaskStepRowViewModel" />
            <DataGridTemplateColumn Header="Detail" Width="3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="tasks:TaskStepRowViewModel">
                  <TextBlock Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Width="110" Binding="{Binding DurationText}" x:DataType="tasks:TaskStepRowViewModel" CellStyleClasses="number">
              <DataGridTextColumn.Header>
                <TextBlock Classes="numberHeader" Text="Duration" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="Progress" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="tasks:TaskStepRowViewModel">
                  <Grid ColumnDefinitions="*,52" Margin="10,0,12,0" VerticalAlignment="Center" IsVisible="{Binding IsRunning}">
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Classes="stream" />
                    <TextBlock Grid.Column="1" Classes="secondary" Margin="10,0,0,0" Text="{Binding ProgressText}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="5" Classes="card" Margin="16,0">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Classes="cardTitle" Text="Log" />
          <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding LogStatus}" VerticalAlignment="Center" />
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Log}" IsReadOnly="True" SelectionMode="Extended"
                  CanUserSortColumns="False" CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Level" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="tasks:TaskLogRow">
                  <ui:StatusChip Text="{Binding LevelText}" IsWarning="{Binding IsWarning}" IsError="{Binding IsError}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Time" Width="170" Binding="{Binding TimeText}" x:DataType="tasks:TaskLogRow" />
            <DataGridTextColumn Header="Device" Width="160" Binding="{Binding Device}" x:DataType="tasks:TaskLogRow" />
            <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" x:DataType="tasks:TaskLogRow" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <ui:DialogFooter Grid.Row="6" x:Name="Footer" CancelText="Close">
      <TextBlock Classes="error" Text="{Binding CancelError}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                 IsVisible="{Binding CancelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button Classes="secondary" Content="Cancel task" Command="{Binding CancelTaskCommand}" IsVisible="{Binding CanCancel}" />
    </ui:DialogFooter>
  </Grid>
</Window>
