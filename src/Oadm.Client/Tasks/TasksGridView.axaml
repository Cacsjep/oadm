<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:tasks="using:Oadm.Client.Tasks"
             x:Class="Oadm.Client.Tasks.TasksGridView"
             x:DataType="tasks:TasksViewModel">
  <Panel>
  <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" SelectionMode="Single" IsReadOnly="True"
            CanUserReorderColumns="False">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Width="3*" MinWidth="260" Binding="{Binding Name}" x:DataType="tasks:TaskRowViewModel" />
      <DataGridTemplateColumn Header="Device" Width="110" SortMemberPath="DeviceText">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="tasks:TaskRowViewModel">
            <TextBlock Text="{Binding DeviceText}" ToolTip.Tip="{Binding DeviceTooltip}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Status" Width="3*" MinWidth="280" SortMemberPath="StateText">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="tasks:TaskRowViewModel">
            <ui:StatusChip Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusTooltip}" IsOk="{Binding IsStateOk}" IsWarning="{Binding IsStateWarning}" IsError="{Binding IsStateError}" IsAccent="{Binding IsStateAccent}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Current step" Width="2*" MinWidth="180" SortMemberPath="CurrentStepText">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="tasks:TaskRowViewModel">
            <TextBlock Text="{Binding CurrentStepText}" ToolTip.Tip="{Binding CurrentStepTooltip}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="Start time" Width="150" Binding="{Binding StartTimeText}" x:DataType="tasks:TaskRowViewModel" />
      <DataGridTextColumn Header="Owner" Width="140" Binding="{Binding Owner}" x:DataType="tasks:TaskRowViewModel" />
      <DataGridTemplateColumn Header="Progress" Width="*" MinWidth="120" SortMemberPath="Progress">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="tasks:TaskRowViewModel">
            <Grid ColumnDefinitions="*,52" Margin="10,0,12,0" VerticalAlignment="Center" IsVisible="{Binding IsActive}">
              <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Classes.stream="{Binding IsActive}" />
              <TextBlock Grid.Column="1" Classes="secondary" Margin="10,0,0,0" Text="{Binding ProgressText}" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
  <TextBlock Classes="secondary" Text="No tasks yet. Right-click devices to run one." IsVisible="{Binding IsEmpty}"
             HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Panel>
</UserControl>
