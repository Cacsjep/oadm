<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:tasks="using:Oadm.Client.Tasks"
             x:Class="Oadm.Client.Tasks.TasksPaneView"
             x:DataType="tasks:TasksViewModel">
  <!-- Collapsible, resizable tasks card below the device grid (height set by the splitter above it) -->
  <Border Classes="card" Padding="16,12,16,12">
    <Grid RowDefinitions="Auto,*">
      <!-- The shared pane header: title and running count left, the progress row, the actions right -->
      <ui:PaneHeader Grid.Row="0" Title="Tasks">
        <ui:PaneHeader.Badge>
          <Border Classes="badge" IsVisible="{Binding HasActive}" ToolTip.Tip="Running tasks">
            <TextBlock Text="{Binding ActiveCountText}" />
          </Border>
        </ui:PaneHeader.Badge>
        <ui:PaneHeader.Middle>
          <ui:ProgressRow Margin="16,0" Text="{Binding Work.Text}" IsActive="{Binding Work.IsActive}" IsVisible="{Binding Work.IsActive}" />
        </ui:PaneHeader.Middle>
        <ui:PaneHeader.Actions>
          <StackPanel Orientation="Horizontal" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsExpanded}">
              <Button Classes="toolbar" Command="{Binding DetailsCommand}" ToolTip.Tip="Show the result per device">
                <ui:IconLabel Icon="{StaticResource Icon.details}" Text="Details" Spacing="8" />
              </Button>
              <!-- Commands of plugins on the selected task (ITaskAction: Run again of Provisioning), only while one fits -->
              <ItemsControl x:Name="TaskActions" ItemsSource="{Binding SelectedActions}" IsVisible="{Binding HasSelectedActions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="tasks:TaskActionItem">
                    <ui:ToolbarButton IconKey="{Binding IconKey}" Text="{Binding Text}" ToolTip.Tip="{Binding Tooltip}" Command="{Binding RunCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="toolbar" Command="{Binding CancelCommand}" ToolTip.Tip="Cancel the running task" IsVisible="{Binding MayCancel}">
                <ui:IconLabel Icon="{StaticResource Icon.cancel}" Text="Cancel" Spacing="8" />
              </Button>
              <Button Classes="toolbar" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the finished task from the history" IsVisible="{Binding MayDelete}">
                <ui:IconLabel Icon="{StaticResource Icon.remove}" Text="Delete" Spacing="8" />
              </Button>
              <Border Classes="vseparator" IsVisible="{Binding MayDeleteAll}" />
              <Button Classes="toolbar danger" Command="{Binding DeleteAllCommand}" ToolTip.Tip="Cancel running tasks and delete the whole task history" IsVisible="{Binding MayDeleteAll}">
                <ui:IconLabel Icon="{StaticResource Icon.deleteAll}" Text="Delete all" Spacing="8" />
              </Button>
              <Border Classes="vseparator" />
            </StackPanel>
            <Button Classes="toolbar iconOnly" Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="Show or hide the tasks">
              <Panel>
                <ui:OadmIcon Data="{StaticResource Icon.chevronDown}" IsVisible="{Binding IsExpanded}" />
                <ui:OadmIcon Data="{StaticResource Icon.chevronUp}" IsVisible="{Binding !IsExpanded}" />
              </Panel>
            </Button>
          </StackPanel>
        </ui:PaneHeader.Actions>
      </ui:PaneHeader>

      <tasks:TasksGridView Grid.Row="1" Margin="0,8,0,0" IsVisible="{Binding IsExpanded}" />
    </Grid>
  </Border>
</UserControl>
