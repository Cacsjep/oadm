<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:tasks="using:Oadm.Client.Tasks"
             x:Class="Oadm.Client.Tasks.TasksPaneView"
             x:DataType="tasks:TasksViewModel">
  <!-- Collapsible, resizable tasks card below the device grid (height set by the splitter above it) -->
  <Border Classes="card" Padding="16,12,16,12">
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="sectionTitle" Text="Tasks" VerticalAlignment="Center" />
          <Border Classes="badge" IsVisible="{Binding HasActive}" ToolTip.Tip="Running tasks">
            <TextBlock Text="{Binding ActiveCountText}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsExpanded}">
            <Button Classes="toolbar" Command="{Binding DetailsCommand}" ToolTip.Tip="Show the result per device">
              <ui:IconLabel Icon="{StaticResource Icon.details}" Text="Details" Spacing="8" />
            </Button>
            <Button Classes="toolbar" Command="{Binding CancelCommand}" ToolTip.Tip="Cancel the running task">
              <ui:IconLabel Icon="{StaticResource Icon.cancel}" Text="Cancel" Spacing="8" />
            </Button>
            <Button Classes="toolbar" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the finished task from the history">
              <ui:IconLabel Icon="{StaticResource Icon.remove}" Text="Delete" Spacing="8" />
            </Button>
            <Button Classes="toolbar" Command="{Binding DeleteAllCommand}" ToolTip.Tip="Cancel running tasks and delete the whole task history">
              <ui:IconLabel Icon="{StaticResource Icon.deleteAll}" Text="Delete all" Spacing="8" />
            </Button>
            <Border Classes="vseparator" />
          </StackPanel>
          <Button Classes="toolbar iconOnly" Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="Show or hide the tasks">
            <Panel>
              <ui:OadmIcon Data="{StaticResource Icon.chevronDown}" IsVisible="{Binding IsExpanded}" />
              <ui:OadmIcon Data="{StaticResource Icon.chevronUp}" IsVisible="{Binding !IsExpanded}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>

      <tasks:TasksGridView Grid.Row="1" Margin="0,8,0,0" IsVisible="{Binding IsExpanded}" />
    </Grid>
  </Border>
</UserControl>
