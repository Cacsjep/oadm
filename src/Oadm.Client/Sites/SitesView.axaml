<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Client.Sites"
             xmlns:sites="using:Oadm.Contracts.Sites"
             x:Class="Oadm.Client.Sites.SitesView"
             x:DataType="vm:SitesViewModel">
  <!-- Rail page Sites (Servers): bound sites and site nodes waiting to be bound in one list. -->
  <Grid RowDefinitions="Auto,*">
    <c:PageTitleBar Grid.Row="0" Title="Sites" Subtitle="Networks OADM reaches through an OADM Site Node." Margin="0,0,0,16" />

    <!-- Accept site nodes is off and nothing to list: what sites are and Accept site nodes (like Compliance while off). -->
    <Border Grid.Row="1" Classes="card" IsVisible="{Binding ShowOffState}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460">
        <ui:OadmIcon Data="{StaticResource Icon.server}" Width="32" Height="32" HorizontalAlignment="Center" />
        <TextBlock Classes="cardTitle" HorizontalAlignment="Center" Text="Site nodes are off" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Manage devices in networks this server cannot reach. An OADM Site Node in that network connects to this server." />
        <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding AcceptCommand}" IsVisible="{Binding MayChange}"
                IsEnabled="{Binding !IsChangingAccept}">
          <ui:IconLabel Icon="{StaticResource Icon.server}" Text="Accept site nodes" />
        </Button>
        <TextBlock Classes="secondary" HorizontalAlignment="Center" IsVisible="{Binding !MayChange}"
                   Text="An administrator can turn them on." />
        <TextBlock Classes="error" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}" IsVisible="{Binding ShowList}">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding AcceptText}" IsVisible="{Binding !MayChange}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="toolbar danger" Command="{Binding TurnOffCommand}" IsEnabled="{Binding !IsChangingAccept}" IsVisible="{Binding ShowTurnOff}">
              <ui:IconLabel Icon="{StaticResource Icon.stop}" Text="Turn off site nodes" Spacing="8" />
            </Button>
            <ui:ToolbarButton Text="Accept site nodes" IconKey="server" Command="{Binding AcceptCommand}" IsEnabled="{Binding !IsChangingAccept}" IsVisible="{Binding ShowAcceptButton}" />
            <ui:SearchBox Text="{Binding SearchText}" Placeholder="Search sites" />
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="secondary" Text="{Binding StatusText}" Margin="2,14,0,8" />

        <DataGrid x:Name="SiteGrid" Grid.Row="2" Classes="wrapRows" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="True" CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="State" Width="*" MinWidth="280" SortMemberPath="StateText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:SiteRowViewModel">
                  <ui:StatusChip Text="{Binding StateText}" Detail="{Binding Detail}" IsOk="{Binding IsOk}" IsError="{Binding IsError}"
                                 IsWarning="{Binding IsWarning}" IsInfo="{Binding IsInfo}" MaxLines="2" Opacity="{Binding RowOpacity}"
                                 ToolTip.Tip="{Binding StateTip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Name" Width="160" MinWidth="120" Binding="{Binding Name}" x:DataType="vm:SiteRowViewModel" />
            <DataGridTextColumn Header="Node address" Width="150" MinWidth="120" Binding="{Binding NodeAddressText}" x:DataType="vm:SiteRowViewModel" />
            <DataGridTextColumn Width="100" Binding="{Binding DeviceCountText}" SortMemberPath="DeviceCount" x:DataType="vm:SiteRowViewModel" CellStyleClasses="number">
              <DataGridTextColumn.Header>
                <TextBlock Classes="numberHeader" Text="Devices" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Width="145" Binding="{Binding RoundTripText}" SortMemberPath="RoundTripMs" x:DataType="vm:SiteRowViewModel" CellStyleClasses="number">
              <DataGridTextColumn.Header>
                <TextBlock Classes="numberHeader" Text="Response time" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Width="130" Binding="{Binding ConnectionsText}" x:DataType="vm:SiteRowViewModel" CellStyleClasses="number">
              <DataGridTextColumn.Header>
                <TextBlock Classes="numberHeader" Text="Connections" ToolTip.Tip="Now open" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Width="165" Binding="{Binding PortsWaitingText}" SortMemberPath="PortsWaiting" x:DataType="vm:SiteRowViewModel" CellStyleClasses="number">
              <DataGridTextColumn.Header>
                <TextBlock Classes="numberHeader" Text="Waiting for approval" ToolTip.Tip="Ports to allow in the OADM Site Node app" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Width="195" Binding="{Binding LargeTransfersText}" SortMemberPath="LargeTransfers" x:DataType="vm:SiteRowViewModel" CellStyleClasses="number">
              <DataGridTextColumn.Header>
                <TextBlock Classes="numberHeader" Text="Uploads and downloads" ToolTip.Tip="Running now" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Version" Width="175" MinWidth="80" Binding="{Binding VersionText}" x:DataType="vm:SiteRowViewModel" />
            <DataGridTextColumn Header="Last seen" Width="140" MinWidth="130" Binding="{Binding LastSeenText}" SortMemberPath="LastSeenSortKey" x:DataType="vm:SiteRowViewModel" />
            <!-- Row actions (administrators): Bind for waiting nodes; Rename, Replace with and Remove site for sites;
                 Replace with and Remove devices for a removed site with kept devices -->
            <DataGridTemplateColumn Width="150" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:SiteRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0">
                    <Button Classes="link" Content="Bind" IsVisible="{Binding CanBind}" Margin="4,0"
                            Command="{Binding $parent[UserControl].((vm:SitesViewModel)DataContext).BindCommand}" CommandParameter="{Binding}" />
                    <Button Classes="toolbar iconOnly" ToolTip.Tip="Rename" IsVisible="{Binding CanManage}"
                            Command="{Binding $parent[UserControl].((vm:SitesViewModel)DataContext).RenameCommand}" CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                    </Button>
                    <Button Classes="toolbar iconOnly" ToolTip.Tip="{x:Static sites:SiteTexts.ReplaceTip}" IsVisible="{Binding CanReplace}"
                            Command="{Binding $parent[UserControl].((vm:SitesViewModel)DataContext).ReplaceCommand}" CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.refresh}" />
                    </Button>
                    <Button Classes="toolbar iconOnly danger" ToolTip.Tip="{Binding RemoveTip}" IsVisible="{Binding CanRemove}"
                            Command="{Binding $parent[UserControl].((vm:SitesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <ui:ProgressRing Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
        <TextBlock Grid.Row="2" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                   TextAlignment="Center" Text="{Binding EmptyText}" IsVisible="{Binding ShowEmpty}" />
        <TextBlock Grid.Row="3" Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Grid.Row="4" Classes="secondary" Text="{Binding NoticeText}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
