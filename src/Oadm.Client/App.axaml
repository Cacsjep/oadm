<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Oadm.Client.App"
             RequestedThemeVariant="Dark">
  <!-- OADM is dark only. All colors and sizes come from Themes/OadmTheme.axaml. -->
  <Application.Styles>
    <StyleInclude Source="avares://Oadm.Client/Themes/OadmTheme.axaml" />
  </Application.Styles>
</Application>
