<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Client.Backup"
        x:Class="Oadm.Client.Backup.BackupPasswordWindow"
        x:DataType="vm:BackupPasswordViewModel"
        Title="Back up now"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- "Back up now" of the Settings page: single operation, the password of the backup. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Back up now" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static vm:BackupPasswordViewModel.Intro}" />
        <ui:FormField Label="Password">
          <ui:PasswordBox x:Name="PasswordField" Text="{Binding Password}" />
        </ui:FormField>
        <ui:FormField Label="Confirm password">
          <ui:PasswordBox Text="{Binding ConfirmPassword}" />
        </ui:FormField>
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Content="Back up" Command="{Binding OkCommand}"
              ToolTip.Tip="{Binding OkBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
