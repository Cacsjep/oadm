<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:c="using:Oadm.Client.Controls"
             x:Class="Oadm.Client.Settings.UsersPageView"
             x:DataType="settings:UsersViewModel">
  <!-- Navigation page Permissions (Admin only): users left and device groups right on top, the roles card (permission matrix) below with a
       splitter, like the Devices page and its tasks. The top row takes the height it needs, the roles card the rest. -->
  <Grid x:Name="Page" RowDefinitions="Auto,Auto,Auto,*">
    <c:PageTitleBar Grid.Row="0" Title="Permissions" Subtitle="Who can log in, which devices they reach and what each role may do." Margin="0,0,0,16" />
    <ScrollViewer Grid.Row="1">
      <!-- Side by side on a wide page; on a narrower one (small or scaled screens) the device groups move below the users
           (UsersPageView.axaml.cs), so no column of the users is cut off; then the two cards share the height with the roles
       card (the splitter moves the line between them). -->
      <Grid x:Name="Columns" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" VerticalAlignment="Top">
        <settings:UsersCardView Grid.Column="0" VerticalAlignment="Top" />
        <settings:DeviceGroupsCardView x:Name="GroupsCard" Grid.Column="2" VerticalAlignment="Top" DataContext="{Binding DeviceGroups}" />
      </Grid>
    </ScrollViewer>
    <GridSplitter Grid.Row="2" Classes="paneSplitter" />
    <settings:RolesCardView Grid.Row="3" DataContext="{Binding RolesCard}" />
  </Grid>
</UserControl>
