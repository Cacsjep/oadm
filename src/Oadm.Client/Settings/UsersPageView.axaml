<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:c="using:Oadm.Client.Controls"
             x:Class="Oadm.Client.Settings.UsersPageView"
             x:DataType="settings:UsersViewModel">
  <!-- Navigation page Users (Admin only): page header and the users card. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <c:PageTitleBar Title="Users" Subtitle="Who can log in to this server and what they may do." />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
        <settings:UsersCardView />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
