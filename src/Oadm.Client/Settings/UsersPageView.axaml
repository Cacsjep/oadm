<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:c="using:Oadm.Client.Controls"
             x:Class="Oadm.Client.Settings.UsersPageView"
             x:DataType="settings:UsersViewModel">
  <!-- Navigation page Users (Admin only): the users card on top, the roles card (permission matrix) below with a
       splitter, like the Devices page and its tasks. -->
  <Grid RowDefinitions="Auto,*,Auto,*">
    <c:PageTitleBar Grid.Row="0" Title="Users" Subtitle="Who can log in to this server and what each role may do." Margin="0,0,0,16" />
    <ScrollViewer Grid.Row="1">
      <settings:UsersCardView MaxWidth="1000" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </ScrollViewer>
    <GridSplitter Grid.Row="2" Classes="paneSplitter" />
    <settings:RolesCardView Grid.Row="3" DataContext="{Binding RolesCard}" />
  </Grid>
</UserControl>
