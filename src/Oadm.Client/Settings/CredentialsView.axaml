<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:c="using:Oadm.Client.Controls"
             x:Class="Oadm.Client.Settings.CredentialsView"
             x:DataType="settings:CredentialsViewModel">
  <!-- Navigation page Credentials (Admin only): the credential list (at most 20 entries) and the add form. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <c:PageTitleBar Title="Credentials" Subtitle="Passwords OADM tries when it adds devices." />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <ItemsControl ItemsSource="{Binding Credentials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settings:CredentialItemViewModel">
                  <Grid ColumnDefinitions="180,160,Auto,Auto,*,Auto" ColumnSpacing="16" Margin="0,0,0,6">
                    <ui:IconLabel Icon="{StaticResource Icon.key}" Text="{Binding UserName}" />
                    <TextBlock Grid.Column="1" Text="{Binding PasswordText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="toolbar iconOnly" ToolTip.Tip="{Binding RevealTooltip}"
                            Command="{Binding $parent[UserControl].((settings:CredentialsViewModel)DataContext).ToggleRevealCredentialCommand}"
                            CommandParameter="{Binding}">
                      <Panel>
                        <ui:OadmIcon Data="{StaticResource Icon.eye}" IsVisible="{Binding !IsRevealed}" />
                        <ui:OadmIcon Data="{StaticResource Icon.eyeOff}" IsVisible="{Binding IsRevealed}" />
                      </Panel>
                    </Button>
                    <Button Grid.Column="3" Classes="toolbar iconOnly" ToolTip.Tip="Copy password"
                            Command="{Binding $parent[UserControl].((settings:CredentialsViewModel)DataContext).CopyCredentialPasswordCommand}"
                            CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.copy}" />
                    </Button>
                    <TextBlock Grid.Column="4" Classes="secondary" Text="{Binding AddedText}" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Classes="toolbar iconOnly danger" ToolTip.Tip="Remove"
                            Command="{Binding $parent[UserControl].((settings:CredentialsViewModel)DataContext).RemoveCredentialCommand}"
                            CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="secondary" Text="No credentials yet." IsVisible="{Binding HasNoCredentials}" />
            <Border Classes="separator" />
            <StackPanel Classes="form">
              <TextBlock Classes="sectionTitle" Text="Add credential" />
              <ui:FormField Label="User name">
                <TextBox Text="{Binding NewCredentialUserName}" />
              </ui:FormField>
              <ui:FormField Label="Password">
                <ui:PasswordBox Text="{Binding NewCredentialPassword}">
                  <ui:PasswordBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCredentialCommand}" />
                  </ui:PasswordBox.KeyBindings>
                </ui:PasswordBox>
              </ui:FormField>
              <ui:FormField>
                <Button Classes="primary" Content="Add credential" Command="{Binding AddCredentialCommand}"
                        ToolTip.Tip="{Binding AddCredentialBlockedReason}" ToolTip.ShowOnDisabled="True" />
              </ui:FormField>
            </StackPanel>
            <TextBlock Text="{Binding CredentialMessage}" Classes.error="{Binding CredentialMessageIsError}" Classes.secondary="{Binding !CredentialMessageIsError}"
                       TextWrapping="Wrap" IsVisible="{Binding CredentialMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
