<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             x:Class="Oadm.Client.Settings.SettingsView"
             x:DataType="settings:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="pageTitle" Text="Settings" Margin="4,0,0,0" />

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="cardTitle" Text="Server" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Stored on the OADM server and shared by every client." />
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
            <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Status polling interval (s)" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" Minimum="5" Maximum="3600" Increment="5"
                           FormatString="0" Value="{Binding PollingIntervalSeconds}" />
            <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Full refresh interval (min)" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Minimum="1" Maximum="1440" Increment="1"
                           FormatString="0" Value="{Binding FullRefreshMinutes}"
                           ToolTip.Tip="Network parameters and certificate info are re-read this often, and when a device comes back online" />
            <TextBlock Grid.Row="2" Classes="fieldLabel" Text="IP range scan parallelism" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Minimum="1" Maximum="256"
                           FormatString="0" Value="{Binding ScanParallelism}" />
            <TextBlock Grid.Row="3" Classes="fieldLabel" Text="IP range scan timeout (ms)" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Minimum="100" Maximum="30000" Increment="100"
                           FormatString="0" Value="{Binding ScanTimeoutMs}" />
            <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Server name" />
            <TextBox Grid.Row="4" Grid.Column="1" Width="320" HorizontalAlignment="Left" Text="{Binding ServerName}" />
            <TextBlock Grid.Row="5" Classes="fieldLabel" Text="Listen URL" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="320" HorizontalAlignment="Left" Text="{Binding ListenUrl}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
            <Button Classes="secondary" Content="Reload" Command="{Binding LoadCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ServerMessage}" Classes.error="{Binding ServerMessageIsError}" Classes.secondary="{Binding !ServerMessageIsError}"
                     TextWrapping="Wrap" IsVisible="{Binding ServerMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="cardTitle" Text="This client" />
          <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
            <TextBlock Classes="fieldLabel" Text="Server address" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Width="320" Text="{Binding ServerAddress}" PlaceholderText="http://localhost:5080" />
              <Button Classes="secondary" Content="Connect" Command="{Binding ApplyServerAddressCommand}" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="secondary" Text="{Binding ClientMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding ClientMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
