<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:backup="using:Oadm.Client.Backup"
             x:Class="Oadm.Client.Settings.SettingsView"
             x:DataType="settings:SettingsViewModel">
  <!-- Every labeled input is a ui:FormField: its error appears directly below the input. Fields are grouped under
       small headings; Save sits in the input column. Operators see the values as plain text, without Save. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <c:PageTitleBar Title="Settings" Subtitle="How the server polls, scans and runs tasks, and how OADM looks and shows video on this computer." />
    <ScrollViewer Grid.Row="1">
      <!-- Two columns: this computer and the server settings left, backup and restore right (administrators). -->
      <!-- Each column grows to 760 px; on a wider window the space stays on the right (the page starts at the left). -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="760" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" MaxWidth="760" />
          <ColumnDefinition Width="0.001*" />
        </Grid.ColumnDefinitions>
      <StackPanel Spacing="16">
        <!-- This computer: saved at once, for every user (client-settings.json) -->
        <Border Classes="card">
          <StackPanel Classes="form">
            <TextBlock Classes="sectionTitle" Text="This computer" />
            <ui:FormField Classes="wide" Label="Live view" Hint="{Binding GpuDecodingHint}">
              <CheckBox IsChecked="{Binding GpuDecoding}" Content="Decode video on the graphics card" />
            </ui:FormField>
            <ui:FormField Classes="wide">
              <CheckBox IsChecked="{Binding Video.ShowDetails}" Content="Show video details over the picture" />
            </ui:FormField>
            <ui:FormField Label="Frame rate (adaptive quality)" Hint="Frames per second when the resolution follows the size">
              <NumericUpDown Minimum="1" Maximum="30" Increment="1" FormatString="0" Value="{Binding Video.AdaptiveFps}" />
            </ui:FormField>
            <ui:FormField Label="Appearance" Hint="{Binding AppearanceHint}">
              <ComboBox ItemsSource="{Binding Appearances}" SelectedItem="{Binding Appearance}" />
            </ui:FormField>
          </StackPanel>
        </Border>
        <!-- Server settings in four cards; administrators edit them (saved together, Save in the last card), operators read
             them as plain text. -->
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Only administrators can change server settings." IsVisible="{Binding IsOperator}" />
        <Border Classes="card">
          <StackPanel Classes="form">
            <TextBlock Classes="sectionTitle" Text="Polling" />
            <StackPanel Classes="form" IsVisible="{Binding IsAdmin}">
              <ui:FormField Label="Status polling interval (s)">
                <NumericUpDown Minimum="5" Maximum="86400" Increment="5" FormatString="0" Value="{Binding PollingIntervalSeconds}" />
              </ui:FormField>
              <ui:FormField Label="Full refresh interval (min)"
                            Hint="How often network settings and certificates are read">
                <NumericUpDown Minimum="1" Maximum="1440" Increment="1" FormatString="0" Value="{Binding FullRefreshMinutes}" />
              </ui:FormField>
            </StackPanel>
            <StackPanel Classes="form" IsVisible="{Binding IsOperator}">
              <ui:FormField Label="Status polling interval (s)">
                <TextBlock Text="{Binding PollingIntervalSeconds}" />
              </ui:FormField>
              <ui:FormField Label="Full refresh interval (min)">
                <TextBlock Text="{Binding FullRefreshMinutes}" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Classes="form">
            <TextBlock Classes="sectionTitle" Text="Discovery" />
            <StackPanel Classes="form" IsVisible="{Binding IsAdmin}">
              <ui:FormField Label="Addresses scanned at once">
                <NumericUpDown Minimum="1" Maximum="256" FormatString="0" Value="{Binding ScanParallelism}" />
              </ui:FormField>
              <ui:FormField Label="IP range scan timeout (ms)">
                <NumericUpDown Minimum="100" Maximum="30000" Increment="100" FormatString="0" Value="{Binding ScanTimeoutMs}" />
              </ui:FormField>
              <ui:FormField Label="Discovery duration (s)"
                            Hint="Discovery on the add devices page ends after this time; Scan again starts it again">
                <NumericUpDown Minimum="5" Maximum="300" Increment="5" FormatString="0" Value="{Binding ZeroConfSeconds}" />
              </ui:FormField>
            </StackPanel>
            <StackPanel Classes="form" IsVisible="{Binding IsOperator}">
              <ui:FormField Label="Addresses scanned at once">
                <TextBlock Text="{Binding ScanParallelism}" />
              </ui:FormField>
              <ui:FormField Label="IP range scan timeout (ms)">
                <TextBlock Text="{Binding ScanTimeoutMs}" />
              </ui:FormField>
              <ui:FormField Label="Discovery duration (s)">
                <TextBlock Text="{Binding ZeroConfSeconds}" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Classes="form">
            <TextBlock Classes="sectionTitle" Text="Tasks" />
            <ui:FormField Label="Parallel tasks per plugin" IsVisible="{Binding IsAdmin}"
                          Hint="How many devices a task runs on at the same time, e.g. restarts or firmware updates.">
              <NumericUpDown Minimum="1" Maximum="256" Increment="1" FormatString="0" Value="{Binding MaxParallelTasksPerPlugin}" />
            </ui:FormField>
            <ui:FormField Label="Parallel tasks per plugin" IsVisible="{Binding IsOperator}">
              <TextBlock Text="{Binding MaxParallelTasksPerPlugin}" />
            </ui:FormField>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Classes="form">
            <TextBlock Classes="sectionTitle" Text="Server" />
            <StackPanel Classes="form" IsVisible="{Binding IsAdmin}">
              <ui:FormField Label="Server name">
                <TextBox Text="{Binding ServerName}" />
              </ui:FormField>
              <ui:FormField Label="Listen URL" Hint="Takes effect after the server restarts">
                <TextBox Text="{Binding ListenUrl}" PlaceholderText="https://0.0.0.0:5080" />
              </ui:FormField>
              <!-- Saves the four server cards together -->
              <ui:FormField Classes="wide">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                          ToolTip.Tip="{Binding SaveBlockedReason}" ToolTip.ShowOnDisabled="True" />
                  <Button Classes="secondary" Content="Reload" Command="{Binding LoadCommand}" />
                </StackPanel>
              </ui:FormField>
            </StackPanel>
            <StackPanel Classes="form" IsVisible="{Binding IsOperator}">
              <ui:FormField Label="Server name">
                <TextBlock Text="{Binding ServerName}" />
              </ui:FormField>
              <ui:FormField Label="Listen URL">
                <TextBlock Text="{Binding ListenUrl}" />
              </ui:FormField>
            </StackPanel>
            <TextBlock Text="{Binding ServerMessage}" Classes.error="{Binding ServerMessageIsError}" Classes.secondary="{Binding !ServerMessageIsError}"
                       TextWrapping="Wrap" IsVisible="{Binding ServerMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <backup:BackupCardView Grid.Column="2" VerticalAlignment="Top" DataContext="{Binding Backup}"
                             IsVisible="{Binding $parent[UserControl].((settings:SettingsViewModel)DataContext).ShowBackup}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
