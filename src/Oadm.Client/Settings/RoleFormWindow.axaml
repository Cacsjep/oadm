<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:settings="using:Oadm.Client.Settings"
        x:Class="Oadm.Client.Settings.RoleFormWindow"
        x:DataType="settings:RolesViewModel"
        Title="{Binding EditorTitle}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- New role, copy or rename of the roles card: single operation. The role is a column of the matrix until Save. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding EditorTitle}" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <ui:FormField Label="Name">
          <TextBox x:Name="NameBox" Text="{Binding EditName}" MaxLength="64" />
        </ui:FormField>
        <ui:FormField Label="Description" Hint="Optional">
          <TextBox Text="{Binding EditDescription}" MaxLength="200" />
        </ui:FormField>
        <ui:FormField Label="Start from" IsVisible="{Binding IsNewEditor}">
          <ComboBox x:Name="StartFromBox" ItemsSource="{Binding StartChoices}" SelectedItem="{Binding StartFrom}" HorizontalAlignment="Stretch" />
        </ui:FormField>
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelEditorCommand}">
      <Button Classes="primary" IsDefault="True" Content="{Binding EditorButton}" Command="{Binding ApplyEditorCommand}"
              ToolTip.Tip="{Binding EditorBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
