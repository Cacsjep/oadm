<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             x:Class="Oadm.Client.Settings.UsersCardView"
             x:DataType="settings:UsersViewModel">
  <!-- Card "Users" of the Permissions page (Admin only). Add user, Edit user and Change password are dialogs (UserFormWindow);
       refusals of the row actions in the message window. -->
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Classes="cardTitle" Text="Users" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ui:ToolbarButton Text="New user" IconKey="add" Command="{Binding OpenAddCommand}" VerticalAlignment="Center" />
      </StackPanel>
      <DataGrid x:Name="UsersGrid" ItemsSource="{Binding Users}" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
                SelectionMode="Single" MaxHeight="360">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="User" Width="180" SortMemberPath="UserName" x:DataType="settings:UserRowViewModel">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="settings:UserRowViewModel">
                <ui:IconLabel Icon="{StaticResource Icon.user}" Text="{Binding UserName}" Margin="10,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Role" Width="180" Binding="{Binding RoleText}" x:DataType="settings:UserRowViewModel" />
          <DataGridTextColumn Header="Devices" Width="160" Binding="{Binding DevicesText}" x:DataType="settings:UserRowViewModel" />
          <DataGridTemplateColumn Header="State" Width="100" SortMemberPath="StateText" x:DataType="settings:UserRowViewModel">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="settings:UserRowViewModel">
                <ui:StatusChip Text="{Binding StateText}" IsOk="{Binding !IsDisabled}" Margin="10,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Row actions: icon buttons in fixed places (a hidden one leaves its place), Delete in red -->
          <DataGridTemplateColumn Width="*" CanUserSort="False" x:DataType="settings:UserRowViewModel">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="settings:UserRowViewModel">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="2" Margin="6,0" HorizontalAlignment="Left" ToolTip.Tip="{Binding SelfTooltip}">
                  <Button Grid.Column="0" Classes="toolbar iconOnly" ToolTip.Tip="Edit user" IsVisible="{Binding CanChange}"
                          Command="{Binding $parent[UserControl].((settings:UsersViewModel)DataContext).OpenEditCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                  </Button>
                  <Button Grid.Column="1" Classes="toolbar iconOnly" ToolTip.Tip="Change password"
                          Command="{Binding $parent[UserControl].((settings:UsersViewModel)DataContext).OpenResetCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{StaticResource Icon.key}" />
                  </Button>
                  <Button Grid.Column="2" Classes="toolbar iconOnly" ToolTip.Tip="{Binding StateActionText}" IsVisible="{Binding CanChange}"
                          Command="{Binding $parent[UserControl].((settings:UsersViewModel)DataContext).ToggleDisabledCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{StaticResource Icon.lock}" />
                  </Button>
                  <Button Grid.Column="3" Classes="toolbar iconOnly danger" ToolTip.Tip="Delete" IsVisible="{Binding CanChange}"
                          Command="{Binding $parent[UserControl].((settings:UsersViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </Border>
</UserControl>
