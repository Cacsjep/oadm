<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:c="using:Oadm.Client.Controls"
             x:Class="Oadm.Client.Settings.AboutPageView"
             x:DataType="settings:AboutViewModel">
  <!-- Navigation page About (everyone): page header and the about card (terms of use, versions, licenses). -->
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <c:PageTitleBar Title="About" Subtitle="Version and licenses." />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <settings:AboutView />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
