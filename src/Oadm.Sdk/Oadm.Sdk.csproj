<Project Sdk="Microsoft.NET.Sdk">
  <!-- The doc comments feed the SDK reference of the website (tools/Oadm.ApiDocs). Missing comments are allowed for now. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>The plugin SDK of OADM (Open AXIS Device Management): task plugins, core plugins, event rule actions.</Description>
    <PackageTags>oadm;axis;vapix;plugin;sdk</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
  </ItemGroup>
  <!-- At release (manage package nuget): a binary break against this baseline fails the pack. Add-ons of older OADM versions keep
       running on this SDK (docs/spec/add-ons.md rule 3): keep it equal to AddOnCatalog.OldestRunningVersion, raise both together. -->
  <PropertyGroup Condition="'$(OadmPackageValidation)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>4.10.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
