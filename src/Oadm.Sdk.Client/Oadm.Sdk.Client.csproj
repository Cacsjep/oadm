<Project Sdk="Microsoft.NET.Sdk">
  <!-- The doc comments feed the SDK reference of the website (tools/Oadm.ApiDocs). Missing comments are allowed for now. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>The client plugin SDK of OADM: dialogs, pages, toolbar entries and the shared Avalonia controls.</Description>
    <PackageTags>oadm;axis;plugin;sdk;avalonia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <!-- The list of issued certificates (IssuedCertificateList) is a DataGrid; the host ships it (shared like Avalonia). -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Shared from the host like Avalonia: ValidatingViewModel is an ObservableObject -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Oadm.Sdk\Oadm.Sdk.csproj" />
  </ItemGroup>
  <!-- At release (manage package nuget): a binary break against this baseline fails the pack. Add-ons of older OADM versions keep
       running on this SDK (docs/spec/add-ons.md rule 3): keep it equal to AddOnCatalog.OldestRunningVersion, raise both together. -->
  <PropertyGroup Condition="'$(OadmPackageValidation)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>4.10.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
