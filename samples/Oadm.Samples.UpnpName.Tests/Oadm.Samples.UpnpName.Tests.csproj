<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj" />
    <ProjectReference Include="..\Oadm.Samples.UpnpName\Oadm.Samples.UpnpName.csproj" />
    <!-- Runs a task like the server's task engine ends it: success adds "Completed", a failure skips the rest. -->
    <Compile Include="..\..\tests\Shared\StepRun.cs" Link="Shared\StepRun.cs" />
  </ItemGroup>
</Project>
