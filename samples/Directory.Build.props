<Project>
  <!--
    The plugins of the developer tutorials (website: Developers > Tutorials). They build and test with the solution but
    are never deployed to artifacts/plugins, so a development OADM does not load them. "manage new task|page|action"
    copies one into plugins/ and tests/ under a new name (tools/Oadm.NewPlugin), where it deploys like every plugin.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <OadmSkipPluginDeploy>true</OadmSkipPluginDeploy>
  </PropertyGroup>
</Project>
