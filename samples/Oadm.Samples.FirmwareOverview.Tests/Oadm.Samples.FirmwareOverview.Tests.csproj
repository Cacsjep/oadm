<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- The client host normally provides these at runtime; the tests bring them. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Oadm.Sdk.Client\Oadm.Sdk.Client.csproj" />
    <ProjectReference Include="..\Oadm.Samples.FirmwareOverview\Oadm.Samples.FirmwareOverview.csproj" />
    <ProjectReference Include="..\Oadm.Samples.FirmwareOverview.Client\Oadm.Samples.FirmwareOverview.Client.csproj" />
  </ItemGroup>
</Project>
