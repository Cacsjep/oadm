#!/bin/sh
# OADM server package preinstall: stop a running server before its files are replaced (upgrade).
launchctl bootout system/com.oadm.server >/dev/null 2>&1 || true
# An installer upgrade keeps files the new package no longer has: the bundled plugins go first and the package brings
# exactly the plugins of its version (docs/spec/plugin-removal.md). Installed plugins of the data folder stay.
rm -rf "/Library/Application Support/OADM/server/plugins"
exit 0
