#!/bin/sh
# OADM client package preinstall: an installer upgrade keeps files the new package no longer has, so the bundled
# plugins go first and the package brings exactly the plugins of its version (docs/spec/plugin-removal.md). The
# client never deletes inside the app bundle (it would break the signature).
rm -rf /Applications/OADM.app/Contents/Resources/plugins
exit 0
