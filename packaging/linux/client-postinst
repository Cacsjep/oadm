#!/bin/sh
# oadm-client postinst: the EST server is a part of PKI since OADM 4.5. dpkg removes the files of its 4.1
# plugin folder on upgrade; anything else left there goes too (the client would skip the folder anyway).
set -e

if [ "$1" = configure ]; then
    rm -rf /opt/oadm/client/plugins/oadm.est
fi

exit 0
