# postun of oadm-client and oadm-site-node-app: the application menu and the icon theme forget the removed entry (only where
# the tools are installed; Fedora's file triggers do the same).
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || :
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    touch --no-create /usr/share/icons/hicolor >/dev/null 2>&1 || :
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || :
fi
exit 0
