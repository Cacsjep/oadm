# oadm-server postun ($1: 0 removal, 1 upgrade). The data folder /var/lib/oadm (database, master key, logs) is kept;
# delete it by hand when it is no longer needed.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
fi
if [ "$1" -eq 0 ]; then
    rm -rf /var/cache/oadm
    if [ -d /var/lib/oadm ]; then
        echo "oadm: the data folder /var/lib/oadm was kept (database, master key, logs)."
    fi
fi
exit 0
