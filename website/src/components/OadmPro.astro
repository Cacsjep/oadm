---
// Landing page: OADM PRO, after "Extend OADM with plugins". Its own panel with a soft violet glow so it stands apart
// from the free sections; no buy button. The top bar's PRO link jumps here (#pro). A click on a plan, or "Request a custom
// plugin", opens the quote form: it posts to the support forum, which mails the request to its admins (`/api/portal/quote`).
import { forumUrl } from '../lib/forum';

const quotePlans = ['Individual', 'Up to 500 devices', 'Up to 30,000 devices', 'Unlimited', 'Custom plugin', 'Something else', 'Not sure yet'];

// Lucide icons (ISC license), 24 x 24 stroke paths.
const icons = {
	globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
	star: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>',
	lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
};
const check = '<path d="M20 6 9 17l-5-5"/>';
const cross = '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>';

// Per two years (the maintenance period of most project offers). Individual: support for one plugin on one server, for a
// project offer. Then two plans per server, sized by its devices (the license key's device limit), and one for a whole
// company. Euro, without VAT. No plan is recommended; the one under the pointer lights up.
const all = ['Support with an SLA', 'Feature requests first', 'EST Server', '30-day trial'];
const plans = [
	{ devices: 'Individual', price: '€399', from: true, text: 'One plugin with commercial support, ready for your project offer.', included: ['Support with an SLA for one plugin', 'Any plugin: OADM, PRO or your own', 'One server', '30-day trial'] },
	{ devices: 'Up to 500 devices', price: '€999', text: 'One server. One site or a small customer.', included: all },
	{ devices: 'Up to 30,000 devices', price: '€4,999', text: 'One server with every device it can manage.', included: all },
	{ devices: 'Unlimited', price: '€9,999', text: 'Any number of servers and devices for one company.', included: all },
];

// The SLA of every plan (#sla; the "Support with an SLA" lines of the plans link here). Planned terms, final at launch.
const covered = [
	'OADM, the enterprise plugins and the plugin of an Individual plan',
	'Bug fixes, for critical bugs a fix outside the normal releases',
	'Support by email, with the people who build OADM',
];
const notCovered = ['Problems of the devices themselves (Axis support)', 'Work on site', 'Plugins of others'];

// Custom plugins: built to order, with support; the customer decides who gets the plugin afterwards.
const custom = [
	{ icon: icons.globe, title: 'Open source', text: 'Part of OADM for everyone. Others help to keep it working.' },
	{ icon: icons.star, title: 'In OADM PRO', text: 'For every PRO customer, kept up to date with each release.' },
	{ icon: icons.lock, title: 'Only for you', text: 'Your plugin stays yours. Nobody else gets it.' },
];
---

<section id="pro" class="pro-section not-content" aria-labelledby="pro-title">
	<div class="pro-head">
		<span class="pro-launch">Estimated launch: end of November 2026</span>
		<h2 id="pro-title" class="landing-title">OADM <span class="pro-word">PRO</span></h2>
		<p class="landing-lead">OADM stays fully open source. PRO adds what companies rely on in production: <b>commercial support with an SLA and enterprise plugins.</b></p>
	</div>


	<h3 class="pro-title">Plans</h3>
	<p class="pro-lead">Every plan runs two years, the maintenance period of most project offers.</p>
	<div class="pro-plans">
		{plans.map((p) => (
			<div class="pro-plan" data-plan={p.devices}>
				<strong>{p.devices}</strong>
				<span class="pro-plan-text">{p.text}</span>
				<span class="pro-price">{p.from && 'From '}<b>{p.price}</b> per 2 years</span>
				<ul>
					{p.included.map((i) => (
						<li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />{i.startsWith('Support with an SLA') ? <a href="#sla">{i}</a> : i}</li>
					))}
				</ul>
				<button type="button" class="dl pro-quote" data-plan={p.devices}>Get a quote</button>
			</div>
		))}
	</div>
	<p class="pro-note">Prices without VAT. Planned prices, final at launch.</p>

	<h3 class="pro-title">Custom plugins</h3>
	<p class="pro-lead">Need a plugin OADM does not have? We build it for you, with support. You decide who gets it:</p>
	<div class="pro-custom">
		{custom.map((c) => (
			<div class="pro-card">
				<span class="pro-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={c.icon} /></span>
				<strong>{c.title}</strong>
				<span>{c.text}</span>
			</div>
		))}
	</div>
	<p class="pro-note">Price on request.</p>
	<button type="button" class="dl pro-quote" data-plan="Custom plugin">Request a custom plugin</button>

	<h3 id="sla" class="pro-title">Support with an SLA</h3>
	<p class="pro-lead">Help within <strong>1 to 3 working days</strong>. No first-level ticket, no waiting in a queue.</p>
	<div class="pro-sla-lists">
		<div class="pro-card">
			<strong>Covered</strong>
			<ul>
				{covered.map((c) => <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />{c}</li>)}
			</ul>
		</div>
		<div class="pro-card">
			<strong>Not covered</strong>
			<ul class="pro-not">
				{notCovered.map((c) => <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={cross} />{c}</li>)}
			</ul>
		</div>
	</div>

	<div class="pro-other">
		<div>
			<h3 class="pro-other-title">Need something else?</h3>
			<p>A feature, a change to OADM or anything the plans do not cover. Tell us what you need.</p>
		</div>
		<button type="button" class="dl pro-quote" data-plan="Something else">Send us a message</button>
	</div>
</section>

<dialog class="quote not-content" aria-labelledby="quote-title">
	<form class="quote-form" method="dialog" data-portal={forumUrl} novalidate>
		<button type="button" class="quote-close" aria-label="Close">×</button>
		<h3 id="quote-title">Get a quote</h3>
		<p class="quote-lead">We answer by email, usually within two working days.</p>
		<div class="quote-fields">
			<label class="wide">Plan
				<select name="plan" required>
					{quotePlans.map((p) => <option value={p}>{p}</option>)}
				</select>
			</label>
			<label>Name<input name="name" autocomplete="name" maxlength="100" required /></label>
			<label>Company<input name="company" autocomplete="organization" maxlength="150" required /></label>
			<label>Email<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
			<label><span>Phone <small>Optional</small></span><input name="phone" type="tel" autocomplete="tel" maxlength="50" /></label>
			<label><span>Country <small>Optional</small></span><input name="country" autocomplete="country-name" maxlength="80" /></label>
			<label><span>Number of devices <small>Optional</small></span><input name="devices" inputmode="numeric" maxlength="50" /></label>
			<label class="wide"><span>Message <small>Optional</small></span><textarea name="message" rows="4" maxlength="4000" placeholder="Your project, the plugin you need, the term of your offer"></textarea></label>
			<!-- honeypot: hidden from people, bots fill it -->
			<label class="quote-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
		</div>
		<p class="quote-message" role="status" hidden></p>
		<div class="quote-footer">
			<a href={`${forumUrl}privacy/`}>Privacy notice</a>
			<button type="submit" class="dl quote-send">Send request</button>
		</div>
	</form>
</dialog>

<script>
	import { forumAvailable } from '../lib/forum';

	const dialog = document.querySelector<HTMLDialogElement>('dialog.quote');
	const form = dialog?.querySelector<HTMLFormElement>('.quote-form');
	if (dialog && form) {
		const message = form.querySelector<HTMLElement>('.quote-message')!;
		const send = form.querySelector<HTMLButtonElement>('.quote-send')!;
		const fields = form.querySelector<HTMLElement>('.quote-fields')!;
		const show = (text: string, ok: boolean) => {
			message.textContent = text;
			message.classList.toggle('ok', ok);
			message.hidden = false;
		};
		// The forum is offline: the request goes by email instead, the form's content already in the mail.
		const contact = 'contact@acs-dev.org';
		const showOffline = (data?: Record<string, string>) => {
			const plan = data?.plan ?? form.querySelector<HTMLSelectElement>('select[name=plan]')!.value;
			const lines = data
				? Object.entries(data)
						.filter(([key, value]) => key !== 'website' && key !== 'plan' && value.trim())
						.map(([key, value]) => `${key[0].toUpperCase()}${key.slice(1)}: ${value.trim()}`)
				: [];
			const link = document.createElement('a');
			link.href = `mailto:${contact}?subject=${encodeURIComponent(`Quote request: ${plan}`)}&body=${encodeURIComponent(lines.join('\n'))}`;
			link.textContent = contact;
			message.replaceChildren('Sorry, our server looks offline. Please send your request by email to ', link, '.');
			message.classList.remove('ok');
			message.hidden = false;
		};

		// A plan card (anywhere on it) or a quote button opens the form with that plan chosen.
		const open = (plan: string) => {
			fields.hidden = false;
			send.hidden = false;
			send.disabled = false;
			message.hidden = true;
			form.querySelector<HTMLSelectElement>('select[name=plan]')!.value = plan;
			dialog.showModal();
			form.querySelector<HTMLInputElement>('input[name=name]')!.focus();
			forumAvailable().then((available) => {
				if (!available) showOffline();
			});
		};
		document.querySelectorAll<HTMLElement>('.pro-plan, .pro-quote').forEach((el) =>
			el.addEventListener('click', (event) => {
				if ((event.target as Element).closest('a')) return;
				event.stopPropagation();
				open(el.dataset.plan ?? 'Not sure yet');
			}),
		);

		dialog.querySelector('.quote-close')!.addEventListener('click', () => dialog.close());
		// A click outside the box (on the backdrop) closes it.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			// The browser's checks first: required fields and the email format, the first problem focused.
			if (!form.reportValidity()) return;
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			send.disabled = true;
			message.hidden = true;
			try {
				const response = await fetch(`${form.dataset.portal}api/portal/quote`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				if (response.ok) {
					fields.hidden = true;
					send.hidden = true;
					show(`Thank you. We will answer you at ${data.email.trim()}.`, true);
					form.reset();
					return;
				}
				if (response.status === 429) {
					show('Too many requests. Wait a few minutes and try again.', false);
				} else {
					const answer = await response.json().catch(() => null);
					if (answer?.message && response.status === 400) show(answer.message, false);
					else showOffline(data);
				}
			} catch {
				showOffline(data);
			}
			send.disabled = false;
		});
	}
</script>

<style>
	/* The PRO panel: a violet glow from the top and an accent edge, so it reads as its own offer. */
	.pro-section {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin-top: 6rem;
		padding: 3.5rem clamp(1rem, 4vw, 3rem) 3rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
		border-radius: 20px;
		box-shadow: 0 0 80px -20px color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
		text-align: center;
		/* The fixed top bar must not cover the panel after the PRO link. */
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}
	.pro-section > *,
	.pro-head > * {
		margin: 0;
	}
	.pro-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}
	.pro-launch {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.8rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
		border-radius: 999px;
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-xs);
		font-weight: 500;
	}
	.pro-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--sl-color-accent-high);
		animation: pro-pulse 2s ease-in-out infinite;
	}
	@keyframes pro-pulse {
		0%, 100% { opacity: 1; box-shadow: 0 0 0 0 color-mix(in srgb, var(--sl-color-accent-high) 60%, transparent); }
		50% { opacity: 0.6; box-shadow: 0 0 0 5px transparent; }
	}
	.pro-section .landing-title {
		font-size: var(--sl-text-4xl);
	}
	.pro-word {
		background: linear-gradient(120deg, var(--sl-color-accent-high), var(--sl-color-accent) 70%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.pro-custom,
	.pro-plans {
		display: grid;
		gap: 0.9rem;
		width: 100%;
		text-align: start;
	}
	.pro-custom {
		grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
	}
	.pro-plans {
		grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
	}
	.pro-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.2rem 1.2rem 1.3rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 14px;
		background: color-mix(in srgb, var(--sl-color-black) 70%, transparent);
		transition: border-color 0.2s, transform 0.2s;
	}
	.pro-card:hover {
		border-color: color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
		transform: translateY(-2px);
	}
	.pro-icon {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		margin-bottom: 0.4rem;
		border-radius: 10px;
		background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
	}
	.pro-icon svg,
	.pro-plan li svg {
		fill: none;
		stroke: var(--sl-color-accent-high);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pro-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.pro-card strong,
	.pro-plan strong {
		color: var(--sl-color-white);
	}
	.pro-card > span:last-child,
	.pro-plan-text {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}

	.pro-title {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
	}
	.pro-lead {
		max-width: 40rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.pro-note {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	/* Plans: name, text, price and list on shared rows (subgrid), so the prices and lists line up across the plans.
	   The plan under the pointer lights up with an accent edge, a violet tint and a glow. */
	.pro-plans {
		grid-template-rows: repeat(5, auto);
		align-items: stretch;
		margin-top: 0.75rem !important;
	}
	.pro-plan {
		display: grid;
		grid-row: span 5;
		grid-template-rows: subgrid;
		row-gap: 0.35rem;
		padding: 1.5rem 1.4rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 16px;
		background:
			linear-gradient(180deg, transparent, transparent),
			color-mix(in srgb, var(--sl-color-black) 70%, transparent);
		cursor: pointer;
		transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s, background 0.25s;
	}
	.pro-plan:hover,
	.pro-plan:focus-within {
		border-color: var(--sl-color-accent);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--sl-color-accent) 18%, transparent), transparent 60%),
			color-mix(in srgb, var(--sl-color-black) 70%, transparent);
		box-shadow: 0 10px 40px -12px color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
		transform: translateY(-4px);
	}
	.pro-plan > * {
		margin: 0;
	}
	.pro-price {
		align-self: end;
		margin-block: 0.9rem 0.6rem !important;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.pro-price b {
		color: var(--sl-color-white);
		font-size: var(--sl-text-4xl);
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.pro-plan ul {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0;
		padding: 0.9rem 0 0;
		border-top: 1px solid var(--sl-color-gray-5);
		list-style: none;
	}
	.pro-plan li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.pro-plan li svg {
		flex: none;
		width: 1rem;
		height: 1rem;
		margin-top: 0.15rem;
		stroke-width: 2.5;
	}

	.pro-plan .pro-quote {
		justify-content: center;
		margin-top: 1rem !important;
	}
	.pro-plan:hover .pro-quote,
	.pro-quote:focus-visible,
	.pro-quote:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: #fff;
	}

	/* The quote form */
	.quote {
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(38rem, calc(100vw - 2rem));
		height: fit-content;
		max-height: calc(100vh - 2rem);
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
		border-radius: 16px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		overflow: auto;
	}
	.quote::backdrop {
		background: rgb(0 0 0 / 0.75);
		backdrop-filter: blur(4px);
	}
	.quote-form {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.75rem 1.75rem 1.5rem;
	}
	.quote-form > *,
	.quote-fields > * {
		margin: 0;
	}
	.quote-form h3 {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
	}
	.quote-lead {
		margin-top: -0.5rem !important;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.quote-close {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		padding: 0.25rem 0.5rem;
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
		transition: color 0.15s;
	}
	.quote-close:hover,
	.quote-close:focus-visible {
		color: var(--sl-color-accent);
	}
	.quote-fields {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.85rem 1rem;
	}
	.quote-fields[hidden] {
		display: none;
	}
	.quote-fields label {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
	.quote-fields small {
		margin-left: 0.35rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 400;
	}
	.quote-fields .wide {
		grid-column: 1 / -1;
	}
	.quote-fields input,
	.quote-fields select,
	.quote-fields textarea {
		width: 100%;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font: inherit;
		font-weight: 400;
	}
	.quote-fields textarea {
		resize: vertical;
	}
	.quote-fields :is(input, select, textarea):focus {
		border-color: var(--sl-color-accent);
		outline: none;
	}
	.quote-fields .quote-trap {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.quote-message {
		color: var(--sl-color-red-high, #ff8f8f);
		font-size: var(--sl-text-sm);
	}
	.quote-message a {
		color: var(--sl-color-accent-high);
	}
	.quote-message.ok {
		color: var(--sl-color-white);
		font-size: var(--sl-text-base);
	}
	.quote-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.quote-footer a {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.quote-send {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: #fff;
	}
	.quote-send:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.quote-send[hidden] {
		display: none;
