---
// Docs header: a link back to the landing page instead of the logo and name (replaces Starlight's SiteTitle). The offline
// docs of the client's Help have no landing page: they show the name only.
import { Icon } from '@astrojs/starlight/components';
import { offline } from '../offline.mjs';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{offline ? <span class="back-home">OADM</span> : <a href={home} class="back-home"><Icon name="left-arrow" />Back</a>}

<style>
	.back-home {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	a.back-home:hover {
		color: var(--sl-color-white);
	}
</style>
