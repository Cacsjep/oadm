---
// The hero of the landing page: centered thin lines of sliced typography, first the main claim (the page's title, held
// longer), then every feature by name with one sentence. Text only. Pure HTML, CSS and the Web Animations API: every animation spans the
// whole loop, so the sequence pauses and resumes as one when it leaves the screen; prefers-reduced-motion shows the
// first line, still.
import '@fontsource-variable/inter';

type Line = { html: string; seconds: number };

const line = (html: string, seconds = 2.1): Line => ({ html, seconds });
const feature = (name: string, text: string): Line => ({ html: `${name}<small>${text}</small>`, seconds: 2.7 });

// The sequence, in order.
const scenes: Line[] = [
	// The opening claim, larger than the other scenes.
	{ html: '<span class="m-hero">Open source<br /><em>AXIS device management.</em></span><small>Built by Professionals. For Professionals.</small>', seconds: 4.5 },
	line('Your own tools.<br /><em>As plugins.</em>'),
	{ html: 'Every feature is <em>a plugin.</em><small>Turn it on or off.</small>', seconds: 2.7 },
	feature('VAPIX Commander', 'Any VAPIX command, rolled out to hundreds of devices.'),
	feature('Event rules', 'Switch a relay, send an email or a command when something happens.'),
	feature('Device triggers', 'Any event of your devices in event rules.'),
	feature('Snapshot report', 'Every camera at a glance, a PDF for the customer.'),
	feature('Hardening scan', 'Every device against the AXIS OS Hardening Guide.'),
	feature('DHCP server', 'Addresses for sites without infrastructure. New Axis devices add themselves.'),
	feature('NTP server', 'The time for every device, from this server.'),
	feature('Metadata Monitor', 'The events a camera sends, live.'),
	feature('Image Health Dashboard', 'Blur, blocked or redirected views of every camera.'),
	feature('I/O Monitor', 'The inputs and outputs of a device, live.'),
	feature('Web View', 'The web interface of every device in tabs, already logged in. Set up apps like Object Analytics on many cameras, one tab after the other.'),
	feature('Live preview', 'Click a camera in the device list to see its video.'),
	feature('Live View', 'Several cameras at once in saved views, like a video wall.'),
	feature('Edge Recording Export', 'The recordings on the SD cards of many cameras, downloaded to your computer.'),
	feature('Tags', 'Your own labels. Group the list by them.'),
];

const GAP = 0.15;

// Times: one scene after the other.
let clock = 0.2;
const timed = scenes.map((scene) => {
	const at = clock;
	clock += scene.seconds + GAP;
	return { html: scene.html, at, until: at + scene.seconds };
});
const loop = Math.round((clock + 0.4) * 100) / 100;
const config = JSON.stringify({ loop, scenes: timed.map(({ at, until }) => ({ at, until })) });
---

<div class="motion not-content" data-motion={config} role="img"
	aria-label="Open source AXIS device management. Built by Professionals. For Professionals. VAPIX Commander, event rules, device triggers, snapshot report, hardening scan, DHCP and NTP server, Metadata Monitor, Image Health Dashboard, I/O Monitor, Web View, live preview, Live View, Edge Recording Export and tags.">
	{timed.map((scene) => (
		<div class="m-line" data-scene>
			<span class="m-measure" set:html={scene.html} />
		</div>
	))}
</div>

<style>
	/* No stage of its own: the lines sit on the page */
	.motion {
		position: relative;
		width: 100%;
		max-width: 72rem;
		height: clamp(11rem, 17vw, 15rem);
		margin: 0 auto 0.5rem;
		overflow: hidden;
		container-type: inline-size;
		font-family: 'Inter Variable', var(--sl-font);
	}

	.m-line {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		text-align: center;
		pointer-events: none;
	}
	.m-line .m-measure,
	.m-line :global(.m-slice) {
		grid-area: 1 / 1;
		font-size: clamp(1.6rem, 6cqi, 4.4rem);
		font-weight: 200;
		line-height: 1.12;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	/* The text in the page flow: it only sizes the line */
	.m-line .m-measure {
		visibility: hidden;
	}
	.m-line :global(em) {
		font-style: normal;
		font-weight: 300;
		color: var(--sl-color-accent-high);
	}
	.m-line :global(small) {
		display: block;
		margin-top: 0.7em;
		font-size: clamp(0.95rem, 1.9cqi, 1.35rem);
		font-weight: 300;
		line-height: 1.4;
		letter-spacing: 0;
		color: var(--sl-color-gray-2);
	}
	.m-line :global(.m-slice) {
		will-change: transform, opacity, filter;
	}
	.m-line :global(.m-hero) {
		display: block;
		font-size: 1.2em;
	}
</style>

<script>
	type Scene = { at: number; until: number };
	type Config = { loop: number; scenes: Scene[] };

	const SLICES = 6;
	const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
	const easeIn = 'cubic-bezier(0.55, 0, 0.75, 0.2)';

	/** How the slices come in and go, one kind per scene in turn. */
	type Kind = 'side' | 'vertical' | 'wipe' | 'halves' | 'zoom' | 'diagonal';
	const KINDS: Kind[] = ['side', 'vertical', 'wipe', 'halves', 'zoom', 'diagonal'];

	/** The upper slices come from the left, the lower ones from the right. */
	const half = (i: number) => (i < SLICES / 2 ? -1 : 1);

	type Band = (left: number, right: number) => string;
	type Frames = [number, Keyframe][];

	/** The entry frames of one slice, from begin until just before begin + 0.75 (the resting frame follows). */
	function entry(kind: Kind, i: number, side: number, begin: number, rest: Keyframe, band: Band): Frames {
		switch (kind) {
			case 'side':
			case 'vertical':
			case 'halves':
			case 'diagonal': {
				// Blur and letter spacing are done early: the end of the move is a plain glide, no last sharpening.
				const from = kind === 'vertical' ? `translate(0, ${side * 40}%) scale(1)`
					: kind === 'diagonal' ? `translate(${side * 6}%, ${-side * 30}%) scale(1)`
					: `translate(${(kind === 'halves' ? half(i) : side) * 9}%, 0) scale(1)`;
				return [
					[begin, { ...rest, transform: from, opacity: 0, filter: 'blur(10px)', letterSpacing: '0.1em', easing: ease }],
					[begin + 0.45, { filter: 'blur(0)', letterSpacing: '-0.02em' }],
				];
			}
			case 'wipe':
				// Each band is uncovered from the left out of a light blur.
				return [
					[begin, { ...rest, clipPath: band(-20, 120), filter: 'blur(6px)', opacity: 0.4, easing: ease }],
					[begin + 0.4, { filter: 'blur(0)', opacity: 1 }],
					[begin + 0.6, { clipPath: band(-20, -20) }],
				];
			case 'zoom':
				// From slightly larger out of a blur; blur done early.
				return [
					[begin, { ...rest, transform: `translate(0, 0) scale(${1.35 - i * 0.03})`, opacity: 0, filter: 'blur(12px)', easing: ease }],
					[begin + 0.45, { filter: 'blur(0)' }],
				];
		}
	}

	/** The exit frames of one slice, after its resting frame at leave. */
	function exit(kind: Kind, i: number, side: number, leave: number, band: Band): Frames {
		switch (kind) {
			case 'side':
				return [[leave + 0.35, { transform: `translate(${-side * 5}%, 0) scale(1)`, opacity: 0, filter: 'blur(8px)', letterSpacing: '0.04em' }]];
			case 'halves':
				return [[leave + 0.35, { transform: `translate(${-half(i) * 5}%, 0) scale(1)`, opacity: 0, filter: 'blur(8px)', letterSpacing: '0.04em' }]];
			case 'diagonal':
				return [[leave + 0.35, { transform: `translate(${-side * 4}%, ${side * 20}%) scale(1)`, opacity: 0, filter: 'blur(8px)', letterSpacing: '0.04em' }]];
			case 'vertical':
				return [[leave + 0.35, { transform: `translate(0, ${-side * 25}%) scale(1)`, opacity: 0, filter: 'blur(8px)', letterSpacing: '0.04em' }]];
			case 'wipe':
				return [[leave + 0.35, { clipPath: band(120, -20), filter: 'blur(4px)', opacity: 0.6 }]];
			case 'zoom':
				return [[leave + 0.35, { transform: 'translate(0, 0) scale(0.9)', opacity: 0, filter: 'blur(8px)' }]];
		}
	}

	function start(root: HTMLElement) {
		const config: Config = JSON.parse(root.dataset.motion!);
		const loop = config.loop;
		const all: Animation[] = [];

		/** One animation over the whole loop: frames at absolute times (s), the first and last values held to the ends. */
		const track = (el: Element, frames: [number, Keyframe][]) => {
			const sorted = [...frames].sort((a, b) => a[0] - b[0]);
			const keyframes: Keyframe[] = [{ ...sorted[0][1], offset: 0 }];
			for (const [t, frame] of sorted) {
				keyframes.push({ ...frame, offset: Math.min(1, Math.max(0, t / loop)) });
			}
			keyframes.push({ ...sorted[sorted.length - 1][1], offset: 1 });
			all.push(el.animate(keyframes, { duration: loop * 1000, iterations: Infinity, easing: 'linear' }));
		};

		/**
		 * A centered line: slices come in out of a blur while the letters pull together, sideways from alternating sides
		 * or (every other scene) from above and below. Once all are in place the whole text stands in for them until they
		 * leave, so the settled text has no seams.
		 */
		const line = (el: HTMLElement, s: Scene, index: number) => {
			const whole = el.querySelector<HTMLElement>('.m-measure')!;
			const html = whole.innerHTML;
			const settled = s.at + (SLICES - 1) * 0.045 + 0.75;
			const leaving = s.until - 0.4;
			// The whole text and the slices swap at the same instants (all animations share one clock): never both, which
			// would draw the letters twice and make them bolder for a moment, and never neither.
			const swap = (from: number, to: number): [number, Keyframe][] => [
				[settled - 0.001, { opacity: from, easing: 'step-end' }],
				[settled, { opacity: to }],
				[leaving - 0.001, { opacity: to, easing: 'step-end' }],
				[leaving, { opacity: from }],
			];
			// The whole text is a slice without a cut: drawn exactly like the slices (same layer, filter and spacing), so
			// the swap shows the same letters, only without the seams between the cuts.
			const full = document.createElement('span');
			full.className = 'm-slice';
			full.innerHTML = html;
			el.appendChild(full);
			const crisp = { filter: 'blur(0)', letterSpacing: '-0.02em', transform: 'translate(0, 0) scale(1)', textShadow: 'none' };
			track(full, swap(0, 1).map(([t, frame]) => [t, { ...crisp, ...frame }]));
			const kind = KINDS[index % KINDS.length];
			for (let i = 0; i < SLICES; i++) {
				const slice = document.createElement('span');
				slice.className = 'm-slice';
				slice.innerHTML = html;
				const top = (i * 100) / SLICES;
				const bottom = 100 - ((i + 1) * 100) / SLICES;
				const band = (left: number, right: number) => `inset(${top}% ${right}% ${bottom}% ${left}%)`;
				slice.style.clipPath = band(-20, -20);
				el.appendChild(slice);
				const side = i % 2 === 0 ? -1 : 1;
				const begin = s.at + i * 0.045;
				const leave = leaving + i * 0.03;
				// Every kind ends its entry at begin + 0.75 in the resting state, which the swap needs.
				const rest: Keyframe = { transform: 'translate(0, 0) scale(1)', opacity: 1, filter: 'blur(0)', letterSpacing: '-0.02em', textShadow: 'none', clipPath: band(-20, -20) };
				track(slice, [
					...entry(kind, i, side, begin, rest, band),
					[begin + 0.75, rest],
					...swap(1, 0),
					[leave, { ...rest, easing: easeIn }],
					...exit(kind, i, side, leave, band),
				]);
			}
		};

		const elements = root.querySelectorAll<HTMLElement>('[data-scene]');
		config.scenes.forEach((scene, i) => line(elements[i], scene, i));

		const hold = (seconds: number) =>
			all.forEach((a) => {
				a.currentTime = seconds * 1000;
				a.pause();
			});

		// Reduced motion: the first line, still. ?t=6.2 holds the sequence at that second (for checking frames).
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			hold(1.6);
			return;
		}

		const at = new URLSearchParams(location.search).get('t');
		if (at !== null) {
			hold(Number(at));
			return;
		}

		// Plays only while on screen.
		new IntersectionObserver((entries) => {
			const visible = entries.some((e) => e.isIntersecting);
			all.forEach((a) => (visible ? a.play() : a.pause()));
		}).observe(root);
	}

	document.querySelectorAll<HTMLElement>('[data-motion]').forEach(start);
</script>
