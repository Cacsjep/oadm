---
// The security band of the landing page for teams that evaluate OADM. Every point is true today (see the Security page).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Lucide icons (ISC license), 24 x 24 stroke paths.
const icons = {
	lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
	key: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>',
	users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	audit: '<path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/>',
	shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
	file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>',
};

const security = [
	{ icon: icons.lock, title: 'Encrypted transport', text: 'TLS between client and server, with certificate pinning.' },
	{ icon: icons.key, title: 'Credential protection', text: 'Device passwords are encrypted at rest (AES-256) and never sent to clients.' },
	{ icon: icons.users, title: 'Role-based access control', text: 'Built-in and custom roles with granular permissions.' },
	{ icon: icons.audit, title: 'Audit trail', text: 'Logins, configuration changes and device actions are logged.' },
	{ icon: icons.shield, title: 'Safe device changes', text: 'Compatibility is verified before any change is written to a device.' },
	{ icon: icons.file, title: 'Secure development', text: 'CodeQL code scanning, dependency monitoring, private vulnerability reporting, SHA-256 checksums.' },
];
---

<section class="trust-band not-content" aria-labelledby="trust-security">
	<h2 id="trust-security" class="landing-title">Security</h2>
	<p class="landing-lead">Device credentials stay on the server. Every access is controlled and logged.</p>
	<div class="trust-grid">
		{security.map((s) => (
			<div class="trust-item">
				<svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} />
				<strong>{s.title}</strong>
				<span>{s.text}</span>
			</div>
		))}
	</div>
	<a class="trust-more" href={`${base}project/security/`}>Security details</a>
</section>


<style>
	.trust-band {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin-top: 5rem;
		text-align: center;
	}
	.trust-grid {
		display: grid;
		gap: 0.75rem;
		width: 100%;
		margin-top: 0.75rem;
		text-align: start;
	}
	.trust-grid {
		grid-template-columns: repeat(3, 1fr);
	}
	@media (max-width: 50rem) {
		.trust-grid {
			grid-template-columns: 1fr;
		}
	}
	.trust-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 12px;
		background: color-mix(in srgb, var(--sl-color-black) 80%, transparent);
	}
	.trust-item svg {
		width: 22px;
		height: 22px;
		margin-bottom: 0.25rem;
		fill: none;
		stroke: var(--sl-color-accent-high);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.trust-item strong {
		color: var(--sl-color-white);
	}
	.trust-item span {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.trust-more {
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
	}
	.trust-more:hover {
		text-decoration: underline;
	}
</style>
