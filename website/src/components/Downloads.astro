---
// Download buttons for the latest release. The links are read from GitHub when the site is built and again in the
// browser, so a new release shows up without a website rebuild. Without either, they open the release page.
import { Icon } from '@astrojs/starlight/components';

import { latestRelease, releasePage, repo } from '../lib/release';

const { assets, version, url } = await latestRelease();

// The newsletter lives on the support forum; the form here subscribes without an account there.
const portal = 'https://support.oadm.app/';

const find = (pattern: RegExp) => assets.find((a) => pattern.test(a.name))?.browser_download_url ?? releasePage;
const links = {
	windows: find(/win-x64\.msi$/),
	macos: find(/osx-x64\.pkg$/),
	server: find(/^oadm-server_.*_amd64\.deb$/),
	client: find(/^oadm-client_.*_amd64\.deb$/),
	serverArm: find(/^oadm-server_.*_arm64\.deb$/),
	clientArm: find(/^oadm-client_.*_arm64\.deb$/),
};
---

<div class="downloads not-content" data-repo={repo}>
	<span class="dl-label">Download</span>
	<div class="download-buttons">
		<a class="dl" data-asset="win-x64\.msi$" href={links.windows}><Icon name="seti:windows" class="os-windows" />Windows</a>
		<details class="dl-linux">
			<summary class="dl"><Icon name="linux" class="os-linux" />Linux<Icon name="down-caret" class="dl-caret" /></summary>
			<div class="dl-menu">
				<a data-linux="amd64" data-asset="^oadm-server_.*_amd64\.deb$" data-client={links.client} href={links.server}>x64</a>
				<a data-linux="arm64" data-asset="^oadm-server_.*_arm64\.deb$" data-client={links.clientArm} href={links.serverArm}>ARM64</a>
			</div>
		</details>
		<a class="dl" data-asset="osx-x64\.pkg$" href={links.macos}><Icon name="apple" class="os-macos" />macOS</a>
	</div>
	<a class="dl-version" href={url} hidden={!version}>{version}</a>
	<span class="dl-label community-label">Community</span>
	<div class="download-buttons">
		<a class="dl" href={portal}><Icon name="comment-alt" class="support-icon" />Support Forum</a>
		<button class="dl newsletter-toggle" type="button" aria-expanded="false" aria-controls="newsletter"><Icon name="email" class="support-icon" />Subscribe to newsletter</button>
	</div>
	<form id="newsletter" class="newsletter" data-portal={portal} hidden>
		<div class="newsletter-row">
			<input type="email" name="email" autocomplete="email" placeholder="you@company.com" aria-label="Email" required />
			<button class="dl" type="submit">Subscribe</button>
		</div>
		<p class="newsletter-message" role="status" hidden></p>
		<p class="newsletter-hint"><a href={`${portal}privacy/`}>Privacy notice</a></p>
		<p class="newsletter-hint newsletter-after" hidden>Every newsletter has a one-click unsubscribe link. No account needed.</p>
	</form>
</div>

<script>
	// Refresh the links from the latest release in the browser.
	const root = document.querySelector<HTMLElement>('.downloads');

	// Linux has two packages: each Linux button downloads the server and the client .deb of its architecture.
	// The Linux menu closes after a choice and on a click elsewhere.
	const linuxMenu = root?.querySelector<HTMLDetailsElement>('.dl-linux');
	document.addEventListener('click', (event) => {
		if (linuxMenu?.open && !linuxMenu.contains(event.target as Node)) linuxMenu.open = false;
	});
	root?.querySelectorAll<HTMLAnchorElement>('a[data-linux]').forEach((button) => button.addEventListener('click', (event) => {
		if (linuxMenu) linuxMenu.open = false;
		const link = event.currentTarget as HTMLAnchorElement;
		const client = link.dataset.client;
		if (!client || client === link.href || !client.endsWith('.deb')) return;
		event.preventDefault();
		for (const url of [link.href, client]) {
			const frame = document.createElement('iframe');
			frame.hidden = true;
			frame.src = url;
			document.body.append(frame);
			setTimeout(() => frame.remove(), 60_000);
		}
	}));

	// Newsletter: the button opens the form, which posts to the support forum (double opt-in by mail).
	const toggle = root?.querySelector<HTMLButtonElement>('.newsletter-toggle');
	const form = root?.querySelector<HTMLFormElement>('.newsletter');
	toggle?.addEventListener('click', () => {
		if (!form) return;
		form.hidden = !form.hidden;
		toggle.setAttribute('aria-expanded', String(!form.hidden));
		if (!form.hidden) form.querySelector('input')?.focus();
	});
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const input = form.querySelector('input')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const message = form.querySelector<HTMLElement>('.newsletter-message')!;
		const show = (text: string, ok: boolean) => {
			message.textContent = text;
			message.classList.toggle('ok', ok);
			message.hidden = false;
		};
		const email = input.value.trim();
		button.disabled = true;
		try {
			const response = await fetch(`${form.dataset.portal}api/portal/subscribe`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			if (response.ok) {
				form.querySelector('.newsletter-row')?.remove();
				show(`Almost done: we sent a confirmation link to ${email}. Your subscription starts when you click it.`, true);
				form.querySelector<HTMLElement>('.newsletter-after')!.hidden = false;
			} else if (response.status === 429) {
				show('Too many tries. Wait a minute and try again.', false);
			} else {
				const answer = await response.json().catch(() => null);
				show(answer?.message || 'The subscription failed. Try again later.', false);
			}
		} catch {
			show('The support forum cannot be reached. Try again later.', false);
		} finally {
			button.disabled = false;
		}
	});

	if (root) {
		// no-store: never a cached answer, so a new release shows on the next page load.
		fetch(`https://api.github.com/repos/${root.dataset.repo}/releases/latest`, { cache: 'no-store' })
			.then((r) => (r.ok ? r.json() : null))
			.then((release) => {
				if (!release) return;
				const version = root.querySelector<HTMLAnchorElement>('.dl-version');
				if (version && release.tag_name) {
					version.textContent = release.tag_name;
					version.href = release.html_url ?? version.href;
					version.hidden = false;
				}
				const assets: { name: string; browser_download_url: string }[] = release.assets ?? [];
				root.querySelectorAll<HTMLAnchorElement>('a[data-asset]').forEach((link) => {
					const pattern = new RegExp(link.dataset.asset ?? '^$');
					const asset = assets.find((a) => pattern.test(a.name));
					if (asset) link.href = asset.browser_download_url;
				});
				root.querySelectorAll<HTMLAnchorElement>('a[data-linux]').forEach((linux) => {
					const client = assets.find((a) => a.name.startsWith('oadm-client_') && a.name.endsWith(`_${linux.dataset.linux}.deb`));
					if (client) linux.dataset.client = client.browser_download_url;
				});
			})
			.catch(() => {});
	}
</script>
