---
// One Download button for the latest release. It opens a dialog with every file per system: OADM, the OADM Site Node
// and the portable ZIPs. The files are read from GitHub when the site is built and again in the browser, so a new
// release shows up without a website rebuild. Without either, every link opens the release page.
import { Icon } from '@astrojs/starlight/components';

import { latestRelease, releasePage, repo } from '../lib/release';

const { assets, version } = await latestRelease();

// The newsletter lives on the support forum; the form here subscribes without an account there.
const portal = 'https://support.oadm.app/';
const youtube = 'https://www.youtube.com/@oadm-ca';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

type Row = { name: string; note?: string; pattern: string };
type Group = { title?: string; rows: Row[] };
type Tab = { id: string; label: string; icon: 'seti:windows' | 'linux' | 'apple' | 'seti:zip'; iconClass: string; groups: Group[]; note?: string };

const portable = (title: string, rid: string): Group => ({
	title,
	rows: [
		{ name: 'Server', pattern: `^OADM-Server-.*-${rid}\\.zip$` },
		{ name: 'Client', pattern: `^OADM-Client-.*-${rid}\\.zip$` },
	],
});
const linux = (id: string, label: string, deb: string): Tab => ({
	id,
	label,
	icon: 'linux',
	iconClass: 'os-linux',
	groups: [
		{
			rows: [
				{ name: 'Server', pattern: `^oadm-server_.*_${deb}\\.deb$` },
				{ name: 'Client', pattern: `^oadm-client_.*_${deb}\\.deb$` },
				{ name: 'Site Node', pattern: `^oadm-site-node_.*_${deb}\\.deb$` },
				{ name: 'Site Node App', note: 'Optional, needs a desktop', pattern: `^oadm-site-node-app_.*_${deb}\\.deb$` },
			],
		},
	],
});
const tabs: Tab[] = [
	{
		id: 'windows',
		label: 'Windows',
		icon: 'seti:windows',
		iconClass: 'os-windows',
		groups: [
			{
				rows: [
					{ name: 'Server and Client Installer', pattern: '^OADM-\\d.*-win-x64\\.msi$' },
					{ name: 'Site Node Installer', pattern: '^OADM-SiteNode-.*-win-x64\\.msi$' },
				],
			},
		],
	},
	linux('linux-x64', 'Linux x64', 'amd64'),
	linux('linux-arm64', 'Linux ARM64', 'arm64'),
	{
		id: 'macos',
		label: 'macOS',
		icon: 'apple',
		iconClass: 'os-macos',
		groups: [{ rows: [{ name: 'Server and Client Installer', pattern: 'osx-x64\\.pkg$' }] }],
		note: 'The Site Node runs on Windows and Linux.',
	},
	{
		id: 'portable',
		label: 'Portable',
		icon: 'seti:zip',
		iconClass: 'os-portable',
		groups: [
			portable('Windows x64', 'win-x64'),
			portable('Linux x64', 'linux-x64'),
			portable('Linux ARM64', 'linux-arm64'),
			portable('macOS', 'osx-x64'),
		],
		note: 'Server and client as ZIP files that run without installing.',
	},
];

// Without release data (offline build) every row shows and opens the release page.
const known = assets.length > 0;
const asset = (pattern: string) => assets.find((a) => new RegExp(pattern).test(a.name));
const size = (bytes?: number) => (bytes ? `${Math.round(bytes / (1024 * 1024))} MB` : '');
const checksums = asset('^SHA256SUMS\\.txt$')?.browser_download_url ?? releasePage;
---

<div class="downloads not-content" data-repo={repo}>
	<button class="dl dl-main" type="button" aria-haspopup="dialog" aria-controls="download-dialog">
		<Icon name="download" />Download<span class="dl-version-text" hidden={!version}>{version}</span>
	</button>
	<dialog id="download-dialog" class="dl-dialog" aria-labelledby="download-title">
		<div class="dl-dialog-head">
			<h2 id="download-title">Download OADM <span class="dl-version-text">{version}</span></h2>
			<button class="dl-close" type="button" aria-label="Close"><Icon name="close" /></button>
		</div>
		<div class="dl-tabs" role="tablist">
			{tabs.map((tab, i) => (
				<button type="button" role="tab" id={`dl-tab-${tab.id}`} aria-controls={`dl-panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={tab.id}>
					<Icon name={tab.icon} class={tab.iconClass} />{tab.label}
				</button>
			))}
		</div>
		{tabs.map((tab, i) => (
			<div class:list={["dl-panel", { "dl-panel-portable": tab.id === "portable" }]} role="tabpanel" id={`dl-panel-${tab.id}`} aria-labelledby={`dl-tab-${tab.id}`} hidden={i !== 0}>
				{tab.groups.map((group) => (
					<section class="dl-group" hidden={known && !group.rows.some((r) => asset(r.pattern))}>
						{group.title && <h3>{group.title}</h3>}
						{group.rows.map((row) => {
							const file = asset(row.pattern);
							return (
								<a class="dl-row" data-asset={row.pattern} href={file?.browser_download_url ?? releasePage} hidden={known && !file}>
									<span class="dl-row-text">
										<span class="dl-row-name">{row.name}{row.note && <span class="dl-row-note">{row.note}</span>}</span>
										<span class="dl-row-file">{file?.name ?? 'Release page'}</span>
									</span>
									<span class="dl-row-size">{size(file?.size)}</span>
									<Icon name="download" class="dl-row-icon" />
								</a>
							);
						})}
					</section>
				))}
				{tab.note && <p class="dl-panel-note">{tab.note}</p>}
			</div>
		))}
		<div class="dl-dialog-foot">
			<a href={`${base}start/install/`}>How to install</a>
			<a class="dl-checksums" href={checksums}>Checksums</a>
			<a href={releasePage}>All files on GitHub</a>
		</div>
	</dialog>
	<nav class="dl-links" aria-label="Community and learning">
		<a class="forum-link" href={portal}><Icon name="comment-alt" />Support Forum</a>
		<button class="newsletter-toggle" type="button" aria-expanded="false" aria-controls="newsletter"><Icon name="email" />Newsletter</button>
		<a href={youtube}><Icon name="youtube" />YouTube</a>
		<a href={`${base}start/install/`}><Icon name="open-book" />Documentation</a>
	</nav>
	<p class="forum-down" hidden>Currently not available. We are working on it.</p>
	<form id="newsletter" class="newsletter" data-portal={portal} hidden>
		<div class="newsletter-row">
			<input type="email" name="email" autocomplete="email" placeholder="you@company.com" aria-label="Email" required />
			<button class="dl" type="submit">Subscribe</button>
		</div>
		<p class="newsletter-message" role="status" hidden></p>
		<p class="newsletter-hint"><a href={`${portal}privacy/`}>Privacy notice</a></p>
		<p class="newsletter-hint newsletter-after" hidden>Every newsletter has a one-click unsubscribe link. No account needed.</p>
	</form>
</div>

<script>
	import { disableForumLink, forumAvailable } from '../lib/forum';

	const root = document.querySelector<HTMLElement>('.downloads');

	// The Download button opens the dialog on the tab of the visitor's system; the backdrop or Escape closes it.
	const dialog = root?.querySelector<HTMLDialogElement>('.dl-dialog');
	const tabs = Array.from(dialog?.querySelectorAll<HTMLButtonElement>('[role=tab]') ?? []);
	const select = (id: string) => {
		for (const tab of tabs) {
			const on = tab.dataset.tab === id;
			tab.setAttribute('aria-selected', String(on));
			tab.tabIndex = on ? 0 : -1;
			const panel = dialog?.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`);
			if (panel) panel.hidden = !on;
		}
	};
	const platform = () => {
		const hints = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? '';
		const agent = `${hints} ${navigator.userAgent}`;
		if (/iPhone|iPad|Android/i.test(agent)) return 'windows';
		if (/Mac/i.test(agent)) return 'macos';
		if (/Linux|X11/i.test(agent)) return /aarch64|arm64/i.test(agent) ? 'linux-arm64' : 'linux-x64';
		return 'windows';
	};
	tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.tab!)));
	root?.querySelector('.dl-main')?.addEventListener('click', () => {
		select(platform());
		dialog?.showModal();
	});
	dialog?.querySelector('.dl-close')?.addEventListener('click', () => dialog.close());
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	// Newsletter: the button opens the form, which posts to the support forum (double opt-in by mail).
	const toggle = root?.querySelector<HTMLButtonElement>('.newsletter-toggle');
	const form = root?.querySelector<HTMLFormElement>('.newsletter');
	toggle?.addEventListener('click', () => {
		if (!form) return;
		form.hidden = !form.hidden;
		toggle.setAttribute('aria-expanded', String(!form.hidden));
		if (!form.hidden) form.querySelector('input')?.focus();
	});
	// The forum is down: Support Forum and the newsletter greyed out, with a short note below them.
	forumAvailable().then((available) => {
		if (available || !root) return;
		root.querySelectorAll<HTMLElement>('.forum-link').forEach(disableForumLink);
		if (toggle) {
			toggle.disabled = true;
			toggle.classList.add('forum-unavailable');
			toggle.setAttribute('aria-expanded', 'false');
		}
		if (form) form.hidden = true;
		root.querySelector<HTMLElement>('.forum-down')!.hidden = false;
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const input = form.querySelector('input')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const message = form.querySelector<HTMLElement>('.newsletter-message')!;
		const show = (text: string, ok: boolean) => {
			message.textContent = text;
			message.classList.toggle('ok', ok);
			message.hidden = false;
		};
		const email = input.value.trim();
		button.disabled = true;
		try {
			const response = await fetch(`${form.dataset.portal}api/portal/subscribe`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			if (response.ok) {
				form.querySelector('.newsletter-row')?.remove();
				show(`Almost done: we sent a confirmation link to ${email}. Your subscription starts when you click it.`, true);
				form.querySelector<HTMLElement>('.newsletter-after')!.hidden = false;
			} else if (response.status === 429) {
				show('Too many tries. Wait a minute and try again.', false);
			} else {
				const answer = await response.json().catch(() => null);
				show(answer?.message || 'The subscription failed. Try again later.', false);
			}
		} catch {
			show('The support forum cannot be reached. Try again later.', false);
		} finally {
			button.disabled = false;
		}
	});

	if (root) {
		// Refresh the files from the latest release in the browser. no-store: never a cached answer, so a new release shows
		// on the next page load.
		fetch(`https://api.github.com/repos/${root.dataset.repo}/releases/latest`, { cache: 'no-store' })
			.then((r) => (r.ok ? r.json() : null))
			.then((release) => {
				if (!release) return;
				if (release.tag_name) {
					root.querySelectorAll<HTMLElement>('.dl-version-text').forEach((version) => {
						version.textContent = release.tag_name;
						version.hidden = false;
					});
				}
				const assets: { name: string; size: number; browser_download_url: string }[] = release.assets ?? [];
				if (assets.length === 0) return;
				root.querySelectorAll<HTMLAnchorElement>('a[data-asset]').forEach((link) => {
					const pattern = new RegExp(link.dataset.asset ?? '^$');
					const asset = assets.find((a) => pattern.test(a.name));
					link.hidden = !asset;
					if (!asset) return;
					link.href = asset.browser_download_url;
					link.querySelector('.dl-row-file')!.textContent = asset.name;
					link.querySelector('.dl-row-size')!.textContent = `${Math.round(asset.size / (1024 * 1024))} MB`;
				});
				root.querySelectorAll<HTMLElement>('.dl-group').forEach((group) => {
					group.hidden = !group.querySelector('a[data-asset]:not([hidden])');
				});
				const sums = assets.find((a) => a.name === 'SHA256SUMS.txt');
				const checksums = root.querySelector<HTMLAnchorElement>('.dl-checksums');
				if (sums && checksums) checksums.href = sums.browser_download_url;
			})
			.catch(() => {});
	}
</script>
