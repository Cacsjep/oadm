<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The SDK writes doc comment files for the website; publish folders and installers never ship them. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <Authors>OADM contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://oadm.app/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cacsjep/oadm</RepositoryUrl>
    <Copyright>Copyright 2026 The OADM contributors</Copyright>
  </PropertyGroup>

  <!-- Device connections only through the route (docs/sites.md, Banned APIs): src/ and plugins/ may not open sockets, ask
       DNS or build HTTP handlers themselves; the few justified exceptions carry a SuppressMessage. tools/, tests/ and
       samples/ stay outside (samples get the same list as warnings from the plugin project SDK). -->
  <!-- The OADM Site Node is the network endpoint at a site (it dials the devices for the server, docs/sites.md): its own
       sockets are the route, so its projects are outside the list. -->
  <PropertyGroup Condition="'$(OadmBannedApis)' == '' and $(MSBuildProjectName.StartsWith('Oadm.SiteNode'))">
    <OadmBannedApis>none</OadmBannedApis>
  </PropertyGroup>
  <PropertyGroup>
    <_OadmProjectDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_OadmProjectDirectory>
    <OadmBannedApis Condition="'$(OadmBannedApis)' == '' and ($(_OadmProjectDirectory.StartsWith('$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))')) or $(_OadmProjectDirectory.StartsWith('$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'plugins'))')))">error</OadmBannedApis>
  </PropertyGroup>
  <ItemGroup Condition="'$(OadmBannedApis)' == 'error'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/Oadm.Plugin.Sdk/targets/BannedSymbols.txt" Visible="false" />
  </ItemGroup>
</Project>
