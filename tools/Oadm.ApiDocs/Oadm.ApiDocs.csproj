<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generates the SDK reference of the website (website/src/content/docs/api/, git-ignored) from the public types of
    Oadm.Sdk and Oadm.Sdk.Client and their doc comments, plus the sidebar of the reference
    (website/src/generated/api-sidebar.json). Run by "manage build docs" and by pages.yml. Build helper, never shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The documented assemblies: copied next to the tool with their doc comment files and dependencies. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk.Client\Oadm.Sdk.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.ApiDocs.Tests" />
  </ItemGroup>
</Project>
