<Project>

  <!-- xunit.runner.visualstudio 4.x adds its own copy of xunit.abstractions.dll (same file, newer timestamp) next to the
       one xunit's package reference already copies. Both go to the same output file, so every build copied it twice and on
       Windows the second copy often failed with "access denied" while the virus scanner held the first. The reference
       copy is enough. -->
  <ItemGroup Condition="'$(NuGetPackageRoot)' != ''">
    <None Remove="$(NuGetPackageRoot)xunit.runner.visualstudio\*\build\*\xunit.abstractions.dll" />
  </ItemGroup>

  <!-- Native debug files of packages (libSkiaSharp.pdb, libHarfBuzzSharp.pdb, about 80 MB each, one per Windows
       processor type) are never used, but every project that references Avalonia copied them: about 8 GB of a full build.
       They stay out of build and publish folders; managed .pdb files are not touched. -->
  <Target Name="OadmSkipNativeDebugFiles" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.Extension)' == '.pdb' and '%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>

  <!-- NuGet packages (the plugin SDK, "manage package nuget"): one README and the app icon for every package page. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)packaging/nuget/README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon/oadm-app-icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>
