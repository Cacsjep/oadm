{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oadm.local/schemas/vapix-commander/library-v1.json",
  "title": "OADM VAPIX Commander library file",
  "type": "object",
  "required": ["formatVersion", "category", "commands"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "category": { "$ref": "#/$defs/category" },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
  },
  "$defs": {
    "category": {
      "enum": ["Common", "System", "Network", "Security", "Users", "Time", "Video", "Image", "PTZ", "Audio", "I/O", "Events", "Storage", "Applications", "Maintenance", "Custom"]
    },
    "placeholderName": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
    "command": {
      "type": "object",
      "required": ["id", "version", "name", "category", "requires", "writes", "fields", "request", "response"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 3, "maxLength": 80 },
        "category": { "$ref": "#/$defs/category" },
        "description": { "type": "string" },
        "docs": { "type": "string", "format": "uri" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["api", "minVersion"],
            "additionalProperties": false,
            "properties": {
              "api": { "type": "string" },
              "minVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
            }
          }
        },
        "writes": { "type": "boolean" },
        "dangerous": { "type": "boolean" },
        "hasVideoOnly": { "type": "boolean" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/placeholderName" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["string", "integer", "number", "boolean", "enum", "password"] },
        "default": {},
        "required": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string" },
        "unit": { "type": "string" },
        "trueValue": { "type": "string" },
        "falseValue": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": { "value": {}, "label": { "type": "string" } }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "bodyType": { "enum": ["none", "json", "form", "text", "xml"] },
        "body": {},
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "response": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["param-cgi", "json-rpc", "rest", "text", "xml", "raw"] },
        "success": { "type": "string" },
        "errorPattern": { "type": "string", "description": "Regex; a matching body is a device error even with HTTP 2xx" },
        "extract": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "path": { "type": "string" },
              "param": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
