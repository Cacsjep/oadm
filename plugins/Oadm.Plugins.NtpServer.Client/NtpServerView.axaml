<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:net="using:Oadm.Sdk.Network"
             xmlns:vm="using:Oadm.Plugins.NtpServer.Client"
             x:Class="Oadm.Plugins.NtpServer.Client.NtpServerView"
             x:DataType="vm:NtpServerViewModel"
             ui:PageHeader.Subtitle="Answers the time requests of the cameras (NTP, UDP port 123).">
  <!-- The description lives in the host page header (ui:PageHeader); the status sits left of the Save button. -->
  <!-- One card (the host's page card): header with the status line, settings form, last requests. Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <StackPanel Grid.Row="1" Classes="form">
      <CheckBox Content="Enable NTP server" IsChecked="{Binding IsEnabled}" />

      <!-- Same shared form rows and widths as the DHCP server page. -->
      <ui:FormField Label="Listen on" InputWidth="460">
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Listen.Items}" SelectedItem="{Binding Listen.Selected}"
                  ToolTip.Tip="The interface the cameras reach this server on. All interfaces listens on every address.">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="net:InterfaceOption">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </ui:FormField>

      <ui:FormField Label="Upstream server" InputWidth="460">
        <StackPanel>
          <TextBox Text="{Binding Upstream}" PlaceholderText="Optional, e.g. pool.ntp.org"
                   ToolTip.Tip="Optional. Empty: the cameras get this computer's time. With an upstream server, this computer follows it." />
          <ui:StatusChip Text="{Binding CheckingText}" IsAccent="True" IsVisible="{Binding IsCheckingUpstream}" Margin="0,6,0,0" />
          <ui:StatusChip Text="{Binding UpstreamResult}" IsOk="True" IsVisible="{Binding HasUpstreamResult}" Margin="0,6,0,0" />
        </StackPanel>
      </ui:FormField>

      <ui:FormField Classes="wide">
        <TextBlock Classes="secondary" Text="{Binding UpstreamInfoText}" IsVisible="{Binding HasUpstreamInfo}" TextWrapping="Wrap" />
      </ui:FormField>

      <ui:FormField InputWidth="460">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                  ToolTip.Tip="Check the upstream server, store the settings and apply them" />
          <ui:StatusChip HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                         Text="{Binding StatusText}" IsOk="{Binding IsStatusOk}" IsWarning="{Binding IsStatusWarning}"
                         IsError="{Binding IsStatusError}" IsAccent="{Binding IsStatusAccent}"
                         ToolTip.Tip="{Binding StatusDetail}" />
        </DockPanel>
      </ui:FormField>
    </StackPanel>

    <TextBlock Grid.Row="2" Classes="sectionTitle" Text="Last requests" Margin="{DynamicResource Oadm.GapTop}" />

    <Panel Grid.Row="3" Margin="0,8,0,0">
      <DataGrid ItemsSource="{Binding Requests}" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                SelectionMode="Single" MinHeight="120">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Width="100" Binding="{Binding Time}" x:DataType="vm:RequestRowViewModel" />
          <DataGridTextColumn Header="Client" Width="160" Binding="{Binding Client}" x:DataType="vm:RequestRowViewModel" />
          <DataGridTextColumn Header="Device" Width="*" Binding="{Binding Device}" x:DataType="vm:RequestRowViewModel" />
          <DataGridTextColumn Header="Offset" Width="110" Binding="{Binding Offset}" x:DataType="vm:RequestRowViewModel" />
          <DataGridTemplateColumn Header="Result" Width="160" x:DataType="vm:RequestRowViewModel">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RequestRowViewModel">
                <ui:StatusChip Text="{Binding Result}" IsOk="{Binding IsAnswered}" IsWarning="{Binding IsLimited}" Margin="10,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="secondary" Text="No requests yet." IsVisible="{Binding !HasRequests}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
    </Panel>
  </Grid>
</UserControl>
