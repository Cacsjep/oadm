<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Oadm.Plugins.Provisioning.Server</AssemblyName>
    <RootNamespace>Oadm.Plugins.Provisioning</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Folder name under artifacts/plugins/, must equal the id in plugin.json. -->
    <OadmPluginId>oadm.provisioning</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host: never copy it (or its dependencies) into the plugin folder. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- One source each, compiled into this assembly too (a project reference would copy the other plugin's Server.dll into
       this folder, where the loader would register its tasks a second time): the address-in-use probe (ping + TCP 80/443)
       and the IPv4 math of the Network plugin, the Axis MAC address blocks of the DHCP server. -->
  <ItemGroup>
    <Compile Include="..\Oadm.Plugins.Network\AddressProbe.cs" Link="Network\AddressProbe.cs" />
    <Compile Include="..\Oadm.Plugins.Network\Model\Ipv4.cs" Link="Network\Ipv4.cs" />
    <Compile Include="..\Oadm.Plugins.DhcpServer\Serving\AxisOui.cs" Link="Dhcp\AxisOui.cs" />
  </ItemGroup>

  <!-- The time zones of AXIS OS of the Date and time plugin: the Date and time node's choice in the editor. -->
  <ItemGroup>
    <Compile Include="..\Oadm.Plugins.DateTime\Model\TimeZoneCatalog.cs" Link="TimeZones\TimeZoneCatalog.cs" />
    <Compile Include="..\Oadm.Plugins.DateTime\Model\ZoneYear.cs" Link="TimeZones\ZoneYear.cs" />
    <EmbeddedResource Include="..\Oadm.Plugins.DateTime\Model\TimeZones.txt" Link="TimeZones\TimeZones.txt" LogicalName="Oadm.Plugins.DateAndTime.TimeZones.txt" />
  </ItemGroup>

  <!-- The VAPIX Commander library and its checks for the node VAPIX commands (the same commands, fields and requirements as
       the Commander page); the library files are copied into this plugin's folder. -->
  <ItemGroup>
    <Compile Include="..\Oadm.Plugins.VapixCommander\CommandModels.cs" Link="Commander\CommandModels.cs" />
    <Compile Include="..\Oadm.Plugins.VapixCommander\CommandLibrary.cs" Link="Commander\CommandLibrary.cs" />
    <Compile Include="..\Oadm.Plugins.VapixCommander\CommandValidator.cs" Link="Commander\CommandValidator.cs" />
    <Compile Include="..\Oadm.Plugins.VapixCommander\FieldValues.cs" Link="Commander\FieldValues.cs" />
    <Compile Include="..\Oadm.Plugins.VapixCommander\CommandJson.cs" Link="Commander\CommandJson.cs" />
    <Compile Include="..\Oadm.Plugins.VapixCommander\Compatibility.cs" Link="Commander\Compatibility.cs" />
    <None Include="..\Oadm.Plugins.VapixCommander\Library\*.json" Link="Library\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Plugins.Provisioning.Tests" />
  </ItemGroup>

  <!-- Development deployment: copy the output to artifacts/plugins/oadm.provisioning/. -->
  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OADM plugin $(OadmPluginId) deployed to $(OadmPluginOutputDir)" />
  </Target>

</Project>
