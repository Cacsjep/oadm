<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:c="using:Oadm.Plugins.VapixCommander.Client"
             xmlns:v="using:Oadm.Plugins.VapixCommander"
             x:Class="Oadm.Plugins.VapixCommander.Client.CommanderView"
             x:DataType="c:CommanderViewModel"
             ui:PageHeader.Subtitle="Send VAPIX commands to one camera, or roll them out to many.">
  <!-- VAPIX Commander page: library | rollout set or raw request (+ result) | target devices with the run controls at its bottom.
       Shared controls and theme classes only (CLAUDE.md "reuse UI components", "no style differences"). -->
  <Grid ColumnDefinitions="430,*,340" ColumnSpacing="{DynamicResource Oadm.Gap}">

    <!-- ============================== Library ============================== -->
    <Border Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <ui:CardHeader Title="Library" Description="{Binding LibrarySummary}">
          <Button Classes="toolbar iconOnly" Command="{Binding ImportCommand}" ToolTip.Tip="Import commands from a file (saved for all OADM clients)">
            <ui:OadmIcon Data="{DynamicResource Icon.upload}" />
          </Button>
        </ui:CardHeader>
        <ui:SearchBox Grid.Row="1" Text="{Binding LibrarySearch}" Placeholder="Search commands" HorizontalAlignment="Left" />
        <!-- A click on a command adds it to the rollout set, a click on a group expands or collapses it (code-behind). -->
        <TreeView x:Name="LibraryTreeView" Grid.Row="2" ItemsSource="{Binding LibraryTree}" SelectedItem="{Binding SelectedNode}">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="c:LibraryNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
            <!-- Export / delete of a saved command appear on hover of its row. -->
            <Style Selector="Grid.libraryRow StackPanel.rowActions">
              <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="Grid.libraryRow:pointerover StackPanel.rowActions">
              <Setter Property="Opacity" Value="1" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="c:LibraryNodeViewModel" ItemsSource="{Binding Children}">
              <Grid Classes="libraryRow" ColumnDefinitions="*,Auto" Background="Transparent" ToolTip.Tip="{Binding Tooltip}"
                    Tapped="OnLibraryNodeTapped" DoubleTapped="OnLibraryNodeDoubleTapped">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Classes="rowActions" Orientation="Horizontal" IsVisible="{Binding IsSaved}">
                  <Button Classes="toolbar iconOnly" ToolTip.Tip="Export this saved command to a file"
                          Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).ExportSavedCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{DynamicResource Icon.export}" />
                  </Button>
                  <Button Classes="toolbar iconOnly" ToolTip.Tip="Delete this saved command for all OADM clients"
                          Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).DeleteSavedCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{DynamicResource Icon.remove}" />
                  </Button>
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock Grid.Row="3" Classes="warning small" Text="{Binding LibraryProblems}" TextWrapping="Wrap" IsVisible="{Binding HasLibraryProblems}" />
      </Grid>
    </Border>

    <!-- ============================== Rollout set / raw request ============================== -->
    <Border Grid.Column="1" Classes="card">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <Border Classes="segmented">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment" Classes.selected="{Binding IsRolloutTab}" Content="Rollout set" Command="{Binding ShowRolloutCommand}" />
              <Button Classes="segment" Classes.selected="{Binding IsRawTab}" Content="Raw request" Command="{Binding ShowRawCommand}" />
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Send to" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding TryDevice}" MinWidth="200" PlaceholderText="Device">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="c:TargetDeviceViewModel">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="secondary" Command="{Binding TryCommand}" ToolTip.Tip="Send the selected command to this device now (read-only commands run immediately, changes ask first)">
              <ui:IconLabel Icon="{DynamicResource Icon.send}" Text="Send" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Rollout set -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="{Binding IsRolloutTab}">
          <!-- Keyboard (code-behind): Delete removes the selected row, Ctrl+Up / Ctrl+Down move it. -->
          <DataGrid x:Name="RolloutGrid" ItemsSource="{Binding RolloutItems}" SelectedItem="{Binding SelectedRolloutItem}" SelectionMode="Single"
                    IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False" MaxHeight="260" MinHeight="120">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Width="44" Binding="{Binding Position}" x:DataType="c:RolloutCommandViewModel" />
              <DataGridTextColumn Header="Command" Width="*" Binding="{Binding Name}" x:DataType="c:RolloutCommandViewModel" />
              <DataGridTextColumn Header="Category" Width="100" Binding="{Binding Category}" x:DataType="c:RolloutCommandViewModel" />
              <DataGridTextColumn Header="Kind" Width="130" Binding="{Binding KindText}" x:DataType="c:RolloutCommandViewModel" />
              <DataGridTextColumn Header="Source" Width="96" Binding="{Binding SourceText}" x:DataType="c:RolloutCommandViewModel" />
              <DataGridTemplateColumn Width="147" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                <DataGridTemplateColumn.Header>
                  <!-- Right-aligned like the row icons, so it sits above their Remove icon. -->
                  <Panel Width="137">
                    <Button Classes="toolbar iconOnly" HorizontalAlignment="Right" ToolTip.Tip="Remove all commands from the rollout set"
                            Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).ClearCommand}">
                      <ui:OadmIcon Data="{DynamicResource Icon.deleteAll}" />
                    </Button>
                  </Panel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="c:RolloutCommandViewModel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                      <Button Classes="toolbar iconOnly" ToolTip.Tip="Move up (Ctrl+Up)" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).MoveUpCommand}">
                        <ui:OadmIcon Data="{DynamicResource Icon.chevronUp}" />
                      </Button>
                      <Button Classes="toolbar iconOnly" ToolTip.Tip="Move down (Ctrl+Down)" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).MoveDownCommand}">
                        <ui:OadmIcon Data="{DynamicResource Icon.chevronDown}" />
                      </Button>
                      <Button Classes="toolbar iconOnly" ToolTip.Tip="Save with values: a new saved command with the entered values, for all OADM clients" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).SavePresetCommand}">
                        <ui:OadmIcon Data="{DynamicResource Icon.save}" />
                      </Button>
                      <Button Classes="toolbar iconOnly" ToolTip.Tip="Remove from the rollout set (Delete)" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).RemoveCommand}">
                        <ui:OadmIcon Data="{DynamicResource Icon.remove}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding !HasRolloutItems}"
                         Text="Click commands in the library to add them, fill their values, choose the target devices and run. Every command becomes a named step of the task on each device." />

              <Border Classes="inlineEditor" IsVisible="{Binding IsPresetOpen}">
                <StackPanel Classes="form">
                  <TextBlock Classes="sectionTitle" Text="Save with values" />
                  <ui:FormField Classes="wide" Label="Name">
                    <TextBox Text="{Binding PresetName}" />
                  </ui:FormField>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save" Command="{Binding ConfirmPresetCommand}"
                            ToolTip.Tip="{Binding PresetBlockedReason}" ToolTip.ShowOnDisabled="True" />
                    <Button Classes="secondary" Content="Cancel" Command="{Binding CancelPresetCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Classes="form" DataContext="{Binding SelectedRolloutItem}" IsVisible="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).HasSelectedRolloutItem}" x:DataType="c:RolloutCommandViewModel">
                <ui:CardHeader Classes="flush" Title="{Binding Name}" Description="{Binding Detail}" />
                <TextBlock Classes="secondary" Text="No values needed." IsVisible="{Binding !HasFields}" />
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="c:FieldViewModel">
                      <!-- The error shows below the input (data validation of Text / SelectedOption), the hint otherwise -->
                      <ui:FormField Classes="wide" Label="{Binding Label}" Hint="{Binding Hint}">
                        <Panel>
                          <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsTextInput}" />
                          <ui:PasswordBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsPassword}" />
                          <CheckBox IsChecked="{Binding BoolValue}" Content="Yes" IsVisible="{Binding IsBoolean}" />
                          <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" HorizontalAlignment="Stretch" IsVisible="{Binding IsEnum}" />
                        </Panel>
                      </ui:FormField>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Raw request (like Postman) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsRawTab}">
          <StackPanel Classes="form" DataContext="{Binding Raw}" x:DataType="c:RawEditorViewModel">
            <Grid Classes="inputRow" ColumnDefinitions="110,*" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" HorizontalAlignment="Stretch" />
              <TextBox Grid.Column="1" Text="{Binding Path}" PlaceholderText="/axis-cgi/param.cgi" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="sectionTitle" Text="Query parameters" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary" Content="Add" Command="{Binding AddQueryRowCommand}" />
                <Button Classes="secondary" Content="Remove" Command="{Binding RemoveQueryRowCommand}" />
                <Button Classes="secondary" Content="Make field" Command="{Binding MakeQueryFieldCommand}" ToolTip.Tip="Turn the selected value into a {{placeholder}} field" />
              </StackPanel>
            </Grid>
            <DataGrid ItemsSource="{Binding QueryRows}" SelectedItem="{Binding SelectedQueryRow}" SelectionMode="Single" CanUserSortColumns="False" MinHeight="90" MaxHeight="200">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Width="*" Binding="{Binding Key}" x:DataType="c:KeyValueRowViewModel" />
                <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" x:DataType="c:KeyValueRowViewModel" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="fieldMessage error" Text="{Binding QueryRowsError}"
                       IsVisible="{Binding QueryRowsError, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowHeaders}">
              <TextBlock Classes="sectionTitle" Text="Headers" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary" Content="Add" Command="{Binding AddHeaderRowCommand}" />
                <Button Classes="secondary" Content="Remove" Command="{Binding RemoveHeaderRowCommand}" />
                <Button Classes="secondary" Content="Make field" Command="{Binding MakeHeaderFieldCommand}" />
              </StackPanel>
            </Grid>
            <DataGrid ItemsSource="{Binding HeaderRows}" IsVisible="{Binding ShowHeaders}" SelectedItem="{Binding SelectedHeaderRow}" SelectionMode="Single" CanUserSortColumns="False" MinHeight="60" MaxHeight="160">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Header" Width="*" Binding="{Binding Key}" x:DataType="c:KeyValueRowViewModel" />
                <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" x:DataType="c:KeyValueRowViewModel" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="fieldMessage error" Text="{Binding HeaderRowsError}"
                       IsVisible="{Binding HeaderRowsError, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <ui:FormField Label="Body" InputWidth="160">
              <ComboBox ItemsSource="{Binding BodyTypeOptions}" SelectedItem="{Binding BodyType}" />
            </ui:FormField>
            <TextBox Classes="code" Text="{Binding BodyText}" Height="120" IsVisible="{Binding HasBody}"
                     PlaceholderText="JSON, form (key=value&amp;key2=value), text or XML; use {{name}} for fields" />

            <ui:FormField Label="Timeout (s)" InputWidth="160">
              <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="600" Increment="5" FormatString="0" />
            </ui:FormField>
            <ui:FormField Label="Response" InputWidth="160">
              <ComboBox ItemsSource="{Binding ResponseKindOptions}" SelectedItem="{Binding ResponseKind}" />
            </ui:FormField>

            <TextBlock Classes="sectionTitle" Text="Fields" IsVisible="{Binding HasFields}" />
            <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:RawFieldViewModel">
                  <StackPanel>
                    <Grid ColumnDefinitions="140,*,130,*" ColumnSpacing="8">
                      <TextBlock Classes="fieldLabel" Text="{Binding Placeholder}" />
                      <TextBox Grid.Column="1" Text="{Binding Label}" PlaceholderText="Label" />
                      <ComboBox Grid.Column="2" ItemsSource="{x:Static c:RawEditorViewModel.FieldTypeOptions}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" />
                      <Panel Grid.Column="3">
                        <TextBox Text="{Binding Value}" PlaceholderText="Value" IsVisible="{Binding !IsPassword}" />
                        <ui:PasswordBox Text="{Binding Value}" PlaceholderText="Value" IsVisible="{Binding IsPassword}" />
                      </Panel>
                    </Grid>
                    <!-- The problem of this field row, directly below it -->
                    <TextBlock Classes="fieldMessage error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Content="Add to rollout" Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).AddRawToRolloutCommand}"
                      ToolTip.Tip="{Binding BlockedReason}" ToolTip.ShowOnDisabled="True" />
              <Button Classes="secondary" Command="{Binding OpenSaveCommand}"><ui:IconLabel Icon="{DynamicResource Icon.save}" Text="Save as command" /></Button>
            </StackPanel>

            <Border Classes="inlineEditor" IsVisible="{Binding IsSaveOpen}">
              <StackPanel Classes="form">
                <TextBlock Classes="sectionTitle" Text="Save as command" />
                <ui:FormField Classes="wide" Label="Name">
                  <TextBox Text="{Binding SaveName}" />
                </ui:FormField>
                <ui:FormField Label="Category" InputWidth="200">
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SaveCategory}" />
                </ui:FormField>
                <ui:FormField Classes="wide" Label="Description">
                  <TextBox Text="{Binding SaveDescription}" />
                </ui:FormField>
                <ui:FormField Classes="wide" Label="Requires API">
                  <StackPanel Classes="inputRow">
                    <TextBox Text="{Binding RequiresApi}" PlaceholderText="param-cgi" Width="200" />
                    <TextBox Text="{Binding RequiresVersion}" PlaceholderText="1.0" Width="80" />
                  </StackPanel>
                </ui:FormField>
                <ui:FormField Classes="wide">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Changes the device" IsChecked="{Binding Writes}" />
                    <CheckBox Content="Dangerous (restart, reset, network, users)" IsChecked="{Binding Dangerous}" />
                  </StackPanel>
                </ui:FormField>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                          ToolTip.Tip="{Binding BlockedReason}" ToolTip.ShowOnDisabled="True" />
                  <Button Classes="secondary" Content="Cancel" Command="{Binding CancelSaveCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Result of Send (Try) -->
        <Border Grid.Row="2" Classes="inlineEditor" IsVisible="{Binding HasTryResult}" MaxHeight="420">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" DataContext="{Binding TryResult}" x:DataType="c:TryResultViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <ui:StatusChip Text="{Binding StatusText}" IsOk="{Binding Success}" IsError="{Binding IsError}" />
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding ExchangeLine}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="toolbar iconOnly" Command="{Binding $parent[UserControl].((c:CommanderViewModel)DataContext).CloseTryResultCommand}" ToolTip.Tip="Close">
                <ui:OadmIcon Data="{DynamicResource Icon.close}" />
              </Button>
            </Grid>
            <SelectableTextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" />
            <SelectableTextBlock Grid.Row="2" Classes="secondary small" Text="{Binding RequestLine}" TextWrapping="Wrap" />
            <Grid Grid.Row="3" ColumnDefinitions="2*,*" ColumnSpacing="8" IsVisible="{Binding HasBody}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="segmented" IsVisible="{Binding CanShowRaw}">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="segment" Classes.selected="{Binding IsPretty}" Content="Pretty" Command="{Binding ShowPrettyCommand}" ToolTip.Tip="Indented and highlighted" />
                    <Button Classes="segment" Classes.selected="{Binding IsRaw}" Content="Raw" Command="{Binding ShowRawCommand}" ToolTip.Tip="Exactly as the device sent it" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="secondary small" Text="{Binding ContentType}" VerticalAlignment="Center" />
                <TextBlock Classes="warning small" Text="Cut at 256 KB." VerticalAlignment="Center" IsVisible="{Binding IsBodyTruncated}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="secondary small" Text="Headers" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="4" ColumnDefinitions="2*,*" ColumnSpacing="8" MinHeight="200" IsVisible="{Binding HasBody}">
              <ui:CodeView Text="{Binding DisplayBody}" Language="{Binding BodyLanguage}" IsFormatted="{Binding IsPretty}" />
              <ui:CodeView Grid.Column="1" Text="{Binding HeadersText}" Language="Plain" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ============================== Target devices (+ run, docked at the bottom) ============================== -->
    <Border Grid.Column="2" Classes="card">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <ui:CardHeader Title="Target devices" Description="{Binding TargetSummary}" />
        <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8">
          <Button Classes="secondary" Content="Devices page selection" Command="{Binding UseDevicesSelectionCommand}" />
          <Button Classes="secondary" Content="All" Command="{Binding SelectAllTargetsCommand}" ToolTip.Tip="Select every device matching the search" />
          <Button Classes="secondary" Content="Compatible" Command="{Binding SelectCompatibleTargetsCommand}" />
          <Button Classes="secondary" Content="None" Command="{Binding ClearTargetsCommand}" />
        </WrapPanel>
        <ui:SearchBox Grid.Row="2" Text="{Binding TargetSearch}" Placeholder="Search devices" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="3" Classes="secondary small" Text="{Binding CompatibilitySummary}" TextWrapping="Wrap" IsVisible="{Binding HasCompatibilitySummary}" />
        <!-- Thousands of devices: virtualized, only the visible rows exist. -->
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TargetList" ItemsSource="{Binding VisibleTargets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:TargetDeviceViewModel">
                <StackPanel Spacing="4" Margin="0,0,0,10">
                  <CheckBox IsChecked="{Binding IsSelected}">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="secondary small" Text="{Binding Subtitle}" />
                    </StackPanel>
                  </CheckBox>
                  <StackPanel Margin="28,0,0,0" Spacing="2">
                    <ui:StatusChip IsWarning="True" Text="{Binding StatusText}" IsVisible="{Binding !IsReachable}" />
                    <ui:StatusChip Text="{Binding CompatibilityText}" IsOk="{Binding AllCompatible}" IsWarning="{Binding IsCompatibilityWarning}" IsError="{Binding IsCompatibilityError}"
                                   ToolTip.Tip="{Binding CompatibilityTooltip}" IsVisible="{Binding ShowCompatibility}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="5" Classes="separator" />
        <StackPanel Grid.Row="6" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasStatus}">
            <ui:StatusChip Text="{Binding Status}" IsOk="{Binding IsStatusOk}" IsError="{Binding IsStatusError}" ToolTip.Tip="{Binding Status}" MaxWidth="300" />
            <Button Classes="link" Content="Show tasks" Command="{Binding ShowTasksCommand}" IsVisible="{Binding CanShowTasks}" />
          </StackPanel>
          <TextBlock Classes="secondary" Text="{Binding RunSummary}" TextWrapping="Wrap" />
          <CheckBox Content="Stop on first error" IsChecked="{Binding StopOnFirstError}"
                    ToolTip.Tip="The first failure stops the whole rollout: the failing device skips its remaining commands, devices not started yet are cancelled, running devices stop after their current command." />
          <Button Classes="primary" HorizontalAlignment="Right" Command="{Binding RunCommand}">
            <ui:IconLabel Icon="{DynamicResource Icon.start}" Text="{Binding RunText}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
