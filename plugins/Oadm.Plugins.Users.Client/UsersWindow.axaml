<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:u="using:Oadm.Plugins.Users.Client"
        x:Class="Oadm.Plugins.Users.Client.UsersWindow"
        x:DataType="u:UsersDialogViewModel"
        Title="Users"
        Width="1040" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Layout of the add devices wizard: title bar, cards, button row. Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Users" />

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Oadm.Gap}" Margin="16,0">
      <!-- Left: what to do -->
      <Border Grid.Column="0" Classes="card">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ui:CardHeader Title="User" Description="{Binding Summary}" />
            <StackPanel Classes="form">
              <ui:FormField Label="Action">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton GroupName="mode" Content="Add" IsChecked="{Binding IsAdd}" />
                  <RadioButton GroupName="mode" Content="Change" IsChecked="{Binding IsChange}" />
                  <RadioButton GroupName="mode" Content="Remove" IsChecked="{Binding IsRemove}" />
                </StackPanel>
              </ui:FormField>

              <ui:FormField Label="User name" IsVisible="{Binding ShowUserName}">
                <TextBox Text="{Binding UserName}" PlaceholderText="1-14 characters: a-z, A-Z, 0-9" />
              </ui:FormField>

              <ui:FormField IsVisible="{Binding IsChange}" Error="{Binding ChangeSelectionError}">
                <StackPanel>
                  <CheckBox Content="Set a new password" IsChecked="{Binding ChangePassword}" />
                  <CheckBox Content="Change role" IsChecked="{Binding ChangeRole}" />
                </StackPanel>
              </ui:FormField>

              <ui:FormField Label="Password" Hint="{Binding PolicyHint}" IsVisible="{Binding ShowPassword}">
                <ui:PasswordBox Text="{Binding Password}" />
              </ui:FormField>
              <ui:FormField Label="Confirm password" IsVisible="{Binding ShowPassword}">
                <ui:PasswordBox Text="{Binding ConfirmPassword}" />
              </ui:FormField>

              <ui:FormField Label="Role" IsVisible="{Binding ShowRole}">
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
              </ui:FormField>
              <ui:FormField IsVisible="{Binding ShowRole}">
                <CheckBox Content="PTZ control" IsChecked="{Binding Ptz}" />
              </ui:FormField>

              <!-- Remove: the users chosen in the Existing users list and what cannot be removed -->
              <ui:FormField Label="Users to remove" IsVisible="{Binding IsRemove}" Hint="{x:Static u:UsersDialogViewModel.RemoveNote}">
                <TextBlock Text="{Binding UsersToRemoveText}" TextWrapping="Wrap" />
              </ui:FormField>

              <TextBlock Classes="warning" Text="{Binding LockOutWarning}" TextWrapping="Wrap" IsVisible="{Binding LockOutWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right: existing users of the first selected device (read-only query) -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <ui:CardHeader Title="Existing users" Description="{Binding UsersDescription}" />
          <!-- Selection is forwarded by the code-behind (SetSelectedUsers); Remove mode selects several rows. -->
          <DataGrid Grid.Row="1" Name="UsersGrid" ItemsSource="{Binding ExistingUsers}" SelectionMode="Single"
                    IsReadOnly="True" CanUserReorderColumns="False">
            <DataGrid.Styles>
              <!-- Protected accounts cannot be selected in Remove mode (greyed by the host's disabled row style). -->
              <Style Selector="DataGridRow" x:DataType="u:ExistingUserRow">
                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                <Setter Property="ToolTip.Tip" Value="{Binding Tooltip}" />
                <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="User name" Width="*" Binding="{Binding Name}" x:DataType="u:ExistingUserRow" />
              <DataGridTextColumn Header="Role" Width="2*" Binding="{Binding RoleText}" x:DataType="u:ExistingUserRow" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes.primary="{Binding !IsRemove}" Classes.danger="{Binding IsRemove}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" IsDefault="True"
              ToolTip.Tip="{Binding ApplyBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
