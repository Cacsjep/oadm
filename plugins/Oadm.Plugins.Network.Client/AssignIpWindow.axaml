<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Network.Client"
        x:Class="Oadm.Plugins.Network.Client.AssignIpWindow"
        x:DataType="vm:AssignIpViewModel"
        Title="{Binding Title}"
        Width="900" Height="720" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Clone of ADM's "Assign IP address": page 1 DHCP or IP range, page 2 the new addresses. Shared controls and
       theme classes only; the table is the AddressAssignmentGrid shared with "Network settings...". Field errors
       below their input, row errors in the table; Finish confirms in the shared message window. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,0" Spacing="{DynamicResource Oadm.Gap}">
        <!-- Page 1: Assign IP address -->
        <Border Classes="card" IsVisible="{Binding IsSettingsPage}">
          <StackPanel>
            <ui:CardHeader Title="Assign IP address" Description="{Binding PageDescription}" />
            <StackPanel Classes="form">
              <RadioButton GroupName="ipv4" Content="{Binding DhcpOptionText}" IsChecked="{Binding UseDhcp}" />
              <RadioButton GroupName="ipv4" Content="{Binding RangeOptionText}" IsChecked="{Binding UseRange}" />
              <StackPanel Classes="form" IsVisible="{Binding UseRange}">
                <ui:FormField Label="{Binding RangeLabel}" Hint="{Binding RangeHint}">
                  <TextBox Text="{Binding IpRange}" PlaceholderText="{Binding RangePlaceholder}" />
                </ui:FormField>
                <ui:FormField Label="Subnet mask">
                  <TextBox Text="{Binding SubnetMask}" PlaceholderText="255.255.255.0" />
                </ui:FormField>
                <ui:FormField Label="Default router">
                  <TextBox Text="{Binding DefaultRouter}" PlaceholderText="192.168.0.1" />
                </ui:FormField>
              </StackPanel>
              <TextBlock Classes="error" Text="{Binding PrefillStatus}" TextWrapping="Wrap" IsVisible="{Binding PrefillStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Page 1: optional DNS servers (static assignment only) -->
        <Border Classes="card">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsSettingsPage" />
              <Binding Path="UseRange" />
            </MultiBinding>
          </Border.IsVisible>
          <StackPanel>
            <ui:CardHeader Title="DNS servers" Description="Optional. Empty keeps the current DNS servers." />
            <StackPanel Classes="form">
              <ui:FormField Label="Primary DNS server">
                <TextBox Text="{Binding DnsPrimary}" PlaceholderText="optional" />
              </ui:FormField>
              <ui:FormField Label="Secondary DNS server">
                <TextBox Text="{Binding DnsSecondary}" PlaceholderText="optional" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Page 2: new IP addresses -->
        <Border Classes="card" IsVisible="{Binding IsReviewPage}">
          <StackPanel>
            <ui:CardHeader Title="New IP addresses" Description="{Binding PageDescription}" />
            <vm:AddressAssignmentGrid Margin="{DynamicResource Oadm.GapTop}" DataContext="{Binding Assignment}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="secondary" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding IsReviewPage}" />
      <Button Classes="primary" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsDefault="True"
              ToolTip.Tip="{Binding BlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
