<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Network.Client"
             x:Class="Oadm.Plugins.Network.Client.AddressAssignmentGrid"
             x:DataType="vm:AddressAssignmentViewModel">
  <!-- The address assignment table of both network dialogs: devices in grid order, current and new IP address
       (editable), optional new host name, status chip with the conflict. Theme styles only. -->
  <StackPanel Spacing="10">
    <!-- Check addresses on the left, above the New IP address column it checks, with the row summary and the result -->
    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
      <Button Classes="secondary" Command="{Binding CheckCommand}" ToolTip.Tip="Check whether the new addresses are in use">
        <ui:IconLabel Icon="{DynamicResource Icon.search}" Text="Check addresses" Spacing="8" />
      </Button>
      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Summary}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding CheckStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
    <DataGrid x:Name="Grid" Classes="wrapRows" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False" CanUserSortColumns="False" MaxHeight="420">
      <DataGrid.Columns>
        <DataGridTextColumn Header="MAC address" Width="140" Binding="{Binding MacAddress}" x:DataType="vm:AddressRowViewModel" />
        <DataGridTextColumn Header="Model" Width="150" Binding="{Binding Model}" x:DataType="vm:AddressRowViewModel" />
        <DataGridTextColumn Header="Current IP address" Width="*" MinWidth="150" Binding="{Binding CurrentAddress}" x:DataType="vm:AddressRowViewModel" />
        <DataGridTemplateColumn Header="New IP address" Width="1.1*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:AddressRowViewModel">
              <TextBox Text="{Binding NewAddress}" IsReadOnly="{Binding !IsEditable}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="New IPv6 address" Width="1.4*" MinWidth="180" IsVisible="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:AddressRowViewModel">
              <TextBox Text="{Binding NewIpv6Address}" IsReadOnly="{Binding !IsIpv6Editable}" PlaceholderText="2001:db8::10" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="New host name" Width="*" MinWidth="140" Binding="{Binding NewHostName}" x:DataType="vm:AddressRowViewModel" IsVisible="False" />
        <DataGridTemplateColumn Header="Status" Width="2.5*" MinWidth="200">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:AddressRowViewModel">
              <ui:StatusChip Text="{Binding StatusText}" IsOk="{Binding IsReady}" IsError="{Binding HasConflict}" ToolTip.Tip="{Binding StatusText}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
