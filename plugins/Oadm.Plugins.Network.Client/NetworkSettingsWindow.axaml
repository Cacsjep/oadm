<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Network.Client"
        x:Class="Oadm.Plugins.Network.Client.NetworkSettingsWindow"
        x:DataType="vm:NetworkSettingsViewModel"
        Title="{Binding Title}"
        Width="820" Height="800" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Layout of the add devices wizard: title bar, cards, button row. Shared controls and theme classes only.
       Every section card: title, "Configuration" choice, then the fields of a static setting. Field errors appear
       below their input (INotifyDataErrorInfo), row errors in the Devices table; risky changes are confirmed on Apply. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,0" Spacing="{DynamicResource Oadm.Gap}">
        <!-- Devices: per-device new IPv4 / IPv6 addresses and host names (several devices) -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Classes="flush" Title="Devices" Description="{Binding DevicesDescription}" />
            <Panel Margin="{DynamicResource Oadm.GapTop}" IsVisible="{Binding ShowPreview}">
              <vm:AddressAssignmentGrid DataContext="{Binding Assignment}" />
            </Panel>
          </StackPanel>
        </Border>

        <!-- IPv4 -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="IPv4" />
            <StackPanel Classes="form">
              <ui:FormField Label="Configuration">
                <ComboBox ItemsSource="{Binding Ipv4Choices}" SelectedItem="{Binding SelectedIpv4}" />
              </ui:FormField>
              <ui:FormField Label="IP address" IsVisible="{Binding ShowIpv4Address}">
                <TextBox Text="{Binding Ipv4Address}" PlaceholderText="192.168.0.90" />
              </ui:FormField>
              <ui:FormField Label="Subnet mask" IsVisible="{Binding IsIpv4Static}">
                <TextBox Text="{Binding Ipv4Mask}" PlaceholderText="255.255.255.0 or 24" />
              </ui:FormField>
              <ui:FormField Label="Default router" IsVisible="{Binding IsIpv4Static}">
                <TextBox Text="{Binding Ipv4Gateway}" PlaceholderText="192.168.0.1" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- IPv6 -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="IPv6" />
            <StackPanel Classes="form">
              <ui:FormField Label="Configuration">
                <ComboBox ItemsSource="{Binding Ipv6Choices}" SelectedItem="{Binding SelectedIpv6}" />
              </ui:FormField>
              <ui:FormField Label="IP address" IsVisible="{Binding ShowIpv6Address}">
                <TextBox Text="{Binding Ipv6Address}" PlaceholderText="2001:db8::10" />
              </ui:FormField>
              <ui:FormField Label="Prefix length" IsVisible="{Binding IsIpv6Static}">
                <TextBox Text="{Binding Ipv6Prefix}" PlaceholderText="64" />
              </ui:FormField>
              <ui:FormField Label="Default router" IsVisible="{Binding IsIpv6Static}">
                <TextBox Text="{Binding Ipv6Gateway}" PlaceholderText="fe80::1 (optional)" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- DNS -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="DNS" />
            <StackPanel Classes="form">
              <ui:FormField Label="Configuration">
                <ComboBox ItemsSource="{Binding DnsChoices}" SelectedItem="{Binding SelectedDns}" />
              </ui:FormField>
              <ui:FormField Label="Primary DNS server" IsVisible="{Binding IsDnsStatic}">
                <TextBox Text="{Binding DnsPrimary}" PlaceholderText="192.168.0.1" />
              </ui:FormField>
              <ui:FormField Label="Secondary DNS server" IsVisible="{Binding IsDnsStatic}">
                <TextBox Text="{Binding DnsSecondary}" PlaceholderText="optional" />
              </ui:FormField>
              <ui:FormField Label="Domain name" IsVisible="{Binding IsDnsStatic}">
                <TextBox Text="{Binding DnsDomain}" PlaceholderText="example.com (optional)" />
              </ui:FormField>
              <ui:FormField Label="Search domains" IsVisible="{Binding IsDnsStatic}">
                <TextBox Text="{Binding DnsSearch}" PlaceholderText="comma separated (optional)" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Host name -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="Host name" />
            <StackPanel Classes="form">
              <ui:FormField Label="Configuration">
                <ComboBox ItemsSource="{Binding HostNameChoices}" SelectedItem="{Binding SelectedHostName}" />
              </ui:FormField>
              <ui:FormField Label="{Binding HostNameLabel}" Hint="{Binding HostNameHint}" IsVisible="{Binding IsHostNameStatic}">
                <TextBox Text="{Binding HostNameText}" PlaceholderText="axis-camera" />
              </ui:FormField>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" IsDefault="True"
              ToolTip.Tip="{Binding ApplyBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
