<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Network.Client"
        x:Class="Oadm.Plugins.Network.Client.NetworkSettingsWindow"
        x:DataType="vm:NetworkSettingsViewModel"
        Title="{Binding Title}"
        Width="820" Height="800" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Layout of the add devices wizard: title bar, cards, button row. Shared controls and theme classes only.
       Every section card: title, "Configuration" choice, then the fields of a static setting. Field errors appear
       below their input (INotifyDataErrorInfo), row errors in the Devices table; risky changes are confirmed on Apply. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,0" Spacing="{DynamicResource Oadm.Gap}">
        <!-- Devices: per-device new IPv4 / IPv6 addresses and host names (several devices) -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Classes="flush" Title="Devices" Description="{Binding DevicesDescription}" />
            <Panel Margin="{DynamicResource Oadm.GapTop}" IsVisible="{Binding ShowPreview}">
              <vm:AddressAssignmentGrid DataContext="{Binding Assignment}" />
            </Panel>
          </StackPanel>
        </Border>

        <!-- IPv4 -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="IPv4" />
            <StackPanel Classes="form">
              <Grid ColumnDefinitions="150,280">
                <TextBlock Classes="fieldLabel" Text="Configuration" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Ipv4Choices}" SelectedItem="{Binding SelectedIpv4}" />
              </Grid>
              <Grid ColumnDefinitions="150,280" IsVisible="{Binding ShowIpv4Address}">
                <TextBlock Classes="fieldLabel" Text="IP address" />
                <TextBox Grid.Column="1" Text="{Binding Ipv4Address}" PlaceholderText="192.168.0.90" />
              </Grid>
              <Grid Classes="form" ColumnDefinitions="150,280" RowDefinitions="Auto,Auto" IsVisible="{Binding IsIpv4Static}">
                <TextBlock Classes="fieldLabel" Text="Subnet mask" />
                <TextBox Grid.Column="1" Text="{Binding Ipv4Mask}" PlaceholderText="255.255.255.0 or 24" />
                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Default gateway" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ipv4Gateway}" PlaceholderText="192.168.0.1" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- IPv6 -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="IPv6" />
            <StackPanel Classes="form">
              <Grid ColumnDefinitions="150,280">
                <TextBlock Classes="fieldLabel" Text="Configuration" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Ipv6Choices}" SelectedItem="{Binding SelectedIpv6}" />
              </Grid>
              <Grid ColumnDefinitions="150,280" IsVisible="{Binding ShowIpv6Address}">
                <TextBlock Classes="fieldLabel" Text="IP address" />
                <TextBox Grid.Column="1" Text="{Binding Ipv6Address}" PlaceholderText="2001:db8::10" />
              </Grid>
              <Grid Classes="form" ColumnDefinitions="150,280" RowDefinitions="Auto,Auto" IsVisible="{Binding IsIpv6Static}">
                <TextBlock Classes="fieldLabel" Text="Prefix length" />
                <TextBox Grid.Column="1" Text="{Binding Ipv6Prefix}" PlaceholderText="64" />
                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Default gateway" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ipv6Gateway}" PlaceholderText="fe80::1 (optional)" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- DNS -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="DNS" />
            <StackPanel Classes="form">
              <Grid ColumnDefinitions="150,280">
                <TextBlock Classes="fieldLabel" Text="Configuration" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DnsChoices}" SelectedItem="{Binding SelectedDns}" />
              </Grid>
              <Grid Classes="form" ColumnDefinitions="150,280" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding IsDnsStatic}">
                <TextBlock Classes="fieldLabel" Text="Primary DNS server" />
                <TextBox Grid.Column="1" Text="{Binding DnsPrimary}" PlaceholderText="192.168.0.1" />
                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Secondary DNS server" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DnsSecondary}" PlaceholderText="optional" />
                <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Domain name" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DnsDomain}" PlaceholderText="example.com (optional)" />
                <TextBlock Grid.Row="3" Classes="fieldLabel" Text="Search domains" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DnsSearch}" PlaceholderText="comma separated (optional)" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Host name -->
        <Border Classes="card">
          <StackPanel>
            <ui:CardHeader Title="Host name" />
            <StackPanel Classes="form">
              <Grid ColumnDefinitions="150,280">
                <TextBlock Classes="fieldLabel" Text="Configuration" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding HostNameChoices}" SelectedItem="{Binding SelectedHostName}" />
              </Grid>
              <Grid ColumnDefinitions="150,280" IsVisible="{Binding IsHostNameStatic}">
                <TextBlock Classes="fieldLabel" Text="{Binding HostNameLabel}" />
                <TextBox Grid.Column="1" Text="{Binding HostNameText}" PlaceholderText="axis-camera" />
              </Grid>
              <TextBlock Classes="secondary small" Text="{Binding HostNameHint}" TextWrapping="Wrap">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsHostNameStatic" />
                    <Binding Path="IsMultiDevice" />
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" IsDefault="True"
              ToolTip.Tip="{Binding ApplyBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
