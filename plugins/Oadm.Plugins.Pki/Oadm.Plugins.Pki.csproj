<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Oadm.Plugins.Pki.Server</AssemblyName>
    <RootNamespace>Oadm.Plugins.Pki</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Folder name under artifacts/plugins/, must equal the id in plugin.json. -->
    <OadmPluginId>oadm.pki</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host: never copy it (or its dependencies) into the plugin folder. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- TLS of EAP-TLS for the 802.1X server (non-blocking TlsServerProtocol, alerts, key export). The server ships the same
         version (Oadm.Sites): compiled against it, never copied into the plugin folder; the plugin load context falls back to
         the host's copy. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The source-available licenses of the EST server (Est/) and the 802.1X server (Radius/), next to their parts. -->
    <None Update="Est\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Radius\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Axis device ID CA certificates (roots and intermediates) as Axis publishes them: the list of CAs, EST and 802.1X. -->
    <EmbeddedResource Include="..\Shared\DeviceId\*.pem" LogicalName="Oadm.Plugins.Shared.DeviceId.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CachedApiCheck.cs" Link="Common\CachedApiCheck.cs" />
    <Compile Include="..\Shared\ViewerScopes.cs" Link="Common\ViewerScopes.cs" />
    <Compile Include="..\Shared\DeviceClock\CameraClock.cs" Link="Common\CameraClock.cs" />
    <Compile Include="..\Shared\DeviceId\AxisDeviceId.cs" Link="Common\AxisDeviceId.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Plugins.Pki.Tests" />
    <InternalsVisibleTo Include="Oadm.Plugins.Est.Tests" />
    <InternalsVisibleTo Include="Oadm.Plugins.Radius.Tests" />
    <InternalsVisibleTo Include="Oadm.Plugins.Pki.Client" />
  </ItemGroup>

  <!-- Development deployment: copy the output to artifacts/plugins/oadm.pki/.
       The client part (Oadm.Plugins.Pki.Client) deploys into the same folder. The EST server (Est/) and the 802.1X server
       (Radius/) are part of this package (docs/spec/pki.md "One plugin"). -->
  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OADM plugin $(OadmPluginId) deployed to $(OadmPluginOutputDir)" />
  </Target>

</Project>
