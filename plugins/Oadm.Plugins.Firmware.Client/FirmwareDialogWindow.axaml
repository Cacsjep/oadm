<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:fw="using:Oadm.Plugins.Firmware.Client"
        xmlns:fws="using:Oadm.Plugins.Firmware"
        x:Class="Oadm.Plugins.Firmware.Client.FirmwareDialogWindow"
        x:DataType="fw:FirmwareDialogViewModel"
        Title="{Binding Title}"
        Width="1200" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- Title bar, the devices with the firmware each installs, the options in one row, the button row.
       Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <!-- Devices: one table, the version from axis.com or a chosen file per device -->
    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <!-- Right in the header: the select that sets every device (signed in, versions arrived) or Sign in to MyAxis -->
        <ui:CardHeader Title="Devices">
          <ComboBox Width="200" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" PlaceholderText="{x:Static fw:FirmwareDialogViewModel.SetVersionsText}"
                    IsVisible="{Binding ShowRules}" IsEnabled="{Binding !IsBusy}" />
          <ui:ToolbarButton IconKey="user" Text="Sign in to MyAxis" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" />
        </ui:CardHeader>
        <StackPanel Grid.Row="2">
          <ui:ProgressRow Margin="0,0,0,8" Value="{Binding LookupProgress}" Text="{Binding LookupStatus}" IsVisible="{Binding IsLookingUp}" />
          <TextBlock Classes="warning" Margin="0,0,0,8" Text="{x:Static fws:OnlineFirmware.UnreachableText}" IsVisible="{Binding OnlineUnreachable}" />
        </StackPanel>
        <DataGrid x:Name="DevicesGrid" Grid.Row="3" Classes="wrapRows" ItemsSource="{Binding Devices}" IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Width="120" Binding="{Binding Address}" x:DataType="fw:FirmwareDeviceRow" />
            <DataGridTextColumn Header="Model" Width="130" Binding="{Binding Model}" x:DataType="fw:FirmwareDeviceRow" />
            <DataGridTemplateColumn Header="Firmware" Width="110" SortMemberPath="CurrentVersion">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="fw:FirmwareDeviceRow">
                  <Panel>
                    <ui:StatusChip IsAccent="True" Text="Reading" IsVisible="{Binding IsReadingStatus}" />
                    <TextBlock Text="{Binding CurrentVersion}" IsVisible="{Binding !IsReadingStatus}" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Version" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="fw:FirmwareDeviceRow">
                  <ComboBox Classes="grouped" Margin="6,4" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" PlaceholderText="Choose file" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Result" Width="160" SortMemberPath="VerdictText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="fw:FirmwareDeviceRow">
                  <ui:StatusChip Margin="10,0" Text="{Binding VerdictText}" IsOk="{Binding IsOk}" IsWarning="{Binding IsWarn}" IsError="{Binding IsError}" ToolTip.Tip="{Binding Message}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- The reason is the important part: the widest column, two lines -->
            <DataGridTemplateColumn Header="Details" Width="*" SortMemberPath="Message">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="fw:FirmwareDeviceRow">
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxLines="2" Margin="10,6" ToolTip.Tip="{Binding Message}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- Judging or setting 100,000 devices: the ring over the table from the first moment -->
        <ui:LoadingOverlay Grid.Row="3" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" />
        <!-- A problem of the whole file choice, directly below the table -->
        <TextBlock Grid.Row="4" Classes="error" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding FileError}" IsVisible="{Binding HasFileError}" />
        <TextBlock Grid.Row="5" Classes="warning" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding PathWarning}" IsVisible="{Binding HasPathWarning}" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasBreakingChanges}">
          <TextBlock Classes="warning" VerticalAlignment="Center" Text="{Binding BreakingChangesNotice}" />
          <Button Classes="link" VerticalAlignment="Center" Content="Read the Axis guide before upgrading" Command="{Binding OpenBreakingChangesCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Options in one row -->
    <Border Grid.Row="2" Classes="card" Margin="16,16,16,0">
      <StackPanel Classes="form">
        <StackPanel Orientation="Horizontal" Spacing="24">
          <ui:FormField Label="Factory default" LabelWidth="NaN" InputWidth="360" IsVisible="{Binding MayFactoryDefault}">
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
          </ui:FormField>
          <CheckBox VerticalAlignment="Center" IsChecked="{Binding AllowDowngrade}" Content="Allow downgrade (requires a factory default)" IsVisible="{Binding MayDowngrade}" />
        </StackPanel>
        <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding ModeWarning}" IsVisible="{Binding HasModeWarning}" />
        <ui:ProgressRow Value="{Binding UploadProgress}" Text="{Binding UploadText}" IsVisible="{Binding IsUploading}" />
        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="3" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Upgrade" Command="{Binding StartCommand}" IsDefault="True"
              ToolTip.Tip="{Binding StartBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
