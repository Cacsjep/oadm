<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Vision.Client"
        x:Class="Oadm.Plugins.Vision.Client.ModelSettingsWindow"
        x:DataType="vm:ModelSettingsViewModel"
        Title="{x:Static vm:ModelSettingsViewModel.Title}"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- A model's Settings: one operation, no card; the errors and the server's refusals below their fields. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static vm:ModelSettingsViewModel.Title}" />
    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <ui:FormField Classes="wide" LabelAbove="True" Label="Format">
          <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" />
        </ui:FormField>
        <ui:FormField Classes="wide" LabelAbove="True" Label="Fit">
          <ComboBox x:Name="FitBox" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ModelSettingsViewModel.Fits}" SelectedItem="{Binding Fit}" />
        </ui:FormField>
        <ui:FormField Classes="wide" LabelAbove="True" Label="Scaling">
          <ComboBox x:Name="ScalingBox" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ModelSettingsViewModel.Scalings}" SelectedItem="{Binding Scaling}" />
        </ui:FormField>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding CanSize}">
          <ui:FormField Classes="wide" LabelAbove="True" Label="Input width">
            <TextBox x:Name="WidthBox" Text="{Binding InputWidth}" />
          </ui:FormField>
          <ui:FormField Grid.Column="1" Classes="wide" LabelAbove="True" Label="Input height">
            <TextBox x:Name="HeightBox" Text="{Binding InputHeight}" />
          </ui:FormField>
        </Grid>
      </StackPanel>
    </Border>
    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Save" Command="{Binding OkCommand}" ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
