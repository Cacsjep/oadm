<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.DhcpServer.Client"
        x:Class="Oadm.Plugins.DhcpServer.Client.StaticLeaseWindow"
        x:DataType="vm:StaticLeaseDialogViewModel"
        Title="{Binding Title}"
        Width="640" Height="400" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Title bar, one card (form), footer. Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <StackPanel Classes="form">
        <ui:FormField Label="MAC address" Hint="The device's MAC address (on AXIS devices the serial number).">
          <TextBox Text="{Binding Mac}" PlaceholderText="e.g. B8:A4:4F:63:13:39" />
        </ui:FormField>
        <ui:FormField Label="IP address" Hint="{Binding SubnetHint}">
          <TextBox Text="{Binding Address}" PlaceholderText="e.g. 10.0.0.48" />
        </ui:FormField>
        <ui:FormField Label="Name" Hint="Optional, e.g. the camera's location.">
          <TextBox Text="{Binding Name}" PlaceholderText="Optional" />
        </ui:FormField>
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
