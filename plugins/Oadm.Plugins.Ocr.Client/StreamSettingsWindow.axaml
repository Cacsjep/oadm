<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Ocr.Client"
        xmlns:api="using:Oadm.Plugins.Ocr.Api"
        x:Class="Oadm.Plugins.Ocr.Client.StreamSettingsWindow"
        x:DataType="vm:StreamSettingsViewModel"
        Title="{x:Static vm:StreamSettingsViewModel.Title}"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- Single operation (docs/spec/ocr.md "Page"): no card; the server's refusal of a field below it. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static vm:StreamSettingsViewModel.Title}" />
    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <ui:FormField Classes="wide" LabelAbove="True" Label="Video source">
          <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" ItemsSource="{Binding VideoSources}" SelectedItem="{Binding SelectedSource}"
                    IsEnabled="{Binding !IsLoading}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="api:CameraSource">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:FormField>
        <ui:FormField Classes="wide" LabelAbove="True" Label="Resolution">
          <ComboBox x:Name="ResolutionBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                    IsEnabled="{Binding !IsLoading}" />
        </ui:FormField>
        <ui:FormField Classes="wide" LabelAbove="True" Label="Frames per second" IsVisible="{Binding ShowFps}">
          <ComboBox x:Name="FpsBox" HorizontalAlignment="Stretch" ItemsSource="{Binding FpsChoices}" SelectedItem="{Binding Fps}" />
        </ui:FormField>
      </StackPanel>
    </Border>
    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="OK" Command="{Binding OkCommand}" />
    </ui:DialogFooter>
  </Grid>
</Window>
