<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Ocr.Client"
             xmlns:api="using:Oadm.Plugins.Ocr.Api"
             x:Class="Oadm.Plugins.Ocr.Client.OcrView"
             x:DataType="vm:OcrViewModel"
             ui:PageHeader.Subtitle="Reads text in camera pictures for the event rules.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), docs/spec/ocr.md "Page": left the readers in a fixed column (New, red Delete,
       search, the list, Runs on and Use the graphics card, the runtime stats below it); then the selected reader in two
       columns: the camera's live video with the areas and the found lines over it (drawing, moving and resizing areas happen
       there), the mode, the latest reading and the results below it; right of it a fixed column with the form, the areas
       (Draw area in their header) and the save status left of Save. Shared controls and theme classes only. -->
  <Grid x:Name="Panes" ColumnDefinitions="320,*" ColumnSpacing="16">

    <!-- Left: the readers. -->
    <Border Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="cardTitle" Text="Readers" VerticalAlignment="Center" Margin="0,0,2,0" />
          <ui:ToolbarOverflowPanel Grid.Column="1" Spacing="4" IsVisible="{Binding MayChange}">
            <ui:ToolbarButton IconKey="add" Text="New" Command="{Binding NewCommand}" ToolTip.Tip="Start from a camera" />
            <ui:ToolbarSeparator />
            <ui:ToolbarButton Classes="danger" IconKey="remove" Text="Delete" Command="{Binding DeleteCommand}" />
          </ui:ToolbarOverflowPanel>
        </Grid>
        <ui:SearchBox Grid.Row="1" Classes="stretch" Text="{Binding SearchText}" Placeholder="Search readers" />

        <Panel Grid.Row="2">
          <!-- At most 50 readers, virtualized all the same; the selection follows the reader on the right. -->
          <ListBox x:Name="ReaderList" Classes="deviceTree" ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReaderRow">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ui:StatusChip Grid.Column="1" Text="{Binding ModeText}" IsOk="{Binding IsKeepingUp}" IsWarning="{Binding IsSlowWatching}" IsError="{Binding IsProblem}" ToolTip.Tip="{Binding Problem}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secondary" Text="{Binding Camera}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="mono" Text="{Binding LastText}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ui:ProgressRing Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
          <TextBlock Classes="secondary" Text="{x:Static vm:OcrViewModel.NoMatchText}" TextWrapping="Wrap" IsVisible="{Binding ShowNoMatch}" />
          <TextBlock Classes="error" VerticalAlignment="Bottom" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        </Panel>

        <StackPanel Grid.Row="3" Spacing="16">
          <!-- What reads the pictures (docs/spec/ocr.md "GPU"). -->
          <StackPanel Spacing="4" IsVisible="{Binding RunsOnText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="cardTitle subsection" Text="Settings" />
            <TextBlock Classes="secondary" Text="{Binding RunsOnText}" TextWrapping="Wrap" />
            <CheckBox Content="Use the graphics card" IsChecked="{Binding UseGpu}" IsEnabled="{Binding CanSetGpu}"
                      ToolTip.Tip="{Binding GpuBlockedReason}" ToolTip.ShowOnDisabled="True" />
          </StackPanel>

          <!-- How the recognition keeps up (docs/spec/ocr.md "Runtime stats"), live every 2 s. -->
          <StackPanel x:Name="StatsPanel" DataContext="{Binding Stats}" x:DataType="vm:OcrStatsViewModel" Spacing="8" IsVisible="{Binding HasStats}">
            <TextBlock Classes="cardTitle subsection" Text="Recognition" />
            <ui:StatusChip HorizontalAlignment="Left" MaxLines="2" Text="{Binding StateText}" IsOk="{Binding IsOk}" IsWarning="{Binding IsBusy}"
                           IsError="{Binding IsOverloaded}" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Classes="secondary" Text="Load" VerticalAlignment="Center" />
              <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Load}" />
              <TextBlock Grid.Column="2" Text="{Binding LoadText}" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
              <TextBlock Grid.Row="0" Classes="secondary" Text="Pictures per second" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PicturesText}" />
              <TextBlock Grid.Row="1" Classes="secondary" Text="Reading time" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReadTimeText}" />
              <TextBlock Grid.Row="2" Classes="secondary" Text="Readers watching" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WatchingText}" />
              <TextBlock Grid.Row="3" Classes="secondary" Text="Live previews" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewsText}" />
              <TextBlock Grid.Row="4" Classes="secondary" Text="Camera streams" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StreamsText}" />
              <!-- The streams per site (a few sites at most). -->
              <ItemsControl Grid.Row="5" Grid.ColumnSpan="2" ItemsSource="{Binding Sites}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SiteRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                      <TextBlock Classes="secondary" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Streams}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Row="6" Classes="secondary" Text="Server CPU" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CpuText}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Right: the selected reader. -->
    <Border Grid.Column="1" Classes="card">
      <Panel>
        <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static vm:OcrViewModel.EmptyText}"
                   IsVisible="{Binding ShowEmpty}" />
        <ui:ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsOpening}" />

        <Grid x:Name="EditorPanel" DataContext="{Binding Editor}" x:DataType="vm:ReaderEditorViewModel"
              IsVisible="{Binding $parent[UserControl].((vm:OcrViewModel)DataContext).HasEditor, FallbackValue=False}"
              ColumnDefinitions="*,320" ColumnSpacing="16">

          <!-- The live video with the areas and the lines over it; the mode, the latest reading, its note and the results below it. -->
          <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <Panel x:Name="VideoPanel">
              <Border Classes="liveViewSurface" />
              <ContentControl x:Name="VideoHost" Content="{Binding VideoView}" IsVisible="{Binding HasLiveVideo}" />
              <vm:ReadingPicture x:Name="Picture" PictureSize="{Binding PictureSize}" Areas="{Binding Areas}" Lines="{Binding ShownLines}"
                                 IsDrawing="{Binding IsDrawing}" ShowStartHint="{Binding ShowStartHint}" CanEdit="{Binding MayChange}"
                                 Version="{Binding OverlayVersion}" />
            </Panel>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <ui:StatusChip Text="{Binding ModeChipText}" IsOk="{Binding IsModeOk}" IsError="{Binding IsModeError}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding PictureText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ui:StatusChip Grid.Row="2" HorizontalAlignment="Left" MaxLines="2" IsWarning="True" Text="{Binding ReadingNote}" IsVisible="{Binding HasReadingNote}" />

            <!-- The results of the latest reading, one row per area, below the video. -->
            <Panel Grid.Row="3">
              <DataGrid x:Name="ResultsGrid" Classes="wrapRows" ItemsSource="{Binding Results}" IsReadOnly="True" CanUserSortColumns="False"
                        CanUserReorderColumns="False" CanUserResizeColumns="True" SelectionMode="Single" VerticalAlignment="Top"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Area" Width="1*" MinWidth="70" Binding="{Binding Area}" x:DataType="vm:ResultRow" />
                  <DataGridTemplateColumn Header="Text" Width="2*" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ResultRow">
                        <StackPanel Spacing="4" Margin="0,4" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="{Binding CutOut}" Height="28" MaxWidth="160" Stretch="Uniform" IsVisible="{Binding HasCutOut}"
                                   VerticalAlignment="Center" />
                            <TextBlock Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </StackPanel>
                          <ui:StatusChip Text="{x:Static vm:ResultRow.TooSmallText}" IsWarning="True" MaxLines="2" IsVisible="{Binding TooSmall}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Width="120" MinWidth="115" Binding="{Binding ConfidenceText}" CellStyleClasses="number" x:DataType="vm:ResultRow">
                    <DataGridTextColumn.Header>
                      <TextBlock Classes="numberHeader" Text="Confidence" />
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="Matches format" Width="140" MinWidth="135">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ResultRow">
                        <Panel>
                          <ui:StatusChip Text="{Binding MatchText}" IsOk="{Binding IsMatch}" IsWarning="{Binding IsNoMatch}" IsVisible="{Binding HasFormat}" />
                          <TextBlock Classes="secondary" Text="{Binding MatchText}" VerticalAlignment="Center" IsVisible="{Binding !HasFormat}" />
                        </Panel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Time" Width="85" MinWidth="85" Binding="{Binding Time}" x:DataType="vm:ResultRow" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" TextWrapping="Wrap"
                         Text="{Binding ResultsEmptyText}" IsVisible="{Binding !HasResults}" />
            </Panel>
          </Grid>

          <!-- Everything else, stacked; the save status and Save at the bottom. -->
          <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
            <ScrollViewer Grid.Row="0">
              <StackPanel Spacing="16" Margin="0,0,10,0">

                <!-- The form. -->
                <StackPanel Spacing="8" IsEnabled="{Binding MayChange}">
                  <ui:FormField Classes="wide" LabelAbove="True" Label="Name">
                    <TextBox Text="{Binding Name}" MaxLength="{x:Static vm:AreaViewModel.MaxNameLength}" />
                  </ui:FormField>
                  <ui:FormField Classes="wide" LabelAbove="True" Label="Camera" Error="{Binding CameraError}">
                    <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ChooseCameraCommand}"
                            ToolTip.Tip="Find a camera by address or model">
                      <ui:IconLabel Icon="{DynamicResource Icon.devices}" Text="{Binding CameraText}" />
                    </Button>
                  </ui:FormField>
                  <ui:FormField Classes="wide" LabelAbove="True" Label="Video source">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding VideoSources}" SelectedItem="{Binding SelectedSource}"
                              IsEnabled="{Binding !IsLoadingCamera}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="api:CameraSource">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </ui:FormField>
                  <ui:FormField Classes="wide" LabelAbove="True" Label="Resolution">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                              IsEnabled="{Binding !IsLoadingCamera}" />
                  </ui:FormField>
                  <ui:FormField Classes="wide" LabelAbove="True" Label="Mode" Error="{Binding ModeError}">
                    <StackPanel Classes="inputRow">
                      <RadioButton Content="Watching" IsChecked="{Binding IsWatching}" />
                      <RadioButton Content="On action" IsChecked="{Binding IsOnAction}" />
                    </StackPanel>
                  </ui:FormField>
                  <ui:FormField Classes="wide" LabelAbove="True" Label="Frames per second" IsVisible="{Binding IsWatching}">
                    <ComboBox x:Name="FpsBox" HorizontalAlignment="Stretch" ItemsSource="{Binding FpsChoices}" SelectedItem="{Binding Fps}" />
                  </ui:FormField>
                </StackPanel>

                <!-- The areas: Draw area and the count in the header. -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="cardTitle subsection" Text="Areas" VerticalAlignment="Center" />
                    <ui:ToolbarButton Grid.Column="1" x:Name="DrawAreaButton" IconKey="focusArea" Text="Draw area" HorizontalAlignment="Left"
                                      Command="{Binding DrawAreaCommand}" IsVisible="{Binding MayChange}"
                                      ToolTip.Tip="{Binding DrawBlockedReason}" ToolTip.ShowOnDisabled="True" />
                    <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding AreaCountText}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Classes="secondary" Text="{x:Static vm:ReaderEditorViewModel.NoAreasText}" TextWrapping="Wrap" IsVisible="{Binding !HasAreas}" />
                  <!-- At most 8 areas. -->
                  <ItemsControl x:Name="AreaList" ItemsSource="{Binding Areas}" IsVisible="{Binding HasAreas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AreaViewModel">
                        <StackPanel Spacing="6" Margin="0,0,0,14" IsEnabled="{Binding $parent[UserControl].((vm:OcrViewModel)DataContext).MayChange}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <ui:FormField Classes="wide" LabelAbove="True" Label="Name">
                              <TextBox Text="{Binding Name}" MaxLength="{x:Static vm:AreaViewModel.MaxNameLength}" />
                            </ui:FormField>
                            <Button Grid.Column="1" Classes="toolbar iconOnly" VerticalAlignment="Bottom" ToolTip.Tip="Delete area" CommandParameter="{Binding}"
                                    Command="{Binding $parent[ItemsControl].((vm:ReaderEditorViewModel)DataContext).RemoveAreaCommand}">
                              <ui:OadmIcon Data="{DynamicResource Icon.remove}" />
                            </Button>
                          </Grid>
                          <StackPanel Classes="inputRow">
                            <RadioButton Content="Any text" IsChecked="{Binding IsAnyText}" />
                            <RadioButton Content="Format" IsChecked="{Binding IsFormat}" />
                          </StackPanel>
                          <ui:FormField Classes="wide" LabelAbove="True" Label="Format" Hint="{x:Static vm:AreaViewModel.FormatHint}" IsVisible="{Binding IsFormat}">
                            <TextBox Classes="mono" Text="{Binding FormatText}" PlaceholderText="AAAU ###### #" MaxLength="{x:Static vm:AreaViewModel.MaxFormatLength}" />
                          </ui:FormField>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <!-- The save status directly left of Save. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding MayChange}">
              <ui:StatusChip Grid.Column="1" VerticalAlignment="Center" Text="{Binding SaveStatus}" IsOk="{Binding IsSaveStatusOk}"
                             IsWarning="{Binding !IsSaveStatusOk}" IsVisible="{Binding HasSaveStatus}" />
              <Button Grid.Column="2" Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                      ToolTip.Tip="{Binding SaveBlockedReason}" ToolTip.ShowOnDisabled="True" />
            </Grid>
          </Grid>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
