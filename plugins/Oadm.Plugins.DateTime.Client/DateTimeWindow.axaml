<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.DateAndTime.Client"
        xmlns:m="using:Oadm.Plugins.DateAndTime.Model"
        x:Class="Oadm.Plugins.DateAndTime.Client.DateTimeWindow"
        x:DataType="vm:DateTimeDialogViewModel"
        Title="{Binding Title}"
        Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Compact clone of the ADM "Set date and time" dialog, one column: Device time, Time zone, Time mode (each radio
       button with its input below it; inputs of the other modes are disabled). Like ADM, OK always writes the time
       zone and the time mode. Single operation: title bar, Border.dialogBody, footer. Every error below its field. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <!-- Device time: the first selected device, read-only, ticking -->
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="sectionTitle" Text="Device time" VerticalAlignment="Bottom" />
          <TextBlock Classes="secondary" Text="{Binding DeviceLabel}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Text="{Binding DeviceTimeText}" IsVisible="{Binding HasDeviceTime}" />
        <ui:StatusChip Text="{Binding DeviceTimeStatus}" IsAccent="{Binding IsLoading}" IsError="{Binding DeviceTimeFailed}" MaxLines="2"
                       IsVisible="{Binding HasDeviceTimeStatus}" />

        <!-- Time zone -->
        <TextBlock Classes="sectionTitle subsection" Text="Time zone" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                  PlaceholderText="Choose a time zone" IsEnabled="{Binding CanEditTimeZone}"
                  IsTextSearchEnabled="True" TextSearch.TextBinding="{Binding City, DataType=m:TimeZoneEntry}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:TimeZoneEntry">
              <TextBlock Text="{Binding ShortLabel}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="Automatically adjust for daylight saving time changes" IsChecked="{Binding AdjustForDst}" IsEnabled="{Binding CanAdjustDst}" />

        <!-- Time mode -->
        <TextBlock Classes="sectionTitle subsection" Text="Time mode" />
        <RadioButton GroupName="mode" Content="Synchronize with server computer time" IsChecked="{Binding IsServerTime}" />
        <StackPanel Classes="optionDetail" IsEnabled="{Binding IsServerTime}" IsVisible="{Binding HasServerTimeDetail}">
          <TextBlock Text="{Binding ServerTimeText}" IsVisible="{Binding HasServerTime}" />
          <TextBlock Classes="secondary small" Text="{Binding ServerTimeNote}" TextWrapping="Wrap"
                     IsVisible="{Binding ServerTimeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <RadioButton GroupName="mode" Content="Synchronize with NTP server" IsChecked="{Binding IsNtp}" />
        <StackPanel Classes="optionDetail" IsEnabled="{Binding IsNtp}">
          <CheckBox Content="Obtain from DHCP" IsChecked="{Binding UseDhcp}" IsEnabled="{Binding !UseNts}" />
          <TextBox Text="{Binding NtpServersText}" PlaceholderText="{Binding ServersPlaceholder}" IsEnabled="{Binding ShowServerList}" />
          <CheckBox Content="Use NTS (Network Time Security)" IsChecked="{Binding UseNts}" IsVisible="{Binding ShowNts}" />
          <TextBlock Classes="secondary small" Text="{Binding NtsHint}" TextWrapping="Wrap" IsVisible="{Binding HasNtsHint}" />
          <TextBlock Classes="secondary small" Text="{Binding NtpNote}" TextWrapping="Wrap"
                     IsVisible="{Binding NtpNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <RadioButton GroupName="mode" Content="Set manually" IsChecked="{Binding IsManual}" />
        <StackPanel Classes="optionDetail" IsEnabled="{Binding IsManual}">
          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ManualDate}" PlaceholderText="yyyy-mm-dd" VerticalAlignment="Top" />
            <TextBox Grid.Column="1" Text="{Binding ManualTime}" PlaceholderText="hh:mm:ss" VerticalAlignment="Top" />
            <Button Grid.Column="2" Classes="secondary" Content="Use this computer's time" Command="{Binding UseComputerTimeCommand}" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Classes="secondary small" Text="{Binding ManualNote}" TextWrapping="Wrap"
                     IsVisible="{Binding ManualNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="OK" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" IsDefault="True"
              ToolTip.Tip="{Binding ApplyBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
