<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.DateAndTime.Client"
        xmlns:m="using:Oadm.Plugins.DateAndTime.Model"
        x:Class="Oadm.Plugins.DateAndTime.Client.DateTimeWindow"
        x:DataType="vm:DateTimeDialogViewModel"
        Title="{Binding Title}"
        Width="2200" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Clone of the ADM / AXIS Camera Station "Set date and time" dialog: Device time, Time zone, Time mode.
       Like ADM, OK always writes the time zone and the time mode. Layout of the add devices page: title bar, cards,
       footer. Shared controls and theme classes only; every error directly below its field. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Oadm.Gap}" RowSpacing="{DynamicResource Oadm.Gap}" Margin="16,0">
      <!-- Device time: read-only facts of the first selected device as one compact strip, so Time mode fits below -->
      <Border Grid.ColumnSpan="2" Classes="card">
        <StackPanel Spacing="10">
          <ui:CardHeader Classes="flush" Title="Device time" Description="{Binding DeviceCardDescription}" />
          <ui:StatusChip Text="{Binding DeviceTimeStatus}" IsAccent="{Binding IsLoading}" IsError="{Binding DeviceTimeFailed}"
                         IsVisible="{Binding HasDeviceTimeStatus}" ToolTip.Tip="{Binding DeviceTimeStatus}" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="6" IsVisible="{Binding HasDeviceTime}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="Device time" />
              <TextBlock Text="{Binding DeviceTimeText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="Time zone" />
              <TextBlock Text="{Binding DeviceTimeZoneText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="Time mode" />
              <TextBlock Text="{Binding DeviceTimeModeText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="Server time" />
              <TextBlock Text="{Binding ServerTimeText}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{DynamicResource Oadm.Gap}">
          <!-- Time mode -->
          <Border Classes="card">
            <StackPanel>
              <ui:CardHeader Title="Time mode" Description="{Binding ModeDescription}" />
              <StackPanel Classes="form">
                <RadioButton GroupName="mode" Content="Synchronize with server computer time" IsChecked="{Binding IsServerTime}" />
                <RadioButton GroupName="mode" Content="Synchronize with NTP server" IsChecked="{Binding IsNtp}" />
                <Grid ColumnDefinitions="28,*" IsVisible="{Binding IsNtp}">
                  <StackPanel Grid.Column="1" Classes="form">
                    <RadioButton GroupName="ntpSource" Content="Obtain from DHCP" IsChecked="{Binding UseDhcp}" IsEnabled="{Binding !UseNts}" />
                    <RadioButton GroupName="ntpSource" Content="Use servers" IsChecked="{Binding UseServers}" />
                    <CheckBox Content="Use NTS (Network Time Security)" IsChecked="{Binding UseNts}" IsVisible="{Binding ShowNts}" />
                    <TextBlock Classes="secondary small" Text="{Binding NtsHint}" TextWrapping="Wrap" IsVisible="{Binding UseNts}" />
                    <ui:FormField Classes="wide" Label="{Binding ServersLabel}" IsVisible="{Binding ShowServerList}">
                      <TextBox Classes="multiline" Text="{Binding NtpServersText}"
                               PlaceholderText="One IP address or host name per line, up to 5" />
                    </ui:FormField>
                  </StackPanel>
                </Grid>
                <RadioButton GroupName="mode" Content="Set manually" IsChecked="{Binding IsManual}" />
                <Grid ColumnDefinitions="28,*" IsVisible="{Binding IsManual}">
                  <StackPanel Grid.Column="1" Classes="form">
                    <ui:FormField Classes="wide" Label="Date">
                      <TextBox Text="{Binding ManualDate}" PlaceholderText="yyyy-mm-dd" />
                    </ui:FormField>
                    <ui:FormField Classes="wide" Label="Time">
                      <TextBox Text="{Binding ManualTime}" PlaceholderText="hh:mm:ss" />
                    </ui:FormField>
                    <ui:FormField Classes="wide">
                      <Button Classes="secondary" Content="Use this computer's time" Command="{Binding UseComputerTimeCommand}" />
                    </ui:FormField>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="secondary small" Text="{Binding ModeNote}" TextWrapping="Wrap" IsVisible="{Binding HasModeNote}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Time zone: searchable IANA list -->
      <Border Grid.Row="1" Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
          <ui:CardHeader Title="Time zone" Description="{Binding TimeZoneDescription}" />
          <ui:SearchBox Grid.Row="1" Text="{Binding ZoneSearch}" Placeholder="Search time zones" IsEnabled="{Binding CanEditTimeZone}" HorizontalAlignment="Left" />
          <DataGrid Grid.Row="2" Margin="{DynamicResource Oadm.GapTop}" ItemsSource="{Binding FilteredZones}" SelectedItem="{Binding SelectedZone}"
                    SelectionMode="Single" IsReadOnly="True" CanUserReorderColumns="False" IsEnabled="{Binding CanEditTimeZone}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="UTC offset" Width="110" Binding="{Binding OffsetText}" x:DataType="m:TimeZoneEntry" />
              <DataGridTextColumn Header="City" Width="*" Binding="{Binding City}" x:DataType="m:TimeZoneEntry" />
              <DataGridTextColumn Header="Time zone" Width="*" Binding="{Binding Id}" x:DataType="m:TimeZoneEntry" />
              <DataGridTextColumn Header="DST" Width="70" Binding="{Binding DaylightSavingText}" x:DataType="m:TimeZoneEntry" />
            </DataGrid.Columns>
          </DataGrid>
          <!-- The time zone error directly below the list (the list itself has no inline error presenter) -->
          <TextBlock Grid.Row="3" Classes="fieldMessage error" Text="{Binding TimeZoneError}" IsVisible="{Binding HasTimeZoneError}" />
          <CheckBox Grid.Row="4" Margin="{DynamicResource Oadm.GapTop}" Content="Automatically adjust for daylight saving time changes"
                    IsChecked="{Binding AdjustForDst}" IsEnabled="{Binding CanAdjustDst}" />
        </Grid>
      </Border>
    </Grid>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="OK" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" IsDefault="True"
              ToolTip.Tip="{Binding ApplyBlockedReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
