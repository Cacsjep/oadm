<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.WebView.Client"
             x:Class="Oadm.Plugins.WebView.Client.WebViewPageView"
             x:DataType="vm:WebViewPageViewModel"
             ui:PageHeader.Subtitle="The web interface of the devices, logged in.">
  <!-- Own cards: the page select and the device tree on the left, the browser on the right (one row: Close all, Reload,
       Back, the tabs; then the page of the active tab, edge to edge). -->
  <Grid ColumnDefinitions="300,*" ColumnSpacing="8">

    <!-- The page the tabs open, then the devices grouped by tag; a click opens the device's tab -->
    <Border Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <!-- One block, so the hidden Custom field adds no gap -->
        <StackPanel Grid.Row="0" Spacing="8">
          <ComboBox ItemsSource="{x:Static vm:WebViewPageViewModel.Presets}" SelectedItem="{Binding SelectedPreset}"
                    HorizontalAlignment="Stretch" ToolTip.Tip="The page the tabs open" />
          <TextBox x:Name="CustomPathBox" Text="{Binding CustomPath}" IsVisible="{Binding IsCustom}"
                   PlaceholderText="{x:Static vm:WebViewTexts.CustomPathHint}" />
        </StackPanel>
        <ui:SearchBox Grid.Row="1" Classes="stretch" Text="{Binding SearchText}" Placeholder="Search devices" />
        <TextBlock Grid.Row="2" Classes="secondary" Text="{x:Static vm:WebViewTexts.NoDevices}" TextWrapping="Wrap"
                   IsVisible="{Binding !HasDevices}" />
        <ListBox x:Name="Tree" Grid.Row="2" Classes="deviceTree" ItemsSource="{Binding TreeRows}" SelectionMode="Single"
                 IsVisible="{Binding HasDevices}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:WebTreeGroup">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <ui:OadmIcon Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                             Data="{StaticResource Icon.chevronDown}" IsVisible="{Binding IsExpanded}" />
                <ui:OadmIcon Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                             Data="{StaticResource Icon.chevronRight}" IsVisible="{Binding !IsExpanded}" />
                <TextBlock Grid.Column="1" Classes="treeGroup" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
            <DataTemplate DataType="vm:WebTreeDevice">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,0,0">
                <ui:DeviceIcon Category="{Binding Category}" Status="{Binding Status}" ShowStatusToolTip="True" Width="16" Height="16" />
                <TextBlock Text="{Binding Address}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Grid>
    </Border>

    <!-- The browser: the page fills the card edge to edge -->
    <Border Grid.Column="1" Classes="card" Padding="0,12,0,20">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid Grid.Row="0" Margin="12,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="4">
          <Button Grid.Column="0" Classes="toolbar iconOnly" Command="{Binding CloseAllTabsCommand}" ToolTip.Tip="Close all tabs">
            <ui:OadmIcon Data="{StaticResource Icon.close}" />
          </Button>
          <Button Grid.Column="1" Classes="toolbar iconOnly" Command="{Binding ReloadCommand}" ToolTip.Tip="Reload">
            <ui:OadmIcon Data="{StaticResource Icon.refresh}" />
          </Button>
          <Button Grid.Column="2" Classes="toolbar iconOnly" Command="{Binding GoBackCommand}" ToolTip.Tip="Back">
            <ui:OadmIcon Data="{StaticResource Icon.chevronLeft}" />
          </Button>

          <!-- One row of tabs; scrolls sideways when they do not fit -->
          <ScrollViewer Grid.Column="3" Margin="8,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WebTab">
                  <Border Classes="browserTab" Classes.active="{Binding IsActive}" ToolTip.Tip="{Binding ToolTip}" PointerPressed="OnTabPressed">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Classes="toolbar iconOnly" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab" VerticalAlignment="Center">
                        <ui:OadmIcon Width="12" Height="12" Data="{StaticResource Icon.close}" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- The pages: the native browser of every tab stays alive, only the active one is shown -->
        <Panel Grid.Row="1">
          <ui:StatusChip IsError="True" Text="{Binding Runtime.Problem}" IsVisible="{Binding IsRuntimeMissing}" MaxLines="8"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
          <TextBlock Classes="secondary" Text="{x:Static vm:WebViewTexts.NoTabs}" IsVisible="{Binding ShowNoTabs}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Panel x:Name="Pages" />
        </Panel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
