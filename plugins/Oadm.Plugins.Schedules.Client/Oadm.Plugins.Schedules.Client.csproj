<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Oadm.Plugins.Schedules.Client</AssemblyName>
    <RootNamespace>Oadm.Plugins.Schedules.Client</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Same folder as the server part: artifacts/plugins/oadm.schedules/. -->
    <OadmPluginId>oadm.schedules</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia, CommunityToolkit.Mvvm and the SDKs are shared from the client host (PluginLoadContext.IsShared):
         compile against them, never copy them into the plugin folder. -->
    <PackageReference Include="Avalonia" Version="12.1.4" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\Oadm.Sdk.Client\Oadm.Sdk.Client.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- The contract models, the action kinds and the JSON options are shared with the server part (same plugin folder). -->
    <ProjectReference Include="..\Oadm.Plugins.Schedules\Oadm.Plugins.Schedules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Plugins.Schedules.Tests" />
  </ItemGroup>

  <!-- Step Then of the wizard is Provisioning's node editor (docs/spec/schedules.md "Actions"): the node view models, their
       fields and look, the file preview and the settings panel, linked from Provisioning's client part and compiled into
       this assembly (the node sources they use come with the server part); the backend through INodeFormServices. -->
  <ItemGroup>
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\NodeEditorViewModel.cs" Link="Provisioning\NodeEditorViewModel.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\NodeFields.cs" Link="Provisioning\NodeFields.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\NodeListFields.cs" Link="Provisioning\NodeListFields.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\NodeLook.cs" Link="Provisioning\NodeLook.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\ConfigPreview.cs" Link="Provisioning\ConfigPreview.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\ProvisioningTexts.cs" Link="Provisioning\ProvisioningTexts.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning.Client\NodeSettingsView.axaml.cs" Link="Provisioning\NodeSettingsView.axaml.cs" />
    <AvaloniaXaml Include="..\Oadm.Plugins.Provisioning.Client\NodeSettingsView.axaml" Link="Provisioning\NodeSettingsView.axaml" />
    <Compile Include="..\Shared\TimeZones.Client\TimeZoneChoice.cs" Link="Common\TimeZoneChoice.cs" />
  </ItemGroup>

  <!-- What the node editor reads beyond the server part's sources: the editor's contract records, the limits of the node
       kinds a schedule never offers (the fields are shared by every kind) and the time zones of the Date and time field. -->
  <ItemGroup>
    <Compile Include="..\Oadm.Plugins.Provisioning\NodeEditorContract.cs" Link="Provisioning\NodeEditorContract.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning\Nodes\DateTimeNode.cs" Link="Provisioning\Nodes\DateTimeNode.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning\Nodes\SdCardNode.cs" Link="Provisioning\Nodes\SdCardNode.cs" />
    <Compile Include="..\Oadm.Plugins.Provisioning\Nodes\UsersNode.cs" Link="Provisioning\Nodes\UsersNode.cs" />
    <Compile Include="..\Oadm.Plugins.DateTime\Model\TimeZoneCatalog.cs" Link="TimeZones\TimeZoneCatalog.cs" />
    <Compile Include="..\Oadm.Plugins.DateTime\Model\ZoneYear.cs" Link="TimeZones\ZoneYear.cs" />
    <EmbeddedResource Include="..\Oadm.Plugins.DateTime\Model\TimeZones.txt" Link="TimeZones\TimeZones.txt" LogicalName="Oadm.Plugins.DateAndTime.TimeZones.txt" />
  </ItemGroup>

  <!-- Development deployment next to the server part in artifacts/plugins/oadm.schedules/. -->
  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OADM client plugin $(OadmPluginId) deployed to $(OadmPluginOutputDir)" />
  </Target>

</Project>
