<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.DeviceTriggers.Client"
        xmlns:ev="using:Oadm.Plugins.DeviceEvents"
        x:Class="Oadm.Plugins.DeviceTriggers.Client.TriggerEditorWindow"
        x:DataType="vm:TriggerEditorViewModel"
        Title="{Binding Title}"
        Width="860" Height="860" MinHeight="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- Dialog header (title + X, no system title bar), then the cards trigger, devices, event in a scroll area, footer. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{DynamicResource Oadm.Gap}" Margin="16,0,16,8">

        <!-- Trigger: name and turned on in one row -->
        <Border Classes="card">
          <StackPanel Orientation="Horizontal" Spacing="24">
            <ui:FormField Label="Name">
              <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="64" />
            </ui:FormField>
            <CheckBox Content="Turned on" IsChecked="{Binding Enabled}" VerticalAlignment="Top" />
          </StackPanel>
        </Border>

        <!-- Devices: thousands possible, virtualized; the event list of each chosen device is read live. -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <ui:CardHeader Grid.Column="0" Title="Devices" Description="{Binding DevicesSummary}" />
              <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Top" Command="{Binding ChooseDevicesCommand}">
                <ui:IconLabel Icon="{StaticResource Icon.devices}" Text="{Binding DevicesButtonText}" />
              </Button>
            </Grid>
            <ui:ProgressRow Value="{Binding ReadProgress}" Text="{Binding ReadText}" IsActive="{Binding IsReading}" IsVisible="{Binding ShowReadProgress}" />
            <DataGrid x:Name="DeviceGrid" Height="240" Classes="wrapRows" ItemsSource="{Binding VisibleDevices}" IsReadOnly="True" SelectionMode="Single"
                      CanUserSortColumns="False" CanUserReorderColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Width="140" Binding="{Binding Address}" x:DataType="vm:TriggerDeviceChoice" />
                <DataGridTextColumn Header="Model" Width="150" Binding="{Binding Model}" x:DataType="vm:TriggerDeviceChoice" />
                <DataGridTextColumn Header="Included by" Width="140" Binding="{Binding IncludedBy}" x:DataType="vm:TriggerDeviceChoice" />
                <DataGridTemplateColumn Header="Events" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:TriggerDeviceChoice">
                      <ui:StatusChip Text="{Binding StatusText}" IsOk="{Binding IsOk}" IsAccent="{Binding IsAccent}" IsError="{Binding IsError}" IsWarning="{Binding IsWarning}" MaxLines="2"
                                     IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="secondary" Text="Choose devices to pick the devices of this trigger." IsVisible="{Binding HasNoDevices}" />
            <TextBlock Classes="error" Text="{Binding DevicesError}" IsVisible="{Binding DevicesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Event: what all chosen devices offer, narrowed per source item -->
        <Border Classes="card">
          <StackPanel Classes="form">
            <ui:FormField Classes="wide" Label="Event" Hint="{Binding EventKindText}" Error="{Binding EventError}">
              <ComboBox Classes="grouped" ItemsSource="{Binding EventChoices}" SelectedItem="{Binding SelectedEventChoice}" PlaceholderText="Choose an event"
                        MaxDropDownHeight="420" />
            </ui:FormField>
            <ItemsControl ItemsSource="{Binding Filters}" IsVisible="{Binding HasFilters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Classes="form" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ev:FilterRowViewModel">
                  <ui:FormField Label="{Binding Label}">
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" MinWidth="240" HorizontalAlignment="Left" />
                  </ui:FormField>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Classes="error" Text="{Binding ServerError}" IsVisible="{Binding HasServerError}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" IsDefault="True" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
              ToolTip.Tip="{Binding Problem}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
