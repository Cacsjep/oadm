<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.LicensePlates.Client"
             x:Class="Oadm.Plugins.LicensePlates.Client.StatsView"
             x:DataType="vm:StatsViewModel">
  <!-- The Stats tab (docs/spec/license-plate-center.md "Stats"): the camera choice and the time; four cards; the plate and the
       vehicle confidence per camera; the reads and the confidence over time with a legend per chart. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Border Grid.Row="0" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
        <ui:ToolbarButton x:Name="CameraChoiceButton" IconKey="devices" Text="{Binding CameraChoiceText}" Command="{Binding ChooseCamerasCommand}" />
        <ComboBox x:Name="RangeChoice" Grid.Column="1" Width="160" VerticalAlignment="Center" ItemsSource="{x:Static vm:StatsViewModel.RangeChoices}" SelectedItem="{Binding SelectedRange}" />
        <ui:ToolbarButton Grid.Column="2" IconKey="refresh" Text="{x:Static vm:PageTexts.Refresh}" Command="{Binding RefreshCommand}" />
        <TextBlock Grid.Column="3" Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <ScrollViewer x:Name="StatsScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasReads}">
        <StackPanel Spacing="12">
          <UniformGrid Rows="1" ColumnSpacing="12">
            <ui:StatCard x:Name="LastHourCard" IconKey="barChart" Title="{x:Static vm:PageTexts.LastHour}" Value="{Binding LastHourText}" />
            <ui:StatCard x:Name="Last24HoursCard" IconKey="barChart" Title="{x:Static vm:PageTexts.Last24Hours}" Value="{Binding Last24HoursText}" />
            <ui:StatCard x:Name="Last7DaysCard" IconKey="barChart" Title="{x:Static vm:PageTexts.Last7Days}" Value="{Binding Last7DaysText}" />
            <ui:StatCard x:Name="TotalCard" IconKey="barChart" Title="{x:Static vm:PageTexts.Total}" Value="{Binding TotalText}" />
          </UniformGrid>

          <!-- One bar per camera (the overall average of the chosen time), sideways when the cameras do not fit. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.PlateConfidence}" />
              <ui:BarChart x:Name="PlateChart" Height="260" Bars="{Binding PlateBars}" Unit="%" Maximum="100" MinSlotWidth="28" RotateLabels="True"
                           EmptyText="{x:Static vm:PageTexts.NoStats}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.VehicleConfidence}" />
              <ui:BarChart x:Name="VehicleChart" Height="260" Bars="{Binding VehicleBars}" Unit="%" Maximum="100" MinSlotWidth="28" RotateLabels="True"
                           IsVisible="{Binding HasVehicleConfidence}" />
              <TextBlock Classes="secondary" Text="{x:Static vm:PageTexts.NoVehicleConfidence}" IsVisible="{Binding !HasVehicleConfidence}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.ReadsOverTime}" />
              <TextBlock x:Name="ResultsLine" Classes="secondary" Text="{Binding ResultsText}" />
              <Grid ColumnDefinitions="*,220" ColumnSpacing="16" Height="260">
                <ui:LineChart x:Name="ReadsChart" Series="{Binding ReadSeries}" Start="{Binding ChartStart}" Step="{Binding ChartStep}" ShowLegend="False"
                              EmptyText="{x:Static vm:PageTexts.NoStats}" />
                <ui:ChartLegend x:Name="ReadsLegend" Grid.Column="1" Items="{Binding Legend}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.ConfidenceOverTime}" />
              <Grid ColumnDefinitions="*,220" ColumnSpacing="16" Height="260">
                <ui:LineChart x:Name="ConfidenceChart" Series="{Binding ConfidenceSeries}" Start="{Binding ChartStart}" Step="{Binding ChartStep}" Unit="%" Maximum="100"
                              ShowLegend="False" EmptyText="{x:Static vm:PageTexts.NoStats}" />
                <ui:ChartLegend x:Name="ConfidenceLegend" Grid.Column="1" Items="{Binding Legend}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EmptyText}" IsVisible="{Binding ShowEmpty}" />
      <ui:LoadingOverlay Text="{x:Static vm:PageTexts.ReadingStats}" IsVisible="{Binding IsLoading}" />
    </Panel>
  </Grid>
</UserControl>
