<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.LicensePlates.Client"
             xmlns:lp="using:Oadm.Plugins.LicensePlates"
             x:Class="Oadm.Plugins.LicensePlates.Client.StatsView"
             x:DataType="vm:StatsViewModel">
  <!-- The Stats tab (docs/spec/license-plate-center.md "Stats"): the camera choice and the time, the counts by result, then
       the reads per hour and the counts by direction, the cameras and the most read plates. Every list is a grid. -->
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Border Grid.Row="0" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
        <ui:ToolbarButton x:Name="CameraChoiceButton" IconKey="devices" Text="{Binding CameraChoiceText}" Command="{Binding ChooseCamerasCommand}" />
        <ComboBox x:Name="RangeChoice" Grid.Column="1" Width="160" VerticalAlignment="Center" ItemsSource="{x:Static vm:StatsViewModel.RangeChoices}" SelectedItem="{Binding SelectedRange}" />
        <ui:ToolbarButton Grid.Column="2" IconKey="refresh" Text="{x:Static vm:PageTexts.Refresh}" Command="{Binding RefreshCommand}" />
        <TextBlock Grid.Column="3" Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <UniformGrid Grid.Row="1" Rows="1" ColumnSpacing="12">
      <ui:StatCard x:Name="TotalCard" Title="{x:Static vm:PageTexts.Total}" Value="{Binding TotalText}" />
      <ui:StatCard Title="{x:Static lp:LicensePlateTexts.Allowed}" Value="{Binding AllowedText}" IsOk="{Binding HasReads}" />
      <ui:StatCard Title="{x:Static lp:LicensePlateTexts.NotAllowed}" Value="{Binding NotAllowedText}" IsError="{Binding HasNotAllowed}" />
      <ui:StatCard Title="{x:Static lp:LicensePlateTexts.Unknown}" Value="{Binding UnknownText}" />
    </UniformGrid>

    <Grid Grid.Row="2" ColumnDefinitions="3*,2*" RowDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="12">
      <Border Grid.Row="0" Grid.Column="0" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.ReadsPerHour}" />
          <ui:BarChart x:Name="HourChart" Height="150" Bars="{Binding HourBars}" EmptyText="{x:Static vm:PageTexts.NoStats}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.ByDirection}" />
          <DataGrid x:Name="DirectionGrid" ItemsSource="{Binding Directions}" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                    HeadersVisibility="Column" Height="150">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static vm:PageTexts.Direction}" Width="*" MinWidth="100" Binding="{Binding Direction}" x:DataType="vm:DirectionStatsRow" />
              <DataGridTextColumn Width="95" MinWidth="95" Binding="{Binding Reads}" CellStyleClasses="number" x:DataType="vm:DirectionStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.Reads}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Width="105" MinWidth="105" Binding="{Binding Allowed}" CellStyleClasses="number" x:DataType="vm:DirectionStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static lp:LicensePlateTexts.Allowed}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Width="130" MinWidth="130" Binding="{Binding NotAllowed}" CellStyleClasses="number" x:DataType="vm:DirectionStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static lp:LicensePlateTexts.NotAllowed}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Width="150" MinWidth="150" Binding="{Binding Unknown}" CellStyleClasses="number" x:DataType="vm:DirectionStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static lp:LicensePlateTexts.Unknown}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.PerCamera}" />
          <DataGrid x:Name="CameraGrid" Grid.Row="1" ItemsSource="{Binding PerCamera}" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static vm:PageTexts.Camera}" Width="*" MinWidth="140" Binding="{Binding Camera}" x:DataType="vm:CameraStatsRow" />
              <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding ReadsText}" SortMemberPath="Reads" CellStyleClasses="number" x:DataType="vm:CameraStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.Reads}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Width="110" MinWidth="110" Binding="{Binding AllowedText}" SortMemberPath="AllowedShare" CellStyleClasses="number" x:DataType="vm:CameraStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.ShareAllowed}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Width="195" MinWidth="195" Binding="{Binding AverageConfidenceText}" SortMemberPath="AverageConfidence" CellStyleClasses="number" x:DataType="vm:CameraStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.AverageConfidence}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Width="120" MinWidth="120" Binding="{Binding LowText}" SortMemberPath="LowShare" CellStyleClasses="number" x:DataType="vm:CameraStatsRow">
                <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.ShareLow}" /></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Header="{x:Static vm:PageTexts.LastRead}" Width="120" Binding="{Binding LastReadText}" SortMemberPath="LastReadSortKey" x:DataType="vm:CameraStatsRow" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.TopPlates}" />
            <DataGrid x:Name="TopPlatesGrid" Grid.Row="1" ItemsSource="{Binding TopPlates}" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static vm:PageTexts.Plate}" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlateCountRow">
                      <TextBlock Classes="mono" Text="{Binding Plate}" Margin="10,0" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding Reads}" CellStyleClasses="number" x:DataType="vm:PlateCountRow">
                  <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.Reads}" /></DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="{StaticResource Oadm.GridCardPadding}">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Classes="cardTitle" Text="{x:Static vm:PageTexts.TopUnknown}" />
            <DataGrid x:Name="TopUnknownGrid" Grid.Row="1" ItemsSource="{Binding TopUnknown}" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static vm:PageTexts.Plate}" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlateCountRow">
                      <TextBlock Classes="mono" Text="{Binding Plate}" Margin="10,0" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding Reads}" CellStyleClasses="number" x:DataType="vm:PlateCountRow">
                  <DataGridTextColumn.Header><TextBlock Classes="numberHeader" Text="{x:Static vm:PageTexts.Reads}" /></DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <TextBlock Grid.RowSpan="2" Grid.ColumnSpan="2" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EmptyText}"
                 IsVisible="{Binding ShowEmpty}" />
      <ui:LoadingOverlay Grid.RowSpan="2" Grid.ColumnSpan="2" Text="{x:Static vm:PageTexts.ReadingStats}" IsVisible="{Binding IsLoading}" />
    </Grid>
  </Grid>
</UserControl>
