<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Radius.Client"
             xmlns:net="using:Oadm.Sdk.Network"
             x:Class="Oadm.Plugins.Radius.Client.RadiusView"
             x:DataType="vm:RadiusViewModel"
             ui:PageHeader.Subtitle="Switches ask OADM which cameras may use their ports.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), shared controls and theme classes only. One page, no tabs: Server | Trusted
       CAs | Switches | Policies side by side (two or one column on narrower pages, RadiusView.Arrange), then Sessions and
       Log full width. Users limited to a device group see Sessions and Log only. Card headers: the title and its buttons
       in one row. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource Oadm.Gap}">
      <Panel IsVisible="{Binding HasAllDevices}">
        <Grid x:Name="CardColumns" ColumnDefinitions="*,16,*,16,1.65*,16,1.25*" RowDefinitions="Auto,Auto,Auto,Auto">
          <!-- ========== Server ========== -->
          <Border x:Name="ServerCard" Grid.Column="0" Classes="card" VerticalAlignment="Top">
            <StackPanel Classes="form">
              <TextBlock Classes="cardTitle" Text="Server" />
              <StackPanel Classes="form" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                <ui:FormField Label="Listen on" InputWidth="290">
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Listen.Items}" SelectedItem="{Binding SelectedInterface}" IsEnabled="{Binding MayManage}"
                            ToolTip.Tip="The interface the switches reach this server on.">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="net:InterfaceOption">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </ui:FormField>
                <ui:FormField Label="Port">
                  <TextBox Text="{Binding Port}" Width="120" HorizontalAlignment="Left" IsReadOnly="{Binding !MayManage}" />
                </ui:FormField>
                <ui:FormField Label="Log entries kept">
                  <TextBox Text="{Binding LogKept}" Width="120" HorizontalAlignment="Left" IsReadOnly="{Binding !MayManage}" />
                </ui:FormField>
              </StackPanel>
              <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding OpenAdvancedCommand}" ToolTip.Tip="TLS versions, cipher suites, packet size">
                <ui:IconLabel Icon="{DynamicResource Icon.sliders}" Text="Advanced" />
              </Button>
              <!-- The status directly left of the Save it reports on. -->
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding MayManage}"
                        ToolTip.Tip="{Binding SaveTip}" ToolTip.ShowOnDisabled="True" />
                <ui:StatusChip HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding StatusText}" IsOk="{Binding StatusOk}"
                               IsWarning="{Binding StatusWarning}" IsError="{Binding StatusError}" MaxLines="2" />
              </DockPanel>
              <TextBlock Classes="secondary" Text="{Binding CertificateText}" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right"
                         IsVisible="{Binding CertificateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="secondary" Text="{Binding SitesText}" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" IsVisible="{Binding HasSiteProblems}" />
              <TextBlock Classes="error" Text="{Binding ActionError}" TextWrapping="Wrap" HorizontalAlignment="Right" IsVisible="{Binding HasActionError}" />
            </StackPanel>
          </Border>

          <!-- ========== Trusted CAs ========== -->
          <Border x:Name="TrustedCasCard" Grid.Column="2" Classes="card" VerticalAlignment="Top" DataContext="{Binding TrustedCas}" x:DataType="vm:TrustedCasViewModel">
            <StackPanel Classes="form">
              <TextBlock Classes="cardTitle" Text="Trusted CAs" />
              <!-- A handful of CAs: no virtualization needed. -->
              <ItemsControl ItemsSource="{Binding Cas}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrustedCaViewModel">
                    <StackPanel Margin="0,0,0,10" Spacing="2">
                      <CheckBox IsChecked="{Binding IsTrusted}" IsEnabled="{Binding MayManage}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                          <TextBlock Classes="secondary small" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox Margin="28,0,0,0" Content="Only devices OADM manages" IsChecked="{Binding OnlyManaged}" IsVisible="{Binding IsTrusted}"
                                IsEnabled="{Binding MayManage}" ToolTip.Tip="Off: any device with a valid certificate of this CA" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="secondary" Text="{Binding EmptyText}" TextWrapping="Wrap" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="secondary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding MayManage}"
                        ToolTip.Tip="{Binding SaveTip}" ToolTip.ShowOnDisabled="True" />
                <TextBlock Classes="secondary" Text="{x:Static vm:TrustedCasViewModel.ManageText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- ========== Switches ========== -->
          <Border x:Name="SwitchesCard" Grid.Column="4" Classes="card" VerticalAlignment="Top" DataContext="{Binding Switches}" x:DataType="vm:SwitchesViewModel">
            <StackPanel Spacing="12">
              <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
                <TextBlock Classes="cardTitle" Text="Switches" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Classes="secondary" Command="{Binding AddCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True">
                  <ui:IconLabel Icon="{DynamicResource Icon.add}" Text="Add switch" />
                </Button>
                <Button Classes="secondary" Command="{Binding EditCommand}" IsVisible="{Binding MayManage}">
                  <ui:IconLabel Icon="{DynamicResource Icon.edit}" Text="Edit" />
                </Button>
                <Button Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding MayManage}">
                  <ui:IconLabel Icon="{DynamicResource Icon.remove}" Text="Delete" />
                </Button>
              </WrapPanel>
              <Panel>
                <DataGrid x:Name="SwitchesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserSortColumns="True"
                          CanUserReorderColumns="False" SelectionMode="Single" Height="240">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="*" MinWidth="90" Binding="{Binding Name}" x:DataType="vm:SwitchRowViewModel" />
                    <DataGridTextColumn Header="Address" Width="100" Binding="{Binding Address}" x:DataType="vm:SwitchRowViewModel" />
                    <DataGridTextColumn Header="Site" Width="95" Binding="{Binding Site}" x:DataType="vm:SwitchRowViewModel" />
                    <DataGridTemplateColumn Header="State" Width="138" SortMemberPath="State" x:DataType="vm:SwitchRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SwitchRowViewModel">
                          <ui:StatusChip Margin="10,0" Text="{Binding State}" IsOk="{Binding IsOk}" IsError="{Binding IsError}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last request" Width="112" Binding="{Binding LastRequest}" SortMemberPath="LastRequestSortKey" x:DataType="vm:SwitchRowViewModel" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,40,16,0" />
              </Panel>
            </StackPanel>
          </Border>

          <!-- ========== Policies (in order; users limited to a group read none) ========== -->
          <Border x:Name="PoliciesCard" Grid.Column="6" Classes="card" VerticalAlignment="Top" DataContext="{Binding Policies}" x:DataType="vm:PoliciesViewModel">
            <StackPanel Spacing="12">
              <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
                <TextBlock Classes="cardTitle" Text="Policies" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Classes="secondary" Command="{Binding AddCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True">
                  <ui:IconLabel Icon="{DynamicResource Icon.add}" Text="Add policy" />
                </Button>
                <Button Classes="secondary" Command="{Binding EditCommand}" IsVisible="{Binding MayManage}">
                  <ui:IconLabel Icon="{DynamicResource Icon.edit}" Text="Edit" />
                </Button>
                <Button Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding MayManage}">
                  <ui:IconLabel Icon="{DynamicResource Icon.remove}" Text="Delete" />
                </Button>
                <ui:ToolbarButton IsIconOnly="True" IconKey="chevronUp" Text="Move up" Command="{Binding MoveUpCommand}" IsVisible="{Binding MayManage}" />
                <ui:ToolbarButton IsIconOnly="True" IconKey="chevronDown" Text="Move down" Command="{Binding MoveDownCommand}" IsVisible="{Binding MayManage}" />
              </WrapPanel>
              <Panel>
                <DataGrid x:Name="PoliciesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Classes="wrapRows" IsReadOnly="True"
                          CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" Height="240">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="*" MinWidth="90" Binding="{Binding Name}" x:DataType="vm:PolicyRowViewModel" />
                    <DataGridTemplateColumn Header="Policy" Width="130" x:DataType="vm:PolicyRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PolicyRowViewModel">
                          <ui:StatusChip Margin="10,0" Text="{Binding Kind}" IsError="{Binding IsBlock}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Devices" Width="1.5*" MinWidth="120" x:DataType="vm:PolicyRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PolicyRowViewModel">
                          <TextBlock Text="{Binding Devices}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Devices}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,40,16,0" />
              </Panel>
              <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
              <ui:FormField Label="Default VLAN" Hint="For devices no VLAN policy matches." IsVisible="{Binding HasVlanPolicies}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBox Text="{Binding DefaultVlan}" Width="120" VerticalAlignment="Top" PlaceholderText="None" IsReadOnly="{Binding !MayManage}" />
                  <Button Classes="secondary" Content="Save" VerticalAlignment="Top" Command="{Binding SaveDefaultVlanCommand}" IsVisible="{Binding MayManage}" />
                </StackPanel>
              </ui:FormField>
            </StackPanel>
          </Border>
        </Grid>
        <ui:LoadingOverlay Text="Reading the 802.1X server" IsVisible="{Binding IsLoading}" />
      </Panel>

      <!-- ============================== Sessions ============================== -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" DataContext="{Binding Sessions}" x:DataType="vm:SessionsViewModel">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <TextBlock Classes="cardTitle" Text="Sessions" VerticalAlignment="Center" />
            <TextBlock Classes="secondary" Text="{Binding CountText}" VerticalAlignment="Center" />
          </StackPanel>
          <ui:ProgressRow Grid.Row="1" Margin="0,0,0,8" Text="Reading the sessions" IsVisible="{Binding IsReloading}" />
          <Panel Grid.Row="2">
            <DataGrid x:Name="SessionsGrid" ItemsSource="{Binding Rows}" Classes="wrapRows" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
                      SelectionMode="Single" Height="300">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Width="140" Binding="{Binding Started}" SortMemberPath="StartedSortKey" x:DataType="vm:SessionRowViewModel" />
                <DataGridTextColumn Header="Switch" Width="100" Binding="{Binding Switch}" x:DataType="vm:SessionRowViewModel" />
                <DataGridTextColumn Header="Port" Width="140" Binding="{Binding Port}" x:DataType="vm:SessionRowViewModel" />
                <DataGridTextColumn Header="MAC address" Width="130" Binding="{Binding Mac}" x:DataType="vm:SessionRowViewModel" />
                <DataGridTextColumn Header="EAP identity" Width="130" Binding="{Binding Identity}" x:DataType="vm:SessionRowViewModel" />
                <DataGridTemplateColumn Header="Device" Width="100" SortMemberPath="Device" x:DataType="vm:SessionRowViewModel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:SessionRowViewModel">
                      <TextBlock Text="{Binding Device}" Classes.guess="{Binding IsGuess}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="IP address" Width="100" Binding="{Binding IpAddress}" x:DataType="vm:SessionRowViewModel" />
                <DataGridTemplateColumn Header="State" Width="*" MinWidth="220" SortMemberPath="State" x:DataType="vm:SessionRowViewModel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:SessionRowViewModel">
                      <ui:StatusChip Text="{Binding State}" IsOk="{Binding IsOk}" IsError="{Binding IsError}" IsAccent="{Binding IsRunning}" ToolTip.Tip="{Binding State}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="80" Binding="{Binding Duration}" SortMemberPath="DurationValue" CellStyleClasses="number" x:DataType="vm:SessionRowViewModel">
                  <DataGridTextColumn.Header>
                    <TextBlock Classes="numberHeader" Text="Duration" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
            <ui:LoadingOverlay Text="Reading the sessions" IsVisible="{Binding IsLoading}" />
          </Panel>
          <TextBlock Grid.Row="3" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,8,0,0" />
        </Grid>
      </Border>

      <!-- ============================== Log ============================== -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" DataContext="{Binding Log}" x:DataType="vm:LogViewModel">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="cardTitle" Text="Log" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Classes="toolbar" Command="{Binding ViewCertificateCommand}" ToolTip.Tip="Also a double click on a row">
                <ui:IconLabel Icon="{StaticResource Icon.details}" Text="View certificate" Spacing="8" />
              </Button>
              <Button Classes="toolbar danger" Command="{Binding DeleteAllCommand}" IsVisible="{Binding MayManage}">
                <ui:IconLabel Icon="{StaticResource Icon.remove}" Text="Delete all" Spacing="8" />
              </Button>
            </StackPanel>
            <ui:SearchBox Grid.Column="2" Text="{Binding Search}" Placeholder="Search every column" Width="260" />
          </Grid>
          <ui:ProgressRow Grid.Row="1" Margin="0,8,0,0" Text="Reading the log" IsVisible="{Binding IsReloading}" />
          <Panel Grid.Row="2" Margin="0,8,0,0">
            <DataGrid x:Name="LogGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Classes="wrapRows" IsReadOnly="True" CanUserSortColumns="False"
                      CanUserReorderColumns="False" SelectionMode="Single" Height="420">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Width="140" Binding="{Binding Time}" x:DataType="vm:LogRowViewModel" />
                <DataGridTextColumn Header="Switch" Width="150" Binding="{Binding Switch}" x:DataType="vm:LogRowViewModel" />
                <DataGridTextColumn Header="Port" Width="130" Binding="{Binding Port}" x:DataType="vm:LogRowViewModel" />
                <DataGridTextColumn Header="MAC address" Width="130" Binding="{Binding Mac}" x:DataType="vm:LogRowViewModel" />
                <DataGridTextColumn Header="EAP identity" Width="130" Binding="{Binding Identity}" x:DataType="vm:LogRowViewModel" />
                <DataGridTextColumn Header="Device" Width="100" Binding="{Binding Device}" x:DataType="vm:LogRowViewModel" />
                <DataGridTextColumn Header="IP address" Width="100" Binding="{Binding IpAddress}" x:DataType="vm:LogRowViewModel" />
                <DataGridTemplateColumn Header="Result" Width="*" MinWidth="220" x:DataType="vm:LogRowViewModel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LogRowViewModel">
                      <ui:StatusChip Text="{Binding Result}" Detail="{Binding Reason}" IsOk="{Binding IsOk}" IsWarning="{Binding IsWarning}" IsError="{Binding IsError}"
                                     ToolTip.Tip="{Binding Reason}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="64" Binding="{Binding Vlan}" CellStyleClasses="number" x:DataType="vm:LogRowViewModel">
                  <DataGridTextColumn.Header>
                    <TextBlock Classes="numberHeader" Text="VLAN" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
            <ui:LoadingOverlay Text="Reading the log" IsVisible="{Binding IsLoading}" />
          </Panel>
          <!-- A whole-table error directly below the table; the pages at the right. -->
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="{Binding PageText}" VerticalAlignment="Center" />
              <Button Classes="toolbar" Command="{Binding PreviousPageCommand}" IsVisible="{Binding HasPages}" ToolTip.Tip="Previous 500">
                <ui:IconLabel Icon="{StaticResource Icon.chevronLeft}" Text="Previous" Spacing="4" />
              </Button>
              <Button Classes="toolbar" Command="{Binding NextPageCommand}" IsVisible="{Binding HasPages}" ToolTip.Tip="Next 500">
                <ui:IconLabel Icon="{StaticResource Icon.chevronRight}" Text="Next" Spacing="4" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
