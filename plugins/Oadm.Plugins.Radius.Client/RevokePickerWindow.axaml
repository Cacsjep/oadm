<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Radius.Client"
        x:Class="Oadm.Plugins.Radius.Client.RevokePickerWindow"
        x:DataType="vm:RevokePickerViewModel"
        Title="Revoke certificates"
        Width="1100" Height="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- Title bar, one card with the shared list of issued certificates (PKI's Certificates tab), footer with the count and
       the red Revoke. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="Revoke certificates" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <ui:IssuedCertificateList x:Name="List">
        <ui:IssuedCertificateList.Toolbar>
          <Button Classes="toolbar" Command="{Binding ViewCertificateCommand}" ToolTip.Tip="Also a double click on a row">
            <ui:IconLabel Icon="{StaticResource Icon.details}" Text="View certificate" Spacing="8" />
          </Button>
        </ui:IssuedCertificateList.Toolbar>
      </ui:IssuedCertificateList>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <TextBlock Classes="secondary" Text="{Binding ChoiceText}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Classes="danger" Content="Revoke" Command="{Binding ChooseCommand}"
              ToolTip.Tip="{Binding RevokeTip}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
