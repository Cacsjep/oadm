<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PolicySettingsView"
             x:DataType="vm:PolicyEditorViewModel">
  <!-- A system policy edited in place on its card (docs/spec/pki.md "Policies", decision 2026-10-25): its heading, the
       policy form without name and devices (errors below each field), then Save with its status directly left of it. One
       Save per policy: the server stores one policy per save, so a refusal belongs to this block alone. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="sectionTitle" Text="{Binding Heading}" />
    <vm:PolicyFormView />
    <DockPanel IsVisible="{Binding IsEditable}">
      <Button DockPanel.Dock="Right" Classes="secondary" Content="Save" Command="{Binding SaveInPlaceCommand}" IsEnabled="{Binding CanSave}"
              ToolTip.Tip="{Binding SaveBlockedReason}" ToolTip.ShowOnDisabled="True" />
      <ui:StatusChip DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding SaveStatus}" IsOk="{Binding IsSaveStatusOk}"
                     IsWarning="{Binding !IsSaveStatusOk}" IsVisible="{Binding HasSaveStatus}" />
      <Panel />
    </DockPanel>
  </StackPanel>
</UserControl>
