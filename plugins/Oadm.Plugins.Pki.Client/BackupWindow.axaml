<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Pki.Client"
        x:Class="Oadm.Plugins.Pki.Client.BackupWindow"
        x:DataType="vm:BackupViewModel"
        Title="{x:Static vm:BackupViewModel.Title}"
        Width="640" Height="380" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Title bar, one card (password twice), footer. Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static vm:BackupViewModel.Title}" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <StackPanel Classes="form">
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="The backup holds the CA with its private key, protected by this password. Import it on another OADM server to move the CA." />
        <ui:FormField Label="Password" Hint="At least 8 characters.">
          <ui:PasswordBox Text="{Binding Password}" />
        </ui:FormField>
        <ui:FormField Label="Confirm password">
          <ui:PasswordBox Text="{Binding ConfirmPassword}" />
        </ui:FormField>
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Back up" Command="{Binding BackupCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
