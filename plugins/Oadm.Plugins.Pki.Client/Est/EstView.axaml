<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Est.Client"
             xmlns:net="using:Oadm.Sdk.Network"
             xmlns:srv="using:Oadm.Plugins.Pki.Client.Servers"
             x:Class="Oadm.Plugins.Est.Client.EstView"
             x:DataType="vm:EstViewModel"
             ui:PageHeader.Subtitle="Cameras get and renew their certificates from OADM by themselves.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), two columns (decision 2026-10-25): Server (with Save and the status left of
       it) above Profiles left, the enrollments and, only when there are any, the certificates the cameras did not renew in
       time right, as high as the page; one column on narrower pages (EstView.Arrange). Shared controls and theme classes only. -->
  <Panel>
    <!-- The server does not run (turned off, no OADM PRO, a start that failed): the off state with Turn on (docs/spec/pki.md
         "One plugin"). -->
    <srv:ServerOffStateView DataContext="{Binding Server}" IsVisible="{Binding ShowOffState}" Icon="{DynamicResource Icon.lock}"
                            Text="Cameras get and renew their certificates from OADM by themselves." />

  <Grid x:Name="PageColumns" ColumnDefinitions="680,16,*" RowDefinitions="*,0" IsVisible="{Binding Server.Running}">
    <!-- Server (listen on, port, enrollments kept, the policies; Save with the status at its right edge, it saves the
         profiles too) above Profiles; the column scrolls on a low page. -->
    <ScrollViewer x:Name="LeftColumn" Grid.Row="0" Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <Border x:Name="GeneralCard" Classes="card" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Classes="form">
            <TextBlock Classes="cardTitle" Text="Server" />
            <!-- Same shared select as the NTP and DHCP server pages. -->
            <ui:FormField Label="Listen on" InputWidth="320">
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Listen.Items}" SelectedItem="{Binding SelectedInterface}" IsEnabled="{Binding MayManage}"
                        ToolTip.Tip="The interface the cameras reach this server on.">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="net:InterfaceOption">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ui:FormField>
            <ui:FormField Label="Port">
              <TextBox Text="{Binding Port}" Width="120" HorizontalAlignment="Left" IsReadOnly="{Binding !MayManage}" />
            </ui:FormField>
            <ui:FormField Label="Enrollments kept">
              <TextBox Text="{Binding EnrollmentsKept}" Width="120" HorizontalAlignment="Left" IsReadOnly="{Binding !MayManage}" />
            </ui:FormField>
            <!-- The certificate is the EST server policy's (shown there); here only what is wrong with it (a site not in it). -->
            <TextBlock Classes="warning" Text="{Binding CertificateWarning}" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left"
                       IsVisible="{Binding CertificateWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="warning" Text="{Binding PolicyProblem}" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left"
                       IsVisible="{Binding PolicyProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding MayManage}"
                    ToolTip.Tip="{Binding SaveTip}" ToolTip.ShowOnDisabled="True" />
            <!-- Turn off (for users who may change the server) between the status of the server and Save. -->
            <srv:ServerSwitchView DockPanel.Dock="Right" DataContext="{Binding Server}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <!-- Who may enroll and which CAs sign in are PKI's policies (Enrollment, EST sign-in CA): "3 policies applied" opens them
                 (decision 2026-10-25), left in the Save row. Not for users limited to a device group (the policies are server-wide). -->
            <Button x:Name="PoliciesLink" DockPanel.Dock="Left" Classes="link" Content="{Binding PoliciesText}" Command="{Binding EditInPkiCommand}" VerticalAlignment="Center"
                    IsVisible="{Binding ShowsPolicies}" Margin="0,0,16,0" />
            <ui:StatusChip HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="{Binding StatusText}" IsOk="{Binding StatusOk}" IsError="{Binding !StatusOk}" />
          </DockPanel>
          <TextBlock Classes="secondary" Text="{Binding ListenersText}" TextWrapping="Wrap" HorizontalAlignment="Right"
                     TextAlignment="Right" Margin="0,6,0,0" IsVisible="{Binding HasListenerProblems}" />
          <TextBlock Classes="error" Text="{Binding ActionError}" TextWrapping="Wrap" HorizontalAlignment="Right"
                     IsVisible="{Binding ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
      <Border x:Name="ProfilesCard" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="6">
          <!-- The title and Add profile in one row, like the other cards. -->
          <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
            <TextBlock Classes="cardTitle" Text="Profiles" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:ToolbarButton Text="Add profile" IconKey="add" Command="{Binding AddProfileCommand}" IsVisible="{Binding MayManage}" />
          </WrapPanel>
          <Grid ColumnDefinitions="180,12,150,12,202,12,Auto">
            <TextBlock Grid.Column="0" Classes="secondary" Text="Profile" />
            <TextBlock Grid.Column="2" Classes="secondary" Text="Use" />
            <TextBlock Grid.Column="4" Classes="secondary" Text="Issuing policy" />
          </Grid>
          <!-- At most four rows (one per use): no virtualization needed. Inputs stay at the top so an error below one does
               not move the others; the check box and Remove sit centered in an input-high box. -->
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileRowViewModel">
                <Grid ColumnDefinitions="180,12,150,12,202,12,Auto" Margin="0,0,0,6">
                  <TextBox Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Top" IsReadOnly="{Binding !MayManage}" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding UseChoices}" SelectedItem="{Binding Use}" HorizontalAlignment="Stretch"
                            VerticalAlignment="Top" IsEnabled="{Binding MayManage}" />
                  <ComboBox Grid.Column="4" ItemsSource="{Binding PolicyChoices}" SelectedItem="{Binding Policy}" HorizontalAlignment="Stretch"
                            VerticalAlignment="Top" IsEnabled="{Binding MayManage}" ToolTip.Tip="{Binding PolicySummary}" />
                  <Panel Grid.Column="6" Height="{DynamicResource Oadm.ControlHeight}" VerticalAlignment="Top" IsVisible="{Binding MayManage}">
                    <!-- One ⋯ button with the row's actions (ui:RowActions): Remove in red. -->
                    <Button Classes="toolbar iconOnly" VerticalAlignment="Center" ToolTip.Tip="{x:Static ui:RowActions.Tip}" Click="OnProfileActions">
                      <ui:OadmIcon Data="{StaticResource Icon.more}" />
                    </Button>
                  </Panel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>

    <!-- ============================== Enrollments ============================== -->
    <Border x:Name="EnrollmentsCard" Grid.Row="0" Grid.Column="2" Classes="card">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
    <!-- Like the event rule log: title, Delete all (red, confirmed), search at the right. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
        <TextBlock Classes="cardTitle" Text="Enrollments" VerticalAlignment="Center" />
        <Button Classes="toolbar" Command="{Binding ViewCertificateCommand}" ToolTip.Tip="Also a double click on a row">
          <ui:IconLabel Icon="{StaticResource Icon.details}" Text="View certificate" Spacing="8" />
        </Button>
        <Button Classes="toolbar danger" Command="{Binding ClearEnrollmentsCommand}" IsVisible="{Binding MayManage}">
          <ui:IconLabel Icon="{StaticResource Icon.remove}" Text="Delete all" Spacing="8" />
        </Button>
      </StackPanel>
      <ui:SearchBox Grid.Column="2" Text="{Binding EnrollmentSearch}" Placeholder="Search device, profile, result, reason" Width="260" />
    </Grid>
    <Panel Grid.Row="1" Margin="0,8,0,0">
      <DataGrid x:Name="EnrollmentsGrid" ItemsSource="{Binding Enrollments}" SelectedItem="{Binding SelectedEnrollment}" Classes="wrapRows" IsReadOnly="True"
                CanUserSortColumns="True" CanUserReorderColumns="False" SelectionMode="Single" MinHeight="140">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Width="160" Binding="{Binding Time}" SortMemberPath="TimeSortKey" CellStyleClasses="dimmed" x:DataType="vm:EnrollmentRow" />
          <DataGridTextColumn Header="Device" Width="160" Binding="{Binding Device}" x:DataType="vm:EnrollmentRow" />
          <DataGridTextColumn Header="Profile" Width="110" Binding="{Binding Profile}" x:DataType="vm:EnrollmentRow" />
          <DataGridTextColumn Header="Kind" Width="90" Binding="{Binding Kind}" x:DataType="vm:EnrollmentRow" />
          <DataGridTemplateColumn Header="Result" Width="*" SortMemberPath="Result" x:DataType="vm:EnrollmentRow">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:EnrollmentRow">
                <ui:StatusChip Margin="8,0" Text="{Binding Reason}" IsOk="{Binding Ok}" IsError="{Binding Refused}" MaxLines="2" ToolTip.Tip="{Binding Reason}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="secondary" Text="{Binding EnrollmentsEmptyText}" IsVisible="{Binding EnrollmentsEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
    </Panel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="{DynamicResource Oadm.GapTop}" IsVisible="{Binding HasNotRenewed}">
      <TextBlock Classes="sectionTitle" Text="Not renewed" VerticalAlignment="Center" />
      <TextBlock Classes="secondary" Text="{Binding NotRenewedSummary}" VerticalAlignment="Center" />
    </StackPanel>
    <DataGrid Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding NotRenewed}" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
              SelectionMode="Single" MaxHeight="240" IsVisible="{Binding HasNotRenewed}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Width="*" Binding="{Binding Device}" x:DataType="vm:NotRenewedRow" />
        <DataGridTextColumn Header="Profile" Width="110" Binding="{Binding Profile}" x:DataType="vm:NotRenewedRow" />
        <DataGridTextColumn Header="Valid until" Width="150" Binding="{Binding ValidUntil}" SortMemberPath="ValidUntilSortKey" x:DataType="vm:NotRenewedRow" />
        <DataGridTemplateColumn Header="State" Width="140" SortMemberPath="State" x:DataType="vm:NotRenewedRow">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:NotRenewedRow">
              <ui:StatusChip Margin="8,0" Text="{Binding State}" IsError="True" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    </Grid>
    </Border>
  </Grid>

    <ui:LoadingOverlay Text="Reading the EST server" IsVisible="{Binding IsLoading}" />
  </Panel>
</UserControl>
