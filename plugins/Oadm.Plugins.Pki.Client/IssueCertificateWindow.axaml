<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Pki.Client"
        x:Class="Oadm.Plugins.Pki.Client.IssueCertificateWindow"
        x:DataType="vm:IssueCertificateViewModel"
        Title="{Binding Title}"
        Width="600" MinWidth="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- Enable HTTPS / Enable IEEE 802.1X / Renew certificates: one form (no card): the issuing policy of this run. Shared controls
       and theme classes only. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <Border Grid.Row="1" Classes="dialogBody">
      <Panel>
        <StackPanel Classes="form">
          <TextBlock Classes="warning" Text="{Binding Warning}" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
          <vm:IssuingPolicyField DataContext="{Binding Choice}" />
        </StackPanel>
        <ui:LoadingOverlay Text="Reading the policies" IsVisible="{Binding Choice.IsLoading}" />
      </Panel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="{Binding StartText}" Command="{Binding StartCommand}"
              ToolTip.Tip="{Binding Choice.NotReadyReason}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
