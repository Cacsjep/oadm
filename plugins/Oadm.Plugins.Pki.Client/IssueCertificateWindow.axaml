<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Pki.Client"
        x:Class="Oadm.Plugins.Pki.Client.IssueCertificateWindow"
        x:DataType="vm:IssueCertificateViewModel"
        Title="{Binding Title}"
        Width="600" MinWidth="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- Enable HTTPS / Enable IEEE 802.1X: one form (no card): the issuing policy and the values of this run. Shared controls
       and theme classes only. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <Border Grid.Row="1" Classes="dialogBody">
      <Panel>
        <StackPanel Classes="form">
          <TextBlock Classes="warning" Text="{Binding Warning}" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
          <ui:FormField Label="Policy" InputWidth="340">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Policies}" SelectedItem="{Binding Policy}" />
          </ui:FormField>
          <ui:FormField Label="CA">
            <TextBlock Text="{Binding CaName}" TextTrimming="CharacterEllipsis" />
          </ui:FormField>
          <ui:FormField Label="Valid (days)">
            <TextBox Text="{Binding ValidDays}" Width="120" HorizontalAlignment="Left" PlaceholderText="1 to 3650" />
          </ui:FormField>
          <ui:FormField Label="Key">
            <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.KeyChoices}" SelectedItem="{Binding Key}" />
          </ui:FormField>

          <!-- IEEE 802.1X: the settings of the policy -->
          <ui:FormField Label="EAPOL version" IsVisible="{Binding IsDot1x}">
            <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.EapolChoices}" SelectedItem="{Binding Eapol}" />
          </ui:FormField>
          <ui:FormField Label="EAP identity" IsVisible="{Binding IsDot1x}">
            <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.IdentityChoices}" SelectedItem="{Binding Identity}" />
          </ui:FormField>
          <ui:FormField Label="Custom identity" InputWidth="340" Hint="{}{serial} and {hostName} are replaced" IsVisible="{Binding IsCustomIdentity}">
            <TextBox Text="{Binding CustomIdentity}" PlaceholderText="e.g. axis-{serial}" />
          </ui:FormField>
          <ui:FormField Label="RADIUS server CA" InputWidth="340" IsVisible="{Binding IsDot1x}">
            <StackPanel Spacing="8">
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RadiusChoices}" SelectedItem="{Binding RadiusCa}" />
              <TextBlock Classes="secondary" Text="{Binding RadiusCaLine}" TextWrapping="Wrap"
                         IsVisible="{Binding RadiusCaLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </ui:FormField>
        </StackPanel>
        <ui:LoadingOverlay Text="Reading the policies" IsVisible="{Binding IsLoading}" />
      </Panel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Enable" Command="{Binding EnableCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
