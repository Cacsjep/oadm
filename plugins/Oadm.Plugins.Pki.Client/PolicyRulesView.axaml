<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PolicyRulesView"
             x:DataType="vm:PolicySectionViewModel">
  <!-- One rule list of a card of the Policies tab (docs/spec/pki.md "Policies", decision 2026-10-25): the title with Add (a
       menu of the kinds when the list has several), one line per policy (name with the System badge, devices where the kinds
       have them, the summary dimmed, the ⋯ menu: Edit, Delete in red, no Delete for a system policy). At most 200 policies:
       the table is virtualized and at most 360 px high (the page scrolls, the table scrolls inside). Empty: one line. -->
  <StackPanel Spacing="8">
    <DockPanel>
      <Button x:Name="AddButton" DockPanel.Dock="Right" Classes="secondary" Click="OnAdd" IsVisible="{Binding MayManage}" IsEnabled="{Binding CanAddRule}"
              ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True">
        <ui:IconLabel Icon="{DynamicResource Icon.add}" Text="Add" />
      </Button>
      <TextBlock Classes="sectionTitle" Text="{Binding Title}" VerticalAlignment="Center" />
    </DockPanel>
    <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rows}" Classes="wrapRows" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
              SelectionMode="Single" MaxHeight="360" IsVisible="{Binding !HasEmptyText}">
      <DataGrid.Columns>
        <!-- Fixed Name and Devices widths: the columns line up from list to list. -->
        <DataGridTemplateColumn Header="Name" Width="240" x:DataType="vm:PolicyRowViewModel">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PolicyRowViewModel">
              <WrapPanel Margin="10,4" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="4">
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <!-- A system policy (OADM needs it): no Delete. -->
                <Border Classes="badge system" VerticalAlignment="Center" IsVisible="{Binding IsSystem}" ToolTip.Tip="{x:Static vm:PolicyRowViewModel.SystemTip}">
                  <TextBlock Text="System" />
                </Border>
              </WrapPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Shown only for kinds with devices (PolicyRulesView.OnDataContextChanged). -->
        <DataGridTemplateColumn Header="Devices" Width="220" x:DataType="vm:PolicyRowViewModel">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PolicyRowViewModel">
              <TextBlock Text="{Binding Devices}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Devices}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Summary" Width="*" MinWidth="160" x:DataType="vm:PolicyRowViewModel">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PolicyRowViewModel">
              <StackPanel Margin="10,4" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="secondary" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <!-- An overlap a tag or site change made later: the warning in the row. -->
                <ui:StatusChip Text="{Binding Warning}" IsWarning="True" MaxLines="2" ToolTip.Tip="{Binding Warning}" HorizontalAlignment="Left"
                               IsVisible="{Binding HasWarning}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="52" x:DataType="vm:PolicyRowViewModel">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PolicyRowViewModel">
              <!-- One ⋯ button with the row's actions, like the certificate tables: Edit, then Delete in red. -->
              <Button Classes="toolbar iconOnly" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{x:Static ui:RowActions.Tip}"
                      Click="OnRowActions" IsVisible="{Binding $parent[UserControl].((vm:PolicySectionViewModel)DataContext).MayManage}">
                <ui:OadmIcon Data="{StaticResource Icon.more}" />
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding HasEmptyText}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
