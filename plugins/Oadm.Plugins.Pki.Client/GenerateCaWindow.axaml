<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Pki.Client"
        x:Class="Oadm.Plugins.Pki.Client.GenerateCaWindow"
        x:DataType="vm:GenerateCaViewModel"
        Title="{x:Static vm:GenerateCaViewModel.Title}"
        Width="640" MinWidth="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource Oadm.TitleBarHeight}">
  <!-- Title bar, one card (form), footer. Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static vm:GenerateCaViewModel.Title}" />

    <Border Grid.Row="1" Classes="dialogBody">
      <StackPanel Classes="form">
        <ui:FormField Label="Common name" Hint="The name devices and browsers show for this CA.">
          <TextBox Text="{Binding CommonName}" />
        </ui:FormField>
        <ui:FormField Label="Organization">
          <TextBox Text="{Binding Organization}" PlaceholderText="Optional" />
        </ui:FormField>
        <ui:FormField Label="Validity (years)">
          <TextBox Text="{Binding ValidityYears}" />
        </ui:FormField>
        <ui:FormField Label="Key">
          <TextBlock Text="{x:Static vm:GenerateCaViewModel.KeyInfo}" />
        </ui:FormField>
        <ui:ProgressRow Text="{x:Static vm:GenerateCaViewModel.BusyText}" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelCommand="{Binding CancelCommand}">
      <Button Classes="primary" Content="Generate" Command="{Binding GenerateCommand}"
              ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
    </ui:DialogFooter>
  </Grid>
</Window>
