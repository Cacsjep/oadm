<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PkiView"
             x:DataType="vm:PkiViewModel"
             ui:PageHeader.Subtitle="Certificates, their policies, and the 802.1X and EST servers.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), shared controls and theme classes only (docs/spec/pki.md "The PKI page"):
       fixed tabs Certificates | Policies | 802.1X server | EST server. Certificates: the CAs and the certificates. Policies:
       one grouped table of the policies and a side panel to create and edit a policy. -->
  <UserControl.DataTemplates>
    <!-- The policy's form in the Policies tab's side panel. -->
    <DataTemplate DataType="vm:PolicyEditorViewModel">
      <vm:PolicyFormView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid RowDefinitions="Auto,*">
  <!-- The fixed tabs (docs/spec/pki.md "The PKI page"): Certificates, Policies, then the server pages the host hands over (only those
       the role may show); no row without a server tab. -->
  <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}" Margin="0,0,0,8">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:PkiTabViewModel">
        <ui:PageTab Title="{Binding Title}" IsActive="{Binding IsActive}" ActivateCommand="{Binding ActivateCommand}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

  <!-- A server tab: its page's own view (only the shown tab's view is in the window). -->
  <ContentControl Grid.Row="1" Content="{Binding ActiveTabView}" IsVisible="{Binding IsServerTab}" />

  <!-- ============================== Policies ============================== -->
  <!-- One grouped table and a side panel (docs/spec/pki.md "Policies", decision 2026-10-25, like Intune): Create and the
       search in the card's toolbar row; the policies in groups (Issuing, Server, 802.1X access, EST enrollment policies,
       Expiry warnings), built-in ones with a badge. A row or Create slides the panel in at the right and pushes the table
       to the left: the types (Create) or the policy's form, Save and Cancel at the bottom. -->
  <Grid x:Name="PoliciesPage" Grid.Row="1" ColumnDefinitions="*,Auto" DataContext="{Binding Policies}" x:DataType="vm:PoliciesViewModel"
        IsVisible="{Binding $parent[vm:PkiView].((vm:PkiViewModel)DataContext).IsPoliciesTab}">
    <Border x:Name="PoliciesCard" Grid.Column="0" Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
          <ui:ToolbarButton Text="Create" IconKey="add" Command="{Binding CreateCommand}" IsVisible="{Binding MayManage}"
                            ToolTip.Tip="{Binding CreateTip}" ToolTip.ShowOnDisabled="True" />
          <ui:SearchBox Grid.Column="2" Width="260" Text="{Binding SearchText}" Placeholder="Search policies" />
        </Grid>
        <ui:ProgressRow DockPanel.Dock="Top" Text="Reading the policies" IsVisible="{Binding IsReloading}" />
        <TextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,8,0,0" />
        <Panel>
          <TextBlock Classes="secondary" Text="{x:Static vm:PoliciesViewModel.NoMatchText}" IsVisible="{Binding HasNoMatch}" />
          <!-- Grouped like the Plugins page (PkiView.GroupPolicies: a collapsible header per group). At most 200 policies:
               virtualized. A click opens the policy in the panel. -->
          <DataGrid x:Name="PoliciesGrid" Classes="groups" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" IsReadOnly="True" CanUserSortColumns="False"
                    CanUserReorderColumns="False" SelectionMode="Single" IsVisible="{Binding !HasNoMatch}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Name" Width="300" x:DataType="vm:PolicyRowViewModel">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PolicyRowViewModel">
                    <Grid ColumnDefinitions="16,Auto,Auto" ColumnSpacing="4" Margin="10,4" VerticalAlignment="Center">
                      <Ellipse Grid.Column="0" Classes="problemDot error" HorizontalAlignment="Left" IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding Problem}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="2" Classes="badge system" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSystem}"
                              ToolTip.Tip="{x:Static vm:PolicyRowViewModel.SystemTip}">
                        <TextBlock Text="Built-in" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Type" Width="200" Binding="{Binding Type}" x:DataType="vm:PolicyRowViewModel" />
              <DataGridTemplateColumn Header="Summary" Width="*" MinWidth="200" x:DataType="vm:PolicyRowViewModel">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PolicyRowViewModel">
                    <TextBlock Classes="secondary" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" Margin="10,4" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The side panel: the title with its close button, the types or the form, the buttons. -->
    <Border x:Name="PolicyPanel" Grid.Column="1" Classes="sidePanel" Classes.open="{Binding IsPanelOpen}">
      <Border Classes="sidePanelContent">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="cardTitle" Text="{Binding PanelTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Classes="badge system" VerticalAlignment="Center" IsVisible="{Binding ShowsSystemBadge}"
                        ToolTip.Tip="{x:Static vm:PolicyRowViewModel.SystemTip}">
                  <TextBlock Text="Built-in" />
                </Border>
              </StackPanel>
              <TextBlock Classes="secondary" Text="{Binding PanelKind}" IsVisible="{Binding HasPanelKind}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="toolbar iconOnly" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
              <ui:OadmIcon Data="{StaticResource Icon.close}" />
            </Button>
          </Grid>

          <!-- The buttons: Delete apart on the left (a custom policy); the status, Cancel, then Next (types) or Save. -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <ui:ToolbarButton Grid.Column="0" Classes="danger" Text="Delete" IconKey="remove" Command="{Binding DeleteOpenCommand}" IsVisible="{Binding CanDelete}" />
            <ui:StatusChip Grid.Column="2" VerticalAlignment="Center" Text="{Binding SaveStatus}" IsWarning="True" IsVisible="{Binding HasSaveStatus}" />
            <Button Grid.Column="3" Classes="secondary" Content="Cancel" Command="{Binding CloseCommand}" />
            <Button Grid.Column="4" Classes="primary" Content="Next" Command="{Binding NextCommand}" IsVisible="{Binding IsChoosingKind}" />
            <Button Grid.Column="4" Classes="primary" Content="Save" Command="{Binding SaveOpenCommand}" IsVisible="{Binding ShowsSave}"
                    ToolTip.Tip="{Binding SaveBlockedReason}" ToolTip.ShowOnDisabled="True" />
          </Grid>

          <Panel>
            <!-- Create: the types with what each does. -->
            <ListBox Classes="deviceTree" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" SelectionMode="Single"
                     IsVisible="{Binding IsChoosingKind}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PolicyKindChoice">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="secondary small" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsEditing}">
              <ContentControl Content="{Binding Editor}" />
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
    </Border>
    <ui:LoadingOverlay Grid.ColumnSpan="2" Text="Reading the policies" IsVisible="{Binding IsLoading}" />
  </Grid>

  <!-- The two cards share the tab's height; the splitter between them gives one more room (like the tasks pane). -->
  <Grid x:Name="CertificatesPage" Grid.Row="1" IsVisible="{Binding IsCertificatesTab}">
    <Grid.RowDefinitions>
      <!-- At least the toolbar row, the header, a few rows and the pages: the cards never get smaller than their content. -->
      <RowDefinition Height="300" MinHeight="250" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="300" />
    </Grid.RowDefinitions>

      <!-- ============================== Certificate authorities ============================== -->
      <!-- The CAs in their own table (decision 2026-10-25): the shared list without groups and filters (search stays), the CA
           rows' actions in the ⋯ menu; Create CA and the CA imports in its toolbar row. Below that row only the first-start CA
           being made or a server that cannot keep a CA (decision 2026-10-26: every CA row shows its own state). -->
      <Border x:Name="AuthoritiesCard" Grid.Row="0" Classes="card" ClipToBounds="True">
          <ui:IssuedCertificateList x:Name="AuthoritiesList" DataContext="{Binding Authorities}" x:DataType="vm:IssuedCertificatesViewModel">
            <ui:IssuedCertificateList.Toolbar>
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}">
                  <TextBlock Classes="cardTitle" Text="Certificate authorities" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <!-- Flat toolbar buttons like the device toolbar (no accent button on this tab, decision 2026-10-25). -->
                  <ui:ToolbarButton Text="Create CA" IconKey="add" Command="{Binding CreateCaCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="A root CA, or one signed by a listed CA" />
                  <ui:ToolbarButton Text="Import" IconKey="upload" IsVisible="{Binding MayManage}">
                    <ui:ToolbarButton.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="CA certificate" Command="{Binding ImportAuthorityCommand}" ToolTip.Tip="A root or intermediate certificate for the policies" />
                        <MenuItem Header="CA with its key" Command="{Binding ImportCommand}" ToolTip.Tip="It can then issue certificates (.pfx, .p12 or PEM files)" />
                      </MenuFlyout>
                    </ui:ToolbarButton.Flyout>
                  </ui:ToolbarButton>
                </WrapPanel>
            </ui:IssuedCertificateList.Toolbar>
            <ui:IssuedCertificateList.Banner>
                <StackPanel Spacing="8" Margin="0,8,0,0" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}"
                          IsVisible="{Binding ShowCaNotice}">
                  <ui:ProgressRow Text="Creating the certificate authority. This takes a few seconds." IsVisible="{Binding IsGenerating}" />
                  <ui:StatusChip Text="{Binding StatusText}" Detail="{Binding StatusDetail}" IsWarning="{Binding IsStatusWarning}" IsError="{Binding IsStatusError}"
                                 MaxLines="2" IsVisible="{Binding ShowCaStatus}" />
                </StackPanel>
            </ui:IssuedCertificateList.Banner>
          </ui:IssuedCertificateList>
      </Border>

      <!-- ============================== Certificates ============================== -->
      <!-- The shared certificate list (Group by, filters, search, pages, View certificate) without the CAs; the page adds
           the title with Create, Sign request and Import in its toolbar row and the actions of each kind of row. -->
      <GridSplitter x:Name="CertificatesSplitter" Grid.Row="1" Classes="paneSplitter" />

      <Border x:Name="CertificatesCard" Grid.Row="2" Classes="card" ClipToBounds="True">
          <!-- Each row's actions: its ⋯ button and its right-click menu, one menu (IssuedCertificatesViewModel.ActionsOf). -->
          <ui:IssuedCertificateList x:Name="CertificatesList" DataContext="{Binding Certificates}" x:DataType="vm:IssuedCertificatesViewModel">
            <ui:IssuedCertificateList.Toolbar>
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}">
                  <TextBlock Classes="cardTitle" Text="Certificates" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ui:ToolbarButton Text="Create" IconKey="add" Command="{Binding Certificates.CreateCommand}" IsVisible="{Binding MayManage}"
                                    ToolTip.Tip="OADM makes the key and the certificate" />
                  <ui:ToolbarButton Text="Sign request" IconKey="edit" Command="{Binding Certificates.SignRequestCommand}" IsVisible="{Binding MayManage}"
                                    ToolTip.Tip="A request of another system; its key stays there" />
                  <ui:ToolbarButton Text="Import" IconKey="upload" Command="{Binding Certificates.ImportCommand}" IsVisible="{Binding MayManage}"
                                    ToolTip.Tip="A certificate, or a .p12 file with its key" />
                </WrapPanel>
            </ui:IssuedCertificateList.Toolbar>
          </ui:IssuedCertificateList>
      </Border>
  </Grid>
  </Grid>
</UserControl>
