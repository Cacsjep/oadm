<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PkiView"
             x:DataType="vm:PkiViewModel"
             ui:PageHeader.Subtitle="Issues device certificates for HTTPS and IEEE 802.1X.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), shared controls and theme classes only. One page, no tabs
       (docs/spec/pki.md "The PKI page"): Certificate authorities | Policies side by side on wide pages (stacked on narrow
       ones, PkiView.Arrange), Certificates full width below, then the settings of device certificates and IEEE 802.1X. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource Oadm.Gap}">
      <Grid x:Name="TopCards" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">

        <!-- ============================== Certificate authorities ============================== -->
        <Border x:Name="AuthoritiesCard" Grid.Column="0" Classes="card" VerticalAlignment="Stretch">
          <StackPanel Spacing="12">
            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
              <TextBlock Classes="cardTitle" Text="Certificate authorities" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Classes="secondary" Command="{Binding GenerateCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="Create a new certificate authority">
                <ui:IconLabel Icon="{DynamicResource Icon.refresh}" Text="Generate new CA" />
              </Button>
              <Button Classes="secondary" IsVisible="{Binding MayManage}">
                <ui:IconLabel Icon="{DynamicResource Icon.upload}" Text="Import CA" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Own CA with its key" Command="{Binding ImportCommand}"
                              ToolTip.Tip="It replaces the OADM CA (.pfx, .p12 or PEM files)" />
                    <MenuItem Header="CA certificate only" Command="{Binding ImportAuthorityCommand}"
                              ToolTip.Tip="A root or intermediate certificate for the policies" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>

            <ui:ProgressRow Text="Creating the certificate authority. This takes a few seconds." IsVisible="{Binding IsGenerating}" />
            <TextBlock Classes="secondary" Text="{Binding NoCaText}" IsVisible="{Binding HasNoCa}" TextWrapping="Wrap" />

            <!-- The OADM CA: its validity and where it is trusted. -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8" IsVisible="{Binding HasCa}">
              <ui:StatusChip Text="{Binding StatusText}" IsOk="{Binding IsStatusOk}" IsWarning="{Binding IsStatusWarning}"
                             IsError="{Binding IsStatusError}" IsAccent="{Binding IsStatusAccent}" ToolTip.Tip="{Binding StatusDetail}" />
              <ui:StatusChip Text="{Binding ServerTrustText}" IsOk="{Binding IsServerTrustOk}" IsError="{Binding IsServerTrustError}"
                             IsAccent="{Binding IsServerTrustAccent}" ToolTip.Tip="{Binding ServerTrustTip}" />
              <ui:StatusChip Text="{Binding ClientTrustText}" IsOk="{Binding IsClientTrustOk}" IsError="{Binding IsClientTrustError}"
                             IsAccent="{Binding IsClientTrustAccent}" ToolTip.Tip="{Binding ClientTrustTip}" />
            </WrapPanel>

            <DataGrid x:Name="AuthoritiesGrid" ItemsSource="{Binding Authorities}" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                      SelectionMode="Single" MaxHeight="300" Classes="wrapRows">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*" MinWidth="140" x:DataType="vm:AuthorityRowViewModel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:AuthorityRowViewModel">
                      <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Tooltip}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kind" Width="Auto" MinWidth="120" Binding="{Binding KindText}" x:DataType="vm:AuthorityRowViewModel" />
                <DataGridTextColumn Header="Valid until" Width="Auto" MinWidth="100" Binding="{Binding ValidUntil}" x:DataType="vm:AuthorityRowViewModel" />
                <DataGridTemplateColumn Header="Used by" Width="*" MinWidth="120" x:DataType="vm:AuthorityRowViewModel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:AuthorityRowViewModel">
                      <TextBlock Text="{Binding UsedBy}" ToolTip.Tip="{Binding UsedBy}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto" MinWidth="160" x:DataType="vm:AuthorityRowViewModel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:AuthorityRowViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,0">
                        <Button Classes="link" Content="View"
                                Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).ViewAuthorityCommand}" CommandParameter="{Binding}" />
                        <Button Classes="link" Content="Export" IsVisible="{Binding IsExportable}" ToolTip.Tip="Save this CA certificate (PEM, public only)"
                                Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).ExportAuthorityCommand}" CommandParameter="{Binding}" />
                        <Button Classes="link danger" Content="Remove" IsVisible="{Binding IsRemovable}"
                                Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).RemoveAuthorityCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <!-- The actions of the OADM CA. -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <Button Classes="secondary" Command="{Binding InstallTrustCommand}" IsVisible="{Binding MayTrustServer}"
                      ToolTip.Tip="Install the CA certificate as trusted root on the server and on this computer (asks for administrator rights)">
                <ui:IconLabel Icon="{DynamicResource Icon.check}" Text="Install in trusted root store" />
              </Button>
              <Button Classes="secondary" IsEnabled="{Binding HasCa}" IsVisible="{Binding MayManage}"
                      ToolTip.Tip="Save the CA certificate without its key">
                <ui:IconLabel Icon="{DynamicResource Icon.export}" Text="Export public certificate" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="PEM (.crt)" Command="{Binding ExportCommand}" CommandParameter="pem" />
                    <MenuItem Header="DER (.cer)" Command="{Binding ExportCommand}" CommandParameter="der" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="secondary" Command="{Binding BackupCommand}" IsVisible="{Binding MayManage}"
                      ToolTip.Tip="Save the CA with its private key in a password-protected file">
                <ui:IconLabel Icon="{DynamicResource Icon.save}" Text="Back up" />
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- ============================== Policies ============================== -->
        <Border x:Name="PoliciesCard" Grid.Column="2" Classes="card" VerticalAlignment="Stretch" DataContext="{Binding Policies}" x:DataType="vm:PoliciesViewModel"
                IsVisible="{Binding IsShown}">
          <Panel>
            <StackPanel Spacing="12">
              <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
                <TextBlock Classes="cardTitle" Text="Policies" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Classes="secondary" Command="{Binding AddCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True">
                  <ui:IconLabel Icon="{DynamicResource Icon.add}" Text="Add policy" />
                </Button>
              </WrapPanel>
              <!-- The filter: one segment per group with kinds. -->
              <Border Classes="segmented" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Filters}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PolicyFilterViewModel">
                      <Button Classes="segment" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                              Command="{Binding $parent[ItemsControl].((vm:PoliciesViewModel)DataContext).SelectFilterCommand}" CommandParameter="{Binding Group}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <ui:ProgressRow Text="Reading the policies" IsVisible="{Binding IsReloading}" />
              <Panel>
                <DataGrid x:Name="PoliciesGrid" ItemsSource="{Binding Rows}" Classes="wrapRows" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                          SelectionMode="Single" MaxHeight="360">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="110" x:DataType="vm:PolicyRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PolicyRowViewModel">
                          <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kind" Width="Auto" MinWidth="100" Binding="{Binding Kind}" x:DataType="vm:PolicyRowViewModel" />
                    <DataGridTemplateColumn Header="Summary" Width="1.6*" MinWidth="140" x:DataType="vm:PolicyRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PolicyRowViewModel">
                          <StackPanel Margin="10,4" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <!-- An overlap a tag or site change made later: the warning in the row. -->
                            <ui:StatusChip Text="{Binding Warning}" IsWarning="True" MaxLines="2" ToolTip.Tip="{Binding Warning}" HorizontalAlignment="Left"
                                           IsVisible="{Binding HasWarning}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Devices" Width="1.2*" MinWidth="110" x:DataType="vm:PolicyRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PolicyRowViewModel">
                          <TextBlock Text="{Binding Devices}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Devices}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="76" x:DataType="vm:PolicyRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PolicyRowViewModel">
                          <!-- Row actions like the Permissions page: icon buttons in fixed places, Delete in red -->
                          <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0"
                                      IsVisible="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.MayManage}">
                            <Button Classes="toolbar iconOnly" ToolTip.Tip="Edit policy"
                                    Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.EditRowCommand}" CommandParameter="{Binding}">
                              <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                            </Button>
                            <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete"
                                    Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.DeleteRowCommand}" CommandParameter="{Binding}">
                              <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                            </Button>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,40,16,0" />
              </Panel>
              <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            </StackPanel>
            <ui:LoadingOverlay Text="Reading the policies" IsVisible="{Binding IsLoading}" />
          </Panel>
        </Border>
      </Grid>

      <!-- ============================== Certificates ============================== -->
      <!-- The shared list of issued certificates (filters, search, pages, View certificate); the page adds Revoke. -->
      <Border Classes="card" Height="620">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock Grid.Row="0" Classes="cardTitle" Text="Certificates" />
          <ui:IssuedCertificateList Grid.Row="1" x:Name="CertificatesList" DataContext="{Binding Certificates}" x:DataType="vm:IssuedCertificatesViewModel">
            <ui:IssuedCertificateList.Toolbar>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="toolbar" Command="{Binding ViewCertificateCommand}" ToolTip.Tip="Also a double click on a row">
                  <ui:IconLabel Icon="{StaticResource Icon.details}" Text="View certificate" Spacing="8" />
                </Button>
                <Button Classes="toolbar danger" Command="{Binding RevokeCommand}" IsVisible="{Binding MayRevoke}">
                  <ui:IconLabel Icon="{StaticResource Icon.cancel}" Text="Revoke" Spacing="8" />
                </Button>
              </StackPanel>
            </ui:IssuedCertificateList.Toolbar>
            <ui:IssuedCertificateList.RowContextMenu>
              <ContextMenu>
                <MenuItem Header="View certificate" Command="{Binding ViewCertificateCommand}" />
                <Separator IsVisible="{Binding MayRevoke}" />
                <MenuItem Header="Revoke" Command="{Binding RevokeCommand}" IsVisible="{Binding MayRevoke}" />
                <MenuItem Header="Revoke all of this device" Command="{Binding RevokeDeviceCommand}" IsVisible="{Binding MayRevoke}" />
              </ContextMenu>
            </ui:IssuedCertificateList.RowContextMenu>
          </ui:IssuedCertificateList>
        </Grid>
      </Border>

      <!-- ============================== Device certificates ============================== -->
      <Border Classes="card">
        <StackPanel Classes="form" IsEnabled="{Binding MayManage}">
          <ui:CardHeader Title="Device certificates" />
          <ui:FormField Label="Certificate validity (days)" InputWidth="460">
            <TextBox Text="{Binding DeviceCertValidityDays}" />
          </ui:FormField>
          <!-- Saved with the IEEE 802.1X settings: one Save at the end of the last settings card -->
        </StackPanel>
      </Border>

      <!-- ============================== IEEE 802.1X ============================== -->
      <Border Classes="card">
        <StackPanel Classes="form" IsEnabled="{Binding MayManage}">
          <ui:CardHeader Title="IEEE 802.1X" />
          <ui:FormField Label="EAPOL version" InputWidth="460">
            <ComboBox ItemsSource="{Binding EapolChoices}" SelectedItem="{Binding EapolVersion}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:Choice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FormField>
          <ui:FormField Label="EAP identity" InputWidth="460">
            <ComboBox ItemsSource="{Binding IdentityChoices}" SelectedItem="{Binding Identity}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:Choice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FormField>
          <ui:FormField Label="Custom identity" InputWidth="460" IsVisible="{Binding IsCustomIdentity}" Hint="{}{serial} and {hostName} are replaced">
            <TextBox Text="{Binding CustomIdentity}" PlaceholderText="e.g. axis-{serial}" />
          </ui:FormField>
          <ui:FormField Label="RADIUS server CA" InputWidth="460">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <ComboBox ItemsSource="{Binding RadiusChoices}" SelectedItem="{Binding RadiusCa}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:Choice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Margin="10,0,0,0" Classes="secondary" Content="Import" Command="{Binding ImportRadiusCaCommand}" IsVisible="{Binding IsRadiusImported}"
                      ToolTip.Tip="Choose the CA certificate (.crt or .cer) that issued the RADIUS server's certificate" />
              <Button Grid.Column="2" Margin="10,0,0,0" Classes="secondary" Content="View" Command="{Binding ViewRadiusCaCommand}" IsVisible="{Binding IsRadiusImported}" />
            </Grid>
          </ui:FormField>
          <ui:FormField Classes="wide" IsVisible="{Binding IsRadiusImported}">
            <TextBlock Classes="secondary" Text="{Binding RadiusCaLine}" TextWrapping="Wrap" />
          </ui:FormField>
          <ui:FormField InputWidth="460">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
              <ui:StatusChip Text="{Binding SaveResult}" IsOk="True" IsVisible="{Binding SaveResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                      ToolTip.Tip="{Binding FormError}" ToolTip.ShowOnDisabled="True" />
            </StackPanel>
          </ui:FormField>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
