<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PkiView"
             x:DataType="vm:PkiViewModel"
             ui:PageHeader.Subtitle="Certificates, their policies, and the 802.1X and EST servers.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), shared controls and theme classes only (docs/spec/pki.md "The PKI page"):
       fixed tabs Certificates | 802.1X server | EST server. Certificates: Policies full width, then the certificate list
       full width with the CAs and their actions in it (no card of the CAs). -->
  <Grid RowDefinitions="Auto,*">
  <!-- The fixed tabs (docs/spec/pki.md "The PKI page"): Certificates, then the server pages the host hands over (only those
       the role may show); no row without a server tab. -->
  <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}" Margin="0,0,0,8">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:PkiTabViewModel">
        <ui:PageTab Title="{Binding Title}" IsActive="{Binding IsActive}" ActivateCommand="{Binding ActivateCommand}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

  <!-- A server tab: its page's own view (only the shown tab's view is in the window). -->
  <ContentControl Grid.Row="1" Content="{Binding ActiveTabView}" IsVisible="{Binding !IsCertificatesTab}" />

  <ScrollViewer x:Name="CertificatesPage" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsCertificatesTab}">
    <StackPanel Spacing="{DynamicResource Oadm.Gap}">
      <!-- ============================== Policies ============================== -->
      <Border x:Name="PoliciesCard" Classes="card" DataContext="{Binding Policies}" x:DataType="vm:PoliciesViewModel"
              IsVisible="{Binding IsShown}">
        <Panel>
          <StackPanel Spacing="12">
            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
              <TextBlock Classes="cardTitle" Text="Policies" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Classes="secondary" Command="{Binding AddCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True">
                <ui:IconLabel Icon="{DynamicResource Icon.add}" Text="Add policy" />
              </Button>
            </WrapPanel>
            <!-- The filter: one segment per group with kinds. -->
            <Border Classes="segmented" HorizontalAlignment="Left">
              <ItemsControl ItemsSource="{Binding Filters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PolicyFilterViewModel">
                    <Button Classes="segment" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                            Command="{Binding $parent[ItemsControl].((vm:PoliciesViewModel)DataContext).SelectFilterCommand}" CommandParameter="{Binding Group}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <ui:ProgressRow Text="Reading the policies" IsVisible="{Binding IsReloading}" />
            <Panel>
              <DataGrid x:Name="PoliciesGrid" ItemsSource="{Binding Rows}" Classes="wrapRows" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                        SelectionMode="Single" MaxHeight="360">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Name" Width="*" MinWidth="110" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Kind" Width="Auto" MinWidth="100" Binding="{Binding Kind}" x:DataType="vm:PolicyRowViewModel" />
                  <DataGridTemplateColumn Header="Summary" Width="2.6*" MinWidth="160" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <StackPanel Margin="10,4" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <!-- An overlap a tag or site change made later: the warning in the row. -->
                          <ui:StatusChip Text="{Binding Warning}" IsWarning="True" MaxLines="2" ToolTip.Tip="{Binding Warning}" HorizontalAlignment="Left"
                                         IsVisible="{Binding HasWarning}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Devices" Width="1.2*" MinWidth="110" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <TextBlock Text="{Binding Devices}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Devices}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="76" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <!-- Row actions like the Permissions page: icon buttons in fixed places, Delete in red -->
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0"
                                    IsVisible="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.MayManage}">
                          <Button Classes="toolbar iconOnly" ToolTip.Tip="Edit policy"
                                  Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.EditRowCommand}" CommandParameter="{Binding}">
                            <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                          </Button>
                          <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete"
                                  Command="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.DeleteRowCommand}" CommandParameter="{Binding}">
                            <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,40,16,0" />
            </Panel>
            <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
          </StackPanel>
          <ui:LoadingOverlay Text="Reading the policies" IsVisible="{Binding IsLoading}" />
        </Panel>
      </Border>

      <!-- ============================== Certificates ============================== -->
      <!-- The shared certificate list (Group by, filters, search, pages, View certificate) with the CAs as rows; the page
           adds the title with Create, Sign request and Import in its toolbar row and the actions of each kind of row. -->
      <!-- As high as the rest of the page (PkiView.FitList), at least MinListHeight: the page scrolls below that. -->
      <Border x:Name="CertificatesCard" Classes="card" Height="680">
          <!-- Each row's actions: its ⋯ button and its right-click menu, one menu (IssuedCertificatesViewModel.ActionsOf). -->
          <!-- One row: the title and Create, Sign request, Import left; Group by, the filters and Search right (below as a whole
               on a narrow card). The OADM CA when it needs attention below that row. -->
          <ui:IssuedCertificateList x:Name="CertificatesList" DataContext="{Binding Certificates}" x:DataType="vm:IssuedCertificatesViewModel">
            <ui:IssuedCertificateList.Toolbar>
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}">
                  <TextBlock Classes="cardTitle" Text="Certificates" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Classes="secondary" IsVisible="{Binding MayManage}">
                    <ui:IconLabel Icon="{DynamicResource Icon.add}" Text="Create" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="Certificate" Command="{Binding Certificates.CreateCommand}" ToolTip.Tip="OADM makes the key and the certificate" />
                        <MenuItem Header="New OADM CA" Command="{Binding GenerateCommand}" ToolTip.Tip="It replaces the OADM CA" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <Button Classes="secondary" Command="{Binding Certificates.SignRequestCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="A request of another system; its key stays there">
                    <ui:IconLabel Icon="{DynamicResource Icon.edit}" Text="Sign request" />
                  </Button>
                  <Button Classes="secondary" IsVisible="{Binding MayManage}">
                    <ui:IconLabel Icon="{DynamicResource Icon.upload}" Text="Import" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="Certificate" Command="{Binding Certificates.ImportCommand}" ToolTip.Tip="A certificate, or a .p12 file with its key" />
                        <MenuItem Header="CA">
                          <MenuItem Header="Own CA with its key" Command="{Binding ImportCommand}" ToolTip.Tip="It replaces the OADM CA (.pfx, .p12 or PEM files)" />
                          <MenuItem Header="CA certificate only" Command="{Binding ImportAuthorityCommand}" ToolTip.Tip="A root or intermediate certificate for the policies" />
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </WrapPanel>
            </ui:IssuedCertificateList.Toolbar>
            <ui:IssuedCertificateList.Banner>
                <StackPanel Spacing="8" Margin="0,8,0,0" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}"
                          IsVisible="{Binding ShowCaNotice}">
                  <ui:ProgressRow Text="Creating the certificate authority. This takes a few seconds." IsVisible="{Binding IsGenerating}" />
                  <TextBlock Classes="secondary" Text="{Binding NoCaText}" IsVisible="{Binding HasNoCa}" TextWrapping="Wrap" />
                  <ui:StatusChip Text="{Binding StatusText}" Detail="{Binding StatusDetail}" IsWarning="{Binding IsStatusWarning}" IsError="{Binding IsStatusError}"
                                 MaxLines="2" IsVisible="{Binding ShowCaStatus}" />
                </StackPanel>
            </ui:IssuedCertificateList.Banner>
          </ui:IssuedCertificateList>
      </Border>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
