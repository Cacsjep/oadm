<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PkiView"
             x:DataType="vm:PkiViewModel"
             ui:PageHeader.Subtitle="Certificates, their policies, and the 802.1X and EST servers.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), shared controls and theme classes only (docs/spec/pki.md "The PKI page"):
       fixed tabs Certificates | Policies | 802.1X server | EST server. Certificates: the certificate list with the CAs and
       their actions in it (no card of the CAs). Policies: the policy table, as high as the page. -->
  <Grid RowDefinitions="Auto,*">
  <!-- The fixed tabs (docs/spec/pki.md "The PKI page"): Certificates, Policies, then the server pages the host hands over (only those
       the role may show); no row without a server tab. -->
  <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}" Margin="0,0,0,8">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:PkiTabViewModel">
        <ui:PageTab Title="{Binding Title}" IsActive="{Binding IsActive}" ActivateCommand="{Binding ActivateCommand}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

  <!-- A server tab: its page's own view (only the shown tab's view is in the window). -->
  <ContentControl Grid.Row="1" Content="{Binding ActiveTabView}" IsVisible="{Binding IsServerTab}" />

  <!-- ============================== Policies ============================== -->
  <Border x:Name="PoliciesCard" Grid.Row="1" Classes="card" DataContext="{Binding Policies}" x:DataType="vm:PoliciesViewModel"
          IsVisible="{Binding $parent[vm:PkiView].((vm:PkiViewModel)DataContext).IsPoliciesTab}">
        <Panel>
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
              <TextBlock Classes="cardTitle" Text="Policies" VerticalAlignment="Center" Margin="0,0,12,0" />
              <!-- Flat toolbar buttons like the device toolbar (decision 2026-10-25); Add policy is the accent one. -->
              <ui:ToolbarButton Text="Add policy" IconKey="add" IsPrimary="True" Command="{Binding AddCommand}" IsVisible="{Binding MayManage}"
                                ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True" />
            </WrapPanel>
            <!-- No filter (decision 2026-10-25): the table groups by what the policies do (PkiView.GroupPolicies). -->
            <ui:ProgressRow Grid.Row="1" Text="Reading the policies" IsVisible="{Binding IsReloading}" />
            <Panel Grid.Row="2">
              <DataGrid x:Name="PoliciesGrid" Classes="wrapRows" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                        SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Name" Width="0.6*" MinWidth="110" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- System (OADM needs it, no Delete; purple) or User (blue). -->
                  <DataGridTemplateColumn Header="Type" Width="Auto" MinWidth="90" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <Border Classes="badge" Classes.system="{Binding IsSystem}" Classes.user="{Binding !IsSystem}" Margin="10,4"
                                HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding OriginTip}">
                          <TextBlock Text="{Binding Origin}" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Kind" Width="Auto" MinWidth="100" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <Border Classes="badge neutral" Margin="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Kind}" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Summary" Width="3.4*" MinWidth="160" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <StackPanel Margin="10,4" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Classes="secondary" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <!-- An overlap a tag or site change made later: the warning in the row. -->
                          <ui:StatusChip Text="{Binding Warning}" IsWarning="True" MaxLines="2" ToolTip.Tip="{Binding Warning}" HorizontalAlignment="Left"
                                         IsVisible="{Binding HasWarning}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Devices" Width="1.2*" MinWidth="110" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <TextBlock Text="{Binding Devices}" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Devices}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="52" x:DataType="vm:PolicyRowViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PolicyRowViewModel">
                        <!-- One ⋯ button with the row's actions, like the certificate tables: Edit, then Delete in red (not for
                             system policies). -->
                        <Button Classes="toolbar iconOnly" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{x:Static ui:RowActions.Tip}"
                                Click="OnPolicyActions" IsVisible="{Binding $parent[UserControl].((vm:PkiViewModel)DataContext).Policies.MayManage}">
                          <ui:OadmIcon Data="{StaticResource Icon.more}" />
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,40,16,0" />
            </Panel>
            <TextBlock Grid.Row="3" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
          </Grid>
          <ui:LoadingOverlay Text="Reading the policies" IsVisible="{Binding IsLoading}" />
        </Panel>
  </Border>

  <!-- The two cards share the tab's height; the splitter between them gives one more room (like the tasks pane). -->
  <Grid x:Name="CertificatesPage" Grid.Row="1" IsVisible="{Binding IsCertificatesTab}">
    <Grid.RowDefinitions>
      <!-- At least the toolbar row, the header, a few rows and the pages: the cards never get smaller than their content. -->
      <RowDefinition Height="300" MinHeight="250" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="300" />
    </Grid.RowDefinitions>

      <!-- ============================== Certificate authorities ============================== -->
      <!-- The CAs in their own table (decision 2026-10-25): the shared list without groups and filters (search stays), the CA
           rows' actions in the ⋯ menu; New OADM CA and the CA imports in its toolbar row. The OADM CA when it needs attention
           below that row. -->
      <Border x:Name="AuthoritiesCard" Grid.Row="0" Classes="card" ClipToBounds="True">
          <ui:IssuedCertificateList x:Name="AuthoritiesList" DataContext="{Binding Authorities}" x:DataType="vm:IssuedCertificatesViewModel">
            <ui:IssuedCertificateList.Toolbar>
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}">
                  <TextBlock Classes="cardTitle" Text="Certificate authorities" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <!-- Flat toolbar buttons like the device toolbar; the tab's accent button is the certificates' Create. -->
                  <ui:ToolbarButton Text="New OADM CA" IconKey="add" Command="{Binding GenerateCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="It replaces the OADM CA" />
                  <ui:ToolbarButton Text="Import" IconKey="upload" IsVisible="{Binding MayManage}">
                    <ui:ToolbarButton.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="CA certificate" Command="{Binding ImportAuthorityCommand}" ToolTip.Tip="A root or intermediate certificate for the policies" />
                        <MenuItem Header="CA with its key" Command="{Binding ImportCommand}" ToolTip.Tip="It can then issue certificates (.pfx, .p12 or PEM files)" />
                      </MenuFlyout>
                    </ui:ToolbarButton.Flyout>
                  </ui:ToolbarButton>
                </WrapPanel>
            </ui:IssuedCertificateList.Toolbar>
            <ui:IssuedCertificateList.Banner>
                <StackPanel Spacing="8" Margin="0,8,0,0" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}"
                          IsVisible="{Binding ShowCaNotice}">
                  <ui:ProgressRow Text="Creating the certificate authority. This takes a few seconds." IsVisible="{Binding IsGenerating}" />
                  <TextBlock Classes="secondary" Text="{Binding NoCaText}" IsVisible="{Binding HasNoCa}" TextWrapping="Wrap" />
                  <ui:StatusChip Text="{Binding StatusText}" Detail="{Binding StatusDetail}" IsWarning="{Binding IsStatusWarning}" IsError="{Binding IsStatusError}"
                                 MaxLines="2" IsVisible="{Binding ShowCaStatus}" />
                </StackPanel>
            </ui:IssuedCertificateList.Banner>
          </ui:IssuedCertificateList>
      </Border>

      <!-- ============================== Certificates ============================== -->
      <!-- The shared certificate list (Group by, filters, search, pages, View certificate) without the CAs; the page adds
           the title with Create, Sign request and Import in its toolbar row and the actions of each kind of row. -->
      <GridSplitter x:Name="CertificatesSplitter" Grid.Row="1" Classes="paneSplitter" />

      <Border x:Name="CertificatesCard" Grid.Row="2" Classes="card" ClipToBounds="True">
          <!-- Each row's actions: its ⋯ button and its right-click menu, one menu (IssuedCertificatesViewModel.ActionsOf). -->
          <ui:IssuedCertificateList x:Name="CertificatesList" DataContext="{Binding Certificates}" x:DataType="vm:IssuedCertificatesViewModel">
            <ui:IssuedCertificateList.Toolbar>
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" x:DataType="vm:PkiViewModel" DataContext="{Binding $parent[vm:PkiView].DataContext}">
                  <TextBlock Classes="cardTitle" Text="Certificates" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ui:ToolbarButton Text="Create" IconKey="add" IsPrimary="True" Command="{Binding Certificates.CreateCommand}" IsVisible="{Binding MayManage}"
                                    ToolTip.Tip="OADM makes the key and the certificate" />
                  <ui:ToolbarButton Text="Sign request" IconKey="edit" Command="{Binding Certificates.SignRequestCommand}" IsVisible="{Binding MayManage}"
                                    ToolTip.Tip="A request of another system; its key stays there" />
                  <ui:ToolbarButton Text="Import" IconKey="upload" Command="{Binding Certificates.ImportCommand}" IsVisible="{Binding MayManage}"
                                    ToolTip.Tip="A certificate, or a .p12 file with its key" />
                </WrapPanel>
            </ui:IssuedCertificateList.Toolbar>
          </ui:IssuedCertificateList>
      </Border>
  </Grid>
  </Grid>
</UserControl>
