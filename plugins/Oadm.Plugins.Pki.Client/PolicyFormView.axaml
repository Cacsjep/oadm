<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Pki.Client"
             x:Class="Oadm.Plugins.Pki.Client.PolicyFormView"
             x:DataType="vm:PolicyEditorViewModel">
  <!-- The policy's form on the right of the Policies tab (decision 2026-10-25): what the kind does, the name (not for a system
       policy), the kind's own fields (the kind is preset by Add: no kind choice) and the devices (All devices, or the shared
       picker behind Choose devices). Read only for users who may not change the policies. -->
  <StackPanel Classes="form" IsEnabled="{Binding IsEditable}">
    <TextBlock Classes="secondary" Text="{Binding KindHint}" TextWrapping="Wrap" />
    <ui:FormField Label="Name" InputWidth="360" IsVisible="{Binding ShowsName}">
      <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="64" PlaceholderText="{Binding NamePlaceholder}" />
    </ui:FormField>
    <!-- 802.1X server and EST server: the certificate the server shows, from the Certificates list (decision 2026-10-25; OADM
         makes one for both when OADM PRO becomes active, other ones come from the Certificates tab). -->
    <ui:FormField Label="Certificate" InputWidth="440" Hint="{Binding CertificateHint}" IsVisible="{Binding IsServerKind}">
      <Panel>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CertificateChoices}" SelectedItem="{Binding Certificate}" IsVisible="{Binding !HasNoCertificates}" />
        <TextBlock Classes="secondary" Text="{x:Static vm:PolicyEditorViewModel.NoCertificatesText}" VerticalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding HasNoCertificates}" />
      </Panel>
    </ui:FormField>
    <ui:FormField Label="VLAN ID" IsVisible="{Binding IsVlan}">
      <TextBox Text="{Binding Vlan}" Width="120" HorizontalAlignment="Left" PlaceholderText="1 to 4094" />
    </ui:FormField>
    <ui:FormField Label="Days before the end" IsVisible="{Binding IsExpiry}">
      <TextBox Text="{Binding Days}" Width="120" HorizontalAlignment="Left" PlaceholderText="1 to 365" />
    </ui:FormField>

    <!-- Issuing (HTTPS, IEEE 802.1X): the CA that issues (any CA with its key), valid days and the key -->
    <ui:FormField Label="Issued by" InputWidth="360" IsVisible="{Binding IsIssuing}">
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding IssuingCaChoices}" SelectedItem="{Binding IssuingCa}" />
    </ui:FormField>
    <ui:FormField Label="Valid (days)" IsVisible="{Binding IsIssuing}">
      <TextBox Text="{Binding ValidDays}" Width="120" HorizontalAlignment="Left" PlaceholderText="1 to 3650" />
    </ui:FormField>
    <ui:FormField Label="Key" IsVisible="{Binding IsIssuing}">
      <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.KeyChoices}" SelectedItem="{Binding Key}" />
    </ui:FormField>

    <!-- IEEE 802.1X certificate: the settings of the former IEEE 802.1X card -->
    <ui:FormField Label="EAPOL version" IsVisible="{Binding IsDot1xCertificate}">
      <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.EapolChoices}" SelectedItem="{Binding Eapol}" />
    </ui:FormField>
    <ui:FormField Label="EAP identity" IsVisible="{Binding IsDot1xCertificate}">
      <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.IdentityChoices}" SelectedItem="{Binding Identity}" />
    </ui:FormField>
    <ui:FormField Label="Custom identity" InputWidth="360" Hint="{}{serial} and {hostName} are replaced">
      <ui:FormField.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsDot1xCertificate" />
          <Binding Path="IsCustomIdentity" />
        </MultiBinding>
      </ui:FormField.IsVisible>
      <TextBox Text="{Binding CustomIdentity}" PlaceholderText="e.g. axis-{serial}" />
    </ui:FormField>
    <!-- A CA of the list (decision 2026-10-25: imported on the Certificates page, no import here); the hint names the CA of the
         802.1X server's certificate. -->
    <ui:FormField Label="RADIUS server CA" InputWidth="360" Hint="{Binding RadiusCaHint}" IsVisible="{Binding IsDot1xCertificate}">
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RadiusCaChoices}" SelectedItem="{Binding RadiusCa}" />
    </ui:FormField>

    <!-- EST sign-in CA: the CA (Axis device ID, OADM CA, previous OADM CAs) and what cameras may sign in with it for -->
    <ui:FormField Label="CA" InputWidth="360" IsVisible="{Binding IsSignInCa}">
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SignInCaChoices}" SelectedItem="{Binding SignInCa}" />
    </ui:FormField>
    <ui:FormField Label="For" Hint="{Binding SignInForHint}" IsVisible="{Binding IsSignInCa}">
      <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.SignInForChoices}" SelectedItem="{Binding SignInFor}" />
    </ui:FormField>

    <!-- Enrollment: all profiles, chosen ones (a few check boxes: no virtualization needed) or no enrollment -->
    <ui:FormField Label="Profiles" Error="{Binding ProfilesError}" IsVisible="{Binding IsEnrollment}">
      <StackPanel Spacing="8">
        <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.ProfileScopeChoices}" SelectedItem="{Binding ProfileScope}" />
        <ItemsControl ItemsSource="{Binding ProfileChoices}" IsVisible="{Binding IsChosenProfiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EnrollmentProfileViewModel">
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="secondary" Text="{Binding ProfilesEmptyText}">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsChosenProfiles" />
              <Binding Path="ProfilesEmptyText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
      </StackPanel>
    </ui:FormField>

    <!-- Kinds with devices: All devices, or the chosen ones with Choose devices (the shared
         picker in its group mode); the devices' error below. A system policy's devices change too. -->
    <ui:FormField Label="Devices" InputWidth="440" Error="{Binding DevicesError}" IsVisible="{Binding ShowsDevicesField}">
      <StackPanel Spacing="8">
        <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.DeviceScopes}" SelectedItem="{Binding Scope}"
                  IsVisible="{Binding ShowsDeviceScope}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding ShowsPicker}">
          <TextBlock Classes="secondary" Text="{Binding DevicesText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Command="{Binding ChooseDevicesCommand}" VerticalAlignment="Center">
            <ui:IconLabel Icon="{DynamicResource Icon.device.camera}" Text="Choose devices" />
          </Button>
        </Grid>
      </StackPanel>
    </ui:FormField>

    <!-- 802.1X trusted CA -->
    <ui:FormField Label="CA" InputWidth="360" IsVisible="{Binding IsAllowCa}">
      <StackPanel Spacing="8">
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CaChoices}" SelectedItem="{Binding Ca}" />
        <CheckBox Content="{x:Static vm:PolicyEditorViewModel.OnlyManagedText}" IsChecked="{Binding OnlyManaged}"
                  ToolTip.Tip="{x:Static vm:PolicyEditorViewModel.OnlyManagedTip}" />
      </StackPanel>
    </ui:FormField>

    <!-- 802.1X server -->
    <ui:FormField Label="Minimum TLS version" Hint="{Binding TlsHint}" IsVisible="{Binding IsServer}">
      <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{x:Static vm:PolicyEditorViewModel.TlsVersions}" SelectedItem="{Binding MinimumTls}" />
    </ui:FormField>
    <ui:FormField Label="Largest EAP packet" Hint="Bytes. The switch can ask for smaller packets." IsVisible="{Binding IsServer}">
      <TextBox Text="{Binding LargestPacket}" Width="120" HorizontalAlignment="Left" />
    </ui:FormField>
    <ui:FormField Label="Reauthentication" IsVisible="{Binding IsServer}">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <ComboBox Width="180" VerticalAlignment="Top" ItemsSource="{x:Static vm:PolicyEditorViewModel.ReauthChoices}" SelectedItem="{Binding Reauth}" />
        <ui:FormField Label="Minutes" LabelWidth="70" IsVisible="{Binding IsReauthEvery}">
          <TextBox Text="{Binding ReauthMinutes}" Width="120" HorizontalAlignment="Left" PlaceholderText="10 to 1,440" />
        </ui:FormField>
      </StackPanel>
    </ui:FormField>
  </StackPanel>
</UserControl>
