<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Radius.Client"
             xmlns:net="using:Oadm.Sdk.Network"
             xmlns:srv="using:Oadm.Plugins.Pki.Client.Servers"
             x:Class="Oadm.Plugins.Radius.Client.RadiusView"
             x:DataType="vm:RadiusViewModel"
             ui:PageHeader.Subtitle="Switches ask OADM which cameras may use their ports.">
  <!-- Own cards (ICorePluginPage.HasOwnCards), shared controls and theme classes only. One page, no tabs, two columns
       (decision 2026-10-25): Server above Switches left, the Sessions table (in progress on top, then the log) right, as high
       as the page; one column on narrower pages (RadiusView.Arrange). The rules are PKI's policies ("6 policies applied", a link left in the Save row). Users limited to a device group see
       the Sessions table only. Card headers: the title and its buttons in one row. -->
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource Oadm.Gap}">
      <!-- The server does not run (turned off, no OADM PRO, a start that failed): only the Server card with Turn on
           (docs/spec/pki.md "One plugin"). -->
      <Border Classes="card" HorizontalAlignment="Left" MinWidth="360" IsVisible="{Binding Server.ShowOffState}">
        <StackPanel Classes="form">
          <TextBlock Classes="cardTitle" Text="Server" />
          <srv:ServerSwitchView DataContext="{Binding Server}" />
        </StackPanel>
      </Border>

      <!-- Columns and rows set by RadiusView.Arrange (two columns or one); its height by RadiusView.FitSessions. -->
      <Grid x:Name="PageRows" IsVisible="{Binding Server.Running}" ColumnDefinitions="680,16,*" RowDefinitions="*,Auto">
      <Panel x:Name="TopCards" Grid.Row="0" Grid.Column="0" IsVisible="{Binding HasAllDevices}">
        <!-- Server above Switches; Switches takes the rest of the column. -->
        <Grid x:Name="CardColumns" RowDefinitions="Auto,16,*">
          <!-- ========== Server ========== -->
          <Border x:Name="ServerCard" Grid.Row="0" Classes="card" VerticalAlignment="Top">
            <StackPanel Classes="form">
              <TextBlock Classes="cardTitle" Text="Server" />
              <StackPanel Classes="form" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                <ui:FormField Label="Listen on" LabelWidth="110" InputWidth="290">
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Listen.Items}" SelectedItem="{Binding SelectedInterface}" IsEnabled="{Binding MayManage}"
                            ToolTip.Tip="The interface the switches reach this server on.">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="net:InterfaceOption">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </ui:FormField>
                <ui:FormField Label="Port" LabelWidth="110">
                  <TextBox Text="{Binding Port}" Width="120" HorizontalAlignment="Left" IsReadOnly="{Binding !MayManage}" />
                </ui:FormField>
                <ui:FormField Label="Log entries kept" LabelWidth="110">
                  <TextBox Text="{Binding LogKept}" Width="120" HorizontalAlignment="Left" IsReadOnly="{Binding !MayManage}" />
                </ui:FormField>
              </StackPanel>
              <!-- The status directly left of the Save it reports on. -->
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding MayManage}"
                        ToolTip.Tip="{Binding SaveTip}" ToolTip.ShowOnDisabled="True" />
                <!-- Turn off (for users who may change the server) between the status of the server and Save. -->
                <srv:ServerSwitchView DockPanel.Dock="Right" DataContext="{Binding Server}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- The rules are PKI's policies: "4 policies applied" opens them (decision 2026-10-25), left in the Save row. -->
                <Button x:Name="PoliciesLink" DockPanel.Dock="Left" Classes="link" Content="{Binding PoliciesText}" Command="{Binding EditInPkiCommand}" VerticalAlignment="Center"
                        IsVisible="{Binding PoliciesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,16,0" />
                <ui:StatusChip HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding StatusText}" IsOk="{Binding StatusOk}"
                               IsWarning="{Binding StatusWarning}" IsError="{Binding StatusError}" MaxLines="2" />
              </DockPanel>
              <TextBlock Classes="secondary" Text="{Binding SitesText}" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" IsVisible="{Binding HasSiteProblems}" />
              <TextBlock Classes="error" Text="{Binding ActionError}" TextWrapping="Wrap" HorizontalAlignment="Right" IsVisible="{Binding HasActionError}" />
            </StackPanel>
          </Border>

          <!-- ========== Switches ========== -->
          <Border x:Name="SwitchesCard" Grid.Row="2" Classes="card" VerticalAlignment="Stretch" DataContext="{Binding Switches}" x:DataType="vm:SwitchesViewModel">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="4" LineSpacing="8">
                <TextBlock Classes="cardTitle" Text="Switches" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- A flat toolbar button like the device toolbar; the page's accent button is Save. -->
                <ui:ToolbarButton Text="Add switch" IconKey="add" Command="{Binding AddCommand}" IsVisible="{Binding MayManage}"
                                  ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True" />
              </WrapPanel>
              <Panel Grid.Row="1" MinHeight="200">
                <!-- Name flexes; the others are wide enough for their longest text. -->
                <DataGrid x:Name="SwitchesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserSortColumns="True"
                          CanUserReorderColumns="False" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="*" MinWidth="110" Binding="{Binding Name}" x:DataType="vm:SwitchRowViewModel" />
                    <DataGridTextColumn Header="Address" Width="150" MinWidth="150" Binding="{Binding Address}" x:DataType="vm:SwitchRowViewModel" />
                    <DataGridTextColumn Header="Site" Width="110" MinWidth="110" Binding="{Binding Site}" x:DataType="vm:SwitchRowViewModel" />
                    <!-- No State column (decision 2026-10-25). -->
                    <DataGridTextColumn Header="Last request" Width="120" MinWidth="120" Binding="{Binding LastRequest}" SortMemberPath="LastRequestSortKey" x:DataType="vm:SwitchRowViewModel" />
                    <DataGridTemplateColumn Width="52" MinWidth="52" CanUserSort="False" x:DataType="vm:SwitchRowViewModel">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SwitchRowViewModel">
                          <!-- One ⋯ button with the row's actions (ui:RowActions): Edit, then Delete in red. -->
                          <Button Classes="toolbar iconOnly" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Actions" Click="OnSwitchActions"
                                  IsVisible="{Binding $parent[UserControl].((vm:RadiusViewModel)DataContext).Switches.MayManage}">
                            <ui:OadmIcon Data="{StaticResource Icon.more}" />
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,40,16,0" />
              </Panel>
            </Grid>
          </Border>
        </Grid>
        <ui:LoadingOverlay Text="Reading the 802.1X server" IsVisible="{Binding IsLoading}" />
      </Panel>

      <!-- ============================== Sessions ============================== -->
      <!-- One table (decision 2026-10-25): the authentications in progress on top, then the log's page, newest first. -->
      <Border x:Name="SessionsCard" Grid.Row="0" Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="cardTitle" Text="Sessions" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Classes="toolbar" Command="{Binding Log.ViewCertificateCommand}" ToolTip.Tip="Also a double click on a row">
                <ui:IconLabel Icon="{StaticResource Icon.details}" Text="View certificate" Spacing="8" />
              </Button>
              <Button Classes="toolbar danger" Command="{Binding Log.DeleteAllCommand}" IsVisible="{Binding Log.MayManage}">
                <ui:IconLabel Icon="{StaticResource Icon.remove}" Text="Delete all" Spacing="8" />
              </Button>
            </StackPanel>
            <ui:SearchBox Grid.Column="2" Text="{Binding Log.Search}" Placeholder="Search every column" Width="260" />
          </Grid>
          <ui:ProgressRow Grid.Row="1" Margin="0,8,0,0" Text="Reading the sessions" IsVisible="{Binding Authentications.IsReloading}" />
          <Panel Grid.Row="2" Margin="0,8,0,0">
            <!-- Columns wide enough for their content; Status flexes. -->
            <DataGrid x:Name="SessionsGrid" ItemsSource="{Binding Authentications.Rows}" SelectedItem="{Binding Authentications.Selected}" Classes="wrapRows"
                      IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Width="170" MinWidth="170" Binding="{Binding Time}" CellStyleClasses="dimmed" x:DataType="vm:IAuthenticationRow" />
                <DataGridTextColumn Header="Switch" Width="140" MinWidth="140" Binding="{Binding Switch}" x:DataType="vm:IAuthenticationRow" />
                <DataGridTextColumn Header="Port" Width="70" MinWidth="70" Binding="{Binding Port}" x:DataType="vm:IAuthenticationRow" />
                <DataGridTextColumn Header="EAP identity" Width="170" MinWidth="170" Binding="{Binding Identity}" x:DataType="vm:IAuthenticationRow" />
                <!-- The number only; the policy that gave it in the tooltip ("VLAN 30 by Building B"). -->
                <DataGridTemplateColumn Header="VLAN" Width="80" MinWidth="80" x:DataType="vm:IAuthenticationRow">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:IAuthenticationRow">
                      <TextBlock Text="{Binding Vlan}" ToolTip.Tip="{Binding VlanText}" Margin="10,4" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="*" MinWidth="220" x:DataType="vm:IAuthenticationRow">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:IAuthenticationRow">
                      <ui:StatusChip Text="{Binding Status}" Detail="{Binding StatusDetail}" IsOk="{Binding IsOk}" IsWarning="{Binding IsWarning}" IsError="{Binding IsError}"
                                     IsAccent="{Binding IsRunning}" ToolTip.Tip="{Binding StatusDetail}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="secondary" Text="{Binding Authentications.EmptyText}" IsVisible="{Binding Authentications.EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
            <ui:LoadingOverlay Text="Reading the sessions" IsVisible="{Binding Authentications.IsLoading}" />
          </Panel>
          <!-- A whole-table error directly below the table; the log's pages at the right. -->
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Classes="error" Text="{Binding Authentications.Error}" TextWrapping="Wrap" IsVisible="{Binding Authentications.HasError}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="{Binding Log.PageText}" VerticalAlignment="Center" />
              <Button Classes="toolbar" Command="{Binding Log.PreviousPageCommand}" IsVisible="{Binding Log.HasPages}" ToolTip.Tip="Previous 500">
                <ui:IconLabel Icon="{StaticResource Icon.chevronLeft}" Text="Previous" Spacing="4" />
              </Button>
              <Button Classes="toolbar" Command="{Binding Log.NextPageCommand}" IsVisible="{Binding Log.HasPages}" ToolTip.Tip="Next 500">
                <ui:IconLabel Icon="{StaticResource Icon.chevronRight}" Text="Next" Spacing="4" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
