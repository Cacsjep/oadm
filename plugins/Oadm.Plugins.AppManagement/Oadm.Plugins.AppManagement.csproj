<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Oadm.Plugins.AppManagement.Server</AssemblyName>
    <RootNamespace>Oadm.Plugins.AppManagement</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Folder name under artifacts/plugins/, must equal the id in plugin.json. -->
    <OadmPluginId>oadm.app-management</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host: never copy it (or its dependencies) into the plugin folder. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- The Applications plugin's own code (one source, compiled into this assembly too): list.cgi and its parser, the
       payload of its tasks, its permission keys and texts. A project reference would copy its *.Server.dll into this
       plugin folder, where the server loader would register its task plugin a second time. -->
  <ItemGroup>
    <Compile Include="..\Oadm.Plugins.Acap\ApplicationApiClient.cs" Link="Acap\ApplicationApiClient.cs" />
    <Compile Include="..\Oadm.Plugins.Acap\Shared\*.cs" Link="Acap\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\CachedApiCheck.cs" Link="Common\CachedApiCheck.cs" />
    <!-- The call without a user and the device id checks. -->
    <Compile Include="..\Shared\ContextCall.cs" Link="Common\ContextCall.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Plugins.AppManagement.Tests" />
  </ItemGroup>

  <!-- Development deployment: copy the output to artifacts/plugins/oadm.app-management/.
       The client part (Oadm.Plugins.AppManagement.Client) deploys into the same folder. -->
  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OADM plugin $(OadmPluginId) deployed to $(OadmPluginOutputDir)" />
  </Target>

</Project>
