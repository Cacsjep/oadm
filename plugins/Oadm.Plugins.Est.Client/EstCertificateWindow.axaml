<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:vm="using:Oadm.Plugins.Est.Client"
        xmlns:est="using:Oadm.Plugins.Est"
        x:Class="Oadm.Plugins.Est.Client.EstCertificateWindow"
        x:DataType="vm:EstCertificateViewModel"
        Title="{Binding Title}"
        Width="820" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- The certificate an enrollment issued: title bar, one card with its sections (validity, issued to and by, key, uses,
       names), footer with Close. Values can be selected and copied. Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{Binding Title}" />

    <ScrollViewer Grid.Row="1" Margin="16,0">
      <Border Classes="card">
        <StackPanel Spacing="20">
          <StackPanel Spacing="8">
            <ui:IconLabel Classes="sectionTitle" Icon="{StaticResource Icon.clock}" Text="Validity" />
            <ui:StatusChip Text="{Binding ValidityText}" IsOk="{Binding IsValid}" IsWarning="{Binding IsEndingSoon}" IsError="{Binding IsProblem}" />
            <StackPanel Classes="form">
              <ui:FormField Label="Valid from"><SelectableTextBlock Text="{Binding ValidFrom}" /></ui:FormField>
              <ui:FormField Label="Valid until"><SelectableTextBlock Text="{Binding ValidUntil}" /></ui:FormField>
            </StackPanel>
          </StackPanel>

          <Grid ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0" Spacing="8">
              <ui:IconLabel Classes="sectionTitle" Icon="{StaticResource Icon.device.camera}" Text="Issued to" />
              <ItemsControl ItemsSource="{Binding IssuedTo}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Classes="form" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="est:NameValue">
                    <ui:FormField Label="{Binding Name}"><SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" /></ui:FormField>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="8">
              <ui:IconLabel Classes="sectionTitle" Icon="{StaticResource Icon.shield}" Text="Issued by" />
              <ItemsControl ItemsSource="{Binding IssuedBy}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Classes="form" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="est:NameValue">
                    <ui:FormField Label="{Binding Name}"><SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" /></ui:FormField>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="8">
            <ui:IconLabel Classes="sectionTitle" Icon="{StaticResource Icon.key}" Text="Key and signature" />
            <StackPanel Classes="form">
              <ui:FormField Label="Key"><SelectableTextBlock Text="{Binding Key}" /></ui:FormField>
              <ui:FormField Label="Signature"><SelectableTextBlock Text="{Binding Signature}" /></ui:FormField>
              <ui:FormField Label="Version"><SelectableTextBlock Text="{Binding Version}" /></ui:FormField>
              <ui:FormField Label="Serial number"><SelectableTextBlock Classes="mono" Text="{Binding SerialNumber}" TextWrapping="Wrap" /></ui:FormField>
              <ui:FormField Label="SHA-256 fingerprint"><SelectableTextBlock Classes="mono" Text="{Binding Fingerprint}" TextWrapping="Wrap" /></ui:FormField>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8">
            <ui:IconLabel Classes="sectionTitle" Icon="{StaticResource Icon.check}" Text="Uses" />
            <SelectableTextBlock Text="{Binding Uses}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="8">
            <ui:IconLabel Classes="sectionTitle" Icon="{StaticResource Icon.globe}" Text="Names in the certificate" />
            <SelectableTextBlock Text="{Binding Names}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <ui:DialogFooter Grid.Row="2" CancelText="Close" CancelCommand="{Binding CloseCommand}" />
  </Grid>
</Window>
