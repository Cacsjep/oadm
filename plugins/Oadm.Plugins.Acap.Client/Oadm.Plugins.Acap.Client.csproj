<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Oadm.Plugins.Acap.Client</AssemblyName>
    <RootNamespace>Oadm.Plugins.Acap.Client</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <OadmPluginId>oadm.acap</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared from the host (PluginLoadContext.IsShared): compile against them, never copy them. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk.Client\Oadm.Sdk.Client.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <PackageReference Include="Avalonia" Version="12.1.3" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package parsing, compatibility rules and payload/query models (Shared/ in the server part). Both
         assemblies live in the same plugin folder, so the client resolves it from there; it contains no
         client-loader types and does not talk to devices from the client. -->
    <ProjectReference Include="..\Oadm.Plugins.Acap\Oadm.Plugins.Acap.csproj" />
  </ItemGroup>

  <!-- Development deployment next to the server part in artifacts/plugins/oadm.acap/. -->
  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OADM client plugin $(OadmPluginId) deployed to $(OadmPluginOutputDir)" />
  </Target>

</Project>
