<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.MetadataMonitor.Client"
             x:Class="Oadm.Plugins.MetadataMonitor.Client.MetadataMonitorView"
             x:DataType="vm:MetadataMonitorViewModel"
             ui:PageHeader.Subtitle="Shows the events a camera sends, live.">
  <!-- One card (the host's page card): camera and stream controls, filter, the message list, the selected message's XML.
       The description lives in the host page header; the status chip sits left of the Start / Stop button.
       Shared controls and theme classes only. -->
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto,260">
    <!-- One row: camera (type to jump) with Start / Stop right of it, filter, Clear, Autoscroll and the message count;
         the status on the right. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
      <ComboBox Grid.Column="0" Width="260" VerticalAlignment="Center" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                PlaceholderText="Choose a camera" IsTextSearchEnabled="True"
                ToolTip.Tip="Type to jump to a camera">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CameraOption">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ui:SearchBox Grid.Column="2" Width="220" VerticalAlignment="Center" Text="{Binding FilterText}" Placeholder="Filter events" />
      <Button Grid.Column="3" Classes="secondary" VerticalAlignment="Center" Content="Clear" Command="{Binding ClearCommand}"
              ToolTip.Tip="Empty the list; the stream keeps running" />
      <CheckBox Grid.Column="4" VerticalAlignment="Center" Content="Autoscroll" IsChecked="{Binding Autoscroll}"
                ToolTip.Tip="Keep the newest message visible" />
      <TextBlock Grid.Column="5" Classes="secondary" VerticalAlignment="Center" Text="{Binding SummaryText}" />
      <ui:StatusChip Grid.Column="7" VerticalAlignment="Center" IsVisible="{Binding HasStatus}"
                     Text="{Binding StatusText}" IsOk="{Binding IsStatusOk}" IsWarning="{Binding IsStatusWarning}"
                     IsError="{Binding IsStatusError}" IsAccent="{Binding IsStatusAccent}" ToolTip.Tip="{Binding StatusDetail}" />
      <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" MinWidth="72" HorizontalContentAlignment="Center"
              Content="{Binding StartStopText}"
              Command="{Binding StartStopCommand}" ToolTip.Tip="{Binding StartStopTip}" ToolTip.ShowOnDisabled="True" />
    </Grid>

    <!-- Up to 10,000 rows: virtualized, batches arrive as one collection change. -->
    <DataGrid x:Name="MessageGrid" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
              IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" MinHeight="160">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Seq#" Width="70" Binding="{Binding Seq}" x:DataType="vm:MessageRow" />
        <DataGridTextColumn Header="Timestamp" Width="180" Binding="{Binding Timestamp}" x:DataType="vm:MessageRow" />
        <!-- Hidden: every row says "Event" (the topic of a malformed message is empty and its XML shows the text) -->
        <DataGridTextColumn Header="Category" Width="100" Binding="{Binding Category}" IsVisible="False" x:DataType="vm:MessageRow" />
        <DataGridTextColumn Header="Event topic" Width="260" Binding="{Binding Topic}" x:DataType="vm:MessageRow" />
        <DataGridTextColumn Header="Capture time" Width="124" Binding="{Binding CaptureTime}" x:DataType="vm:MessageRow" />
        <DataGridTextColumn Header="Property operation" Width="160" Binding="{Binding Operation}" x:DataType="vm:MessageRow" />
        <DataGridTextColumn Header="Info" Width="*" Binding="{Binding Info}" x:DataType="vm:MessageRow" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Classes="secondary" Text="Choose a camera and press Start." IsVisible="{Binding ShowEmptyHint}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <!-- Splitter and detail only while a message is selected (code-behind collapses the row). -->
    <GridSplitter x:Name="DetailSplitter" Grid.Row="2" Classes="paneSplitter" IsVisible="{Binding HasDetail}" />

    <!-- The selected message's XML, always pretty-printed and highlighted (user decision: no Raw switch). -->
    <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding HasDetail}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Classes="secondary" Text="{Binding DetailTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Classes="toolbar iconOnly" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the XML of this message">
          <ui:OadmIcon Data="{DynamicResource Icon.copy}" />
        </Button>
      </Grid>
      <ui:CodeView Grid.Row="1" Text="{Binding DetailText}" Language="Xml" IsFormatted="True" />
    </Grid>
  </Grid>
</UserControl>
