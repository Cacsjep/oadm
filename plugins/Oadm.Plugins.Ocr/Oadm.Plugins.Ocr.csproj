<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Oadm.Plugins.Ocr.Server</AssemblyName>
    <RootNamespace>Oadm.Plugins.Ocr</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Folder name under artifacts/plugins/, must equal the id in plugin.json. -->
    <OadmPluginId>oadm.ocr</OadmPluginId>
    <OadmPluginOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'plugins', '$(OadmPluginId)'))</OadmPluginOutputDir>
    <!-- An add-on (docs/spec/add-ons.md): never in the OADM installers or ZIPs, its own release ZIP per platform. Read by
         the publish scripts (manage.ps1, manage.sh, release.yml; package A4 of the build plan). -->
    <OadmAddOn>true</OadmAddOn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host: never copy it (or its dependencies) into the plugin folder. -->
    <ProjectReference Include="..\..\src\Oadm.Sdk\Oadm.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Recognition (docs/spec/ocr.md "GPU" and "Packaging and dependencies"): ONNX Runtime per server platform, chosen by the
       target RID (the add-on ZIP builds per RID) or, without one, by the building machine. Each uses the
       Microsoft.ML.OnnxRuntime.Managed version of its own runtime (osx-x64 stays on 1.23.2, the last with Intel Mac libraries). Windows: DirectML (any graphics card) plus the CPU; Linux x64: the GPU build
       with the CUDA provider plus the CPU; everything else: the CPU build. -->
  <PropertyGroup>
    <OcrOnnxRuntimeVersion>1.24.4</OcrOnnxRuntimeVersion>
    <OcrRid>$(RuntimeIdentifier)</OcrRid>
    <OcrRid Condition="'$(OcrRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</OcrRid>
    <!-- 1.24 dropped Intel Macs: 1.23.2 is the last package with osx-x64 natives. -->
    <OcrOnnxRuntimeVersion Condition="'$(OcrRid)' == 'osx-x64'">1.23.2</OcrOnnxRuntimeVersion>
  </PropertyGroup>
  <ItemGroup Condition="$(OcrRid.StartsWith('win'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OcrOnnxRuntimeVersion)" />
    <!-- DirectML.dll copies itself only for an x64 PlatformTarget; place it next to onnxruntime.dll, which loads it (the
         one in System32 is too old). -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" />
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" Link="runtimes\win-x64\native\DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- DirectML.dll ships outside deps.json: its own license (MICROSOFT SOFTWARE LICENSE TERMS - DIRECTML) goes into the
         optional plugin's THIRD-PARTY-NOTICES.txt through this item (the addon mode of tools/Oadm.Notices). -->
    <OadmNoticePackage Include="Microsoft.AI.DirectML" Version="1.15.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(OcrRid)' == 'linux-x64'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="$(OcrOnnxRuntimeVersion)" />
  </ItemGroup>
  <ItemGroup Condition="!$(OcrRid.StartsWith('win')) and '$(OcrRid)' != 'linux-x64'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OcrOnnxRuntimeVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- JPEG decode, crop, turn and bicubic scale. The version of the host's Avalonia.Skia, so one process never holds two. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- Linux servers without fontconfig and freetype; private: the client and the tests bring Avalonia's own Linux assets. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" PrivateAssets="all" Publish="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The character list and the models' license (Models/README.md): next to the server part in the plugin folder. -->
    <None Include="Models\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The models themselves: downloaded at build into a local cache, checked and copied into Models\ (never in git). -->
  <Import Project="Models\Models.targets" />

  <ItemGroup>
    <!-- The call without a user (the host itself, tests). -->
    <Compile Include="..\Shared\ContextCall.cs" Link="Common\ContextCall.cs" />
    <!-- The frame source, the engine and the picture limits shared with Vision Center (docs/spec/vision-center.md "Parts and contract"). -->
    <Compile Include="..\Shared\Vision\**\*.cs" Link="Shared\Vision\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Oadm.Plugins.Shared.Vision" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oadm.Plugins.Ocr.Tests" />
  </ItemGroup>

  <!-- Development deployment: copy the output to artifacts/plugins/oadm.ocr/.
       The client part (Oadm.Plugins.Ocr.Client) deploys into the same folder. -->
  <Target Name="OadmDeployPlugin" AfterTargets="Build" Condition="'$(OadmSkipPluginDeploy)' != 'true'">
    <ItemGroup>
      <_OadmPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OadmPluginFiles)" DestinationFiles="@(_OadmPluginFiles->'$(OadmPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="OADM plugin $(OadmPluginId) deployed to $(OadmPluginOutputDir)" />
  </Target>

</Project>
