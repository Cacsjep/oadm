<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:sdk="using:Oadm.Sdk.Client"
        xmlns:vm="using:Oadm.Plugins.Provisioning.Client"
        x:Class="Oadm.Plugins.Provisioning.Client.ProvisioningWindow"
        x:DataType="vm:ProvisioningDialogViewModel"
        Title="{x:Static sdk:DeviceTexts.Provisioning}"
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        WindowDecorations="BorderOnly">
  <!-- Provisioning management (docs/spec/provisioning.md "Where it lives"): a card with the On / Off switch (its refusal
       directly below it), the active profile and the warnings; a card with the profile list and its command buttons (New,
       Edit, Activate; Delete in red, apart), the server's refusal below the list; a lone Close. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static sdk:DeviceTexts.Provisioning}" Subtitle="{x:Static vm:ProvisioningTexts.Subtitle}" />

    <Border Grid.Row="1" Classes="card" Margin="16,0,16,16">
      <StackPanel Classes="form">
        <ui:FormField Label="{x:Static sdk:DeviceTexts.Provisioning}" Error="{Binding SwitchError}">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <ui:OnOffSwitch x:Name="OnSwitch" IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding ToggleCommand}"
                            ToolTip.Tip="{Binding SwitchTip}" />
            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding OnText}" IsVisible="{Binding HasOnText}" />
          </StackPanel>
        </ui:FormField>
        <ui:FormField Label="{x:Static vm:ProvisioningTexts.ActiveProfile}" Error="{Binding ActiveError}">
          <ComboBox x:Name="ActiveProfileChoice" ItemsSource="{Binding ActiveChoices}" SelectedItem="{Binding ActiveChoice}"
                    IsEnabled="{Binding IsIdle}" PlaceholderText="{x:Static vm:ProvisioningTexts.NoValidProfile}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileRow">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:FormField>
        <ItemsControl x:Name="Warnings" ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="warning" Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Margin="16,0">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ui:ToolbarOverflowPanel Spacing="4">
            <ui:ToolbarButton x:Name="NewButton" IconKey="add" Text="{x:Static vm:ProvisioningTexts.New}" Command="{Binding NewCommand}" />
            <ui:ToolbarButton x:Name="EditButton" IconKey="edit" Text="{x:Static vm:ProvisioningTexts.Edit}" Command="{Binding EditCommand}" />
            <ui:ToolbarButton x:Name="ActivateButton" IconKey="check" Text="{x:Static vm:ProvisioningTexts.Activate}" Command="{Binding ActivateCommand}"
                              ToolTip.Tip="{Binding ActivateTip}" ToolTip.ShowOnDisabled="True" />
          </ui:ToolbarOverflowPanel>
          <ui:ToolbarButton x:Name="DeleteButton" Grid.Column="1" Classes="danger" IconKey="remove" Text="{x:Static vm:ProvisioningTexts.Delete}"
                            Command="{Binding DeleteCommand}" />
        </Grid>

        <Panel Grid.Row="1">
          <DataGrid x:Name="ProfileGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserSortColumns="True"
                    CanUserReorderColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static vm:ProvisioningTexts.Name}" Width="*" Binding="{Binding Name}" x:DataType="vm:ProfileRow" />
              <DataGridTemplateColumn Header="{x:Static vm:ProvisioningTexts.State}" Width="170" CanUserSort="True" SortMemberPath="StateText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <ui:StatusChip Margin="10,0" Text="{Binding StateText}" IsOk="{Binding IsActive}" IsWarning="{Binding HasErrors}" IsVisible="{Binding HasState}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Classes="secondary" Text="{x:Static vm:ProvisioningTexts.NoProfiles}" IsVisible="{Binding ShowEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
        </Panel>

        <TextBlock Grid.Row="2" Classes="fieldMessage error" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <ui:LoadingOverlay Grid.Row="1" Grid.RowSpan="2" Text="{x:Static vm:ProvisioningTexts.Reading}" IsVisible="{Binding IsLoading}" />

    <ui:DialogFooter Grid.Row="3" CancelText="{x:Static vm:ProvisioningTexts.Close}" CancelCommand="{Binding CloseCommand}" />
  </Grid>
</Window>
