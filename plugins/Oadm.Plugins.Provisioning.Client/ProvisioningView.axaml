<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Provisioning.Client"
             xmlns:contract="using:Oadm.Plugins.Provisioning"
             x:Class="Oadm.Plugins.Provisioning.Client.ProvisioningView"
             x:DataType="vm:ProvisioningViewModel"
             ui:PageHeader.Subtitle="{x:Static vm:ProvisioningTexts.Subtitle}">
  <!-- Own cards (docs/spec/provisioning.md "The page"): the DHCP server on top; below it the cameras and, right of them, the
       flow of the camera clicked last (the shared node canvas, read only). Shared controls and theme classes only. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="16">

    <!-- The DHCP server: its state, interface and range; Turn on / Edit open its own page. The pool warning below. -->
    <Border x:Name="DhcpCard" Grid.Row="0" Classes="card">
      <StackPanel Spacing="8">
        <Grid Classes="titleRow" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="16">
          <TextBlock Grid.Column="0" Classes="cardTitle" Text="{x:Static vm:ProvisioningTexts.DhcpServer}" VerticalAlignment="Center" />
          <ui:StatusChip Grid.Column="1" VerticalAlignment="Center" Text="{Binding DhcpStatusText}" IsOk="{Binding DhcpIsRunning}" IsWarning="{Binding !DhcpIsRunning}" />
          <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding DhcpInterfaceText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding DhcpRangeText}" VerticalAlignment="Center" />
          <ui:ToolbarButton x:Name="DhcpButton" Grid.Column="4" IconKey="settings" Text="{Binding DhcpButtonText}" Command="{Binding OpenDhcpCommand}"
                            ToolTip.Tip="{x:Static vm:ProvisioningTexts.DhcpEditTip}" />
        </Grid>
        <ui:StatusChip x:Name="PoolWarning" IsWarning="True" Text="{Binding WarningText}" IsVisible="{Binding HasWarning}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Border x:Name="CamerasCard" Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
          <!-- Start or Stop, the active profile and Manage profiles left; the state of provisioning at the right end. -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" IsVisible="{Binding MayManage}">
              <ui:ToolbarButton x:Name="StartButton" IconKey="start" Text="{x:Static vm:ProvisioningTexts.StartProvisioning}" Command="{Binding StartCommand}"
                                IsVisible="{Binding IsStopped}" ToolTip.Tip="{Binding StartTip}" ToolTip.ShowOnDisabled="True" />
              <ui:ToolbarButton x:Name="StopButton" IconKey="stop" Text="{x:Static vm:ProvisioningTexts.StopProvisioning}" Command="{Binding StopCommand}"
                                IsVisible="{Binding IsStarted}" />
              <ui:ProgressRing Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="secondary" Text="{x:Static vm:ProvisioningTexts.Profile}" VerticalAlignment="Center" />
              <ComboBox x:Name="ProfileBox" Width="220" VerticalAlignment="Center" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}"
                        PlaceholderText="{x:Static vm:ProvisioningTexts.NoProfile}" IsEnabled="{Binding MayManage}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="contract:ProfileSummary">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <ui:StatusChip IsWarning="True" Text="{x:Static vm:ProvisioningTexts.HasErrors}" IsVisible="{Binding !IsValid}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <ui:ToolbarButton x:Name="ManageProfilesButton" Grid.Column="2" IconKey="settings" Text="{x:Static vm:ProvisioningTexts.ManageProfiles}"
                              Command="{Binding ManageProfilesCommand}" IsVisible="{Binding MayManage}" />
            <ui:StatusChip x:Name="StateChip" Grid.Column="4" VerticalAlignment="Center" Text="{Binding StateText}" IsOk="{Binding IsStarted}" />
          </Grid>

          <!-- The cameras: the actions on the selected rows left, the counts, the search right. -->
          <Grid Grid.Row="1" Classes="titleRow" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="{DynamicResource Oadm.GapTop}">
            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{x:Static vm:ProvisioningTexts.Cameras}" VerticalAlignment="Center" />
            <ui:ToolbarOverflowPanel Grid.Column="1" Spacing="4" IsVisible="{Binding MayManage}">
              <ui:ToolbarButton IconKey="refresh" Text="{x:Static vm:ProvisioningTexts.RunFailedAgain}" Command="{Binding RunFailedAgainCommand}"
                                ToolTip.Tip="{x:Static vm:ProvisioningTexts.RunFailedAgainTip}" />
              <ui:ToolbarButton IconKey="start" Text="{x:Static vm:ProvisioningTexts.Continue}" Command="{Binding ContinueCommand}"
                                ToolTip.Tip="{x:Static vm:ProvisioningTexts.ContinueTip}" />
              <ui:ToolbarSeparator />
              <ui:ToolbarButton Classes="danger" IconKey="remove" Text="{x:Static vm:ProvisioningTexts.Remove}" Command="{Binding RemoveCommand}"
                                ToolTip.Tip="{x:Static vm:ProvisioningTexts.RemoveTip}" />
            </ui:ToolbarOverflowPanel>
            <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding SummaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ui:SearchBox Grid.Column="3" Width="240" Text="{Binding SearchText}" Placeholder="{x:Static vm:ProvisioningTexts.SearchCameras}" />
          </Grid>

          <TextBlock Grid.Row="2" Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />

          <Panel Grid.Row="3">
            <DataGrid x:Name="CameraGrid" Classes="wrapRows" ItemsSource="{Binding Rows}" IsReadOnly="True" CanUserSortColumns="True"
                      CanUserReorderColumns="False" SelectionMode="Extended" MinHeight="160">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static vm:ProvisioningTexts.Time}" Width="150" Binding="{Binding TimeText}" SortMemberPath="TimeSortKey" x:DataType="vm:CameraRowViewModel" />
                <DataGridTextColumn Header="{x:Static vm:ProvisioningTexts.MacAddress}" Width="140" Binding="{Binding Mac}" x:DataType="vm:CameraRowViewModel" />
                <DataGridTextColumn Header="{x:Static vm:ProvisioningTexts.Model}" Width="1*" MinWidth="125" Binding="{Binding Model}" x:DataType="vm:CameraRowViewModel" />
                <DataGridTextColumn Header="{x:Static vm:ProvisioningTexts.Address}" Width="115" Binding="{Binding Address}" SortMemberPath="AddressSortKey" x:DataType="vm:CameraRowViewModel" />
                <DataGridTemplateColumn Header="{x:Static vm:ProvisioningTexts.State}" Width="175" CanUserSort="True" SortMemberPath="StateSortKey">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:CameraRowViewModel">
                      <ui:StatusChip Margin="10,0" Text="{Binding StateText}" MaxLines="2" IsOk="{Binding IsOk}" IsWarning="{Binding IsWarning}"
                                     IsError="{Binding IsError}" IsAccent="{Binding IsAccent}" IsInfo="{Binding IsInfo}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static vm:ProvisioningTexts.Node}" Width="0.9*" MinWidth="100" Binding="{Binding NodeText}" x:DataType="vm:CameraRowViewModel" />
                <DataGridTemplateColumn Header="{x:Static vm:ProvisioningTexts.Problem}" Width="2*" MinWidth="160" CanUserSort="True" SortMemberPath="Problem">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:CameraRowViewModel">
                      <TextBlock Margin="10,0" VerticalAlignment="Center" Text="{Binding Problem}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Problem}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyLine" Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding ShowEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
          </Panel>
        </Grid>
      </Border>

      <!-- The flow of the camera clicked last: every node of the session's profile with the camera's result (read only). -->
      <Border x:Name="FlowCard" Grid.Column="1" Classes="card" Width="400" Margin="16,0,0,0" IsVisible="{Binding HasFlow}">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid Classes="titleRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Classes="cardTitle" Text="{Binding FlowTitle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding FlowSubtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Classes="toolbar iconOnly" ToolTip.Tip="Close" Command="{Binding CloseFlowCommand}">
              <ui:OadmIcon Data="{DynamicResource Icon.close}" />
            </Button>
          </Grid>
          <Border Grid.Row="1" Classes="liveViewSurface" ClipToBounds="True">
            <ui:NodeChainCanvas x:Name="FlowCanvas" Chain="{Binding Flow}" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Until the first state arrived -->
    <ui:LoadingOverlay Grid.Row="0" Grid.RowSpan="2" Text="{x:Static vm:ProvisioningTexts.Reading}" IsVisible="{Binding IsLoading}" />
  </Grid>
</UserControl>
