{
  "formatVersion": 1,
  "category": "Video",
  "commands": [
    {
      "id": "video.streamprofiles.list",
      "version": 1,
      "name": "List stream profiles",
      "category": "Video",
      "description": "All stream profiles with their parameters.",
      "docs": "https://developer.axis.com/vapix/network-video/stream-profiles/",
      "requires": [
        {
          "api": "stream-profiles",
          "minVersion": "1.0"
        }
      ],
      "writes": false,
      "hasVideoOnly": true,
      "fields": [],
      "request": {
        "method": "POST",
        "path": "/axis-cgi/streamprofile.cgi",
        "bodyType": "json",
        "body": {
          "apiVersion": "1.0",
          "context": "oadm",
          "method": "list",
          "params": {
            "streamProfileName": []
          }
        },
        "timeoutSeconds": 15,
        "query": {},
        "headers": {}
      },
      "response": {
        "kind": "json-rpc",
        "extract": [
          {
            "label": "Profiles",
            "path": "data.streamProfile"
          }
        ]
      }
    },
    {
      "id": "video.streamprofile.create",
      "version": 1,
      "name": "Create stream profile",
      "category": "Video",
      "description": "Adds a stream profile, e.g. parameters videocodec=h264&resolution=1920x1080&fps=25.",
      "docs": "https://developer.axis.com/vapix/network-video/stream-profiles/",
      "requires": [
        {
          "api": "stream-profiles",
          "minVersion": "1.0"
        }
      ],
      "writes": true,
      "hasVideoOnly": true,
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "string",
          "default": "",
          "pattern": "^.{1,64}$"
        },
        {
          "name": "description",
          "label": "Description",
          "type": "string",
          "default": "",
          "required": false
        },
        {
          "name": "parameters",
          "label": "Stream parameters",
          "type": "string",
          "default": "videocodec=h264&resolution=1920x1080&fps=25"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/axis-cgi/streamprofile.cgi",
        "bodyType": "json",
        "body": {
          "apiVersion": "1.0",
          "context": "oadm",
          "method": "create",
          "params": {
            "streamProfile": [
              {
                "name": "{{name}}",
                "description": "{{description}}",
                "parameters": "{{parameters}}"
              }
            ]
          }
        },
        "timeoutSeconds": 15,
        "query": {},
        "headers": {}
      },
      "response": {
        "kind": "json-rpc"
      }
    },
    {
      "id": "video.streamprofile.remove",
      "version": 1,
      "name": "Remove stream profile",
      "category": "Video",
      "description": "Deletes a stream profile by name.",
      "docs": "https://developer.axis.com/vapix/network-video/stream-profiles/",
      "requires": [
        {
          "api": "stream-profiles",
          "minVersion": "1.0"
        }
      ],
      "writes": true,
      "hasVideoOnly": true,
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "string",
          "default": "",
          "pattern": "^.{1,64}$"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/axis-cgi/streamprofile.cgi",
        "bodyType": "json",
        "body": {
          "apiVersion": "1.0",
          "context": "oadm",
          "method": "remove",
          "params": {
            "streamProfileName": [
              {
                "name": "{{name}}"
              }
            ]
          }
        },
        "timeoutSeconds": 15,
        "query": {},
        "headers": {}
      },
      "response": {
        "kind": "json-rpc"
      }
    },
    {
      "id": "video.stream.get",
      "version": 1,
      "name": "Get video stream settings",
      "category": "Video",
      "description": "Resolution, compression, frame rate, rotation, rate control and Zipstream of one channel.",
      "docs": "https://developer.axis.com/vapix/network-video/parameter-management/",
      "requires": [
        {
          "api": "param-cgi",
          "minVersion": "1.0"
        }
      ],
      "writes": false,
      "hasVideoOnly": true,
      "fields": [
        {
          "name": "channel",
          "label": "Video channel",
          "type": "integer",
          "default": 0,
          "min": 0,
          "max": 7,
          "description": "Image.I# index, 0 = first view area / channel."
        }
      ],
      "request": {
        "method": "GET",
        "path": "/axis-cgi/param.cgi",
        "query": {
          "action": "list",
          "group": "Image.I{{channel}}"
        },
        "headers": {},
        "bodyType": "none",
        "body": null,
        "timeoutSeconds": 15
      },
      "response": {
        "kind": "param-cgi",
        "extract": [
          {
            "label": "Resolution",
            "param": "Image.I{{channel}}.Appearance.Resolution"
          },
          {
            "label": "Compression",
            "param": "Image.I{{channel}}.Appearance.Compression"
          },
          {
            "label": "FPS",
            "param": "Image.I{{channel}}.Stream.FPS"
          },
          {
            "label": "Rotation",
            "param": "Image.I{{channel}}.Appearance.Rotation"
          },
          {
            "label": "Bitrate mode",
            "param": "Image.I{{channel}}.RateControl.Mode"
          },
          {
            "label": "Zipstream strength",
            "param": "Image.I{{channel}}.MPEG.ZStrength"
          },
          {
            "label": "GOP length (P count)",
            "param": "Image.I{{channel}}.MPEG.PCount"
          }
        ]
      }
    },
    {
      "id": "video.resolution.set",
      "version": 1,
      "name": "Set default resolution",
      "category": "Video",
      "description": "Default resolution of a video channel.",
      "docs": "https://developer.axis.com/vapix/network-video/parameter-management/",
      "requires": [
        {
          "api": "param-cgi",
          "minVersion": "1.0"
        }
      ],
      "writes": true,
      "hasVideoOnly": true,
      "fields": [
        {
          "name": "channel",
          "label": "Video channel",
          "type": "integer",
          "default": 0,
          "min": 0,
          "max": 7,
          "description": "Image.I# index, 0 = first view area / channel."
        },
        {
          "name": "resolution",
          "label": "Resolution",
          "type": "string",
          "default": "1920x1080",
          "pattern": "^[0-9]+x[0-9]+$"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/axis-cgi/param.cgi",
        "query": {
          "action": "update",
          "Image.I{{channel}}.Appearance.Resolution": "{{resolution}}"
        },
        "headers": {},
        "bodyType": "none",
        "body": null,
        "timeoutSeconds": 15
      },
      "response": {
        "kind": "param-cgi",
        "success": "OK"
      }
    },
