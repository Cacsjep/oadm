{
  "formatVersion": 1,
  "category": "Image",
  "commands": [
    {
      "id": "image.settings.get",
      "version": 1,
      "name": "Get image settings",
      "category": "Image",
      "description": "Brightness, contrast, saturation, sharpness, WDR, white balance and exposure of a sensor.",
      "docs": "https://developer.axis.com/vapix/network-video/imaging-api/",
      "requires": [
        {
          "api": "param-cgi",
          "minVersion": "1.0"
        }
      ],
      "writes": false,
      "hasVideoOnly": true,
      "fields": [
        {
          "name": "source",
          "label": "Image source",
          "type": "integer",
          "default": 0,
          "min": 0,
          "max": 7,
          "description": "ImageSource.I# index, 0 = first sensor."
        }
      ],
      "request": {
        "method": "GET",
        "path": "/axis-cgi/param.cgi",
        "query": {
          "action": "list",
          "group": "ImageSource.I{{source}}"
        },
        "headers": {},
        "bodyType": "none",
        "body": null,
        "timeoutSeconds": 15
      },
      "response": {
        "kind": "param-cgi",
        "extract": [
          {
            "label": "Brightness",
            "param": "ImageSource.I{{source}}.Sensor.Brightness"
          },
          {
            "label": "Contrast",
            "param": "ImageSource.I{{source}}.Sensor.Contrast"
          },
          {
            "label": "Saturation",
            "param": "ImageSource.I{{source}}.Sensor.ColorLevel"
          },
          {
            "label": "Sharpness",
            "param": "ImageSource.I{{source}}.Sensor.Sharpness"
          },
          {
            "label": "WDR",
            "param": "ImageSource.I{{source}}.Sensor.WDR"
          },
          {
            "label": "White balance",
            "param": "ImageSource.I{{source}}.Sensor.WhiteBalance"
          },
          {
            "label": "Exposure",
            "param": "ImageSource.I{{source}}.Sensor.Exposure"
          },
          {
            "label": "Max gain",
            "param": "ImageSource.I{{source}}.Sensor.MaxGain"
          },
          {
            "label": "IR cut filter",
            "param": "ImageSource.I{{source}}.DayNight.IrCutFilter"
          },
          {
            "label": "Day/night shift level",
            "param": "ImageSource.I{{source}}.DayNight.ShiftLevel"
          }
        ]
      }
    },
