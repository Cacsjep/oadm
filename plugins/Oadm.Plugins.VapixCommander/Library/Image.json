    {
      "id": "image.daynight.get",
      "version": 1,
      "name": "Get day/night configuration",
      "category": "Image",
      "description": "Shift level and dwell times of a channel.",
      "docs": "https://developer.axis.com/vapix/network-video/daynight-api/",
      "requires": [
        {
          "api": "daynight",
          "minVersion": "1.0"
        }
      ],
      "writes": false,
      "hasVideoOnly": true,
      "fields": [
        {
          "name": "source",
          "label": "Image source",
          "type": "integer",
          "default": 0,
          "min": 0,
          "max": 7,
          "description": "ImageSource.I# index, 0 = first sensor."
        }
      ],
      "request": {
        "method": "POST",
        "path": "/axis-cgi/daynight.cgi",
        "bodyType": "json",
        "body": {
          "apiVersion": "1.0",
          "context": "oadm",
          "method": "getConfiguration",
          "params": {
            "channel": "{{source}}"
          }
        },
        "timeoutSeconds": 15,
        "query": {},
        "headers": {}
      },
      "response": {
        "kind": "json-rpc",
        "extract": [
          {
            "label": "Day to night level",
            "path": "data.0.DayNightShiftLevel"
          },
          {
            "label": "Day to night dwell (s)",
            "path": "data.0.DayNightDwellTime"
          },
          {
            "label": "Night to day dwell (s)",
            "path": "data.0.NightDayDwellTime"
          }
        ]
      }
    },
