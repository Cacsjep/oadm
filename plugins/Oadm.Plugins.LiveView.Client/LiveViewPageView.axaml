<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.LiveView.Client"
             x:Class="Oadm.Plugins.LiveView.Client.LiveViewPageView"
             x:DataType="vm:LiveViewPageViewModel"
             ui:PageHeader.IsHidden="True">
  <!-- No page header (every pixel for the video). Own cards: the saved views (Edit and Delete in each row) and the cameras on the left, the open views as tabs on the
       right (one row: Close all, while editing Name / Save / Cancel, the tabs; then the grid of the active view, edge to edge). -->
  <Panel x:Name="Root">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

      <!-- Views on top, the cameras grouped by tag below; a click on a view opens it, a camera is dragged into a view.
           Collapsed like the navigation rail: a narrow card with the views as icons. -->
      <Border Grid.Column="0" Classes="card viewsPanel" Classes.collapsed="{Binding IsPanelCollapsed}">
        <DockPanel>
        <!-- At the bottom like the navigation rail's toggle -->
        <Button DockPanel.Dock="Bottom" Classes="toolbar viewsToggle" Command="{Binding TogglePanelCommand}" ToolTip.Tip="{Binding PanelToggleText}">
          <Panel>
            <ui:IconLabel Icon="{StaticResource Icon.panelOpen}" Text="{Binding PanelToggleText}" IsTextVisible="False" IsVisible="{Binding IsPanelCollapsed}" />
            <ui:IconLabel Icon="{StaticResource Icon.panelClose}" Text="{Binding PanelToggleText}" IsVisible="{Binding !IsPanelCollapsed}" />
          </Panel>
        </Button>
        <Panel>
        <StackPanel Classes="viewsCollapsed" IsVisible="{Binding IsPanelCollapsed}">
          <Button Classes="toolbar iconOnly" Command="{Binding NewViewCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="New view">
            <ui:OadmIcon Data="{StaticResource Icon.gridAdd}" />
          </Button>
          <ListBox x:Name="CollapsedViewList" Classes="deviceTree" ItemsSource="{Binding Views}" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ViewEntry">
                <ui:OadmIcon Data="{StaticResource Icon.grid}" Width="16" Height="16" ToolTip.Tip="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,2*" RowSpacing="8" IsVisible="{Binding !IsPanelCollapsed}">
          <ui:CardHeader Grid.Row="0" Title="Views">
            <Button Classes="toolbar iconOnly" Command="{Binding NewViewCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="New view">
              <ui:OadmIcon Data="{StaticResource Icon.gridAdd}" />
            </Button>
          </ui:CardHeader>
          <Panel Grid.Row="1">
            <TextBlock Classes="secondary" Text="{Binding NoViewsText}" TextWrapping="Wrap" IsVisible="{Binding ShowNoViews}" />
            <ListBox x:Name="ViewList" Classes="deviceTree" ItemsSource="{Binding Views}" SelectionMode="Single">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewEntry">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <ui:OadmIcon Grid.Column="0" Data="{StaticResource Icon.grid}" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- Right at the edge, close together -->
                    <StackPanel Grid.Column="2" Classes="rowActions" IsVisible="{Binding $parent[UserControl].((vm:LiveViewPageViewModel)DataContext).MayManage}">
                    <Button Classes="toolbar iconOnly" ToolTip.Tip="Edit view" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].((vm:LiveViewPageViewModel)DataContext).EditViewCommand}">
                      <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                    </Button>
                    <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete view" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].((vm:LiveViewPageViewModel)DataContext).DeleteViewCommand}">
                      <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                    </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
          <TextBlock Grid.Row="2" Classes="error" Text="{Binding LoadError}" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
          <ui:CardHeader Grid.Row="3" Title="Cameras" />
          <ui:SearchBox Grid.Row="4" Classes="stretch" Text="{Binding SearchText}" Placeholder="Search cameras" />
          <Panel Grid.Row="5">
            <TextBlock Classes="secondary" Text="{x:Static vm:LiveViewTexts.NoCameras}" TextWrapping="Wrap" IsVisible="{Binding !HasCameras}" />
            <ui:DeviceTree x:Name="Tree" Model="{Binding Tree}" IsVisible="{Binding HasCameras}" />
          </Panel>
        </Grid>
        </Panel>
        </DockPanel>
      </Border>

      <!-- The open views: one row of actions and tabs, then the grid of the active view -->
      <Border Grid.Column="1" Classes="card" Padding="0,12,0,0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" Margin="12,0" ColumnDefinitions="Auto,Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
              <Button Classes="toolbar iconOnly" Command="{Binding CloseAllTabsCommand}" ToolTip.Tip="Close all tabs">
                <ui:OadmIcon Data="{StaticResource Icon.close}" />
              </Button>
            </StackPanel>

            <!-- Editing: the name (error below it), Save and Cancel -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Top"
                        DataContext="{Binding ActiveTab}" IsVisible="{Binding IsEditing, FallbackValue=False}" x:DataType="vm:ViewTab">
              <ui:FormField Classes="inline" Label="Name" InputWidth="220">
                <TextBox Text="{Binding Name}" MaxLength="64" />
              </ui:FormField>
              <Button Classes="primary" Command="{Binding $parent[UserControl].((vm:LiveViewPageViewModel)DataContext).SaveViewCommand}" VerticalAlignment="Top">
                <ui:IconLabel Icon="{StaticResource Icon.save}" Text="Save" />
              </Button>
              <Button Classes="secondary" Content="Cancel" VerticalAlignment="Top"
                      Command="{Binding $parent[UserControl].((vm:LiveViewPageViewModel)DataContext).CancelEditCommand}" />
            </StackPanel>

            <!-- One row of tabs; scrolls sideways when they do not fit -->
            <ScrollViewer Grid.Column="2" Margin="8,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ViewTab">
                    <ui:PageTab Title="{Binding Title}" IsActive="{Binding IsActive}" ToolTip.Tip="{Binding ToolTip}"
                                ActivateCommand="{Binding ActivateCommand}" CloseCommand="{Binding CloseCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- A refused save or drop of the active view -->
          <TextBlock Grid.Row="1" Margin="12,8,12,0" Classes="error" TextWrapping="Wrap" Text="{Binding ActiveTab.Error, FallbackValue={x:Null}}"
                     IsVisible="{Binding ActiveTab.HasError, FallbackValue=False}" />
          <TextBlock Grid.Row="1" Margin="12,8,12,0" Classes="secondary" TextWrapping="Wrap" Text="{Binding ActiveTab.Notice, FallbackValue={x:Null}}"
                     IsVisible="{Binding ActiveTab.HasNotice, FallbackValue=False}" />

          <Panel Grid.Row="2" Margin="0,5,0,0">
            <TextBlock Classes="secondary" Text="{x:Static vm:LiveViewTexts.NoTabs}" IsVisible="{Binding ShowNoTabs}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- The grid of every open view stays alive, only the active one is shown -->
            <Panel x:Name="Pages" />
            <TextBlock Classes="secondary" Text="{x:Static vm:LiveViewTexts.EmptyView}" IsVisible="{Binding ActiveTab.ShowEmptyHint, FallbackValue=False}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <ui:StatusChip IsError="True" Text="{Binding PictureProblem}" IsVisible="{Binding HasPictureProblem}" MaxLines="4"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" IsHitTestVisible="False" />
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <!-- The camera being dragged from the tree follows the pointer -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="DragGhost" Classes="dragGhost" IsVisible="False">
        <TextBlock x:Name="DragGhostText" />
      </Border>
    </Canvas>
  </Panel>
</UserControl>
