<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Dashboards.Client"
             xmlns:m="using:Oadm.Plugins.Dashboards"
             x:Class="Oadm.Plugins.Dashboards.Client.DashboardsPageView"
             x:DataType="vm:DashboardsPageViewModel"
             ui:PageHeader.IsHidden="True"
             Focusable="True">
  <!-- Like Live View: no page header. Left card: the dashboards, the cameras and the events with values; right card: one row
       (Close all, while editing Name / Save / Cancel, the tabs), then the grid of the active dashboard and, while editing,
       the panel of the selected widget. -->
  <Panel x:Name="Root">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

      <Border Grid.Column="0" Classes="card viewsPanel" Classes.collapsed="{Binding IsPanelCollapsed}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Classes="toolbar viewsToggle" Command="{Binding TogglePanelCommand}" ToolTip.Tip="{Binding PanelToggleText}">
            <Panel>
              <ui:IconLabel Icon="{StaticResource Icon.panelOpen}" Text="{Binding PanelToggleText}" IsTextVisible="False" IsVisible="{Binding IsPanelCollapsed}" />
              <ui:IconLabel Icon="{StaticResource Icon.panelClose}" Text="{Binding PanelToggleText}" IsVisible="{Binding !IsPanelCollapsed}" />
            </Panel>
          </Button>
          <Panel>
            <StackPanel Classes="viewsCollapsed" IsVisible="{Binding IsPanelCollapsed}">
              <Button Classes="toolbar iconOnly" Command="{Binding NewDashboardCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="New dashboard">
                <ui:OadmIcon Data="{StaticResource Icon.add}" />
              </Button>
              <ListBox x:Name="CollapsedDashboardList" Classes="deviceTree" ItemsSource="{Binding Dashboards}" SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashboardEntry">
                    <ui:OadmIcon Data="{StaticResource Icon.gauge}" Width="16" Height="16" ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,3*" RowSpacing="8" IsVisible="{Binding !IsPanelCollapsed}">
              <ui:CardHeader Grid.Row="0" Title="Dashboards">
                <Button Classes="toolbar iconOnly" Command="{Binding NewDashboardCommand}" IsVisible="{Binding MayManage}" ToolTip.Tip="New dashboard">
                  <ui:OadmIcon Data="{StaticResource Icon.add}" />
                </Button>
              </ui:CardHeader>
              <Panel Grid.Row="1">
                <TextBlock Classes="secondary" Text="{Binding NoDashboardsText}" TextWrapping="Wrap" IsVisible="{Binding ShowNoDashboards}" />
                <ListBox x:Name="DashboardList" Classes="deviceTree" ItemsSource="{Binding Dashboards}" SelectionMode="Single">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardEntry">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ui:OadmIcon Grid.Column="0" Data="{StaticResource Icon.gauge}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Classes="rowActions" IsVisible="{Binding $parent[UserControl].((vm:DashboardsPageViewModel)DataContext).MayManage}">
                          <Button Classes="toolbar iconOnly" ToolTip.Tip="Edit dashboard" CommandParameter="{Binding}"
                                  Command="{Binding $parent[UserControl].((vm:DashboardsPageViewModel)DataContext).EditDashboardCommand}">
                            <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                          </Button>
                          <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete dashboard" CommandParameter="{Binding}"
                                  Command="{Binding $parent[UserControl].((vm:DashboardsPageViewModel)DataContext).DeleteDashboardCommand}">
                            <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
              <TextBlock Grid.Row="2" Classes="error" Text="{Binding LoadError}" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
              <ui:CardHeader Grid.Row="3" Title="Events" />
              <ui:SearchBox Grid.Row="4" Classes="stretch" Text="{Binding EventSearch}" Placeholder="Search events" />
              <Panel Grid.Row="5">
                <TextBlock Classes="secondary" Text="{x:Static m:DashboardTexts.NoEvents}" TextWrapping="Wrap" IsVisible="{Binding !HasEvents}" />
                <ListBox x:Name="EventList" Classes="deviceTree" ItemsSource="{Binding Events}" SelectionMode="Single" IsVisible="{Binding HasEvents}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EventListItem">
                      <Panel>
                        <TextBlock Classes="navGroup" Text="{Binding Header}" IsVisible="{Binding IsHeader}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsEvent}" ToolTip.Tip="{Binding FieldsText}">
                          <ui:OadmIcon Grid.Column="0" Data="{StaticResource Icon.zap}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="secondary small" Text="{Binding FieldsText}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </Grid>
          </Panel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="0,12,0,0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" Margin="12,0" ColumnDefinitions="Auto,Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
              <Button Classes="toolbar iconOnly" Command="{Binding CloseAllTabsCommand}" ToolTip.Tip="Close all tabs">
                <ui:OadmIcon Data="{StaticResource Icon.close}" />
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Top"
                        DataContext="{Binding ActiveTab}" IsVisible="{Binding IsEditing, FallbackValue=False}" x:DataType="vm:DashboardTab">
              <ui:FormField Classes="inline" Label="Name" InputWidth="220">
                <TextBox Text="{Binding Name}" MaxLength="64" />
              </ui:FormField>
              <Button Classes="primary" Command="{Binding $parent[UserControl].((vm:DashboardsPageViewModel)DataContext).SaveDashboardCommand}" VerticalAlignment="Top">
                <ui:IconLabel Icon="{StaticResource Icon.save}" Text="Save" />
              </Button>
              <Button Classes="secondary" Content="Cancel" VerticalAlignment="Top"
                      Command="{Binding $parent[UserControl].((vm:DashboardsPageViewModel)DataContext).CancelEditCommand}" />
              <Button Classes="secondary" VerticalAlignment="Top" ToolTip.Tip="Live video of one or several cameras"
                      Command="{Binding $parent[UserControl].((vm:DashboardsPageViewModel)DataContext).AddCamerasCommand}">
                <ui:IconLabel Icon="{StaticResource Icon.video}" Text="Add cameras" />
              </Button>
            </StackPanel>

            <ScrollViewer Grid.Column="2" Margin="8,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashboardTab">
                    <ui:PageTab Title="{Binding Title}" IsActive="{Binding IsActive}" ToolTip.Tip="{Binding ToolTip}"
                                ActivateCommand="{Binding ActivateCommand}" CloseCommand="{Binding CloseCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <TextBlock Grid.Row="1" Margin="12,8,12,0" Classes="error" TextWrapping="Wrap" Text="{Binding ActiveTab.Error, FallbackValue={x:Null}}"
                     IsVisible="{Binding ActiveTab.HasError, FallbackValue=False}" />

          <Grid Grid.Row="2" Margin="0,5,0,0" ColumnDefinitions="*,Auto">
            <Panel Grid.Column="0">
              <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEmptyState}" MaxWidth="520">
                <TextBlock Classes="secondary" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding OpenTriggersCommand}" IsVisible="{Binding ShowOpenTriggers}">
                  <ui:IconLabel Icon="{StaticResource Icon.flame}" Text="Open Device triggers" />
                </Button>
              </StackPanel>
              <Panel x:Name="Pages" />
              <TextBlock Classes="secondary" Text="{x:Static m:DashboardTexts.EmptyDashboard}" IsVisible="{Binding ActiveTab.ShowEmptyHint, FallbackValue=False}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Panel>

            <!-- The panel of the selected widget, right of the grid while editing -->
            <Border Grid.Column="1" Classes="dashboardPanel" IsVisible="{Binding ActiveTab.ShowPanel, FallbackValue=False}">
              <Panel>
                <TextBlock Classes="secondary" Text="{x:Static m:DashboardTexts.ChooseWidget}" TextWrapping="Wrap"
                           IsVisible="{Binding !ActiveTab.HasPanel, FallbackValue=False}" />
                <ScrollViewer IsVisible="{Binding ActiveTab.HasPanel, FallbackValue=False}" HorizontalScrollBarVisibility="Disabled">
                  <!-- A new panel for every selection (WidgetEditorView, GroupEditorView): select fields never carry one widget's choice to the next -->
                  <ContentControl x:Name="EditorHost" Content="{Binding ActiveTab.Panel, FallbackValue={x:Null}}" />
                </ScrollViewer>
              </Panel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- The event or camera being dragged follows the pointer -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="DragGhost" Classes="dragGhost" IsVisible="False">
        <TextBlock x:Name="DragGhostText" />
      </Border>
    </Canvas>
  </Panel>

</UserControl>
