<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:vm="using:Oadm.Plugins.Dashboards.Client"
             x:Class="Oadm.Plugins.Dashboards.Client.GroupEditorView"
             x:DataType="vm:GroupEditorViewModel">
  <!-- The panel of several selected widgets: copy and remove for all, the size, then only the settings they share
       ("Mixed" where they differ) -->
  <UserControl.Resources>
    <DataTemplate x:Key="DashboardColorTemplate" x:DataType="vm:ColorOption">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="colorSwatch" Background="{Binding Brush}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DashboardIconTemplate" x:DataType="vm:IconOption">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ui:OadmIcon Data="{Binding Data}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Classes="compactForm" Spacing="10" Margin="0,0,12,0">
    <ui:CardHeader Title="{Binding Title}">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="toolbar iconOnly" Command="{Binding CopyForDevicesCommand}" IsVisible="{Binding CanCopy}" ToolTip.Tip="Copy for other devices">
          <ui:OadmIcon Data="{StaticResource Icon.copy}" />
        </Button>
        <Button Classes="toolbar iconOnly danger" Command="{Binding RemoveAllCommand}" ToolTip.Tip="Remove widgets">
          <ui:OadmIcon Data="{StaticResource Icon.remove}" />
        </Button>
      </StackPanel>
    </ui:CardHeader>

    <ui:FormField Classes="wide" Label="Width" Hint="Cells (2 to 20)">
      <TextBox Text="{Binding WidthText}" PlaceholderText="{Binding WidthWatermark}" MaxLength="2" />
    </ui:FormField>
    <ui:FormField Classes="wide" Label="Height" Hint="Cells (2 to 20)">
      <TextBox Text="{Binding HeightText}" PlaceholderText="{Binding HeightWatermark}" MaxLength="2" />
    </ui:FormField>
    <ui:FormField Classes="wide" Label="Show name" IsVisible="{Binding ShowValueSettings}">
      <ComboBox ItemsSource="{Binding YesNoChoices}" SelectedItem="{Binding ShowNameChoice}" PlaceholderText="Mixed" />
    </ui:FormField>

    <StackPanel Spacing="10" IsVisible="{Binding ShowOnOff}">
      <ui:FormField Classes="wide" Label="On icon">
        <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding OnIcon}" PlaceholderText="Mixed" ItemTemplate="{StaticResource DashboardIconTemplate}" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="On color">
        <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding OnColor}" PlaceholderText="Mixed" ItemTemplate="{StaticResource DashboardColorTemplate}" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="On text" Hint="Optional">
        <TextBox Text="{Binding OnText}" PlaceholderText="{Binding OnTextWatermark}" MaxLength="64" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Off icon">
        <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding OffIcon}" PlaceholderText="Mixed" ItemTemplate="{StaticResource DashboardIconTemplate}" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Off color">
        <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding OffColor}" PlaceholderText="Mixed" ItemTemplate="{StaticResource DashboardColorTemplate}" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Off text" Hint="Optional">
        <TextBox Text="{Binding OffText}" PlaceholderText="{Binding OffTextWatermark}" MaxLength="64" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Icon size" Hint="{Binding IconSizeText}">
        <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding IconSizeValue}" />
      </ui:FormField>
    </StackPanel>

    <ui:FormField Classes="wide" Label="Font size" Hint="{Binding FontSizeText}" IsVisible="{Binding ShowText}">
      <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding FontSizeValue}" />
    </ui:FormField>
    <ui:FormField Classes="wide" Label="Color" IsVisible="{Binding ShowColor}">
      <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding Color}" PlaceholderText="Mixed" ItemTemplate="{StaticResource DashboardColorTemplate}" />
    </ui:FormField>

    <StackPanel Spacing="10" IsVisible="{Binding ShowGauge}">
      <ui:FormField Classes="wide" Label="Min">
        <TextBox Text="{Binding MinText}" PlaceholderText="{Binding MinWatermark}" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Max">
        <TextBox Text="{Binding MaxText}" PlaceholderText="{Binding MaxWatermark}" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Line width" Hint="{Binding LineWidthText}">
        <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LineWidthValue}" />
      </ui:FormField>
    </StackPanel>

    <StackPanel Spacing="10" IsVisible="{Binding ShowNumber}">
      <ui:FormField Classes="wide" Label="Decimal places">
        <ComboBox ItemsSource="{Binding DecimalChoices}" SelectedItem="{Binding Decimals}" PlaceholderText="Mixed" />
      </ui:FormField>
      <ui:FormField Classes="wide" Label="Unit" Hint="Optional">
        <TextBox Text="{Binding Unit}" PlaceholderText="{Binding UnitWatermark}" MaxLength="10" />
      </ui:FormField>
    </StackPanel>
  </StackPanel>
</UserControl>
